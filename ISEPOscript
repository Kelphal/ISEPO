ISE.PlatformEngine.retryFailed =
function()
{
    var keys =
        Object.keys(
            ISE.PlatformEngine
                .failedQuestions
        );

    var results =
        [];

    for(
        var i = 0;
        i < keys.length;
        i++
    )
    {
        var question =
            ISE.PlatformEngine
                .failedQuestions[
                    keys[i]
                ];

        if(
            !question
        )
        {
            continue;
        }

        /*
         * The DOM may have been replaced.
         * Re-discovering is safer than blindly
         * using the old element.
         */

        var currentQuestions =
            ISE.PlatformEngine
                .fullDiscover();

        for(
            var j = 0;
            j < currentQuestions.length;
            j++
        )
        {
            var current =
                currentQuestions[j];

            if(
                ISE.PlatformEngine
                    .normalize(
                        current.text
                    ) ===
                ISE.PlatformEngine
                    .normalize(
                        question.text
                    )
            )
            {
                results.push(
                    ISE.PlatformEngine
                        .processQuestion(
                            current
                        )
                );

                break;
            }
        }
    }

    return results;
};


