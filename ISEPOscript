/* ------------------------------------------------------------
   CATEGORY DETECTION
   ------------------------------------------------------------ */

ISE.AnswerEngine.detectCategory = function (questionText) {

    var text = ISE.SemanticEngine.normalize(questionText);

    if (!text) {
        return null;
    }

    var categories = Object.keys(ISE.AnswerEngine.patterns);

    var bestCategory = null;
    var bestScore = 0;

    for (var i = 0; i < categories.length; i++) {

        var category = categories[i];
        var patterns = ISE.AnswerEngine.patterns[category];

        for (var j = 0; j < patterns.length; j++) {

            var pattern = patterns[j];
            var score = 0;

            if (ISE.SemanticEngine.hasPhrase(text, pattern)) {
                score = 1;
            } else {

                var overlap =
                    ISE.SemanticEngine.tokenOverlap(text, pattern);

                if (overlap >= 0.65) {
                    score = overlap;
                }
            }

            if (score > bestScore) {
                bestScore = score;
                bestCategory = category;
            }
        }
    }

    if (!bestCategory) {
        return null;
    }

    return {
        category: bestCategory,
        confidence: bestScore
    };
};


