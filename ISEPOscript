            date.getFullYear();

        var monthDifference =
            now.getMonth() -
            date.getMonth();

        if (
            monthDifference < 0 ||
            (
                monthDifference === 0 &&
                now.getDate() < date.getDate()
            )
        ) {
            age--;
        }

        return age;
    }


