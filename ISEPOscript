ISE.classifier = {};

ISE.classifier.detectMedicalDiagnosis =
function (text) {

    const normalized =
        ISE.text.expandContractions(
            text
        );

    if (!normalized) {
        return {
            matched: false,
            confidence: 0
        };
    }

    let score = 0;

    let phraseMatches = 0;

    for (
        const phrase
        of ISE.MEDICAL.diagnosisPhrases
    ) {

        if (
            normalized.includes(
                ISE.text.normalize(phrase)
            )
        ) {

            phraseMatches++;

            score += 0.20;
        }
    }

    const medicalMatches =
        ISE.text.countMatches(
            normalized,
            ISE.MEDICAL.medicalContext
        );

    score +=
        Math.min(
            medicalMatches * 0.08,
            0.40
        );

    if (
        normalized.includes("?")
    ) {
        score += 0.05;
    }

    if (
        normalized.includes("following")
    ) {
        score += 0.08;
    }

    if (
        normalized.includes("any")
    ) {
        score += 0.08;
    }

    if (
        normalized.includes("ever")
    ) {
        score += 0.05;
    }

    score =
        Math.min(
            score,
            1
        );

    return {
        matched:
            phraseMatches > 0 ||
            (
                medicalMatches >= 2 &&
                normalized.includes(
                    "diagnos"
                )
            ),

        confidence: score,

        category:
            "medical_diagnosis",

        profileField:
            "diagnosedConditions"
    };
};


