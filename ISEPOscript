/* ------------------------------------------------------------
   SHOULD RETRY
   ------------------------------------------------------------ */

ISE.RecoveryEngine.shouldRetry =
function(
    question,
    result
)
{
    if(
        !question
    )
    {
        return false;
    }

    var type =
        ISE.RecoveryEngine
            .classifyFailure(
                result
            );

    /*
     * Unsupported questions should never be retried
     * indefinitely. They remain unsupported.
     */

    if(
        type ===
        "unsupported"
    )
    {
        return false;
    }

    var count =
        ISE.RecoveryEngine
            .attemptCount(
                question
            );

    if(
        count >=
        ISE.RecoveryEngine
            .retryPolicy
            .maxAttempts
    )
    {
        return false;
    }

    return true;
};


/* ------------------------------------------------------------
   RETRY QUESTION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.retryQuestion =
function(
    question,
    answer,
    reason
)
{
    if(
        !question
    )
    {
        return false;
    }

    if(
        !ISE.RecoveryEngine
            .shouldRetry(
                question,
                {
                    reason:
                        reason || ""
                }
            )
    )
    {
        return false;
    }

    var count =
        ISE.RecoveryEngine
            .attemptCount(
                question
            );

    var delays =
        ISE.RecoveryEngine
            .retryPolicy
            .delays;

    var index =
        Math.min(
            count,
            delays.length - 1
        );

    var delay =
        delays[index];

    ISE.RecoveryEngine
        .statistics
        .retried++;

    ISE.RecoveryEngine
        .statistics
        .delayedRetries++;

    ISE.RecoveryEngine
        .delay(
            delay,
            function()
            {
                if(
                    !ISE.RecoveryEngine
                        .isQuestionAlive(
                            question
                        )
                )
                {
                    ISE.RecoveryEngine
                        .statistics
                        .staleQuestions++;

                    return;
                }

                ISE.RecoveryEngine
                    .process(
                        question,
                        answer,
                        true
                    );
            }
        );

    return true;
};


/* ------------------------------------------------------------
   SPECIALIZED RETRY
   ------------------------------------------------------------ */

ISE.RecoveryEngine.retrySpecialized =
function(
    question,
    answer
)
{
    if(
        !question
    )
    {
        return false;
    }

    ISE.RecoveryEngine
        .delay(
            350,
            function()
            {
                try
                {
                    if(
                        ISE.SpecializedSurvey &&
                        typeof ISE.SpecializedSurvey
                            .process ===
                        "function"
                    )
                    {
                        ISE.SpecializedSurvey
                            .process(
                                question.text,
                                question.container
                            );
                    }
                }
                catch(error)
                {
                    ISE.RecoveryEngine
                        .statistics
                        .exceptions++;
                }
            }
        );

    return true;
};


/* ------------------------------------------------------------
   STANDARD ENGINE PROCESSOR
   ------------------------------------------------------------ */

ISE.RecoveryEngine.callAutofill =
function(
    question,
    answer
)
{
    /*
     * Platform engine gets first opportunity.
     */

    if(
        ISE.PlatformEngine &&
        typeof ISE.PlatformEngine
            .autofillQuestion ===
        "function"
    )
    {
        try
        {
            var platformResult =
                ISE.PlatformEngine
                    .autofillQuestion(
                        question,
                        answer
                    );

            if(
                platformResult &&
                platformResult.success
            )
            {
                return platformResult;
            }
        }
        catch(error)
        {
            ISE.RecoveryEngine
                .statistics
                .exceptions++;
        }
    }

    /*
     * Existing general autofill engine.
     */

    if(
        ISE.AutofillEngine &&
        typeof ISE.AutofillEngine
            .processQuestion ===
        "function"
    )
    {
        try
        {
            return ISE.AutofillEngine
                .processQuestion(
                    question
                );
        }
        catch(error)
        {
            ISE.RecoveryEngine
                .statistics
                .exceptions++;

            return {
                success:
                    false,

                reason:
                    "Autofill exception."
            };
        }
    }

    return {
        success:
            false,

        reason:
            "No autofill engine available."
    };
};


/* ------------------------------------------------------------
   MASTER PROCESS
   ------------------------------------------------------------ */

ISE.RecoveryEngine.process =
function(
    question,
    suppliedAnswer,
    isRetry
)
{
    if(
        ISE.RecoveryEngine
            .processing
    )
    {
        /*
         * Queue instead of recursively processing
         * multiple questions at once.
         */

        ISE.RecoveryEngine
            .queue
            .push(
            {
                question:
                    question,

                answer:
                    suppliedAnswer,

                retry:
                    isRetry === true
            }
        );

        return {
            success:
                false,

            queued:
                true
        };
    }

    ISE.RecoveryEngine
        .processing = true;

    try
    {
        if(
            !question
        )
        {
            return {
                success:
                    false,

                reason:
                    "Missing question."
            };
        }

        if(
            !ISE.RecoveryEngine
                .isQuestionAlive(
                    question
                )
        )
        {
            ISE.RecoveryEngine
                .statistics
                .staleQuestions++;

            return {
                success:
                    false,

                reason:
                    "Question is no longer connected."
            };
        }

        /*
         * Resolve answer only when one was not supplied.
         */

        var answer =
            suppliedAnswer;

        if(
            answer ===
            undefined ||
            answer ===
            null
        )
        {
            if(
                ISE.AnswerEngine &&
                typeof ISE.AnswerEngine
                    .resolve ===
                "function"
            )
            {
                try
                {
                    var resolution =
                        ISE.AnswerEngine
                            .resolve(
                                question.text
                            );

                    if(
                        !resolution ||
                        resolution.supported ===
                        false
                    )
                    {
                        ISE.RecoveryEngine
                            .statistics
                            .unsupported++;

                        return {
                            success:
                                false,

                            unsupported:
                                true,

                            reason:
                                "No profile-supported answer."
                        };
                    }

                    answer =
                        resolution.answer;
                }
                catch(error)
                {
                    ISE.RecoveryEngine
                        .statistics
                        .exceptions++;

                    return {
                        success:
                            false,

                        reason:
                            "Answer resolution failed."
                    };
                }
            }
            else
            {
                return {
                    success:
                        false,

                    unsupported:
                        true,

                    reason:
                        "Answer engine unavailable."
                };
            }
        }

        /*
         * An empty answer is never automatically submitted.
         */

        if(
            answer ===
            null ||
            typeof answer ===
            "undefined" ||
            String(
                answer
            ).trim() ===
            ""
        )
        {
            ISE.RecoveryEngine
                .statistics
                .unsupported++;

            return {
                success:
                    false,

                unsupported:
                    true,

                reason:
                    "Resolved answer was empty."
            };
        }

        ISE.RecoveryEngine
            .recordAttempt(
                question,
                answer,
                {
                    retry:
                        isRetry === true
                }
            );

        /*
         * Snapshot before filling.
         */

        var before =
            ISE.RecoveryEngine
                .snapshot(
                    question
                );

        var result =
            ISE.RecoveryEngine
                .callAutofill(
                    question,
                    answer
                );

        /*
         * If another engine successfully filled it,
         * independently verify the DOM.
         */

        if(
            result &&
            result.success
        )
        {
            var verification =
                ISE.RecoveryEngine
                    .verifyQuestion(
                        question,
                        answer
                    );

            if(
                verification.verified
            )
            {
                result.verification =
                    verification;

                result.before =
                    before;

                ISE.RecoveryEngine
                    .recordSuccess(
                        question,
                        result
                    );

                return result;
            }

            /*
             * Framework may have reverted the value.
             */

            ISE.RecoveryEngine
                .statistics
                .verificationFailed++;

            ISE.RecoveryEngine
                .statistics
                .revertedValues++;

            result.verification =
                verification;

            ISE.RecoveryEngine
                .recordFailure(
                    question,
                    "Verification failed after fill.",
                    result
                );

            ISE.RecoveryEngine
                .retryQuestion(
                    question,
                    answer,
                    "verification-failure"
                );

            return {
                success:
                    false,

                reason:
                    "Fill occurred but verification failed.",

                retryScheduled:
                    true
            };
        }

        /*
         * Fill did not succeed.
         */

        ISE.RecoveryEngine
            .recordFailure(
                question,
                result &&
                result.reason
                    ? result.reason
                    : "Fill failed.",
                result
            );

        ISE.RecoveryEngine
            .recordFailureType(
                result
            );

        if(
            ISE.RecoveryEngine
                .shouldRetry(
                    question,
                    result
                )
        )
        {
            ISE.RecoveryEngine
                .retryQuestion(
                    question,
                    answer,
                    result &&
                    result.reason
                        ? result.reason
                        : "fill-failure"
                );
        }

        return {
            success:
                false,

            reason:
                result &&
                result.reason
                    ? result.reason
                    : "Fill failed.",

            retryScheduled:
                true
        };
    }
    catch(error)
    {
        ISE.RecoveryEngine
            .statistics
            .exceptions++;

        ISE.RecoveryEngine
            .recordFailure(
                question,
                error.message ||
                "Unexpected error.",
                {
                    exception:
                        true
                }
            );

        return {
            success:
                false,

            reason:
                error.message ||
                "Unexpected recovery error."
        };
    }
    finally
    {
        ISE.RecoveryEngine
            .processing = false;

        ISE.RecoveryEngine
            .flushQueue();
    }
};


/* ------------------------------------------------------------
   QUEUE FLUSH
   ------------------------------------------------------------ */

ISE.RecoveryEngine.flushQueue =
function()
{
    if(
        ISE.RecoveryEngine
            .processing
    )
    {
        return;
    }

    if(
        !ISE.RecoveryEngine
            .queue
            .length
    )
    {
        return;
    }

    var item =
        ISE.RecoveryEngine
            .queue
            .shift();

    if(
        !item
    )
    {
        return;
    }

    ISE.RecoveryEngine
        .delay(
            0,
            function()
            {
                ISE.RecoveryEngine
                    .process(
                        item.question,
                        item.answer,
                        item.retry
                    );
            }
        );
};


/* ------------------------------------------------------------
   PROCESS QUESTION USING RESOLUTION ONLY
   ------------------------------------------------------------ */

ISE.RecoveryEngine.processResolved =
function(
    question,
    resolution
)
{
    if(
        !resolution
    )
    {
        return {
            success:
                false,

            reason:
                "Missing resolution."
        };
    }

    if(
        resolution.supported ===
        false
    )
    {
        return {
            success:
                false,

            unsupported:
                true,

            reason:
                "Resolution is unsupported."
        };
    }

    return ISE.RecoveryEngine
        .process(
            question,
            resolution.answer,
            false
        );
};


/* ------------------------------------------------------------
   BATCH PROCESS
   ------------------------------------------------------------ */

ISE.RecoveryEngine.processAll =
function(
    questions
)
{
    if(
        !Array.isArray(
            questions
        )
    )
    {
        return [];
    }

    var results = [];

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        results.push(
            ISE.RecoveryEngine
                .process(
                    questions[i],
                    undefined,
                    false
                )
        );
    }

    return results;
};


/* ------------------------------------------------------------
   RETRY FAILED QUESTIONS
   ------------------------------------------------------------ */

ISE.RecoveryEngine.retryFailed =
function()
{
    var keys =
        Object.keys(
            ISE.RecoveryEngine
                .failures
        );

    var retried = 0;

    for(
        var i = 0;
        i < keys.length;
        i++
    )
    {
        var id =
            keys[i];

        var failure =
            ISE.RecoveryEngine
                .failures[id];

        if(
            !failure
        )
        {
            continue;
        }

        /*
         * Locate the current question again rather than
         * assuming the old DOM node still exists.
         */

        var questions = [];

        if(
            ISE.DOM &&
            typeof ISE.DOM
                .discoverQuestions ===
            "function"
        )
        {
            try
            {
                questions =
                    ISE.DOM
                        .discoverQuestions(
                            document
                        );
            }
            catch(error)
            {
                questions = [];
            }
        }

        for(
            var j = 0;
            j < questions.length;
            j++
        )
        {
            var currentId =
                ISE.RecoveryEngine
                    .questionId(
                        questions[j]
                    );

            if(
                currentId ===
                id
            )
            {
                ISE.RecoveryEngine
                    .process(
                        questions[j],
                        undefined,
                        true
                    );

                retried++;

                break;
            }
        }
    }

    return retried;
};


/* ------------------------------------------------------------
   RESET FAILED STATE
   ------------------------------------------------------------ */

ISE.RecoveryEngine.reset =
function()
{
    ISE.RecoveryEngine
        .attempts = {};

    ISE.RecoveryEngine
        .successes = {};

    ISE.RecoveryEngine
