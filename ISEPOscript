/* ------------------------------------------------------------
   FAILURE CLASSIFICATION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.classifyFailure =
function(
    result
)
{
    if(
        !result
    )
    {
        return "unknown";
    }

    var reason =
        String(
            result.reason ||
            ""
        ).toLowerCase();

    if(
        reason.indexOf(
            "unsupported"
        ) !== -1 ||
        result.unsupported
    )
    {
        return "unsupported";
    }

    if(
        reason.indexOf(
            "confidence"
        ) !== -1
    )
    {
        return "low-confidence";
    }

    if(
        reason.indexOf(
            "control"
        ) !== -1 &&
        reason.indexOf(
            "found"
        ) !== -1
    )
    {
        return "missing-controls";
    }

    if(
        reason.indexOf(
            "fill"
        ) !== -1
    )
    {
        return "fill-failure";
    }

    if(
        reason.indexOf(
            "verify"
        ) !== -1
    )
    {
        return "verification-failure";
    }

    return "unknown";
};


/* ------------------------------------------------------------
   STATISTICS FOR FAILURE
   ------------------------------------------------------------ */

ISE.RecoveryEngine.recordFailureType =
function(
    result
)
{
    var type =
        ISE.RecoveryEngine
            .classifyFailure(
                result
            );

    if(
        type ===
        "unsupported"
    )
    {
        ISE.RecoveryEngine
            .statistics
            .unsupported++;
    }
    else if(
        type ===
        "low-confidence"
    )
    {
        ISE.RecoveryEngine
            .statistics
            .lowConfidence++;
    }
    else if(
        type ===
        "missing-controls"
    )
    {
        ISE.RecoveryEngine
            .statistics
            .missingControls++;
    }
};


/* ------------------------------------------------------------
   VERIFY QUESTION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.verifyQuestion =
function(
    question,
    expected
)
{
    if(
        !question
    )
    {
        return {
            verified: false,
            reason:
                "Missing question."
        };
    }

    var container =
        question.container ||
        question.element;

    if(
        !container
    )
    {
        return {
            verified: false,
            reason:
                "Missing question container."
        };
    }

    var expectedText =
        ISE.RecoveryEngine
            .answerText(
                expected
            );

    var controls = [];

    try
    {
        controls =
            container.querySelectorAll(
                "input," +
                "select," +
                "textarea," +
                "button," +
                "[role='radio']," +
                "[role='checkbox']," +
                "[role='option']," +
                "[role='combobox']," +
                "[role='slider']"
            );
    }
    catch(error)
    {
        controls = [];
    }

    var observed = [];

    for(
        var i = 0;
        i < controls.length;
        i++
    )
    {
        var value =
            ISE.RecoveryEngine
                .readControl(
                    controls[i]
                );

        if(
            value !==
            ""
        )
        {
            observed.push(
                value
            );
        }
    }

    for(
        var j = 0;
        j < observed.length;
        j++
    )
    {
        if(
            ISE.RecoveryEngine
                .answersEquivalent(
                    observed[j],
                    expectedText
                )
        )
        {
            return {
                verified:
                    true,

                actual:
                    observed[j],

                expected:
                    expectedText
            };
        }
    }

    /*
     * Boolean verification.
     */

    var expectedNormalized =
        ISE.RecoveryEngine
            .normalize(
                expectedText
            );

    if(
        ISE.semantic &&
        typeof ISE.semantic.isYes ===
        "function" &&
        typeof ISE.semantic.isNo ===
        "function"
    )
    {
        var expectedYes =
            ISE.semantic.isYes(
                expectedNormalized
            );

        var expectedNo =
            ISE.semantic.isNo(
                expectedNormalized
            );

        if(
            expectedYes ||
            expectedNo
        )
        {
            for(
                var k = 0;
                k < controls.length;
                k++
            )
            {
                var type =
                    ISE.RecoveryEngine
                        .attr(
                            controls[k],
                            "type"
                        )
                        .toLowerCase();

                var role =
                    ISE.RecoveryEngine
                        .attr(
                            controls[k],
                            "role"
                        )
                        .toLowerCase();

                var selected =
                    false;

                try
                {
                    selected =
                        controls[k].checked ===
                        true;
                }
                catch(error)
                {
                }

                var aria =
                    ISE.RecoveryEngine
                        .attr(
                            controls[k],
                            "aria-checked"
                        )
                        .toLowerCase();

                if(
                    aria ===
                    "true"
                )
                {
                    selected = true;
                }

                if(
                    selected
                )
                {
                    var label =
                        ISE.PlatformEngine &&
                        typeof ISE.PlatformEngine
                            .description ===
                        "function"
                            ? ISE.PlatformEngine
                                .description(
                                    controls[k]
                                )
                            : "";

                    if(
                        expectedYes &&
                        ISE.semantic.isYes(
                            label
                        )
                    )
                    {
                        return {
                            verified:
                                true,

                            actual:
                                label,

                            expected:
                                expectedText
                        };
                    }

                    if(
                        expectedNo &&
                        ISE.semantic.isNo(
                            label
                        )
                    )
                    {
                        return {
                            verified:
                                true,

                            actual:
                                label,

                            expected:
                                expectedText
                        };
                    }
                }
            }
        }
    }

    return {
        verified:
            false,

        expected:
            expectedText,

        observed:
            observed
    };
};


