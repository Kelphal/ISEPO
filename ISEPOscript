/* ------------------------------------------------------------
   SAFE TEXT
   ------------------------------------------------------------ */

ISE.DynamicEngine.text = function (
    element
) {

    if (!element) {
        return "";
    }

    try {

        return String(
            element.innerText ||
            element.textContent ||
            ""
        )
        .replace(/\s+/g, " ")
        .trim();

    } catch (error) {

        return "";
    }
};


/* ------------------------------------------------------------
   NORMALIZE
   ------------------------------------------------------------ */

ISE.DynamicEngine.normalize = function (
    value
) {

    if (
        ISE.text &&
        typeof ISE.text.normalize ===
        "function"
    ) {

        return ISE.text.normalize(
            value || ""
        );
    }

    return String(
        value || ""
    )
    .toLowerCase()
    .replace(/\s+/g, " ")
    .trim();
};


/* ------------------------------------------------------------
   SAFE ATTRIBUTE
   ------------------------------------------------------------ */

ISE.DynamicEngine.attr = function (
    element,
    name
) {

    if (!element || !name) {
        return "";
    }

    try {

        return String(
            element.getAttribute(
                name
            ) || ""
        ).trim();

    } catch (error) {

        return "";
    }
};


/* ------------------------------------------------------------
   VISIBILITY
   ------------------------------------------------------------ */

ISE.DynamicEngine.visible = function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        element.hidden === true ||
        element.disabled === true
    ) {
        return false;
    }

    try {

        var style =
            window.getComputedStyle(
                element
            );

        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.opacity === "0"
        ) {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );

    } catch (error) {

        return true;
    }
};


/* ------------------------------------------------------------
   NODE TYPE
   ------------------------------------------------------------ */

ISE.DynamicEngine.nodeType =
function (
    node
) {

    if (!node) {
        return "";
    }

    return String(
        node.nodeName ||
        ""
    ).toLowerCase();
};


/* ------------------------------------------------------------
   ELEMENT CHECK
   ------------------------------------------------------------ */

ISE.DynamicEngine.isElement =
function (
    node
) {

    if (!node) {
        return false;
    }

    return (
        node.nodeType === 1
    );
};


/* ------------------------------------------------------------
   SHADOW ROOT CHECK
   ------------------------------------------------------------ */

ISE.DynamicEngine.isShadowRoot =
function (
    node
) {

    if (!node) {
        return false;
    }

    try {

        return (
            typeof ShadowRoot !==
            "undefined" &&
            node instanceof
            ShadowRoot
        );

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   UNIQUE ARRAY
   ------------------------------------------------------------ */

ISE.DynamicEngine.unique =
function (
    array
) {

    var output = [];

    if (!Array.isArray(array)) {
        return output;
    }

    var seen =
        new Set();

    for (
        var i = 0;
        i < array.length;
        i++
    ) {

        var item =
            array[i];

        if (!item) {
            continue;
        }

        if (
            seen.has(
                item
            )
        ) {
            continue;
        }

        seen.add(
            item
        );

        output.push(
            item
        );
    }

    return output;
};


/* ------------------------------------------------------------
   QUESTION FINGERPRINT
   ------------------------------------------------------------ */

ISE.DynamicEngine.fingerprint =
function (
    question
) {

    if (!question) {
        return "";
    }

    var text =
        typeof question ===
        "string"
            ? question
            : (
                question.text ||
                question.question ||
                ""
            );

    text =
        ISE.DynamicEngine
            .normalize(
                text
            );

    if (!text) {
        return "";
    }

    /*
     * Include nearby structure when possible.
     * This helps distinguish repeated wording used
     * in separate survey sections.
     */

    var category = "";

    try {

        if (
            question.category
        ) {

            category =
                String(
                    question.category
                );
        }

    } catch (error) {}

    return (
        category +
        "::" +
        text
    );
};


/* ------------------------------------------------------------
   CONTROL FINGERPRINT
   ------------------------------------------------------------ */

ISE.DynamicEngine.controlFingerprint =
function (
    element
) {

    if (!element) {
        return "";
    }

    var type =
        ISE.DynamicEngine
            .attr(
                element,
                "type"
            );

    var name =
        ISE.DynamicEngine
            .attr(
                element,
                "name"
            );

    var id =
        ISE.DynamicEngine
            .attr(
                element,
                "id"
            );

    var value =
        ISE.DynamicEngine
            .attr(
                element,
                "value"
            );

    return [
        type,
        name,
        id,
        value
    ]
    .join("|")
    .toLowerCase();
};


/* ------------------------------------------------------------
   QUESTION CONTAINER FINGERPRINT
   ------------------------------------------------------------ */

ISE.DynamicEngine.containerFingerprint =
function (
    container
) {

    if (!container) {
        return "";
    }

    var text =
        ISE.DynamicEngine
            .normalize(
                ISE.DynamicEngine
                    .text(
                        container
                    )
            );

    if (!text) {
        return "";
    }

    var controls = [];

    try {

        var nodes =
            container.querySelectorAll(
                "input," +
                "select," +
                "textarea," +
                "button," +
                "[role='radio']," +
                "[role='checkbox']," +
                "[role='combobox']," +
                "[role='slider']"
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            controls.push(
                ISE.DynamicEngine
                    .controlFingerprint(
                        nodes[i]
                    )
            );
        }

    } catch (error) {}

    return (
        text.substring(
            0,
            500
        ) +
        "::" +
        controls.join(
            ";"
        )
    );
};


/* ------------------------------------------------------------
   PROCESSING MEMORY
   ------------------------------------------------------------ */

ISE.DynamicEngine.wasProcessed =
function (
    fingerprint
) {

    if (!fingerprint) {
        return false;
    }

    return !!(
        ISE.DynamicEngine
            .processedFingerprints[
                fingerprint
            ]
    );
};


ISE.DynamicEngine.markProcessed =
function (
