/* ============================================================
   BASIC TEXT UTILITIES
   ============================================================ */

ISE.AdvancedSemantics.normalize =
function(
    value
)
{
    if(
        ISE.text &&
        typeof ISE.text.normalize ===
        "function"
    )
    {
        return ISE.text.normalize(
            value || ""
        );
    }

    return String(
        value || ""
    )
    .toLowerCase()
    .replace(/[“”]/g,'"')
    .replace(/[‘’]/g,"'")
    .replace(/\s+/g," ")
    .trim();
};


ISE.AdvancedSemantics.tokens =
function(
    value
)
{
    var text =
        ISE.AdvancedSemantics
            .normalize(
                value
            );

    if(
        !text
    )
    {
        return [];
    }

    var parts =
        text
            .replace(
                /[^a-z0-9$%.\- ]+/g,
                " "
            )
            .split(/\s+/)
            .filter(
                function(
                    item
                )
                {
                    return !!item;
                }
            );

    if(
        parts.length >
        ISE.AdvancedSemantics
            .config
            .maximumTokens
    )
    {
        parts =
            parts.slice(
                0,
                ISE.AdvancedSemantics
                    .config
                    .maximumTokens
            );
    }

    return parts;
};


ISE.AdvancedSemantics.contains =
function(
    text,
    list
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    for(
        var i = 0;
        i < list.length;
        i++
    )
    {
        if(
            normalized.indexOf(
                ISE.AdvancedSemantics
                    .normalize(
                        list[i]
                    )
            ) !== -1
        )
        {
            return true;
        }
    }

    return false;
};


