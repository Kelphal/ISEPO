    function isAnswerChoice(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {

            return false;
        }

        if (
            isControl(
                element
            )
        ) {

            return true;
        }

        var role =
            lower(
                attr(
                    element,
                    "role"
                )
            );

        if (
            [
                "radio",
                "checkbox",
                "option"
            ].indexOf(
                role
            ) !==
            -1
        ) {

            return true;
        }

        var classes =
            lower(
                attr(
                    element,
                    "class"
                )
            );

        if (
            containsAny(
                classes,
                [
                    "answer",
                    "choice",
                    "option",
                    "radio",
                    "checkbox"
                ]
            )
        ) {

            return true;
        }

        return false;
    }


    function collectChoices(
        container
    ) {

        if (
            !container ||
            !container.querySelectorAll
        ) {

            return [];
        }

        var all =
            container.querySelectorAll(
                "*"
            );

        var choices =
            [];

        for (
            var i = 0;
            i <
            all.length;
            i++
        ) {

            if (
                !visible(
                    all[i]
                )
            ) {

                continue;
            }

            if (
                isAnswerChoice(
                    all[i]
                )
            ) {

                var text =
                    choiceText(
                        all[i]
                    );

                if (
                    text
                ) {

                    choices.push({

                        element:
                            all[i],

                        text:
                            clean(
                                text
                            )
                    });
                }
            }

            if (
                choices.length >=
                engine.config
                    .maximumChoices
            ) {

                break;
            }
        }

        return deduplicateChoices(
            choices
        );
    }


    function deduplicateChoices(
        choices
    ) {

        var result =
            [];

        var seen =
            new Set();

        for (
            var i = 0;
            i <
            choices.length;
            i++
        ) {

            var key =
                normalize(
                    choices[i].text
                );

            if (
                !key ||
                seen.has(
                    key
                )
            ) {

                continue;
            }

            seen.add(
                key
            );

            result.push(
                choices[i]
            );
        }

        return result;
    }


    /* ============================================================
       INSTRUCTION DETECTION
       ============================================================ */

    function isInstructionText(
        text
    ) {

        var normalized =
            normalize(
                text
            );

        if (
            !normalized
        ) {

            return false;
        }

        var instructionPatterns = [

            "select all that apply",
            "choose all that apply",
            "select one",
            "choose one",
            "please select",
            "please choose",
            "select the answer",
            "choose the answer",
            "for each",
            "rate each",
            "drag",
            "move the slider",
            "rank the following",
            "rank these",
            "order the following",
            "use the scale",
            "click one",
            "click all",
            "check all",
            "check one",
            "enter your answer",
            "enter a number",
            "enter the amount",
            "enter your age"
        ];

        return containsAny(
            normalized,
            instructionPatterns
        );
    }


    function extractInstructions(
        container
    ) {

        if (
            !container ||
            !container.querySelectorAll
        ) {

            return [];
        }

        var elements =
            container.querySelectorAll(
                "p,small,div,span,label"
            );

        var results =
            [];

        for (
            var i = 0;
            i <
            elements.length;
            i++
        ) {

            var element =
                elements[i];

            if (
                !visible(
                    element
                )
            ) {

                continue;
            }

            var text =
                clean(
                    element.innerText ||
                    element.textContent ||
                    ""
                );

            if (
                !text
            ) {

                continue;
            }

            if (
                isInstructionText(
                    text
                )
            ) {

                results.push(
                    text
                );
            }
        }


        return Array.from(
            new Set(
                results
            )
        ).slice(
            0,
            30
        );
    }


    /* ============================================================
       QUESTION DETECTION
       ============================================================ */

    function looksLikeQuestion(
        text
    ) {

        var normalized =
            normalize(
                text
            );

        if (
            !normalized
        ) {

            return false;
        }

        if (
            /[?？]\s*$/.test(
                text
            )
        ) {

            return true;
        }

        var patterns = [

            /^do you\b/,
            /^did you\b/,
            /^have you\b/,
            /^has your\b/,
            /^are you\b/,
            /^were you\b/,
            /^is your\b/,
            /^are your\b/,
            /^what\b/,
            /^which\b/,
            /^when\b/,
            /^where\b/,
            /^why\b/,
            /^how\b/,
            /^how many\b/,
            /^how much\b/,
            /^how often\b/,
            /^how old\b/,
            /^can you\b/,
            /^would you\b/,
            /^could you\b/
        ];

        for (
            var i = 0;
            i <
            patterns.length;
            i++
        ) {

            if (
                patterns[i].test(
                    normalized
                )
            ) {

                return true;
            }
        }

        return false;
    }


    /* ============================================================
       QUESTION TEXT FILTERING
       ============================================================ */

    function removeChoiceText(
        container,
        text
    ) {

        var choices =
            collectChoices(
                container
            );

        var cleaned =
            String(
                text ||
                ""
            );

        for (
            var i = 0;
            i <
            choices.length;
            i++
        ) {

            var choice =
                choices[i].text;

            if (
                choice.length <
                2
            ) {

                continue;
            }

            var escaped =
                choice.replace(
                    /[.*+?^${}()|[\]\\]/g,
                    "\\$&"
                );

            try {

                cleaned =
                    cleaned.replace(
                        new RegExp(
                            "\\b" +
                            escaped +
                            "\\b",
                            "gi"
                        ),
                        " "
                    );

            }
            catch (error) {
            }
        }

        return clean(
            cleaned
        );
    }


    function questionText(
        container
    ) {

        if (
            !container
        ) {

            return "";
        }

        var explicit = [

            attr(
                container,
                "data-question"
            ),

            attr(
                container,
                "data-question-text"
            ),

            attr(
                container,
                "aria-label"
            )
        ].filter(
            Boolean
        );


        if (
            explicit.length
        ) {

            return limit(
                clean(
                    explicit.join(
                        " "
                    )
                ),
                engine.config
                    .maximumQuestionText
            );
        }


        var headings =
            container.querySelectorAll
            ?
            container.querySelectorAll(
                "h1,h2,h3,h4,h5,h6,legend"
            )
            :
            [];


        var headingText =
            [];

        for (
            var i = 0;
            i <
            headings.length;
            i++
        ) {

            if (
                visible(
                    headings[i]
                )
            ) {

                var value =
                    clean(
                        headings[i]
                            .innerText ||
                        headings[i]
                            .textContent ||
                        ""
                    );

                if (
                    value
                ) {

                    headingText.push(
                        value
                    );
                }
            }
        }


        if (
            headingText.length
        ) {

            var headingCombined =
                clean(
                    headingText.join(
                        " "
                    )
                );

            if (
                looksLikeQuestion(
                    headingCombined
                )
            ) {

                return limit(
                    headingCombined,
                    engine.config
                        .maximumQuestionText
                );
            }
        }


        var text =
            textOf(
                container
            );


        text =
            removeChoiceText(
                container,
                text
            );


        /*
         * Remove common instructions from the
         * beginning of the extracted text.
         */

        text =
            text.replace(
                /^(please\s+)?(select|choose|check)\s+(one|all|one or more)[\s:,-]*/i,
                ""
            );


        return limit(
            clean(
                text
            ),
            engine.config
                .maximumQuestionText
        );
    }


    /* ============================================================
       QUESTION TYPE
       ============================================================ */

    function detectQuestionType(
        container,
        text
    ) {

        var normalized =
            normalize(
                text
            );

        var controls =
            collectControls(
                container
            );

        var radios =
            0;

        var checkboxes =
            0;

        var selects =
            0;

        var textInputs =
            0;

        var sliders =
            0;

        var buttons =
            0;

        for (
            var i = 0;
            i <
            controls.length;
            i++
        ) {

            var control =
                controls[i];

            var elementTag =
                tag(
                    control
                );

            var type =
                lower(
                    attr(
                        control,
                        "type"
                    )
                );

            var role =
                lower(
                    attr(
                        control,
                        "role"
                    )
                );

            if (
                type ===
                "radio" ||
                role ===
                "radio"
            ) {

                radios++;

            }
            else if (
                type ===
                "checkbox" ||
                role ===
                "checkbox"
            ) {

                checkboxes++;

            }
            else if (
                elementTag ===
                "select" ||
                role ===
                "combobox" ||
                role ===
                "listbox"
            ) {

                selects++;

            }
            else if (
                type ===
                "range" ||
                role ===
                "slider"
            ) {

                sliders++;

            }
            else if (
                elementTag ===
                "button" ||
                role ===
                "button"
            ) {

                buttons++;

            }
            else {

                textInputs++;
            }
        }


        if (
            checkboxes >=
            2 ||
            /select all|all that apply|choose all|multiple answers/
                .test(
                    normalized
                )
        ) {

            return "multi-select";
        }


        if (
            sliders >
            0
        ) {

            return "slider";
        }


        if (
            selects >
            0
        ) {

            return "dropdown";
        }


        if (
            radios >=
            2
        ) {

            return "single-select";
        }


        if (
            /rank|ranking|order these|order the following/
                .test(
                    normalized
                )
        ) {

            return "ranking";
        }


        if (
            /matrix|grid|rate each|for each|each of the following/
                .test(
                    normalized
                )
        ) {

            return "matrix";
        }


        if (
            /how many|how much|enter.*number|number of/
                .test(
                    normalized
                )
        ) {

            return "numeric";
        }


        if (
            textInputs >
            0
        ) {

            return "text";
        }


        return "unknown";
    }


    /* ============================================================
       QUESTION SCORE
       ============================================================ */

    function scoreQuestion(
        container
    ) {

        if (
            !container ||
            !visible(
                container
            )
        ) {

            return 0;
        }

        var text =
            questionText(
                container
            );

        if (
            !text
        ) {

            return 0;
        }

        var score =
            0;

        if (
            looksLikeQuestion(
                text
            )
        ) {

            score +=
                0.40;
        }

        if (
            /[?？]\s*$/.test(
                text
            )
        ) {

            score +=
                0.20;
        }


        var controls =
            collectControls(
                container
            );

        if (
            controls.length >
            0
        ) {

            score +=
                0.25;
        }


        if (
            attr(
                container,
                "data-question"
            )
        ) {

            score +=
                0.20;
        }


        if (
            attr(
                container,
                "data-question-id"
            )
        ) {

            score +=
                0.15;
        }


        if (
            tag(
                container
            ) ===
            "fieldset"
        ) {

            score +=
                0.10;
        }


        var type =
            detectQuestionType(
                container,
                text
            );

        if (
            type !==
            "unknown"
        ) {

            score +=
                0.10;
        }


        return Math.min(
            1,
            score
        );
    }


    /* ============================================================
       GROUP / CONTAINER DETECTION
       ============================================================ */

    function ancestorChain(
        element
    ) {

        var result =
            [];

        var current =
            element;

        var depth =
            0;

        while (
            current &&
            depth <
            engine.config
                .maximumGroupDepth
        ) {

            if (
                isElement(
                    current
                )
            ) {

                result.push(
                    current
                );
            }

            current =
                current.parentElement;

            depth++;
        }

        return result;
    }


    function structuralScore(
        element
    ) {

        if (
            !element
        ) {

            return 0;
        }

        var score =
            0;

        var elementTag =
            tag(
                element
            );

        var classes =
            normalize(
                attr(
                    element,
                    "class"
                )
            );

        var id =
            normalize(
                attr(
                    element,
                    "id"
                )
            );


        if (
            elementTag ===
            "fieldset"
        ) {

            score +=
                0.45;
        }


        if (
            containsAny(
                classes,
                [
                    "question",
                    "survey-question",
                    "question-container",
                    "question-wrapper",
                    "survey-item",
                    "survey-question-container"
                ]
            )
        ) {

            score +=
                0.35;
        }


        if (
            containsAny(
                id,
                [
                    "question",
                    "survey-question"
                ]
            )
        ) {

            score +=
                0.30;
        }


        if (
            attr(
                element,
                "data-question"
            )
        ) {

            score +=
                0.40;
        }


        if (
            attr(
                element,
                "data-question-id"
            )
        ) {

            score +=
                0.35;
        }


        return Math.min(
            1,
            score
        );
    }


    function findQuestionContainer(
        element
    ) {

        if (
            !element
        ) {

            return null;
        }

        var chain =
            ancestorChain(
                element
            );

        var best =
            null;

        var bestScore =
            0;


        for (
            var i = 0;
            i <
            chain.length;
            i++
        ) {

            var candidate =
                chain[i];

            var score =
                structuralScore(
                    candidate
                );

            var controls =
                collectControls(
                    candidate
                );

            if (
                controls.length
            ) {

                score +=
                    Math.min(
                        0.25,
                        controls.length *
                        0.03
                    );
            }


            var text =
                questionText(
                    candidate
                );

            if (
                looksLikeQuestion(
                    text
                )
            ) {

                score +=
                    0.35;
            }


            if (
                score >
                bestScore
            ) {

                bestScore =
                    score;

                best =
                    candidate;
            }
        }


        return best;
    }


    /* ============================================================
       QUESTION CANDIDATES
       ============================================================ */

    function findQuestionContainers(
        root
    ) {

        if (
            !root ||
            !root.querySelectorAll
        ) {

            return [];
        }

        var candidates =
            [];

        var selectors = [

            "[data-question]",
            "[data-question-id]",
            "[data-question-text]",
            "[data-questionid]",
            "[class*='question']",
            "[class*='Question']",
            "[class*='survey-question']",
            "[class*='SurveyQuestion']",
            "fieldset",
            "[role='group']",
            "[role='radiogroup']"
        ];


        for (
            var i = 0;
            i <
            selectors.length;
            i++
        ) {

            try {

                var found =
                    root.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j <
                    found.length;
                    j++
                ) {

                    if (
                        candidates.indexOf(
                            found[j]
                        ) ===
                        -1
                    ) {

                        candidates.push(
                            found[j]
                        );
                    }
                }

            }
            catch (error) {

                engine.state.errors++;
            }
        }


        /*
         * Controls can reveal a question container
         * even when the container itself has no
         * useful class or data attribute.
         */

        var controls =
            root.querySelectorAll(
                "input,select,textarea,button,[role='button'],[role='radio'],[role='checkbox'],[role='combobox'],[role='slider']"
            );


        for (
            var k = 0;
            k <
            controls.length;
            k++
        ) {

            var container =
                findQuestionContainer(
                    controls[k]
                );

            if (
                container &&
                candidates.indexOf(
                    container
                ) ===
                -1
            ) {

                candidates.push(
                    container
                );
            }
        }


        return candidates;
    }


    /* ============================================================
       GROUP FINGERPRINT
       ============================================================ */

    function groupFingerprint(
        container
    ) {

        if (
            !container
        ) {

            return "";
        }

        var text =
            questionText(
                container
            );

        var className =
            normalize(
                attr(
                    container,
                    "class"
                )
            );

        var id =
            normalize(
                attr(
                    container,
                    "id"
                )
            );

        var type =
            detectQuestionType(
                container,
                text
            );

        return hash(
            text +
            "|" +
            className +
            "|" +
            id +
            "|" +
            type
        );
    }


    /* ============================================================
       CONTEXT CREATION
       ============================================================ */

    function buildContext(
        container
    ) {

        if (
            !container
        ) {

            return null;
        }

        var text =
            questionText(
                container
            );

        var controls =
            collectControls(
                container
            );

        var choices =
            collectChoices(
                container
            );

        var instructions =
            extractInstructions(
                container
            );

        var type =
            detectQuestionType(
                container,
                text
            );

        var score =
            scoreQuestion(
                container
            );


        var context = {

            id:
                groupFingerprint(
                    container
                ),

            element:
                container,

            text:
                text,

            normalizedText:
                normalize(
                    text
                ),

            type:
                type,

            score:
                score,

            controls:
                controls,

            choices:
                choices,

            instructions:
                instructions,

            visible:
                visible(
                    container
                ),

            createdAt:
                Date.now(),

            updatedAt:
                Date.now(),

            processed:
                false,

            supported:
                false,

            answer:
                null,

            platform:
                null,

            relationships:
                {

                    parent:
                        null,

                    children:
                        [],

                    siblings:
                        [],

                    related:
                        []
                },

            flags:
                {

                    multiSelect:
                        type ===
                        "multi-select",

                    matrix:
                        type ===
                        "matrix",

                    ranking:
                        type ===
                        "ranking",

                    numeric:
                        type ===
                        "numeric",

                    conditional:
                        false,

                    repeated:
                        false,

                    instructionOnly:
                        false,

                    likelyQuestion:
                        score >=
                        engine.config
                            .minimumQuestionScore
                }
        };


        /*
         * Shared instruction detection.
         */

        if (
            instructions.length >
            0
        ) {

            engine.statistics
                .instructionsDetected +=
                instructions.length;
        }


        /*
         * Matrix tracking.
         */

        if (
            type ===
            "matrix"
        ) {

            engine.statistics
                .matrixContexts++;
        }


        /*
         * Multi-select tracking.
         */

        if (
            type ===
            "multi-select"
        ) {

            engine.statistics
                .multiSelectContexts++;
        }


        engine.statistics
            .contextsCreated++;


        return context;
    }


    /* ============================================================
       CONTEXT RELATIONSHIPS
       ============================================================ */

    function establishParent(
        context
    ) {

        if (
            !context ||
            !context.element
        ) {

            return;
        }

        var parent =
            context.element.parentElement;

        while (
            parent
        ) {

            var parentId =
                groupFingerprint(
                    parent
                );

            if (
                parentId &&
                engine.state
                    .contexts
                    .has(
                        parentId
                    )
            ) {

                var parentContext =
                    engine.state
                        .contexts
                        .get(
                            parentId
                        );

                if (
                    parentContext !==
                    context
                ) {

                    context.relationships
                        .parent =
                        parentContext.id;

                    if (
                        parentContext
                            .relationships
                            .children
                            .indexOf(
                                context.id
                            ) ===
                        -1
                    ) {

                        parentContext
                            .relationships
                            .children
                            .push(
                                context.id
                            );
                    }

                    return;
                }
            }

            parent =
                parent.parentElement;
        }
    }


    function establishSiblingRelations(
        contexts
    ) {

        for (
            var i = 0;
            i <
            contexts.length;
            i++
        ) {

            var first =
                contexts[i];

            if (
                !first
            ) {

                continue;
            }

            for (
                var j = i + 1;
                j <
                contexts.length;
                j++
            ) {

                var second =
                    contexts[j];

                if (
                    !second
                ) {

                    continue;
                }


                var similarityScore =
                    similarity(
                        first.text,
                        second.text
                    );


                /*
                 * Similar question wording means
                 * this may be a repeated question
                 * or repeated survey structure.
                 */

                if (
                    similarityScore >=
                    0.55
                ) {

                    first.relationships
                        .related
                        .push(
                            second.id
                        );

                    second.relationships
                        .related
                        .push(
                            first.id
                        );

                    first.flags
                        .repeated =
                        true;

                    second.flags
                        .repeated =
                        true;

                    engine.statistics
                        .repeatedContexts++;
                }
            }
        }
    }


    /* ============================================================
       CONDITIONAL QUESTION DETECTION
       ============================================================ */

    function detectConditional(
        context
    ) {

        if (
            !context
        ) {

            return false;
        }

        var text =
            normalize(
                context.text
            );

        var parentText =
            "";

        if (
            context.relationships
                .parent &&
            engine.state
                .contexts
                .has(
                    context.relationships
                        .parent
                )
        ) {

            parentText =
                normalize(
                    engine.state
                        .contexts
                        .get(
                            context.relationships
                                .parent
                        )
                        .text
                );
        }


        var conditionalWords = [

            "if",
            "if you selected",
            "if you answered",
            "if yes",
            "if no",
            "depending on your answer",
            "based on your answer",
            "only if",
            "for those who",
            "if applicable",
            "if this applies"
        ];


        var found =
            containsAny(
                text,
                conditionalWords
            ) ||
            containsAny(
                parentText,
                conditionalWords
            );


        if (
            found
        ) {

            context.flags
                .conditional =
                true;

            engine.statistics
                .conditionalContexts++;
        }


        return found;
    }


    /* ============================================================
       CONTEXT REGISTRATION
       ============================================================ */

    function registerContext(
        context
    ) {

        if (
            !context
        ) {

            return null;
        }

        var id =
            context.id;

        if (
            !id
        ) {

            return null;
        }


        if (
            engine.state
                .contexts
                .has(
                    id
                )
        ) {

            var existing =
                engine.state
                    .contexts
                    .get(
                        id
                    );

            existing.element =
                context.element;

            existing.updatedAt =
                Date.now();

            existing.visible =
                context.visible;

            existing.controls =
                context.controls;

            existing.choices =
                context.choices;

            existing.instructions =
                context.instructions;

            existing.type =
                context.type;

            existing.text =
                context.text;

            existing.normalizedText =
                context.normalizedText;

            engine.statistics
                .contextsUpdated++;

            return existing;
        }


        engine.state
            .contexts
            .set(
                id,
                context
            );

        engine.state
            .groups
            .set(
                id,
                context
            );

        engine.state
            .groupCount++;

        engine.state
            .contextCount++;

        return context;
    }


    /* ============================================================
       PROCESS CONTEXT
       ============================================================ */

    function processContext(
        context
    ) {

        if (
            !context
        ) {

            return null;
        }

        if (
            context.score <
            engine.config
                .minimumQuestionScore
        ) {

            return context;
        }


        /*
         * Avoid treating a block that only contains
         * instructions as an actual question.
         */

        if (
            !looksLikeQuestion(
                context.text
            ) &&
            context.controls.length ===
            0
        ) {

            context.flags
                .instructionOnly =
                true;

            return context;
        }


        detectConditional(
            context
        );


        /*
         * Platform handoff.
         */

        if (
            ISE.PlatformAdaptation &&
            typeof ISE.PlatformAdaptation
                .getPlatform ===
            "function"
        ) {

            try {

                var platform =
                    ISE.PlatformAdaptation
                        .getPlatform();

                if (
                    platform
                ) {

                    context.platform =
                        platform.key;
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        /*
         * Make the context available to the
         * main autofill engine.
         */

        if (
            ISE.PlatformEngine
        ) {

            try {

                if (
                    typeof ISE.PlatformEngine
                        .registerContext ===
                    "function"
                ) {

                    ISE.PlatformEngine
                        .registerContext(
                            context
                        );
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        return context;
    }


    /* ============================================================
       SCAN
       ============================================================ */

    engine.scan =
        function (
            root
        ) {

            if (
                !engine.state.running
            ) {

                return [];
            }

            root =
                root ||
                document.body ||
                document.documentElement;


            if (
                !root
            ) {

                return [];
            }


            engine.statistics
                .scans++;

            engine.state
                .scanCount++;

            engine.state
                .lastScan =
                Date.now();


            var candidates =
                findQuestionContainers(
                    root
                );


            var contexts =
                [];


            for (
                var i = 0;
                i <
                candidates.length;
                i++
            ) {

                try {

                    if (
                        !visible(
                            candidates[i]
                        )
                    ) {

                        continue;
                    }

                    var context =
                        buildContext(
                            candidates[i]
                        );

                    if (
                        !context
                    ) {

                        continue;
                    }

                    if (
                        context.score <
                        engine.config
                            .minimumQuestionScore
                    ) {

                        continue;
                    }

                    var registered =
                        registerContext(
                            context
                        );

                    if (
                        registered
                    ) {

                        contexts.push(
                            registered
                        );
                    }

                }
                catch (error) {

                    engine.state.errors++;

                    engine.statistics
                        .errors++;
                }
            }


            /*
             * Establish parent relationships
             * after all contexts exist.
             */

            for (
                var j = 0;
                j <
                contexts.length;
                j++
            ) {

                establishParent(
                    contexts[j]
                );
            }


            establishSiblingRelations(
                contexts
            );


            for (
                var k = 0;
                k <
                contexts.length;
                k++
            ) {

                processContext(
                    contexts[k]
                );
            }


            engine.state
                .questionCount =
                engine.state
                    .contexts
                    .size;


            return contexts;
        };


    /* ============================================================
       QUESTION LOOKUP
       ============================================================ */

    engine.getContext =
        function (
            id
        ) {

            if (
                !id
            ) {

                return null;
            }

            return engine.state
                .contexts
                .get(
                    id
                ) ||
                null;
        };


    engine.getContexts =
        function () {

            return Array.from(
                engine.state
                    .contexts
                    .values()
            );
        };


    engine.getVisibleContexts =
        function () {

            return engine.getContexts()
                .filter(
                    function (
                        context
                    ) {

                        return (
                            context &&
                            context.element &&
                            visible(
                                context.element
                            )
                        );
                    }
                );
        };


    /* ============================================================
       CONTEXT FOR CONTROL
       ============================================================ */

    engine.getContextForControl =
        function (
            control
        ) {

            if (
                !control
            ) {

                return null;
            }

            var container =
                findQuestionContainer(
                    control
                );

            if (
                !container
            ) {

                return null;
            }

            var id =
                groupFingerprint(
                    container
                );

            return engine.getContext(
                id
            );
        };


    /* ============================================================
       QUESTION CONTAINER COMPATIBILITY
       ============================================================ */

    /*
     * Part 19 can call this method directly.
     */

    engine.findQuestionContainers =
        function (
            root
        ) {

            return findQuestionContainers(
                root ||
                document
            );
        };


    /* ============================================================
       REMOVE STALE CONTEXTS
       ============================================================ */

    engine.cleanup =
        function () {

            var removed =
                0;

            engine.state
                .contexts
                .forEach(
                    function (
                        context,
                        id
                    ) {

                        if (
                            !context ||
                            !context.element
                        ) {

                            engine.state
                                .contexts
                                .delete(
                                    id
                                );

                            engine.state
                                .groups
                                .delete(
                                    id
                                );

                            removed++;

                            return;
                        }


                        try {

                            if (
                                !document
                                    .documentElement
                                    .contains(
                                        context.element
                                    )
                            ) {

                                /*
                                 * Don't remove contexts
                                 * that belong to a ShadowRoot
                                 * or same-origin iframe.
                                 */

                                var ownerDocument =
                                    context.element
                                        .ownerDocument;

                                if (
                                    ownerDocument ===
                                    document
                                ) {

                                    engine.state
                                        .contexts
                                        .delete(
                                            id
                                        );

                                    engine.state
                                        .groups
                                        .delete(
                                            id
                                        );

                                    removed++;
                                }
                            }

                        }
                        catch (error) {

                            engine.statistics
                                .errors++;
                        }
                    }
                );


            engine.state
                .staleCount +=
                removed;

            engine.statistics
                .staleContexts +=
                removed;

            return removed;
        };


    /* ============================================================
       MUTATION OBSERVER
       ============================================================ */

    function installObserver() {

        if (
            !engine.config
                .observeMutations
        ) {

            return;
        }

        if (
            typeof MutationObserver ===
            "undefined"
        ) {

            return;
        }

        if (
            engine.state
                .mutationObserver
        ) {

            return;
        }

        var root =
            document.documentElement;

        if (
            !root
        ) {

            return;
        }


        try {

            engine.state
                .mutationObserver =
                new MutationObserver(
                    function (
                        mutations
                    ) {

                        engine.state
                            .mutationCount +=
                            mutations.length;

                        engine.statistics
                            .mutations +=
                            mutations.length;

                        engine.state
                            .lastMutation =
                            Date.now();

                        engine.requestScan(
                            "mutation"
                        );

                    }
                );


            engine.state
                .mutationObserver
                .observe(
                    root,
                    {

                        childList:
                            true,

                        subtree:
                            true,

                        attributes:
                            true,

                        characterData:
                            true
                    }
                );

        }
        catch (error) {

            engine.state.errors++;

            engine.statistics
                .errors++;
        }
    }


    /* ============================================================
       REQUEST SCAN
       ============================================================ */

    engine.requestScan =
        function (
            reason
        ) {

            if (
                !engine.state.running
            ) {

                return;
            }

            if (
                engine.state
                    .scanTimer
            ) {

                return;
            }

            engine.state
                .scanTimer =
                setTimeout(
                    function () {

                        engine.state
                            .scanTimer =
                            null;

                        engine.cleanup();

                        engine.scan();

                    },
                    engine.config
                        .mutationDelay
                );
        };


    /* ============================================================
       PERIODIC SCAN
       ============================================================ */

    function startInterval() {

        if (
            engine.state
                .intervalTimer
        ) {

            return;
        }

        engine.state
            .intervalTimer =
            setInterval(
                function () {

                    if (
                        !engine.state.running
                    ) {

                        return;
                    }

                    engine.cleanup();

                    engine.scan();

                },
                engine.config
                    .scanInterval
            );
    }


    function stopInterval() {

        if (
            engine.state
                .intervalTimer
        ) {

            clearInterval(
                engine.state
                    .intervalTimer
            );

            engine.state
                .intervalTimer =
                null;
        }
    }


    /* ============================================================
       DIAGNOSTICS
       ============================================================ */

    engine.diagnostics =
        function () {

            var contexts =
                engine.getContexts();

            return {

                version:
                    VERSION,

                running:
                    engine.state.running,

                scans:
                    engine.statistics.scans,

                contexts:
                    contexts.length,

                visibleContexts:
                    engine.getVisibleContexts()
                        .length,

                groups:
                    engine.state.groups.size,

                mutations:
                    engine.statistics.mutations,

                staleContexts:
                    engine.statistics
                        .staleContexts,

                contextTypes:
                    contexts.reduce(
                        function (
                            result,
                            context
                        ) {

                            var type =
                                context.type ||
                                "unknown";

                            result[type] =
                                (
                                    result[type] ||
                                    0
                                ) + 1;

                            return result;

                        },
                        {}
                    ),

                supported:
                    contexts.filter(
                        function (
                            context
                        ) {

                            return context
                                .supported;
                        }
                    ).length,

                conditional:
                    contexts.filter(
                        function (
                            context
                        ) {

                            return context.flags &&
                                context.flags
                                    .conditional;
                        }
                    ).length,

                repeated:
                    contexts.filter(
                        function (
                            context
                        ) {

                            return context.flags &&
                                context.flags
                                    .repeated;
                        }
                    ).length,

                matrix:
                    contexts.filter(
                        function (
                            context
                        ) {

                            return context.flags &&
                                context.flags
                                    .matrix;
                        }
                    ).length
            };
        };


    /* ============================================================
       CONTEXT REPORT
       ============================================================ */

    engine.report =
        function () {

            return engine.getContexts()
                .map(
                    function (
                        context
                    ) {

                        return {

                            id:
                                context.id,

                            text:
                                context.text,

                            type:
                                context.type,

                            score:
                                context.score,

                            platform:
                                context.platform,

                            controls:
                                context.controls.length,

                            choices:
                                context.choices.length,

                            instructions:
                                context.instructions,

                            processed:
                                context.processed,

                            supported:
                                context.supported,

                            answer:
                                context.answer,

                            parent:
                                context.relationships
                                    .parent,

                            children:
                                context.relationships
                                    .children
                                    .slice(),

                            related:
                                context.relationships
                                    .related
                                    .slice(),

                            flags:
                                Object.assign(
                                    {},
                                    context.flags
                                )
                        };
                    }
                );
        };


    /* ============================================================
       SAFE ANSWER HANDOFF
       ============================================================ */

    engine.resolveContext =
        function (
            context
        ) {

            if (
                !context
            ) {

                return {

                    supported:
                        false,

                    answer:
                        null,

                    confidence:
                        0,

                    reason:
                        "missing-context"
                };
            }


            /*
             * LogicalReasoning has priority.
             */

            if (
                ISE.LogicalReasoning &&
                typeof ISE.LogicalReasoning
                    .safeResolve ===
                "function"
            ) {

                try {

                    var logical =
                        ISE.LogicalReasoning
                            .safeResolve(
                                context.text
                            );

                    if (
                        logical &&
                        logical.supported
                    ) {

                        return logical;
                    }

                }
                catch (error) {

                    engine.state.errors++;

                    engine.statistics
                        .errors++;
                }
            }


            /*
             * Advanced semantics fallback.
             */

            if (
                ISE.AdvancedSemantics &&
                typeof ISE.AdvancedSemantics
                    .safeResolve ===
                "function"
            ) {

                try {

                    var advanced =
                        ISE.AdvancedSemantics
                            .safeResolve(
                                context.text
                            );

                    if (
                        advanced &&
                        advanced.supported
                    ) {

                        return advanced;
                    }

                }
                catch (error) {

                    engine.state.errors++;

                    engine.statistics
                        .errors++;
                }
            }


            return {

                supported:
                    false,

                answer:
                    null,

                confidence:
                    0,

                reason:
                    "unsupported-profile-question"
            };
        };


    /* ============================================================
       SAFE CONTEXT PROCESSOR
       ============================================================ */

    engine.processSupportedContexts =
        function () {

            var contexts =
                engine.getVisibleContexts();

            var results =
                [];


            for (
                var i = 0;
                i <
                contexts.length;
                i++
            ) {

                var context =
                    contexts[i];

                if (
                    !context ||
                    !context.flags
                        .likelyQuestion
                ) {

                    continue;
                }


                var resolution =
                    engine.resolveContext(
                        context
                    );


                if (
                    !resolution ||
                    !resolution.supported
                ) {

                    /*
                     * Unsupported means stop here.
                     * Do not guess.
                     */

                    results.push({

                        context:
                            context,

                        supported:
                            false,

                        resolution:
                            resolution
                    });

                    continue;
                }


                if (
                    Number(
                        resolution.confidence ||
                        0
                    ) <
                    0.40
                ) {

                    results.push({

                        context:
                            context,

                        supported:
                            false,

                        resolution:
                            {

                                supported:
                                    false,

                                answer:
                                    null,

                                confidence:
                                    resolution
                                        .confidence ||
                                    0,

                                reason:
                                    "low-confidence"
                            }
                    });

                    continue;
                }


                context.supported =
                    true;

                context.answer =
                    resolution.answer;

                context.processed =
                    true;


                results.push({

                    context:
                        context,

                    supported:
                        true,

                    resolution:
                        resolution
                });
            }


            return results;
        };


    /* ============================================================
       START
       ============================================================ */

    engine.start =
        function () {

            if (
                engine.state.running
            ) {

                return true;
            }

            engine.state.running =
                true;


            try {

                installObserver();

                engine.scan();

                startInterval();


                try {

                    if (
                        ISE.log
                    ) {

                        ISE.log(
                            "Part 21 — Context Intelligence " +
                            VERSION +
                            " started."
                        );
                    }

                }
                catch (ignored) {
                }


            }
            catch (error) {

                engine.state.errors++;

                engine.statistics
                    .errors++;

                try {

                    if (
                        ISE.warn
                    ) {

                        ISE.warn(
                            "Part 21 startup error",
                            error
                        );
                    }

                }
                catch (ignored2) {
                }
            }


            return true;
        };


    /* ============================================================
       STOP
       ============================================================ */

    engine.stop =
        function () {

            engine.state.running =
                false;


            if (
                engine.state
                    .scanTimer
            ) {

                clearTimeout(
                    engine.state
                        .scanTimer
                );

                engine.state
                    .scanTimer =
                    null;
            }


            stopInterval();


            if (
                engine.state
                    .mutationObserver
            ) {

                try {

                    engine.state
                        .mutationObserver
                        .disconnect();

                }
                catch (error) {
                }

                engine.state
                    .mutationObserver =
                    null;
            }


            return true;
        };


    /* ============================================================
       TESTS
       ============================================================ */

    engine.test =
        function () {

            var tests =
                [];

            function add(
                name,
                passed
            ) {

                tests.push({

                    name:
                        name,

                    passed:
                        !!passed
                });
            }


            add(
                "Version exists",
                VERSION.length > 0
            );


            add(
                "Question container engine exists",
