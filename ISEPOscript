       ============================================================ */

    engine.resolve = function (questionText) {

        engine.statistics.calls++;

        ensureProfile();

        var original =
            questionText;

        var text =
            cleanQuestion(
                questionText
            );

        if (!text) {

            engine.statistics.unsupported++;

            return {
                supported: false,
                reason: "Empty question"
            };
        }

        var cacheKey =
            compact(text);

        if (
            engine.cache.has(
                cacheKey
            )
        ) {

            engine.statistics.cachedMatches++;

            var cached =
                engine.cache.get(
                    cacheKey
                );

            if (
                cached &&
                cached.supported
            ) {
                engine.statistics.supported++;
            }

            return cached;
        }

        var result = null;

        /*
         * Highest-specificity rules first.
         */

        result =
            resolveTwoWeekWakefulness(
                text
            );

        if (!result) {
            result =
                resolveDiagnosis(
                    text
                );
        }

        if (!result) {
            result =
                resolveDOB(
                    text
                );
        }

        if (!result) {
            result =
                resolveChildren(
                    text
                );
        }

        if (!result) {
            result =
                resolveVehicle(
                    text
                );
        }

        if (!result) {
            result =
                resolveAge(
                    text
                );
        }

        if (!result) {
            result =
                resolveGender(
                    text
                );
        }

        if (!result) {
            result =
                resolveMarital(
                    text
                );
        }

        if (!result) {
            result =
                resolveEmployment(
                    text
                );
        }

        if (!result) {
            result =
                resolveEducation(
                    text
                );
        }

        if (!result) {
            result =
                resolveIncome(
                    text
                );
        }

        if (!result) {
            result =
                resolveLocation(
                    text
                );
        }

        if (!result) {
            result =
                resolveGeneralConfiguredFacts(
                    text
                );
        }

        /*
         * Unsupported questions deliberately remain
         * unsupported.
         */

        if (!result) {

            result = {
                supported: false,
                reason:
                    "No explicit profile fact or safe derivation matches",
                category:
                    detectCategory(text),
                intent:
                    detectIntent(text)
            };
        }

        result.question =
            original;

        result.normalizedQuestion =
            text;

        result.category =
            result.category ||
            detectCategory(text);

        result.intent =
            result.intent ||
            detectIntent(text);

        /*
         * Statistics.
         */

        if (result.supported) {

            engine.statistics.supported++;

            if (
                result.source &&
                result.source.indexOf(
                    "profile."
                ) === 0
            ) {
                engine.statistics.profileMatches++;
            }

            if (
                result.confidence >=
                0.95
            ) {
                engine.statistics.highConfidence++;
            }
            else if (
                result.confidence >=
                0.80
            ) {
                engine.statistics.mediumConfidence++;
            }
            else {
                engine.statistics.lowConfidence++;
            }

            if (
                result.category ===
                "diagnosis"
            ) {
                engine.statistics.diagnosisMatches++;
            }

            if (
                result.category &&
                result.category.indexOf(
                    "experience."
                ) === 0
            ) {
                engine.statistics.experienceMatches++;
            }

            if (
                result.answer ===
                "Yes" ||
                result.answer ===
                "No"
            ) {
                engine.statistics.yesNoMatches++;
            }

            if (
                result.category ===
                "age" ||
                result.category ===
                "children" ||
                result.category ===
                "vehicle" ||
                result.category ===
                "income"
            ) {
                engine.statistics.numericMatches++;
            }

            if (
                result.category ===
                "dob"
            ) {
                engine.statistics.dateMatches++;
            }
        }
        else {
            engine.statistics.unsupported++;
        }

        engine.cache.set(
            cacheKey,
            result
        );

        return result;
    };


    /* ============================================================
       SAFE RESOLUTION WRAPPER
       ============================================================ */

    engine.safeResolve =
        function (questionText) {

            try {

                var result =
                    engine.resolve(
                        questionText
                    );

                if (
                    !result ||
                    !result.supported
                ) {
                    return {
                        supported: false,
                        reason:
                            result &&
                            result.reason
                            ?
                            result.reason
                            :
                            "Unsupported question"
                    };
                }

                return result;

            }
            catch (error) {

                if (
                    ISE &&
                    ISE.warn
                ) {

                    ISE.warn(
                        "Advanced semantic resolution failed",
                        error
                    );
                }

                return {
                    supported: false,
                    reason:
                        "Semantic engine exception"
                };
            }
        };


    /* ============================================================
       ANSWER EQUIVALENCE
       ============================================================ */

    engine.answersEquivalent =
        function (
            expected,
            actual
        ) {

            var a =
                normalize(expected);

            var b =
                normalize(actual);

            if (!a || !b) {
                return false;
            }

            if (a === b) {
                return true;
            }

            if (
                isYes(a) &&
                isYes(b)
            ) {
                return true;
            }

            if (
                isNo(a) &&
                isNo(b)
            ) {
                return true;
            }

            if (
                isNone(a) &&
                isNone(b)
            ) {
                return true;
            }

            var numberA =
                Number(
                    a.replace(/[$,% ,]/g, "")
                );

            var numberB =
                Number(
                    b.replace(/[$,% ,]/g, "")
                );

            if (
                !isNaN(numberA) &&
                !isNaN(numberB)
            ) {

                return (
                    numberA ===
                    numberB
                );
            }

            return false;
        };


