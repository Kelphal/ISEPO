    if(
        ISE.log
    )
    {
        ISE.log(
            "Recovery state reset."
        );
    }
};


/* ------------------------------------------------------------
   CLEAN OLD HISTORY
   ------------------------------------------------------------ */

ISE.RecoveryEngine.cleanup =
function()
{
    var cutoff =
        ISE.RecoveryEngine
            .now() -
        (
            30 *
            60 *
            1000
        );

    var history =
        ISE.RecoveryEngine
            .history;

    var output = [];

    for(
        var i = 0;
        i < history.length;
        i++
    )
    {
        if(
            history[i].time >=
            cutoff
        )
        {
            output.push(
                history[i]
            );
        }
    }

    ISE.RecoveryEngine
        .history =
        output;

    var objects = [
        "attempts",
        "successes",
        "failures"
    ];

    for(
        var j = 0;
        j < objects.length;
        j++
    )
    {
        var object =
            ISE.RecoveryEngine[
                objects[j]
            ];

        var keys =
            Object.keys(
                object
            );

        for(
            var k = 0;
            k < keys.length;
            k++
        )
        {
            var record =
                object[
                    keys[k]
                ];

            if(
                record &&
                record.time &&
                record.time <
                cutoff
            )
            {
                delete object[
                    keys[k]
                ];
            }

            if(
                record &&
                record.last &&
                record.last <
                cutoff
            )
            {
                delete object[
                    keys[k]
                ];
            }
        }
    }
};


/* ------------------------------------------------------------
   RECOVERY MONITOR
   ------------------------------------------------------------ */

ISE.RecoveryEngine.startMonitor =
function()
{
    if(
        ISE.RecoveryEngine
            .active
    )
    {
        return;
    }

    ISE.RecoveryEngine
        .active = true;

    var timer =
        setInterval(
            function()
            {
                ISE.RecoveryEngine
                    .cleanup();

                ISE.RecoveryEngine
                    .flushQueue();

            },
            3000
        );

    ISE.RecoveryEngine
        .timers
        .push(
            timer
        );
};


/* ------------------------------------------------------------
   STOP MONITOR
   ------------------------------------------------------------ */

ISE.RecoveryEngine.stopMonitor =
function()
{
    for(
        var i = 0;
        i <
        ISE.RecoveryEngine
            .timers
            .length;
        i++
    )
    {
        try
        {
            clearTimeout(
                ISE.RecoveryEngine
                    .timers[i]
            );

            clearInterval(
                ISE.RecoveryEngine
                    .timers[i]
            );
        }
        catch(error)
        {
        }
    }

    ISE.RecoveryEngine
        .timers = [];

    ISE.RecoveryEngine
        .active = false;
};


