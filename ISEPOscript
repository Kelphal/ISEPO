            }

            engine.statistics
                .supportedQuestions++;

            var profileValue =
                profileValueForQuestion(
                    questionText
                );

            /*
             * Direct text/numeric controls.
             */

            if (
                (
                    questionType.numeric ||
                    questionType.date
