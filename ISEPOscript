        "data-test"
    ];

    for (
        var i = 0;
        i < dataAttributes.length;
        i++
    ) {

        if (
            ISE.PlatformEngine
                .attr(
                    element,
                    dataAttributes[i]
                )
        ) {

            return true;
        }
    }

    var className =
        ISE.PlatformEngine
            .attr(
                element,
                "class"
            )
            .toLowerCase();

    var patterns = [

        "radio",

        "checkbox",

        "option",

        "choice",

        "answer",

        "select",

        "dropdown",

        "combobox",

