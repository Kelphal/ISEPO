/* ------------------------------------------------------------
   PROFILE SAFETY / DEFAULTS
   ------------------------------------------------------------ */

ISE.AnswerEngine.ensureProfile = function () {

    if (!ISE.PROFILE) {
        ISE.PROFILE = {};
    }

    if (ISE.PROFILE.diagnosedConditions === undefined) {
        ISE.PROFILE.diagnosedConditions = [];
    }

    if (!Array.isArray(ISE.PROFILE.diagnosedConditions)) {
        ISE.PROFILE.diagnosedConditions = [];
    }

    return ISE.PROFILE;
};

ISE.AnswerEngine.ensureProfile();


/* ------------------------------------------------------------
   TEXT NORMALIZATION
   ------------------------------------------------------------ */

ISE.SemanticEngine.normalize = function (value) {

    if (value === null || value === undefined) {
        return "";
    }

    return String(value)
        .toLowerCase()
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201C\u201D]/g, '"')
        .replace(/&amp;/g, " and ")
        .replace(/&/g, " and ")
        .replace(/\$/g, " dollars ")
        .replace(/,/g, "")
        .replace(/[()[\]{}:;!?]/g, " ")
        .replace(/[\/\\|]/g, " ")
        .replace(/[-–—]/g, " ")
        .replace(/\s+/g, " ")
        .trim();
};


ISE.SemanticEngine.tokens = function (value) {

    var normalized = ISE.SemanticEngine.normalize(value);

    if (!normalized) {
        return [];
    }

    return normalized
        .split(/\s+/)
        .filter(function (token) {
            return token.length > 0;
        });
};


ISE.SemanticEngine.uniqueTokens = function (value) {

    var tokens = ISE.SemanticEngine.tokens(value);
    var seen = {};
    var output = [];

    for (var i = 0; i < tokens.length; i++) {

        if (!seen[tokens[i]]) {
            seen[tokens[i]] = true;
            output.push(tokens[i]);
        }
    }

    return output;
};


ISE.SemanticEngine.hasPhrase = function (text, phrase) {

    var normalizedText = ISE.SemanticEngine.normalize(text);
    var normalizedPhrase = ISE.SemanticEngine.normalize(phrase);

    if (!normalizedText || !normalizedPhrase) {
        return false;
    }

    return normalizedText.indexOf(normalizedPhrase) !== -1;
};


ISE.SemanticEngine.hasAnyPhrase = function (text, phrases) {

    if (!Array.isArray(phrases)) {
        return false;
    }

    for (var i = 0; i < phrases.length; i++) {

        if (ISE.SemanticEngine.hasPhrase(text, phrases[i])) {
            return true;
        }
    }

    return false;
};


/* ------------------------------------------------------------
   TOKEN SIMILARITY
   ------------------------------------------------------------ */

ISE.SemanticEngine.tokenOverlap = function (a, b) {

    var left = ISE.SemanticEngine.uniqueTokens(a);
    var right = ISE.SemanticEngine.uniqueTokens(b);

    if (!left.length || !right.length) {
        return 0;
    }

    var rightMap = {};
    var matches = 0;

    for (var i = 0; i < right.length; i++) {
        rightMap[right[i]] = true;
    }

    for (var j = 0; j < left.length; j++) {

        if (rightMap[left[j]]) {
            matches++;
        }
    }

    return matches / Math.max(left.length, right.length);
};


ISE.SemanticEngine.containsToken = function (text, token) {

    var tokens = ISE.SemanticEngine.uniqueTokens(text);
    var normalizedToken = ISE.SemanticEngine.normalize(token);

    for (var i = 0; i < tokens.length; i++) {

        if (tokens[i] === normalizedToken) {
            return true;
        }
    }

    return false;
};


