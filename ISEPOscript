/* ------------------------------------------------------------
   QUESTION MARK DETECTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.hasQuestionMark = function (
    text
) {

    if (!text) {
        return false;
    }

    return String(text).indexOf("?") !== -1;
};


/* ------------------------------------------------------------
   INTERROGATIVE DETECTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.interrogatives = [

    "what",
    "which",
    "where",
    "when",
    "why",
    "how",
    "who",
    "whose",
    "are",
    "is",
    "do",
    "does",
    "did",
    "have",
    "has",
    "had",
    "can",
    "could",
    "would",
    "will",
    "were",
    "was"
];


ISE.QuestionIntelligence.startsLikeQuestion = function (
    text
) {

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return false;
    }

    var tokens =
        normalized.split(/\s+/);

    if (!tokens.length) {
        return false;
    }

    return (
        ISE.QuestionIntelligence.interrogatives
            .indexOf(tokens[0]) !== -1
    );
};


/* ------------------------------------------------------------
   QUESTION SENTENCE DETECTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.looksLikeQuestion = function (
    text
) {

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return false;
    }

    var score = 0;

    if (
        ISE.QuestionIntelligence.hasQuestionMark(
            text
        )
    ) {
        score += 0.35;
    }

    if (
        ISE.QuestionIntelligence.startsLikeQuestion(
            normalized
        )
    ) {
        score += 0.35;
    }

    if (
        ISE.SemanticEngine.hasAnyPhrase(
            normalized,
            ISE.QuestionIntelligence.instructions
        )
    ) {
        score += 0.2;
    }

    var category =
        ISE.AnswerEngine.detectCategory(
            normalized
        );

    if (category) {
        score += 0.35;
    }

    return score >= 0.35;
};


/* ------------------------------------------------------------
   ANSWER CHOICE DETECTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.isAnswerChoice = function (
    text,
    element
) {

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return false;
    }

    var score = 0;

    if (
        ISE.QuestionIntelligence.answerChoicePhrases
            .indexOf(normalized) !== -1
    ) {
        score += 0.9;
    }

    if (
        ISE.SemanticEngine.isYes(
            normalized
        )
    ) {
        score += 0.8;
    }

    if (
        ISE.SemanticEngine.isNo(
            normalized
        )
    ) {
        score += 0.8;
    }

    if (
        ISE.SemanticEngine.isNone(
            normalized
        )
    ) {
        score += 0.8;
    }

    if (
        ISE.SemanticEngine.isDontKnow(
            normalized
        )
    ) {
        score += 0.8;
    }

    if (
        ISE.SemanticEngine.isPreferNot(
            normalized
        )
    ) {
        score += 0.8;
    }

    /*
     * Radio/checkbox labels are overwhelmingly likely
     * to be answer choices rather than questions.
     */

    if (element) {

        var tag =
            String(
                element.tagName || ""
            ).toLowerCase();

        var role =
            ISE.ControlEngine
                ? ISE.ControlEngine.attr(
                    element,
                    "role"
                )
                : "";

        role =
            ISE.SemanticEngine.normalize(
                role
            );

        if (
            tag === "label" ||
            tag === "option" ||
            role === "radio" ||
            role === "checkbox" ||
            role === "option"
        ) {
            score += 0.45;
        }
    }

    /*
     * Very short standalone text without a question
     * structure is usually an answer choice.
     */

    if (
        normalized.split(/\s+/).length <= 5 &&
        !ISE.QuestionIntelligence.looksLikeQuestion(
            normalized
        )
    ) {
        score += 0.2;
    }

    return score >= 0.65;
};


/* ------------------------------------------------------------
   CATEGORY PHRASE SCORING
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.categoryScore = function (
    text,
    category
) {

    if (
        !ISE.AnswerEngine.patterns ||
        !ISE.AnswerEngine.patterns[category]
    ) {
        return 0;
    }

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    var patterns =
        ISE.AnswerEngine.patterns[
            category
        ];

    var best = 0;

    for (
        var i = 0;
        i < patterns.length;
        i++
    ) {

        var phrase =
            ISE.SemanticEngine.normalize(
                patterns[i]
            );

        if (
            normalized.indexOf(
                phrase
            ) !== -1
        ) {
            best = Math.max(
                best,
                1
            );

            continue;
        }

        var overlap =
            ISE.SemanticEngine.tokenOverlap(
                normalized,
                phrase
            );

        best = Math.max(
            best,
            overlap
        );
    }

    return best;
};


/* ------------------------------------------------------------
   ADVANCED CATEGORY DETECTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.detectCategory = function (
    text
) {

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return null;
    }

    var categories =
        Object.keys(
            ISE.AnswerEngine.patterns
        );

    var candidates = [];

    for (
        var i = 0;
        i < categories.length;
        i++
    ) {

        var category =
            categories[i];

        var score =
            ISE.QuestionIntelligence.categoryScore(
                normalized,
                category
            );

        if (score > 0) {

            candidates.push({
                category: category,
                score: score
            });
        }
    }

    candidates.sort(
        function (a, b) {
            return b.score - a.score;
        }
    );

    if (!candidates.length) {
        return null;
    }

    return {
        category:
            candidates[0].category,

        confidence:
            candidates[0].score,

        alternatives:
            candidates.slice(
                1,
                5
            )
    };
};


/* ------------------------------------------------------------
   QUESTION SCORE
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.score = function (
    text,
    element
) {

    if (!text) {
        return 0;
    }

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return 0;
    }

    var score = 0;

    /*
     * Explicit question marker.
     */

    if (
        ISE.QuestionIntelligence.hasQuestionMark(
            text
        )
    ) {
        score += 0.3;
    }

    /*
     * Interrogative opening.
     */

    if (
        ISE.QuestionIntelligence.startsLikeQuestion(
            normalized
        )
    ) {
        score += 0.3;
    }

    /*
     * Profile category match.
     */

    var category =
        ISE.QuestionIntelligence.detectCategory(
            normalized
        );

    if (category) {

        score += Math.min(
            0.5,
            category.confidence * 0.5
        );
    }

    /*
     * Instruction language.
     */

    if (
        ISE.SemanticEngine.hasAnyPhrase(
            normalized,
            ISE.QuestionIntelligence.instructions
        )
    ) {
        score += 0.15;
    }

    /*
     * Answer choices should reduce the score.
     */

    if (
        ISE.QuestionIntelligence.isAnswerChoice(
            normalized,
            element
        )
    ) {
        score -= 0.7;
    }

    /*
     * Navigation/footer text should strongly reduce it.
     */

    if (
        ISE.SemanticEngine.hasAnyPhrase(
            normalized,
            ISE.QuestionIntelligence.nonQuestionPhrases
        )
    ) {
        score -= 0.8;
    }

    /*
     * Extremely short text is rarely a complete question.
     */

    var wordCount =
        normalized.split(/\s+/).length;

    if (wordCount <= 2) {
        score -= 0.25;
    }

    /*
     * Long blocks may be instructions or descriptions,
     * but category phrases can still make them legitimate.
     */

    if (wordCount > 100 && !category) {
        score -= 0.3;
    }

    return Math.max(
        0,
        Math.min(
            1,
            score
        )
    );
};


/* ------------------------------------------------------------
   QUESTION TYPE
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.getType = function (
    text
) {

    var normalized =
        ISE.SemanticEngine.normalize(
            text
        );

    if (!normalized) {
        return "unknown";
    }

    if (
        normalized.indexOf("select all") !== -1 ||
        normalized.indexOf("choose all") !== -1 ||
        normalized.indexOf("check all") !== -1 ||
        normalized.indexOf("select any") !== -1 ||
        normalized.indexOf("choose any") !== -1
    ) {
        return "multi-select";
    }

    if (
        normalized.indexOf("select one") !== -1 ||
        normalized.indexOf("choose one") !== -1 ||
        normalized.indexOf("pick one") !== -1
    ) {
        return "single-select";
    }

    if (
        normalized.indexOf("rank") !== -1 ||
        normalized.indexOf("ranking") !== -1 ||
        normalized.indexOf("order") !== -1
    ) {
        return "ranking";
    }

    if (
        normalized.indexOf("rate") !== -1 ||
        normalized.indexOf("rating") !== -1 ||
        normalized.indexOf("scale") !== -1
    ) {
        return "rating";
    }

    if (
        normalized.indexOf("how many") !== -1 ||
        normalized.indexOf("number of") !== -1 ||
        normalized.indexOf("how old") !== -1 ||
        normalized.indexOf("amount") !== -1
    ) {
        return "numeric";
    }

    if (
        normalized.indexOf("date") !== -1 ||
        normalized.indexOf("birthday") !== -1 ||
        normalized.indexOf("born") !== -1
    ) {
        return "date";
    }

    if (
        normalized.indexOf("why") === 0 ||
        normalized.indexOf("please explain") === 0 ||
        normalized.indexOf("describe") === 0
    ) {
        return "open-text";
    }

    return "single-select";
};


/* ------------------------------------------------------------
   QUESTION CONTEXT EXTRACTION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.getContext = function (
    element
) {

    if (!element) {
        return "";
    }

    var pieces = [];

    var current =
        element;

    var depth = 0;

    while (
        current &&
        depth < 6
    ) {

        var text =
            ISE.ControlEngine
                ? ISE.ControlEngine.text(
                    current
                )
                : (
                    current.innerText ||
                    current.textContent ||
                    ""
                );

        if (text) {
            pieces.push(text);
        }

        current =
            current.parentElement;

        depth++;
    }

    return pieces
        .reverse()
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
};


/* ------------------------------------------------------------
   QUESTION CONTAINER FINDING
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.findContainer = function (
    element
) {

    if (!element) {
        return null;
    }

    var current =
        element;

    var best =
        element;

    var bestScore =
        0;

    var depth = 0;

    while (
        current &&
        depth < 8
    ) {

        var text =
            ISE.ControlEngine
                ? ISE.ControlEngine.text(
                    current
                )
                : (
                    current.innerText ||
                    current.textContent ||
                    ""
                );

        var score =
            ISE.QuestionIntelligence.score(
                text,
                current
            );

        var controls = 0;

        try {

            controls =
                current.querySelectorAll(
                    "input,select,textarea,button,[role='radio'],[role='checkbox'],[role='option']"
                ).length;

        } catch (error) {}

        /*
         * A good question container generally contains
         * the question plus at least one control.
         */

        if (controls > 0) {
            score += 0.25;
        }

        if (score > bestScore) {

            bestScore = score;
            best = current;
        }

        current =
            current.parentElement;

        depth++;
    }

    return best;
};


/* ------------------------------------------------------------
   EXTRACT QUESTION TEXT FROM CONTROL
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.extractQuestionText = function (
    control
) {

    if (!control) {
        return "";
    }

    var container =
        ISE.QuestionIntelligence.findContainer(
            control
        );

    if (!container) {
        return "";
    }

    var candidates = [];

    /*
     * Explicit labels.
     */

    try {

        var label =
            ISE.ControlEngine.findLabelForInput(
                control
            );

        if (label) {
            candidates.push(
                ISE.ControlEngine.text(label)
            );
        }

    } catch (error) {}


    /*
     * ARIA label.
     */

    var aria =
        ISE.ControlEngine.attr(
            control,
            "aria-label"
        );

    if (aria) {
        candidates.push(aria);
    }


    /*
     * Nearby headings.
     */

    try {

        var headings =
            container.querySelectorAll(
                "h1,h2,h3,h4,h5,h6,legend,[role='heading']"
            );

        for (
            var i = 0;
            i < headings.length;
            i++
        ) {

            candidates.push(
                ISE.ControlEngine.text(
                    headings[i]
                )
            );
        }

    } catch (error) {}


    /*
     * Text preceding the control.
     */

    var containerText =
        ISE.ControlEngine.text(
            container
        );

    if (containerText) {
        candidates.push(
            containerText
        );
    }


    /*
     * Select the candidate that most strongly
     * resembles an actual question.
     */

    var bestText = "";
    var bestScore = 0;

    for (
        var j = 0;
        j < candidates.length;
        j++
    ) {

        var candidate =
            candidates[j];

        if (!candidate) {
            continue;
        }

        var score =
            ISE.QuestionIntelligence.score(
                candidate,
                null
            );

        if (score > bestScore) {

            bestScore = score;
            bestText = candidate;
        }
    }

    return bestText;
};


/* ------------------------------------------------------------
   QUESTION OBJECT CREATION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.createQuestion = function (
    element
) {

    var text =
        ISE.QuestionIntelligence.extractQuestionText(
            element
        );

    if (!text) {
        return null;
    }

    var score =
        ISE.QuestionIntelligence.score(
            text,
            element
        );

    if (score < 0.35) {
        return null;
    }

    var category =
        ISE.QuestionIntelligence.detectCategory(
            text
        );

    var type =
        ISE.QuestionIntelligence.getType(
            text
        );

    var container =
        ISE.QuestionIntelligence.findContainer(
            element
        );

    return {

        element: element,

        container: container,

        text: text,

        questionText: text,

        confidence: score,

        type: type,

        category:
            category
                ? category.category
                : null,

        categoryConfidence:
            category
                ? category.confidence
                : 0,

        timestamp:
            Date.now(),

        _autofillProcessed: false,

        _lastAutofillResult: null
    };
};


/* ------------------------------------------------------------
   DEDUPLICATION
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.questionKey = function (
    question
) {

    if (!question) {
        return "";
    }

    var text =
        ISE.SemanticEngine.normalize(
            question.text
        );

    var category =
        question.category ||
        "";

    return (
        category +
        "::" +
        text
    );
};


ISE.QuestionIntelligence.dedupe = function (
    questions
) {

    if (!Array.isArray(questions)) {
        return [];
    }

    var seen = {};
    var output = [];

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        var question =
            questions[i];

        var key =
            ISE.QuestionIntelligence.questionKey(
                question
            );

        if (!key) {
            continue;
        }

        if (seen[key]) {
            continue;
        }

        seen[key] = true;

        output.push(question);
    }

    return output;
};


/* ------------------------------------------------------------
   FILTER OUT ANSWER CHOICES
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.filterQuestions = function (
    questions
) {

    if (!Array.isArray(questions)) {
        return [];
    }

    var output = [];

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        var question =
            questions[i];

        if (!question) {
            continue;
        }

        if (
            ISE.QuestionIntelligence.isAnswerChoice(
                question.text,
                question.element
            )
        ) {
            continue;
        }

        if (
            question.confidence < 0.35
        ) {
            continue;
        }

        output.push(question);
    }

    return output;
};


/* ------------------------------------------------------------
   MERGE WITH GLOBAL QUESTION STATE
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.register = function (
    question
) {

    if (!question) {
        return false;
    }

    if (!ISE.STATE) {
        return false;
    }

    if (!Array.isArray(ISE.STATE.questions)) {
        ISE.STATE.questions = [];
    }

    var key =
        ISE.QuestionIntelligence.questionKey(
            question
        );

    for (
        var i = 0;
        i < ISE.STATE.questions.length;
        i++
    ) {

        var existing =
            ISE.STATE.questions[i];

        if (
            ISE.QuestionIntelligence.questionKey(
                existing
            ) === key
        ) {

            /*
             * Keep the newer DOM reference if the survey
             * dynamically replaced its controls.
             */

            if (
                question.element &&
                existing.element !==
                    question.element
            ) {
                existing.element =
                    question.element;
            }

            if (
                question.container
            ) {
                existing.container =
                    question.container;
            }

            return false;
        }
    }

    ISE.STATE.questions.push(
        question
    );

    if (
        ISE.STATE.statistics
    ) {

        ISE.STATE.statistics.questionsDetected =
            (
                ISE.STATE.statistics.questionsDetected ||
                0
            ) + 1;
    }

    return true;
};


/* ------------------------------------------------------------
   SCAN QUESTION-RELATED ELEMENTS
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.scan = function (
    root
) {

    var target =
        root ||
        document;

    var candidates = [];

    var selectors = [
        "label",
        "legend",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "[role='heading']",
        "input",
        "select",
        "textarea",
        "button",
        "[role='radio']",
        "[role='checkbox']",
        "[role='option']"
    ];

    try {

        var nodes =
            target.querySelectorAll(
                selectors.join(",")
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var node =
                nodes[i];

            var text =
                ISE.ControlEngine.text(
                    node
                );

            if (!text) {
                continue;
            }

            /*
             * Directly ignore obvious answer choices.
             */

            if (
                ISE.QuestionIntelligence.isAnswerChoice(
                    text,
                    node
                )
            ) {
                continue;
            }

            if (
                ISE.QuestionIntelligence.looksLikeQuestion(
                    text
                )
            ) {

                candidates.push(node);
            }

            /*
             * Controls can contain little/no text,
             * so separately derive their parent question.
             */

            var tag =
                ISE.ControlEngine.tag(
                    node
                );

            if (
                tag === "input" ||
                tag === "select" ||
                tag === "textarea" ||
                tag === "button"
            ) {

                var question =
                    ISE.QuestionIntelligence.createQuestion(
                        node
                    );

                if (question) {
                    candidates.push(
                        question
                    );
                }
            }
        }

    } catch (error) {

        if (ISE.warn) {
            ISE.warn(
                "Advanced question scan failed:",
                error
            );
        }
    }

    var normalized = [];

    for (
        var j = 0;
        j < candidates.length;
        j++
    ) {

        var item =
            candidates[j];

        if (
            item &&
            item.text &&
            item.confidence !== undefined
        ) {

            normalized.push(item);
            continue;
        }

        var generated =
            ISE.QuestionIntelligence.createQuestion(
                item
            );

        if (generated) {
            normalized.push(generated);
        }
    }

    normalized =
        ISE.QuestionIntelligence.filterQuestions(
            normalized
        );

    normalized =
        ISE.QuestionIntelligence.dedupe(
            normalized
        );

    for (
        var k = 0;
        k < normalized.length;
        k++
    ) {

        ISE.QuestionIntelligence.register(
            normalized[k]
        );
    }

    return normalized;
};


/* ------------------------------------------------------------
   PROFILE-SUPPORTED QUESTION CHECK
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.isProfileSupported = function (
    question
) {

    if (!question) {
        return false;
    }

    var result =
        ISE.AnswerEngine.resolve(
            question.text
        );

    return !!(
        result &&
        result.supported
    );
};


/* ------------------------------------------------------------
   QUESTION ANALYSIS
   ------------------------------------------------------------ */

ISE.QuestionIntelligence.analyze = function (
    question
) {

    if (!question) {
        return null;
    }

    var answer =
        ISE.AnswerEngine.resolve(
            question.text
        );

    return {

        question:
            question.text,

        confidence:
            question.confidence,

        type:
            question.type,

        category:
            question.category,

        categoryConfidence:
            question.categoryConfidence,

        profileSupported:
            !!(
                answer &&
                answer.supported
            ),

        answer:
            answer || null
    };
};


