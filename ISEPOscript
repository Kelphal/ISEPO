ISE.AnswerEngine.resolveVehicle = function (questionText) {

    var cars = ISE.AnswerEngine.getCars();

    if (cars === null) {
        return null;
    }

    var text = ISE.SemanticEngine.normalize(questionText);

    if (
        ISE.SemanticEngine.hasPhrase(text, "do you have a car") ||
        ISE.SemanticEngine.hasPhrase(text, "do you own a car") ||
        ISE.SemanticEngine.hasPhrase(text, "do you have a vehicle") ||
        ISE.SemanticEngine.hasPhrase(text, "do you own a vehicle") ||
        ISE.SemanticEngine.hasPhrase(text, "own any cars") ||
        ISE.SemanticEngine.hasPhrase(text, "own any vehicles")
    ) {

        return {
            supported: true,
            kind: "single",
            value: cars > 0 ? "Yes" : "No",
            confidence: 0.99,
            category: "vehicle",
            reason: "Vehicle ownership derived from configured car count."
        };
    }

    return {
        supported: true,
        kind: "number",
        value: cars,
        confidence: 0.95,
        category: "vehicle",
        reason: "Configured car count."
    };
};


