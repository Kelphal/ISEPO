ISE.AutofillEngine.getStatus = function () {

    return {
        version:
            ISE.ControlEngine.version,

        statistics:
            Object.assign(
                {},
                ISE.AutofillEngine.statistics
            ),

        recent:
            ISE.AutofillEngine.lastResults.slice()
    };
};


