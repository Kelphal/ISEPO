/* ------------------------------------------------------------
   EXTENDED CONTROL SCAN
   ------------------------------------------------------------ */

ISE.PlatformEngine.extendedScan =
function (
    root
) {

    var platform =
        ISE.PlatformEngine
            .detect();

    var controls =
        ISE.PlatformEngine
            .scan(
                root ||
                document
            );

    var extensions =
        ISE.PlatformEngine
            .selectorExtensions[
                platform
            ] ||
        ISE.PlatformEngine
            .selectorExtensions
            .generic;

    try {

        var extra =
            (
                root ||
                document
            )
            .querySelectorAll(
                extensions.join(
                    ","
                )
            );

        for (
            var i = 0;
            i < extra.length;
            i++
        ) {

            if (
                controls.indexOf(
                    extra[i]
                ) === -1 &&
                ISE.PlatformEngine
                    .visible(
                        extra[i]
                    )
            ) {

                controls.push(
                    extra[i]
                );
            }
        }

    } catch (error) {}

    return ISE.PlatformEngine
        .unique(
            controls
        );
};


