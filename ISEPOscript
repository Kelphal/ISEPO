   ============================================================ */

ISE.AdvancedSemantics.analyze =
function(
    text
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    var category =
        ISE.AdvancedSemantics
            .detectCategory(
                normalized
            );

    var analysis =
    {
        text:
            normalized,

        form:
            ISE.AdvancedSemantics
                .detectQuestionForm(
                    normalized
                ),

        category:
            category.category,

        categoryConfidence:
            category.score,

        negation:
            ISE.AdvancedSemantics
                .detectNegation(
                    normalized
                ),

        conditional:
            ISE.AdvancedSemantics
                .detectConditional(
                    normalized
                ),

        ownership:
            ISE.AdvancedSemantics
                .detectOwnership(
                    normalized
                ),

        quantity:
            ISE.AdvancedSemantics
                .detectQuantityIntent(
                    normalized
                ),

        range:
            ISE.AdvancedSemantics
                .detectRangeIntent(
                    normalized
                ),

        frequency:
            ISE.AdvancedSemantics
                .detectFrequency(
                    normalized
                ),

        isBoolean:
            ISE.AdvancedSemantics
                .isBooleanQuestion(
                    normalized
                ),

        isDate:
            ISE.AdvancedSemantics
                .isDateQuestion(
                    normalized
                ),

        isAge:
            ISE.AdvancedSemantics
                .isAgeQuestion(
                    normalized
                ),

        isChildren:
            ISE.AdvancedSemantics
                .isChildrenQuestion(
                    normalized
                ),

        isVehicle:
            ISE.AdvancedSemantics
                .isVehicleQuestion(
                    normalized
                ),

        isIncome:
            ISE.AdvancedSemantics
                .isIncomeQuestion(
                    normalized
                ),

        isDiagnosis:
            ISE.AdvancedSemantics
                .isDiagnosisQuestion(
                    normalized
                )
    };

    return analysis;
};


/* ============================================================
   MASTER PROFILE RESOLUTION
   ============================================================ */

ISE.AdvancedSemantics.resolve =
function(
    text
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    var analysis =
        ISE.AdvancedSemantics
            .analyze(
                normalized
            );

    var resolver =
        null;

    switch(
        analysis.category
    )
    {
        case "diagnosis":
            resolver =
                ISE.AdvancedSemantics
                    .resolveDiagnosis;
            break;

        case "vehicle":
            resolver =
                ISE.AdvancedSemantics
                    .resolveVehicle;
            break;

        case "children":
            resolver =
                ISE.AdvancedSemantics
                    .resolveChildren;
            break;

        case "income":
            resolver =
                ISE.AdvancedSemantics
                    .resolveIncome;
            break;

        case "age":

            if(
                ISE.AnswerEngine &&
                typeof ISE.AnswerEngine
                    .resolveAge ===
                "function"
            )
            {
                try
                {
                    resolver =
                        ISE.AnswerEngine
                            .resolveAge;
                }
                catch(error)
                {
                }
            }

            break;

        case "gender":
            resolver =
                ISE.AdvancedSemantics
                    .resolveGender;
            break;

        case "marital":
            resolver =
                ISE.AdvancedSemantics
                    .resolveMarital;
            break;

        case "employment":
            resolver =
                ISE.AdvancedSemantics
                    .resolveEmployment;
            break;

        case "education":
            resolver =
                ISE.AdvancedSemantics
                    .resolveEducation;
            break;

        case "location":
            resolver =
                ISE.AdvancedSemantics
                    .resolveLocation;
            break;
    }

    if(
        analysis.isDate &&
        !resolver
    )
    {
        resolver =
            ISE.AdvancedSemantics
                .resolveDate;
    }

    if(
        resolver
    )
    {
        try
        {
            var result =
                resolver(
                    normalized
                );

            if(
                result
            )
            {
                result.analysis =
                    analysis;

                return result;
            }
        }
        catch(error)
        {
            if(
                ISE.warn
            )
            {
                ISE.warn(
                    "Advanced semantic resolver error:",
                    error
                );
            }
        }
    }

    /*
     * Fall back to the existing AnswerEngine,
     * but only if it has a resolver.
     */

    if(
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine
            .resolve ===
        "function"
    )
    {
        try
        {
            var fallback =
                ISE.AnswerEngine
                    .resolve(
                        normalized
                    );

            if(
                fallback
            )
            {
                fallback.analysis =
                    analysis;

                return fallback;
            }
        }
        catch(error)
        {
        }
    }

    return {
        supported:
            false,

        confidence:
            0,

        category:
            analysis.category,

        analysis:
            analysis,

        reason:
            "No configured profile fact supports this question."
    };
};


/* ============================================================
   CONTROL-OPTION SEMANTIC MATCHING
   ============================================================ */

ISE.AdvancedSemantics.optionSimilarity =
function(
    optionText,
    answer
)
{
    var option =
        ISE.AdvancedSemantics
            .normalize(
                optionText
            );

    var expected =
        ISE.AdvancedSemantics
            .normalize(
                answer
            );

    if(
        !option ||
        !expected
    )
    {
        return 0;
    }

    if(
        option ===
        expected
    )
    {
        return 1;
    }

    var optionBoolean =
        ISE.AdvancedSemantics
            .normalizeBoolean(
                option
            );

    var answerBoolean =
        ISE.AdvancedSemantics
            .normalizeBoolean(
                expected
            );

    if(
        optionBoolean &&
        answerBoolean &&
        optionBoolean ===
        answerBoolean
    )
    {
        return 1;
    }

    var overlap =
        ISE.AdvancedSemantics
            .tokenOverlap(
                option,
                expected
            );

    if(
        overlap >
        0.75
    )
    {
        return 0.95;
    }

    if(
        overlap >
        0.50
    )
    {
        return 0.80;
    }

    if(
        overlap >
        0.25
    )
    {
        return 0.60;
    }

    return 0;
};


/* ============================================================
   RANGE OPTION MATCHING
