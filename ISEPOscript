/* ------------------------------------------------------------
   CONTROL COLLECTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.collect = function (
    root
) {

    var target =
        root ||
        document;

    var output = [];

    try {

        var nodes =
            target.querySelectorAll(
                ISE.AdvancedControls.selector
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var node =
                nodes[i];

            if (
                !ISE.AdvancedControls.isVisible(
                    node
                )
            ) {
                continue;
            }

            if (
                ISE.AdvancedControls.isDisabled(
                    node
                )
            ) {
                continue;
            }

            output.push(node);
        }

    } catch (error) {}

    return output;
};


