    if (!isFinite(step) || step <= 0) {
        step = 1;
    }

    if (!isFinite(value)) {
        value = min;
    }

    return {
        min: min,
        max: max,
        step: step,
        value: value
    };
};


/* ------------------------------------------------------------
   SAFE VALUE SETTER
   ------------------------------------------------------------ */

ISE.AdvancedControls.setNativeValue = function (
    element,
    value
) {

    if (!element) {
        return false;
    }

    try {

        var prototype =
            Object.getPrototypeOf(
                element
            );

        var descriptor =
            Object.getOwnPropertyDescriptor(
                prototype,
                "value"
            );

        if (
            descriptor &&
            descriptor.set
        ) {

            descriptor.set.call(
                element,
                value
            );

        } else {

            element.value =
                value;
        }

        return true;

    } catch (error) {

        try {
            element.value = value;
            return true;
        } catch (error2) {
            return false;
        }
    }
};


/* ------------------------------------------------------------
   EVENT DISPATCH
   ------------------------------------------------------------ */

ISE.AdvancedControls.dispatch = function (
    element,
    eventName
) {

    if (!element) {
        return;
    }

    try {

        element.dispatchEvent(
            new Event(
                eventName,
                {
                    bubbles: true,
                    cancelable: true
                }
            )
        );

    } catch (error) {

        try {

            var event =
                document.createEvent(
                    "Event"
                );

            event.initEvent(
                eventName,
                true,
                true
            );

            element.dispatchEvent(
                event
            );

        } catch (error2) {}
    }
};


/* ------------------------------------------------------------
   SELECT VALUE MATCHING
   ------------------------------------------------------------ */

ISE.AdvancedControls.matchSelectOption = function (
    control,
    answer
) {

    if (!control) {
        return null;
    }

    var options =
        ISE.AdvancedControls.getOptions(
            control
        );

    var normalizedAnswer =
        ISE.SemanticEngine.normalize(
            answer
        );

    if (!normalizedAnswer) {
        return null;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < options.length;
        i++
    ) {

        var option =
            options[i];

        if (option.disabled) {
            continue;
        }

        var text =
            ISE.SemanticEngine.normalize(
                option.text
            );

        var value =
            ISE.SemanticEngine.normalize(
                option.value
            );

        var score = 0;

        if (
            text === normalizedAnswer ||
            value === normalizedAnswer
        ) {
            score = 1;
        }

        if (
            text.indexOf(
                normalizedAnswer
            ) !== -1
        ) {
            score = Math.max(
                score,
                0.85
            );
        }

        if (
            normalizedAnswer.indexOf(
                text
            ) !== -1
        ) {
            score = Math.max(
                score,
                0.8
            );
        }

        var overlap =
            ISE.SemanticEngine.tokenOverlap(
                text,
                normalizedAnswer
            );

        score =
            Math.max(
                score,
                overlap
            );

        if (
            ISE.AnswerEngine &&
            typeof ISE.AnswerEngine
                .answerMatches ===
                "function"
        ) {

            if (
                ISE.AnswerEngine.answerMatches(
                    text,
                    answer
                )
            ) {
                score =
                    Math.max(
                        score,
                        0.95
                    );
            }
        }

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = {
                option: option,
                score: score
            };
        }
    }

    return best;
};


/* ------------------------------------------------------------
   SELECT FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillSelect = function (
    control,
    answer
) {

    if (!control) {
        return false;
    }

    var match =
        ISE.AdvancedControls.matchSelectOption(
            control,
            answer
        );

    if (!match) {
        return false;
    }

    try {

        control.selectedIndex =
            Array.prototype.indexOf.call(
                control.options,
                match.option.element
            );

        control.value =
            match.option.value;

        ISE.AdvancedControls.dispatch(
            control,
            "input"
        );

        ISE.AdvancedControls.dispatch(
            control,
            "change"
        );

        return (
            String(control.value) ===
            String(match.option.value)
        );

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   CLICKABLE CUSTOM CONTROL
   ------------------------------------------------------------ */

ISE.AdvancedControls.click = function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        ISE.AdvancedControls.isDisabled(
            element
        )
    ) {
        return false;
    }

    try {

        element.click();

        return true;

    } catch (error) {

        try {

            element.dispatchEvent(
                new MouseEvent(
                    "click",
                    {
                        bubbles: true,
                        cancelable: true,
                        view: window
                    }
                )
            );

            return true;

        } catch (error2) {

            return false;
        }
    }
};


/* ------------------------------------------------------------
   RADIO STATE
   ------------------------------------------------------------ */

ISE.AdvancedControls.isChecked = function (
    control
) {

    if (!control) {
        return false;
    }

    if (
        control.checked === true
    ) {
        return true;
    }

    var aria =
        ISE.AdvancedControls.attr(
            control,
            "aria-checked"
        );

    if (aria === "true") {
        return true;
    }

    var selected =
        ISE.AdvancedControls.attr(
            control,
            "aria-selected"
        );

    return (
        selected === "true"
    );
};


/* ------------------------------------------------------------
   SET CHECKED
   ------------------------------------------------------------ */

ISE.AdvancedControls.setChecked = function (
    control,
    desired
) {

    if (!control) {
        return false;
    }

    var current =
        ISE.AdvancedControls.isChecked(
            control
        );

    if (
        current === desired
    ) {
        return true;
    }

    /*
     * Native controls should be activated by click
     * rather than simply modifying .checked.
     */

    if (
        ISE.AdvancedControls.tag(
            control
        ) === "input"
    ) {

        ISE.AdvancedControls.click(
            control
        );

        return (
            ISE.AdvancedControls.isChecked(
                control
            ) === desired
        );
    }

    ISE.AdvancedControls.click(
        control
    );

    return true;
};


/* ------------------------------------------------------------
   CHECKBOX MULTI-SELECT MATCHING
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillCheckboxGroup = function (
    controls,
    answers
) {

    if (
        !Array.isArray(controls) ||
        !controls.length
    ) {
        return false;
    }

    if (
        !Array.isArray(answers)
    ) {
        answers = [
            answers
        ];
    }

    var normalizedAnswers =
        answers.map(
            function (value) {
                return ISE.SemanticEngine
                    .normalize(
                        value
                    );
            }
        );

    var changed = false;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var text =
            ISE.AdvancedControls.controlText(
                control
            );

        var normalizedText =
            ISE.SemanticEngine.normalize(
                text
            );

        var shouldCheck = false;

        for (
            var j = 0;
            j < normalizedAnswers.length;
            j++
        ) {

            var answer =
                normalizedAnswers[j];

            if (!answer) {
                continue;
            }

            if (
                normalizedText === answer ||
                normalizedText.indexOf(
                    answer
                ) !== -1 ||
                answer.indexOf(
                    normalizedText
                ) !== -1
            ) {

                shouldCheck = true;
                break;
            }

            var overlap =
                ISE.SemanticEngine.tokenOverlap(
                    normalizedText,
                    answer
                );

            if (
                overlap >= 0.65
            ) {

                shouldCheck = true;
                break;
            }
        }

        if (
            ISE.AdvancedControls.setChecked(
                control,
                shouldCheck
            )
        ) {
            changed = true;
        }
    }

    return changed;
};


/* ------------------------------------------------------------
   RADIO GROUP FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillRadioGroup = function (
    controls,
    answer
) {

    if (
        !Array.isArray(controls) ||
        !controls.length
    ) {
        return false;
    }

    var normalizedAnswer =
        ISE.SemanticEngine.normalize(
            answer
        );

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var text =
            ISE.SemanticEngine.normalize(
                ISE.AdvancedControls.controlText(
                    control
                )
            );

        var value =
            ISE.SemanticEngine.normalize(
                ISE.AdvancedControls.attr(
                    control,
                    "value"
                )
            );

        var score = 0;

        if (
            text === normalizedAnswer ||
            value === normalizedAnswer
        ) {
            score = 1;
        }

        if (
            text.indexOf(
                normalizedAnswer
            ) !== -1
        ) {
            score =
                Math.max(
                    score,
                    0.85
                );
        }

        if (
            normalizedAnswer.indexOf(
                text
            ) !== -1 &&
            text.length > 0
        ) {
            score =
                Math.max(
                    score,
                    0.8
                );
        }

        var overlap =
            ISE.SemanticEngine.tokenOverlap(
                text,
                normalizedAnswer
            );

        score =
            Math.max(
                score,
                overlap
            );

        if (
            ISE.AnswerEngine &&
            typeof ISE.AnswerEngine.answerMatches ===
                "function"
        ) {

            if (
                ISE.AnswerEngine.answerMatches(
                    text,
                    answer
                )
            ) {

                score =
                    Math.max(
                        score,
                        0.95
                    );
            }
        }

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = control;
        }
    }

    /*
     * Require a meaningful match.
     * Never randomly select a radio option.
     */

    if (
        !best ||
        bestScore < 0.55
    ) {
        return false;
    }

    return ISE.AdvancedControls.setChecked(
        best,
        true
    );
};


/* ------------------------------------------------------------
   CUSTOM BUTTON OPTION FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.findClickableAnswer = function (
    container,
    answer
) {

    if (!container) {
        return null;
    }

    var normalizedAnswer =
        ISE.SemanticEngine.normalize(
            answer
        );

    if (!normalizedAnswer) {
        return null;
    }

    var nodes = [];

    try {

        nodes =
            container.querySelectorAll(
                "button,[role='button'],[role='option'],[role='radio'],[role='checkbox'],label,[data-value],[data-answer],[data-option],[data-choice]"
            );

    } catch (error) {

        return null;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < nodes.length;
        i++
    ) {

        var node =
            nodes[i];

        if (
            !ISE.AdvancedControls.isVisible(
                node
            )
        ) {
            continue;
        }

        if (
            ISE.AdvancedControls.isDisabled(
                node
            )
        ) {
            continue;
        }

        var text =
            ISE.SemanticEngine.normalize(
                ISE.AdvancedControls.controlText(
                    node
                )
            );

        if (!text) {
            continue;
        }

        var score = 0;

        if (
            text === normalizedAnswer
        ) {
            score = 1;
        }

        if (
            text.indexOf(
                normalizedAnswer
            ) !== -1
        ) {
            score =
                Math.max(
                    score,
                    0.82
                );
        }

        var overlap =
            ISE.SemanticEngine.tokenOverlap(
                text,
                normalizedAnswer
            );

        score =
            Math.max(
                score,
                overlap
            );

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = node;
        }
    }

    if (
        !best ||
        bestScore < 0.55
    ) {
        return null;
    }

    return {
        element: best,
        score: bestScore
    };
};


/* ------------------------------------------------------------
   CUSTOM BUTTON FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillCustomChoice = function (
    container,
    answer
) {

    var match =
        ISE.AdvancedControls.findClickableAnswer(
            container,
            answer
        );

    if (!match) {
        return false;
    }

    return ISE.AdvancedControls.click(
        match.element
    );
};


/* ------------------------------------------------------------
   SLIDER VALUE SETTER
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillSlider = function (
    control,
    value
) {

    if (!control) {
        return false;
    }

    var range =
        ISE.AdvancedControls.getRangeInfo(
            control
        );

    if (!range) {
        return false;
    }

    var numeric =
        parseFloat(
            value
        );

    if (!isFinite(numeric)) {
        return false;
    }

    numeric =
        Math.max(
            range.min,
            Math.min(
                range.max,
                numeric
            )
        );

    /*
     * Snap to step.
     */

    numeric =
        range.min +
        Math.round(
            (
                numeric -
                range.min
            ) /
            range.step
        ) *
        range.step;

    numeric =
        Math.max(
            range.min,
            Math.min(
                range.max,
                numeric
            )
        );

    if (
        !ISE.AdvancedControls.setNativeValue(
            control,
            String(numeric)
        )
    ) {
        return false;
    }

    ISE.AdvancedControls.dispatch(
        control,
        "input"
    );

    ISE.AdvancedControls.dispatch(
        control,
        "change"
    );

    var finalValue =
        parseFloat(
            control.value
        );

    return (
        isFinite(finalValue) &&
        Math.abs(
            finalValue -
            numeric
        ) <=
        Math.max(
            range.step,
            0.01
        )
    );
};


/* ------------------------------------------------------------
   NUMBER FIELD FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillNumber = function (
    control,
    value
) {

    if (!control) {
        return false;
    }

    var numeric =
        parseFloat(
            value
        );

    if (!isFinite(numeric)) {
        return false;
    }

    var min =
        parseFloat(
            ISE.AdvancedControls.attr(
                control,
                "min"
            )
        );

    var max =
        parseFloat(
            ISE.AdvancedControls.attr(
                control,
                "max"
            )
        );

    if (isFinite(min)) {
        numeric =
            Math.max(
                min,
                numeric
            );
    }

    if (isFinite(max)) {
        numeric =
            Math.min(
                max,
                numeric
            );
    }

    if (
        !ISE.AdvancedControls.setNativeValue(
            control,
            String(numeric)
        )
    ) {
        return false;
    }

    ISE.AdvancedControls.dispatch(
        control,
        "input"
    );

    ISE.AdvancedControls.dispatch(
        control,
        "change"
    );

    return (
        String(
            control.value
        ) === String(numeric)
    );
};


/* ------------------------------------------------------------
   TEXT FIELD FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillText = function (
    control,
    value
) {

    if (!control) {
        return false;
    }

    if (
        value === null ||
        value === undefined
    ) {
        return false;
    }

    var stringValue =
        String(value);

    if (
        !ISE.AdvancedControls.setNativeValue(
            control,
            stringValue
        )
    ) {
        return false;
    }

    ISE.AdvancedControls.dispatch(
        control,
        "input"
    );

    ISE.AdvancedControls.dispatch(
        control,
        "change"
    );

    return (
        String(
            control.value
        ) === stringValue
    );
};


/* ------------------------------------------------------------
   DATE CONTROL FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fillDate = function (
    control,
    dateValue
) {

    if (!control) {
        return false;
    }

    var date =
        ISE.SemanticEngine.parseDate(
            dateValue
        );

    if (!date) {
        return false;
    }

    var type =
        ISE.AdvancedControls
            .attr(
                control,
                "type"
            )
            .toLowerCase();

    var value = "";

    if (
        type === "date"
    ) {

        value =
            date.year +
            "-" +
            String(
                date.month
            ).padStart(
                2,
                "0"
            ) +
            "-" +
            String(
                date.day
            ).padStart(
                2,
                "0"
            );

    } else if (
        type === "month"
    ) {

        value =
            date.year +
            "-" +
            String(
                date.month
            ).padStart(
                2,
                "0"
            );

    } else {

        value =
            String(
                date.month
            ).padStart(
                2,
                "0"
            ) +
            "/" +
            String(
                date.day
            ).padStart(
                2,
                "0"
            ) +
            "/" +
            date.year;
    }

    return ISE.AdvancedControls.fillText(
        control,
        value
    );
};


/* ------------------------------------------------------------
   DATE GROUP DETECTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.findDateGroup = function (
    control
) {

    if (!control) {
        return null;
    }

    var container =
        control.closest
            ? control.closest(
                "fieldset,[data-question],[data-group],[role='group']"
              )
            : null;

    if (!container) {
        container =
            control.parentElement;
    }

    if (!container) {
        return null;
    }

    var inputs = [];

    try {

        var nodes =
            container.querySelectorAll(
                "input,select"
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var node =
                nodes[i];

            var type =
                ISE.AdvancedControls.getType(
                    node
                );

            if (
                type === "date" ||
                type === "number" ||
                type === "text" ||
                type === "select"
            ) {

                inputs.push(
                    node
                );
            }
        }

    } catch (error) {}

    if (
        inputs.length < 2
    ) {
        return null;
    }

    var labels =
        inputs.map(
            function (node) {
                return ISE.SemanticEngine
                    .normalize(
                        ISE.AdvancedControls
                            .controlText(
                                node
                            )
                    );
            }
        );

    var hasMonth = false;
    var hasDay = false;
    var hasYear = false;

    for (
        var j = 0;
        j < labels.length;
        j++
    ) {

        var label =
            labels[j];

        if (
            label.indexOf("month") !== -1
        ) {
            hasMonth = true;
        }

        if (
            label.indexOf("day") !== -1
        ) {
            hasDay = true;
        }

        if (
            label.indexOf("year") !== -1
        ) {
            hasYear = true;
        }
    }

    if (
        hasMonth ||
        hasDay ||
        hasYear
    ) {

        return {
            container: container,
            controls: inputs
        };
    }

    return null;
};


/* ------------------------------------------------------------
   GRID DETECTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.isGrid = function (
    container
) {

    if (!container) {
        return false;
    }

    var role =
        ISE.AdvancedControls.role(
            container
        );

    if (
        role === "grid" ||
        role === "table"
    ) {
        return true;
    }

    var table =
        ISE.AdvancedControls.tag(
            container
        ) === "table";

    if (table) {
        return true;
    }

    try {

        var rows =
            container.querySelectorAll(
                "tr,[role='row']"
            );

        if (
            rows.length >= 2
        ) {

            var selectable =
                container.querySelectorAll(
                    "input[type='radio'],input[type='checkbox'],[role='radio'],[role='checkbox']"
                );

            return (
                selectable.length >= 2
            );
        }

    } catch (error) {}

    return false;
};


/* ------------------------------------------------------------
   GRID ROW EXTRACTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.getGridRows = function (
    container
) {

    if (!container) {
        return [];
    }

    var rows = [];

    try {

        var nodes =
            container.querySelectorAll(
                "tr,[role='row']"
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var row =
                nodes[i];

            var text =
                ISE.AdvancedControls.safeText(
                    row
                );

            if (!text) {
                continue;
            }

            rows.push({
                element: row,
                text: text,
                controls:
                    ISE.AdvancedControls
                        .collect(
                            row
                        )
            });
        }

    } catch (error) {}

    return rows;
};


/* ------------------------------------------------------------
   GRID COLUMNS
   ------------------------------------------------------------ */

ISE.AdvancedControls.getGridColumns = function (
    container
) {

    if (!container) {
        return [];
    }

    var columns = [];

    try {

        var headers =
            container.querySelectorAll(
                "th,[role='columnheader']"
            );

        for (
            var i = 0;
            i < headers.length;
            i++
        ) {

            var header =
                headers[i];

            var text =
                ISE.AdvancedControls.safeText(
                    header
                );

            if (!text) {
                continue;
            }

            columns.push({
                element: header,
                text: text,
                index: i
            });
        }

    } catch (error) {}

    return columns;
};


/* ------------------------------------------------------------
   GRID ROW QUESTION TEXT
   ------------------------------------------------------------ */

ISE.AdvancedControls.getGridRowText = function (
    row
) {

    if (!row) {
        return "";
    }

    var text =
        ISE.AdvancedControls.safeText(
            row
        );

    var controls =
        ISE.AdvancedControls.collect(
            row
        );

    /*
     * Remove answer-choice text from the row where
     * possible so the remaining text represents the
     * row/question rather than the answer scale.
     */

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var controlText =
            ISE.AdvancedControls.safeText(
                controls[i]
            );

        if (!controlText) {
            continue;
        }

        if (
            ISE.QuestionIntelligence &&
            ISE.QuestionIntelligence
                .isAnswerChoice(
                    controlText,
                    controls[i]
                )
        ) {

            text =
                text
                    .replace(
                        controlText,
                        ""
                    );
        }
    }

    return text
        .replace(/\s+/g, " ")
        .trim();
};


/* ------------------------------------------------------------
   GRID SCAN
   ------------------------------------------------------------ */

ISE.AdvancedControls.scanGrids = function (
    root
) {

    var target =
        root ||
        document;

    var grids = [];

    try {

        var candidates =
            target.querySelectorAll(
                "table,[role='grid'],[role='table'],fieldset,[data-grid]"
            );

        for (
            var i = 0;
            i < candidates.length;
            i++
        ) {

            var container =
                candidates[i];

            if (
                !ISE.AdvancedControls.isGrid(
                    container
                )
            ) {
                continue;
            }

            var rows =
                ISE.AdvancedControls
                    .getGridRows(
                        container
                    );

            var columns =
                ISE.AdvancedControls
                    .getGridColumns(
                        container
                    );

            if (
                rows.length < 2
            ) {
                continue;
            }

            grids.push({
                element: container,
                rows: rows,
                columns: columns,
                rowCount: rows.length,
                columnCount:
                    columns.length
            });
        }

    } catch (error) {}

    return grids;
};


/* ------------------------------------------------------------
   GRID QUESTION RESOLUTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.getGridQuestion = function (
    grid
) {

    if (!grid) {
        return null;
    }

    var container =
        grid.element;

    var candidates = [];

    try {

        var legends =
            container.querySelectorAll(
                "legend,h1,h2,h3,h4,h5,h6,[role='heading']"
            );

        for (
            var i = 0;
            i < legends.length;
            i++
        ) {

            var text =
                ISE.AdvancedControls.safeText(
                    legends[i]
                );

            if (text) {
                candidates.push(text);
            }
        }

    } catch (error) {}

    var parent =
        container.parentElement;

    if (parent) {

        var parentText =
            ISE.AdvancedControls.safeText(
                parent
            );

        if (parentText) {
            candidates.push(
                parentText
            );
        }
    }

    var best = "";
    var bestScore = 0;

    for (
        var j = 0;
        j < candidates.length;
        j++
    ) {

        var score =
            ISE.QuestionIntelligence.score(
                candidates[j]
            );

        if (
            score > bestScore
        ) {

            bestScore = score;
            best = candidates[j];
        }
    }

    if (!best) {
        return null;
    }

    return {
        text: best,
        confidence: bestScore,
        type: "grid"
    };
};


/* ------------------------------------------------------------
   GRID CONTROL MATCH
   ------------------------------------------------------------ */

ISE.AdvancedControls.matchGridRow = function (
    row,
    answer
) {

    if (!row) {
        return null;
    }

    var controls =
        row.controls ||
        ISE.AdvancedControls.collect(
            row.element
        );

    if (!controls.length) {
        return null;
    }

    return ISE.AdvancedControls
        .findBestControl(
            controls,
            answer
        );
};


/* ------------------------------------------------------------
   BEST CONTROL MATCH
   ------------------------------------------------------------ */

ISE.AdvancedControls.findBestControl = function (
    controls,
    answer
) {

    if (
        !Array.isArray(controls) ||
        !controls.length
    ) {
        return null;
    }

    var normalizedAnswer =
        ISE.SemanticEngine.normalize(
            answer
        );

    if (!normalizedAnswer) {
        return null;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var text =
            ISE.SemanticEngine.normalize(
                ISE.AdvancedControls.controlText(
                    control
                )
            );

        var value =
            ISE.SemanticEngine.normalize(
                ISE.AdvancedControls.attr(
                    control,
                    "value"
                )
            );

        var score = 0;

        if (
            text === normalizedAnswer ||
            value === normalizedAnswer
        ) {
            score = 1;
        }

        if (
            text.indexOf(
                normalizedAnswer
            ) !== -1
        ) {

            score =
                Math.max(
                    score,
                    0.85
                );
        }

        if (
            normalizedAnswer.indexOf(
                text
            ) !== -1 &&
            text.length > 0
        ) {

            score =
                Math.max(
                    score,
                    0.8
                );
        }

        var overlap =
            ISE.SemanticEngine.tokenOverlap(
                text,
                normalizedAnswer
            );

        score =
            Math.max(
                score,
                overlap
            );

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = control;
        }
    }

    if (
        !best ||
        bestScore < 0.45
    ) {
        return null;
    }

    return {
        element: best,
        score: bestScore
    };
};


/* ------------------------------------------------------------
   GENERIC ADVANCED FILL
   ------------------------------------------------------------ */

ISE.AdvancedControls.fill = function (
    control,
    answer
) {

    if (!control) {
        return false;
    }

    var type =
        ISE.AdvancedControls.getType(
            control
        );

    switch (type) {

        case "select":

            return ISE.AdvancedControls
                .fillSelect(
                    control,
                    answer
                );


        case "radio":

            return ISE.AdvancedControls
                .setChecked(
                    control,
                    true
                );


        case "checkbox":

            return ISE.AdvancedControls
                .setChecked(
                    control,
                    true
                );


        case "number":

            return ISE.AdvancedControls
                .fillNumber(
                    control,
                    answer
                );


        case "slider":

            return ISE.AdvancedControls
                .fillSlider(
                    control,
                    answer
                );


        case "date":

            return ISE.AdvancedControls
                .fillDate(
                    control,
                    answer
                );


        case "text":

        case "textarea":

        case "email":

        case "phone":

            return ISE.AdvancedControls
                .fillText(
                    control,
                    answer
                );


        case "button":

        case "option":

        case "combobox":

            return ISE.AdvancedControls
                .click(
                    control
                );


        default:

            return ISE.AdvancedControls
                .fillCustomChoice(
                    control.parentElement,
                    answer
                );
    }
};


/* ------------------------------------------------------------
   VERIFICATION
   ------------------------------------------------------------ */

ISE.AdvancedControls.verify = function (
    control,
    answer
) {

    if (!control) {
        return false;
    }

    var type =
        ISE.AdvancedControls.getType(
            control
        );

    if (
        type === "radio" ||
        type === "checkbox"
    ) {

        return ISE.AdvancedControls
            .isChecked(
                control
            );
    }

    if (
        type === "select"
    ) {

        var value =
            ISE.SemanticEngine.normalize(
                control.value
            );

        var normalizedAnswer =
            ISE.SemanticEngine.normalize(
                answer
            );

        if (
            value === normalizedAnswer
        ) {
            return true;
        }

        var selected =
            control.options[
                control.selectedIndex
            ];

        if (selected) {

            return (
                ISE.SemanticEngine
                    .normalize(
                        selected.text
                    ) ===
                normalizedAnswer
            );
        }

        return false;
    }

    if (
        type === "slider" ||
        type === "number"
    ) {

        var numericValue =
            parseFloat(
                control.value
            );

        var numericAnswer =
            parseFloat(
                answer
            );

        if (
            isFinite(
                numericValue
            ) &&
            isFinite(
                numericAnswer
            )
        ) {

            return (
                Math.abs(
                    numericValue -
                    numericAnswer
                ) < 0.0001
            );
        }

        return false;
    }

    if (
        control.value !==
        undefined
    ) {

        return (
            String(
                control.value
            ) ===
            String(answer)
        );
    }

    return false;
};


/* ------------------------------------------------------------
   ADVANCED QUESTION CONTROL MAP
   ------------------------------------------------------------ */

ISE.AdvancedControls.buildMap = function (
    root
) {

    var controls =
        ISE.AdvancedControls.collect(
            root
        );

    var groups =
        ISE.AdvancedControls.groupControls(
            controls
        );

    var map = [];

    var keys =
        Object.keys(
            groups
        );

    for (
        var i = 0;
        i < keys.length;
        i++
    ) {

        var key =
            keys[i];

        var group =
            groups[key];

        if (!group.length) {
            continue;
        }

        var question =
            ISE.AdvancedControls
                .findQuestion(
                    group[0]
                );

        map.push({

            key: key,

            controls: group,

            question: question,

            type:
                ISE.AdvancedControls
                    .getType(
                        group[0]
                    )
        });
    }

    return map;
};


/* ------------------------------------------------------------
   ADVANCED CONTROL DIAGNOSTICS
   ------------------------------------------------------------ */

ISE.AdvancedControls.diagnostics = function (
    root
) {

    var controls =
        ISE.AdvancedControls.collect(
            root
        );

    var counts = {};

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var type =
            ISE.AdvancedControls.getType(
                controls[i]
            );

        if (!counts[type]) {
            counts[type] = 0;
        }

        counts[type]++;
    }

    return {

        version:
            ISE.AdvancedControls.version,

        totalControls:
            controls.length,

        types:
            counts,

        radioGroups:
            Object.keys(
                ISE.AdvancedControls
                    .getRadioGroups(
                        root
                    )
            ).length,

        checkboxGroups:
            Object.keys(
                ISE.AdvancedControls
                    .getCheckboxGroups(
                        root
                    )
            ).length,

        grids:
            ISE.AdvancedControls
                .scanGrids(
                    root
                ).length
    };
};


/* ------------------------------------------------------------
   CONTROL TEST
   ------------------------------------------------------------ */

ISE.AdvancedControls.test = function (
    root
) {

    var report =
        ISE.AdvancedControls
            .diagnostics(
                root
            );

    if (ISE.log) {

        ISE.log(
            "Advanced control diagnostics:",
            report
        );
    }

    return report;
};


/* ------------------------------------------------------------
   INTEGRATION WITH AUTOFILL ENGINE
   ------------------------------------------------------------ */

ISE.AdvancedControls.integrateAutofill =
function () {

    if (
        !ISE.AutofillEngine
    ) {
        return false;
    }

    /*
     * Preserve the existing Part 4 methods.
     * These wrappers only provide additional control
     * strategies for controls Part 4 may not understand.
     */

    if (
        !ISE.AutofillEngine.advancedControlResolver
    ) {

        ISE.AutofillEngine
            .advancedControlResolver =
            function (
                question,
                answer
            ) {

                if (
                    !question ||
                    !answer
                ) {
                    return false;
                }

                var container =
                    question.container;

                if (!container) {
                    return false;
                }

                /*
                 * GRID
                 */

                if (
                    ISE.AdvancedControls
                        .isGrid(
                            container
                        )
                ) {

                    var grid = {
                        element:
                            container,

                        rows:
                            ISE.AdvancedControls
                                .getGridRows(
                                    container
                                ),

                        columns:
                            ISE.AdvancedControls
                                .getGridColumns(
                                    container
                                )
                    };

                    /*
                     * A scalar answer can be applied
                     * when the grid contains a matching
                     * answer column.
                     */

                    for (
                        var g = 0;
                        g < grid.rows.length;
                        g++
                    ) {

                        var row =
                            grid.rows[g];

                        var match =
                            ISE.AdvancedControls
                                .matchGridRow(
                                    row,
                                    answer
                                );

                        if (match) {

                            return ISE.AdvancedControls
                                .click(
                                    match.element
                                );
                        }
                    }
                }


                /*
                 * RADIO GROUP
                 */

                var radios =
                    container.querySelectorAll
                        ? container.querySelectorAll(
                            "input[type='radio'],[role='radio']"
                          )
                        : [];

                if (
                    radios.length
                ) {

                    var radioArray =
                        Array.prototype.slice.call(
                            radios
                        );

                    return ISE.AdvancedControls
                        .fillRadioGroup(
                            radioArray,
                            answer
                        );
                }


                /*
                 * SELECT
                 */

                var selects =
                    container.querySelectorAll
                        ? container.querySelectorAll(
                            "select,[role='combobox']"
                          )
                        : [];

                for (
                    var s = 0;
                    s < selects.length;
                    s++
                ) {

                    if (
                        ISE.AdvancedControls
                            .fillSelect(
                                selects[s],
                                answer
                            )
                    ) {

                        return true;
                    }
                }


                /*
                 * SLIDER
                 */

                var sliders =
                    container.querySelectorAll
                        ? container.querySelectorAll(
                            "input[type='range'],[role='slider']"
                          )
                        : [];

                for (
                    var r = 0;
                    r < sliders.length;
                    r++
                ) {

                    if (
                        ISE.AdvancedControls
                            .fillSlider(
                                sliders[r],
                                answer
                            )
                    ) {

                        return true;
                    }
                }


                /*
                 * NUMBER INPUT
                 */

                var numbers =
                    container.querySelectorAll
                        ? container.querySelectorAll(
                            "input[type='number']"
                          )
                        : [];

                for (
                    var n = 0;
                    n < numbers.length;
                    n++
                ) {

                    if (
                        ISE.AdvancedControls
                            .fillNumber(
                                numbers[n],
                                answer
                            )
                    ) {

                        return true;
                    }
                }


                /*
                 * CUSTOM BUTTONS
                 */

                if (
                    ISE.AdvancedControls
                        .fillCustomChoice(
                            container,
                            answer
                        )
                ) {

                    return true;
                }

                return false;
            };
    }

    return true;
};


/* ------------------------------------------------------------
   ADVANCED QUESTION PROCESSOR
   ------------------------------------------------------------ */

ISE.AdvancedControls.processQuestion =
function (
    question,
    answer
) {

    if (
        !question ||
        answer === undefined ||
        answer === null
    ) {
        return {
            success: false,
            reason: "Missing question or answer."
        };
    }

    var container =
        question.container ||
        question.element;

    if (!container) {

        return {
            success: false,
            reason: "No question container."
        };
    }

    var success = false;

    try {

        /*
         * MULTI-SELECT ANSWERS
         */

        if (
            Array.isArray(answer)
        ) {

            var checkboxes =
                container.querySelectorAll
                    ? container.querySelectorAll(
                        "input[type='checkbox'],[role='checkbox']"
                      )
                    : [];

            if (
                checkboxes.length
            ) {

                success =
                    ISE.AdvancedControls
                        .fillCheckboxGroup(
                            Array.prototype.slice.call(
                                checkboxes
                            ),
                            answer
                        );

                if (success) {

                    return {
                        success: true,
                        method: "checkbox-group"
                    };
                }
            }
        }


        /*
         * STANDARD ADVANCED CONTROL
         */

        success =
            ISE.AutofillEngine
                .advancedControlResolver
                ? ISE.AutofillEngine
                    .advancedControlResolver(
                        question,
                        answer
                    )
                : false;

        if (success) {

            return {
                success: true,
                method: "advanced-resolver"
            };
        }


        /*
         * FALLBACK TO EXISTING PART 4 ENGINE
         */

        if (
            typeof ISE.AutofillEngine
                .processQuestion ===
            "function"
        ) {

            var result =
                ISE.AutofillEngine
                    .processQuestion(
                        question
                    );

            if (
                result &&
                result.success
            ) {

                return result;
            }
        }

    } catch (error) {

        if (ISE.warn) {

            ISE.warn(
                "Advanced question processing error:",
                error
            );
        }

        return {
            success: false,
            reason: String(error)
        };
    }

    return {
        success: false,
        reason: "No matching supported control."
    };
};


/* ------------------------------------------------------------
   AUTOMATIC CONTROL SCAN
   ------------------------------------------------------------ */

ISE.AdvancedControls.scan = function (
    root
) {

    var target =
        root ||
        document;

    var diagnostics =
        ISE.AdvancedControls
            .diagnostics(
                target
            );

    var grids =
        ISE.AdvancedControls
            .scanGrids(
                target
            );

    var map =
        ISE.AdvancedControls
            .buildMap(
                target
            );

    return {

        diagnostics:
            diagnostics,

        grids:
            grids,

        controlMap:
            map
    };
};


