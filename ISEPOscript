            ) {

                return {
                    found:
                        true,

                    amount:
                        2,

                    unit:
                        "weeks",

                    days:
                        14
                };
            }

            return result;
        }

        var amount =
            Number(
                match[1]
            );

        var unit =
            match[2];

        var days =
            null;

        if (
            unit === "day" ||
            unit === "days"
        ) {
            days =
                amount;
        }
        else if (
            unit === "week" ||
            unit === "weeks"
        ) {
            days =
                amount * 7;
        }
        else if (
            unit === "month" ||
            unit === "months"
        ) {
            days =
                amount * 30;
        }
        else if (
            unit === "year" ||
            unit === "years"
        ) {
            days =
                amount * 365;
        }

        return {

            found:
                true,

            amount:
                amount,

            unit:
                unit,

            days:
                days
        };
    }


