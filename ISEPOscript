        text.indexOf("range") !== -1 ||
        text.indexOf("how many") !== -1 ||
        text.indexOf("how much") !== -1
    );
};


/* ------------------------------------------------------------
   RANGE EXTRACTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.extractRanges =
function (
    text
) {

    var normalized =
        ISE.SpecializedSurvey.normalize(
            text
        );

    var ranges = [];

    var patterns = [

        /between\s+(\d+(?:\.\d+)?)\s+and\s+(\d+(?:\.\d+)?)/i,

        /from\s+(\d+(?:\.\d+)?)\s+to\s+(\d+(?:\.\d+)?)/i,

        /(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)/i,

        /under\s+(\d+(?:\.\d+)?)/i,

        /less\s+than\s+(\d+(?:\.\d+)?)/i,

        /over\s+(\d+(?:\.\d+)?)/i,

        /more\s+than\s+(\d+(?:\.\d+)?)/i
    ];

    for (
        var i = 0;
        i < patterns.length;
        i++
    ) {

        var match =
            normalized.match(
                patterns[i]
            );

        if (!match) {
            continue;
        }

        if (
            match.length >= 3
        ) {

            ranges.push({
                min:
                    parseFloat(
                        match[1]
                    ),

                max:
                    parseFloat(
                        match[2]
                    )
            });

        } else if (
            match.length >= 2
        ) {

            ranges.push({
                value:
                    parseFloat(
                        match[1]
                    )
            });
        }
    }

    return ranges;
};


/* ------------------------------------------------------------
   NUMERIC OPTION CLASSIFICATION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.numericOption =
function (
    text
) {

    var normalized =
        ISE.SpecializedSurvey.normalize(
            text
        );

    var match =
        normalized.match(
            /-?\d+(?:\.\d+)?/
        );

    if (!match) {
        return null;
    }

    var value =
        parseFloat(
            match[0]
        );

    if (!isFinite(value)) {
        return null;
    }

    return value;
};


/* ------------------------------------------------------------
   NUMERIC RANGE CHOICE
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.matchNumericRange =
function (
    choices,
    target
) {

    if (
        !Array.isArray(choices) ||
        !choices.length
    ) {
        return null;
    }

    var numericTarget =
        parseFloat(
            target
        );

    if (!isFinite(numericTarget)) {
        return null;
    }

    var best = null;
    var bestDistance =
        Infinity;

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var text =
            ISE.SpecializedSurvey
                .normalize(
                    choice.text
                );

        var numbers =
            text.match(
                /-?\d+(?:\.\d+)?/g
            );

        if (!numbers) {
            continue;
        }

        var values =
            numbers.map(
                function (v) {
                    return parseFloat(v);
                }
            );

        var distance =
            Infinity;

        if (
            values.length >= 2
        ) {

            var min =
                Math.min(
                    values[0],
                    values[1]
                );

            var max =
                Math.max(
                    values[0],
                    values[1]
                );

            if (
                numericTarget >= min &&
                numericTarget <= max
            ) {

                distance = 0;

            } else {

                distance =
                    Math.min(
                        Math.abs(
                            numericTarget -
                            min
                        ),
                        Math.abs(
                            numericTarget -
                            max
                        )
                    );
            }

        } else {

            distance =
                Math.abs(
                    numericTarget -
                    values[0]
                );
        }

        if (
            distance < bestDistance
        ) {

            bestDistance =
                distance;

            best = choice;
        }
    }

    if (!best) {
        return null;
    }

    return {
        choice: best,
        distance: bestDistance
    };
};


/* ------------------------------------------------------------
   AGE RANGE MATCHING
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.matchAgeRange =
function (
    choices
) {

    if (
        !ISE.PROFILE ||
        !ISE.PROFILE.age
    ) {
        return null;
    }

    var age =
        parseInt(
            ISE.PROFILE.age,
            10
        );

    if (
        !isFinite(age)
    ) {
        return null;
    }

    var best = null;

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var text =
            ISE.SpecializedSurvey
                .normalize(
                    choice.text
                );

        var range =
            text.match(
                /(\d+)\s*(?:to|-)\s*(\d+)/
            );

        if (range) {

            var min =
                parseInt(
                    range[1],
                    10
                );

            var max =
                parseInt(
                    range[2],
                    10
                );

            if (
                age >= min &&
                age <= max
            ) {

                return choice;
            }
        }

        var under =
            text.match(
                /under\s+(\d+)/
            );

        if (
            under &&
            age <
            parseInt(
                under[1],
                10
            )
        ) {

            return choice;
        }

        var over =
            text.match(
                /(?:over|above)\s+(\d+)/
            );

        if (
            over &&
            age >
            parseInt(
                over[1],
                10
            )
        ) {

            return choice;
        }
    }

    return best;
};


/* ------------------------------------------------------------
   INCOME RANGE MATCHING
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.matchIncomeRange =
function (
    choices
) {

    if (
        !ISE.PROFILE ||
        ISE.PROFILE.income ===
        undefined
    ) {
        return null;
    }

    var income =
        parseFloat(
            String(
                ISE.PROFILE.income
            )
            .replace(
                /[$,]/g,
                ""
            )
        );

    if (!isFinite(income)) {
        return null;
    }

    /*
     * Handle profiles entered as annual income
     * such as 70000.
     */

    var best = null;

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var text =
            ISE.SpecializedSurvey
                .normalize(
                    choice.text
                );

        var values =
            text.match(
                /\d+(?:\.\d+)?\s*(?:k|m)?/gi
            );

        if (!values) {
            continue;
        }

        var nums = [];

        for (
            var j = 0;
            j < values.length;
            j++
        ) {

            var raw =
                values[j]
                    .replace(
                        /\s/g,
                        ""
                    );

            var multiplier = 1;

            if (
                raw.indexOf("k") !== -1
            ) {
                multiplier = 1000;
            }

            if (
                raw.indexOf("m") !== -1
            ) {
                multiplier = 1000000;
            }

            raw =
                raw.replace(
                    /[^0-9.]/g,
                    ""
                );

            var number =
                parseFloat(
                    raw
                );

            if (
                isFinite(number)
            ) {

                nums.push(
                    number *
                    multiplier
                );
            }
        }

        if (
            nums.length >= 2
        ) {

            var min =
                Math.min(
                    nums[0],
                    nums[1]
                );

            var max =
                Math.max(
                    nums[0],
                    nums[1]
                );

            if (
                income >= min &&
                income <= max
            ) {

                return choice;
            }
        }
    }

    /*
     * Open-ended income options.
     */

    for (
        var k = 0;
        k < choices.length;
        k++
    ) {

        var choiceText =
            ISE.SpecializedSurvey
                .normalize(
                    choices[k].text
                );

        var over =
            choiceText.match(
                /(?:over|more than|above)\s*\$?(\d+(?:\.\d+)?)\s*(k|m)?/
            );

        if (over) {

            var threshold =
                parseFloat(
                    over[1]
                );

            if (
                over[2] === "k"
            ) {
                threshold *= 1000;
            }

            if (
                over[2] === "m"
            ) {
                threshold *= 1000000;
            }

            if (
                income >= threshold
            ) {

                return choices[k];
            }
        }

        var under =
            choiceText.match(
                /(?:under|less than|below)\s*\$?(\d+(?:\.\d+)?)\s*(k|m)?/
            );

        if (under) {

            var upper =
                parseFloat(
                    under[1]
                );

            if (
                under[2] === "k"
            ) {
                upper *= 1000;
            }

            if (
                under[2] === "m"
            ) {
                upper *= 1000000;
            }

            if (
                income <= upper
            ) {

                return choices[k];
            }
        }
    }

    return best;
};


/* ------------------------------------------------------------
   PROFILE RANGE FILL
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.fillProfileRange =
function (
    question,
    container
) {

    var category =
        ISE.QuestionIntelligence
            ? ISE.QuestionIntelligence
                .detectCategory(
                    question
                )
            : null;

    if (!category) {
        return {
            success: false,
            reason:
                "No profile category detected."
        };
    }

    var choices =
        ISE.SpecializedSurvey
            .dedupeChoices(
                ISE.SpecializedSurvey
                    .collectChoices(
                        container
                    )
            );

    if (!choices.length) {
        return {
            success: false,
            reason:
                "No answer choices detected."
        };
    }

    var match = null;

    if (
        category.category === "age"
    ) {

        match =
            ISE.SpecializedSurvey
                .matchAgeRange(
                    choices
                );
    }

    if (
        category.category === "income"
    ) {

        match =
            ISE.SpecializedSurvey
                .matchIncomeRange(
                    choices
                );
    }

    if (!match) {

        return {
            success: false,
            reason:
                "No supported range match."
        };
    }

    var clicked =
        ISE.SpecializedSurvey.click(
            match.element
        );

    return {
        success: clicked,
        method: "profile-range"
    };
};


/* ------------------------------------------------------------
   SPECIALIZED QUESTION PROCESSOR
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.process =
function (
    question,
    container
) {

    if (!question) {
        return {
            success: false,
            reason: "Missing question."
        };
    }

    if (!container) {
        container =
            question.container ||
            question.element;
    }

    if (!container) {
        return {
            success: false,
            reason: "Missing question container."
        };
    }

    var type =
        ISE.SpecializedSurvey.detectType(
            question,
            container
        );

    /*
     * MULTI-SELECT
     */

    if (
        type === "multi-select"
    ) {

        var multi =
            ISE.SpecializedSurvey
                .fillMultiSelect(
                    question,
                    container
                );

        if (multi.success) {
            return multi;
        }
    }


    /*
     * MATRIX / GRID
     */

    if (
        type === "matrix" ||
        type === "matrix-rating"
    ) {

        var matrix =
            ISE.SpecializedSurvey
                .fillMatrix(
                    question,
                    container
                );

        if (matrix.success) {
            return matrix;
        }
    }


    /*
     * RATING
     */

    if (
        type === "rating"
    ) {

        var rating =
            ISE.SpecializedSurvey
                .fillRating(
                    question,
                    container
                );

        if (rating.success) {
            return rating;
        }
    }


    /*
     * LIKERT
     */

    if (
        ISE.SpecializedSurvey
            .isLikert(
                container
            )
    ) {

        var likert =
            ISE.SpecializedSurvey
                .fillRating(
                    question,
                    container
                );

        if (likert.success) {
            return likert;
        }
    }


    /*
     * RANGE QUESTION
     */

    if (
        ISE.SpecializedSurvey
            .isRangeQuestion(
                question
            )
    ) {

        var range =
            ISE.SpecializedSurvey
                .fillProfileRange(
                    question,
                    container
                );

        if (range.success) {
            return range;
        }
    }


    /*
     * RANKING
     *
     * Intentionally left unsupported unless the
     * profile explicitly contains a ranking preference.
     */

    if (
        ISE.SpecializedSurvey
            .isRankingQuestion(
                question
            )
    ) {

        return {
            success: false,
            reason:
                "Ranking preference not established."
        };
    }

    return {
        success: false,
        reason:
            "No specialized strategy matched."
    };
};


/* ------------------------------------------------------------
   INTEGRATION WITH PART 6
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.integrate =
function () {

    if (
        !ISE.AutofillEngine
    ) {
        return false;
    }

    ISE.AutofillEngine
        .specializedSurveyResolver =
        function (
            question
        ) {

            if (!question) {
                return false;
            }

            var container =
                question.container ||
                question.element;

            if (!container) {
                return false;
            }

            var result =
                ISE.SpecializedSurvey
                    .process(
                        question,
                        container
                    );

            return result;
        };

    return true;
};


/* ------------------------------------------------------------
   SCAN ALL SPECIALIZED STRUCTURES
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.scan =
function (
    root
) {

    var target =
        root ||
        document;

    var grids = [];
    var ratings = [];
    var rankings = [];
    var multiSelects = [];

    try {

        var containers =
            target.querySelectorAll(
                "fieldset," +
                "table," +
                "[role='grid']," +
                "[role='group']," +
                "[data-question]," +
                "[data-question-id]," +
                "[data-grid]," +
                "[data-survey-question]"
            );

        for (
            var i = 0;
            i < containers.length;
            i++
        ) {

            var container =
                containers[i];

            if (
                !ISE.SpecializedSurvey
                    .visible(
                        container
                    )
            ) {
                continue;
            }

            var text =
                ISE.SpecializedSurvey.text(
                    container
                );

            var normalized =
                ISE.SpecializedSurvey.normalize(
                    text
                );

            if (
                ISE.AdvancedControls &&
                ISE.AdvancedControls
                    .isGrid(
                        container
                    )
            ) {

                grids.push(
                    container
                );
            }

            if (
                ISE.SpecializedSurvey
                    .isLikert(
                        container
                    )
            ) {

                ratings.push(
                    container
                );
            }

            if (
                normalized.indexOf(
                    "select all"
                ) !== -1
            ) {

                multiSelects.push(
                    container
                );
            }

            if (
                normalized.indexOf(
                    "rank"
                ) !== -1
            ) {

                rankings.push(
                    container
                );
            }
        }

    } catch (error) {}

    return {

        grids:
            grids.length,

        ratings:
            ratings.length,

        multiSelects:
            multiSelects.length,

        rankings:
            rankings.length
    };
};


/* ------------------------------------------------------------
   CHOICE ANALYSIS
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.analyzeChoices =
function (
    container
) {

    var choices =
        ISE.SpecializedSurvey
            .dedupeChoices(
                ISE.SpecializedSurvey
                    .collectChoices(
                        container
                    )
            );

    var analysis = [];

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var normalized =
            ISE.SpecializedSurvey
                .normalize(
                    choice.text
                );

        var classification =
            "other";

        if (
            ISE.SemanticEngine
                .isYes(
                    normalized
                )
        ) {

            classification =
                "yes";
        }

        else if (
            ISE.SemanticEngine
                .isNo(
                    normalized
                )
        ) {

            classification =
                "no";
        }

        else if (
            ISE.SemanticEngine
                .isNone(
                    normalized
                )
        ) {

            classification =
                "none";
        }

        else if (
            ISE.SemanticEngine
                .isDontKnow(
                    normalized
                )
        ) {

            classification =
                "unknown";
        }

        else if (
            ISE.SemanticEngine
                .isPreferNot(
                    normalized
                )
        ) {

            classification =
                "prefer-not";
        }

        else if (
            /strongly\s+agree/.test(
                normalized
            )
        ) {

            classification =
                "strong-agree";
        }

        else if (
            /strongly\s+disagree/.test(
                normalized
            )
        ) {

            classification =
                "strong-disagree";
        }

        analysis.push({

            text:
                choice.text,

            value:
                choice.value,

            classification:
                classification
        });
    }

    return analysis;
};


