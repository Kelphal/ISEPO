/* ------------------------------------------------------------
   BASIC DOM UTILITIES
   ------------------------------------------------------------ */

ISE.AdvancedControls.safeText = function (element) {

    if (!element) {
        return "";
    }

    var value = "";

    try {
        value =
            element.innerText ||
            element.textContent ||
            "";
    } catch (error) {}

    return String(value)
        .replace(/\s+/g, " ")
        .trim();
};


ISE.AdvancedControls.tag = function (element) {

    if (!element) {
        return "";
    }

    return String(
        element.tagName || ""
    ).toLowerCase();
};


ISE.AdvancedControls.attr = function (
    element,
    name
) {

    if (!element || !name) {
        return "";
    }

    try {
        return String(
            element.getAttribute(name) || ""
        ).trim();
    } catch (error) {
        return "";
    }
};


ISE.AdvancedControls.role = function (
    element
) {

    return ISE.AdvancedControls.attr(
        element,
        "role"
    ).toLowerCase();
};


ISE.AdvancedControls.isVisible = function (
    element
) {

    if (!element) {
        return false;
    }

    try {

        if (
            element.hidden === true ||
            element.disabled === true
        ) {
            return false;
        }

        var style =
            window.getComputedStyle(
                element
            );

        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.opacity === "0"
        ) {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );

    } catch (error) {

        return true;
    }
};


ISE.AdvancedControls.isDisabled = function (
    element
) {

    if (!element) {
        return true;
    }

    if (element.disabled === true) {
        return true;
    }

    var ariaDisabled =
        ISE.AdvancedControls.attr(
            element,
            "aria-disabled"
        );

    return (
        ariaDisabled === "true"
    );
};


/* ------------------------------------------------------------
   CONTROL TYPE IDENTIFICATION
   ------------------------------------------------------------ */

ISE.AdvancedControls.getType = function (
    element
) {

    if (!element) {
        return "unknown";
    }

    var tag =
        ISE.AdvancedControls.tag(
            element
        );

    var role =
        ISE.AdvancedControls.role(
            element
        );

    var type =
        ISE.AdvancedControls.attr(
            element,
            "type"
        ).toLowerCase();

    if (tag === "input") {

        if (type === "radio") {
            return "radio";
        }

        if (type === "checkbox") {
            return "checkbox";
        }

        if (
            type === "number"
        ) {
            return "number";
        }

        if (
            type === "date" ||
            type === "datetime-local" ||
            type === "month" ||
            type === "week"
        ) {
            return "date";
        }

        if (
            type === "range"
        ) {
            return "slider";
        }

        if (
            type === "email"
        ) {
            return "email";
        }

        if (
            type === "tel"
        ) {
            return "phone";
        }

        return "text";
    }

    if (tag === "select") {
        return "select";
    }

    if (tag === "textarea") {
        return "textarea";
    }

    if (
        role === "radio"
    ) {
        return "radio";
    }

    if (
        role === "checkbox"
    ) {
        return "checkbox";
    }

    if (
        role === "option"
    ) {
        return "option";
    }

    if (
        role === "combobox"
    ) {
        return "combobox";
    }

    if (
        role === "slider"
    ) {
        return "slider";
    }

    if (
        role === "button"
    ) {
        return "button";
    }

    if (
        role === "listbox"
    ) {
        return "listbox";
    }

    if (
        tag === "button"
    ) {
        return "button";
    }

    return "unknown";
};


/* ------------------------------------------------------------
   LABEL EXTRACTION
   ------------------------------------------------------------ */

ISE.AdvancedControls.getLabels = function (
    element
) {

    if (!element) {
        return [];
    }

    var labels = [];

    function add(
        value
    ) {

        if (!value) {
            return;
        }

        var text =
            String(value)
                .replace(/\s+/g, " ")
                .trim();

        if (!text) {
            return;
        }

        if (
            labels.indexOf(text) === -1
        ) {
            labels.push(text);
        }
    }

    add(
        ISE.AdvancedControls.attr(
            element,
            "aria-label"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "title"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "placeholder"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "data-label"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "data-answer"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "data-value"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "data-option"
        )
    );

    add(
        ISE.AdvancedControls.attr(
            element,
            "data-choice"
        )
    );

    var id =
        ISE.AdvancedControls.attr(
            element,
            "id"
        );

    if (id) {

        try {

            var explicit =
                document.querySelector(
                    "label[for='" +
                    CSS.escape(id) +
                    "']"
                );

            if (explicit) {
                add(
                    ISE.AdvancedControls.safeText(
                        explicit
                    )
                );
            }

        } catch (error) {}
    }

    var parent =
        element.parentElement;

    if (parent) {

        var parentText =
            ISE.AdvancedControls.safeText(
                parent
            );

        if (
            parentText &&
            parentText.length <= 200
        ) {
            add(parentText);
        }
    }

    return labels;
};


/* ------------------------------------------------------------
   NORMALIZE CONTROL TEXT
   ------------------------------------------------------------ */

ISE.AdvancedControls.controlText = function (
    element
) {

    var labels =
        ISE.AdvancedControls.getLabels(
            element
        );

    var text =
        ISE.AdvancedControls.safeText(
            element
        );

    if (text) {
        labels.push(text);
    }

    return labels
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
};


