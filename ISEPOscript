    /* ============================================================
   INTELLIGENT SURVEY ENGINE
   PART 7 — SPECIALIZED SURVEY STRUCTURES
   ============================================================ */

ISE.SpecializedSurvey = ISE.SpecializedSurvey || {};

ISE.SpecializedSurvey.version = "7.0.0";


/* ------------------------------------------------------------
   BASIC HELPERS
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.normalize = function (value) {

    if (ISE.SemanticEngine &&
        typeof ISE.SemanticEngine.normalize === "function") {

        return ISE.SemanticEngine.normalize(
            value || ""
        );
    }

    return String(value || "")
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim();
};


ISE.SpecializedSurvey.text = function (element) {

    if (!element) {
        return "";
    }

    try {

        return String(
            element.innerText ||
            element.textContent ||
            ""
        )
        .replace(/\s+/g, " ")
        .trim();

    } catch (error) {

        return "";
    }
};


ISE.SpecializedSurvey.attr = function (
    element,
    name
) {

    if (!element || !name) {
        return "";
    }

    try {

        return String(
            element.getAttribute(name) || ""
        ).trim();

    } catch (error) {

        return "";
    }
};


ISE.SpecializedSurvey.tag = function (
    element
) {

    if (!element) {
        return "";
    }

    return String(
        element.tagName || ""
    ).toLowerCase();
};


ISE.SpecializedSurvey.visible = function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        element.hidden === true ||
        element.disabled === true
    ) {
        return false;
    }

    try {

        var style =
            window.getComputedStyle(
                element
            );

        if (
            style.display === "none" ||
            style.visibility === "hidden"
        ) {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );

    } catch (error) {

        return true;
    }
};


/* ------------------------------------------------------------
   QUESTION TYPE DETECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.detectType = function (
    question,
    container
) {

    var text =
        ISE.SpecializedSurvey.normalize(
            question
        );

    if (!text) {
        text = "";
    }

    var hasCheckboxes = false;
    var hasRadios = false;
    var hasRange = false;
    var hasSelect = false;
    var hasTable = false;

    if (container) {

        try {

            hasCheckboxes =
                container.querySelectorAll(
                    "input[type='checkbox'],[role='checkbox']"
                ).length > 0;

            hasRadios =
                container.querySelectorAll(
                    "input[type='radio'],[role='radio']"
                ).length > 0;

            hasRange =
                container.querySelectorAll(
                    "input[type='range'],[role='slider']"
                ).length > 0;

            hasSelect =
                container.querySelectorAll(
                    "select,[role='combobox'],[role='listbox']"
                ).length > 0;

            hasTable =
                container.querySelectorAll(
                    "table,[role='grid'],[role='row']"
                ).length > 0;

        } catch (error) {}
    }

    if (
        text.indexOf("select all") !== -1 ||
        text.indexOf("choose all") !== -1 ||
        text.indexOf("check all") !== -1 ||
        text.indexOf("select any") !== -1 ||
        text.indexOf("choose any") !== -1 ||
        hasCheckboxes
    ) {

        return "multi-select";
    }

    if (
        text.indexOf("rank") !== -1 ||
        text.indexOf("ranking") !== -1 ||
        text.indexOf("rank the") !== -1 ||
        text.indexOf("order the") !== -1
    ) {

        return "ranking";
    }

    if (
        text.indexOf("rate") !== -1 ||
        text.indexOf("rating") !== -1 ||
        text.indexOf("scale") !== -1 ||
        text.indexOf("satisfied") !== -1 ||
        text.indexOf("agree") !== -1 ||
        text.indexOf("likelihood") !== -1
    ) {

        if (hasTable) {
            return "matrix-rating";
        }

        return "rating";
    }

    if (hasTable) {
        return "matrix";
    }

    if (hasRange) {
        return "range";
    }

    if (hasSelect) {
        return "dropdown";
    }

    if (hasRadios) {
        return "single-select";
    }

    return "unknown";
};


/* ------------------------------------------------------------
   ANSWER CHOICE COLLECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.collectChoices = function (
    container
) {

    if (!container) {
        return [];
    }

    var nodes = [];

    try {

        nodes =
            container.querySelectorAll(
                "label," +
                "option," +
                "button," +
                "[role='radio']," +
                "[role='checkbox']," +
                "[role='option']," +
                "[role='button']," +
                "[data-value]," +
                "[data-answer]," +
                "[data-option]," +
                "[data-choice]"
            );

    } catch (error) {

        return [];
    }

    var choices = [];

    for (
        var i = 0;
        i < nodes.length;
        i++
    ) {

        var node =
            nodes[i];

        if (
            !ISE.SpecializedSurvey.visible(
                node
            )
        ) {
            continue;
        }

        var text =
            ISE.SpecializedSurvey.text(
                node
            );

        if (!text) {
            continue;
        }

        var value =
            ISE.SpecializedSurvey.attr(
                node,
                "value"
            );

        if (!value) {
            value =
                ISE.SpecializedSurvey.attr(
                    node,
                    "data-value"
                );
        }

        if (!value) {
            value =
                ISE.SpecializedSurvey.attr(
                    node,
                    "data-answer"
                );
        }

        choices.push({
            element: node,
            text: text,
            value: value || text
        });
    }

    return choices;
};


/* ------------------------------------------------------------
   CHOICE DEDUPLICATION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.dedupeChoices = function (
    choices
) {

    var output = [];
    var seen = {};

    if (!Array.isArray(choices)) {
        return output;
    }

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var key =
            ISE.SpecializedSurvey.normalize(
                choice.text
            );

        if (!key) {
            continue;
        }

        if (seen[key]) {
            continue;
        }

        seen[key] = true;

        output.push(
            choice
        );
    }

    return output;
};


/* ------------------------------------------------------------
   CHOICE SEMANTIC SCORE
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.choiceScore = function (
    choiceText,
    answer
) {

    var choice =
        ISE.SpecializedSurvey.normalize(
            choiceText
        );

    var target =
        ISE.SpecializedSurvey.normalize(
            answer
        );

    if (!choice || !target) {
        return 0;
    }

    if (choice === target) {
        return 1;
    }

    if (
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine.answerMatches ===
        "function"
    ) {

        try {

            if (
                ISE.AnswerEngine.answerMatches(
                    choice,
                    answer
                )
            ) {
                return 0.98;
            }

        } catch (error) {}
    }

    if (
        choice.indexOf(target) !== -1
    ) {
        return 0.88;
    }

    if (
        target.indexOf(choice) !== -1
    ) {
        return 0.84;
    }

    var overlap = 0;

    if (
        ISE.SemanticEngine &&
        typeof ISE.SemanticEngine.tokenOverlap ===
        "function"
    ) {

        overlap =
            ISE.SemanticEngine.tokenOverlap(
                choice,
                target
            );
    }

    return Math.min(
        0.8,
        overlap
    );
};


/* ------------------------------------------------------------
   BEST CHOICE
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.bestChoice = function (
    choices,
    answer
) {

    if (
        !Array.isArray(choices) ||
        !choices.length
    ) {
        return null;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var choice =
            choices[i];

        var score =
            ISE.SpecializedSurvey.choiceScore(
                choice.text,
                answer
            );

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = choice;
        }
    }

    if (!best) {
        return null;
    }

    return {
        choice: best,
        score: bestScore
    };
};


/* ------------------------------------------------------------
   SAFE CLICK
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.click = function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        element.disabled === true
    ) {
        return false;
    }

    try {

        element.click();

        return true;

    } catch (error) {

        try {

            element.dispatchEvent(
                new MouseEvent(
                    "click",
                    {
                        bubbles: true,
                        cancelable: true,
                        view: window
                    }
                )
            );

            return true;

        } catch (error2) {

            return false;
        }
    }
};


/* ------------------------------------------------------------
   RATING SCALE DETECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.getRatingScale = function (
    container
) {

    if (!container) {
        return null;
    }

    var choices =
        ISE.SpecializedSurvey
            .dedupeChoices(
                ISE.SpecializedSurvey
                    .collectChoices(
                        container
                    )
            );

    if (
        choices.length < 2
    ) {
        return null;
    }

    var labels = [];

    for (
        var i = 0;
        i < choices.length;
        i++
    ) {

        var text =
            ISE.SpecializedSurvey
                .normalize(
                    choices[i].text
                );

        if (!text) {
            continue;
        }

        labels.push({
            text: text,
            element:
                choices[i].element,
            value:
                choices[i].value
        });
    }

    var hasAgreement = false;
    var hasSatisfaction = false;
    var hasLikelihood = false;

    for (
        var j = 0;
        j < labels.length;
        j++
    ) {

        var label =
            labels[j].text;

        if (
            label.indexOf("agree") !== -1
        ) {
            hasAgreement = true;
        }

        if (
            label.indexOf("satisf") !== -1
        ) {
            hasSatisfaction = true;
        }

        if (
            label.indexOf("likely") !== -1 ||
            label.indexOf("unlikely") !== -1
        ) {
            hasLikelihood = true;
        }
    }

    var numericCount = 0;

    for (
        var k = 0;
        k < labels.length;
        k++
    ) {

        if (
            /^\d+$/.test(
                labels[k].text
            )
        ) {
            numericCount++;
        }
    }

    if (
        hasAgreement ||
        hasSatisfaction ||
        hasLikelihood ||
        numericCount >= 2
    ) {

        return {
            choices: labels,
            agreement: hasAgreement,
            satisfaction: hasSatisfaction,
            likelihood: hasLikelihood,
            numeric:
                numericCount >= 2
        };
    }

    return null;
};


/* ------------------------------------------------------------
   RATING ANSWER INTERPRETATION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.resolveRatingAnswer =
function (
    questionText,
    scale
) {

    if (!scale) {
        return null;
    }

    /*
     * We only resolve rating questions when the
     * configured profile gives us a factual answer.
     *
     * No arbitrary rating is generated.
     */

    var answer =
        ISE.AnswerEngine.resolve(
            questionText
        );

    if (
        answer &&
        answer.supported
    ) {

        return answer;
    }

    return null;
};


/* ------------------------------------------------------------
   RATING FILL
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.fillRating =
function (
    question,
    container
) {

    var scale =
        ISE.SpecializedSurvey
            .getRatingScale(
                container
            );

    if (!scale) {
        return {
            success: false,
            reason: "No recognizable rating scale."
        };
    }

    var answer =
        ISE.SpecializedSurvey
            .resolveRatingAnswer(
                question,
                scale
            );

    if (
        !answer ||
        !answer.supported
    ) {

        return {
            success: false,
            reason:
                "Rating answer is not profile-supported."
        };
    }

    var match =
        ISE.SpecializedSurvey
            .bestChoice(
                scale.choices,
                answer.value
            );

    if (
        !match ||
        match.score < 0.65
    ) {

        return {
            success: false,
            reason:
                "No sufficiently strong rating match."
        };
    }

    var clicked =
        ISE.SpecializedSurvey.click(
            match.choice.element
        );

    return {
        success: clicked,
        method: "rating",
        score: match.score,
        answer: answer.value
    };
};


/* ------------------------------------------------------------
   LIKERT DETECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.isLikert = function (
    container
) {

    if (!container) {
        return false;
    }

    var text =
        ISE.SpecializedSurvey.normalize(
            ISE.SpecializedSurvey.text(
                container
            )
        );

    var signals = 0;

    if (
        text.indexOf("strongly agree") !== -1
    ) {
        signals++;
    }

    if (
        text.indexOf("strongly disagree") !== -1
    ) {
        signals++;
    }

    if (
        text.indexOf("somewhat agree") !== -1
    ) {
        signals++;
    }

    if (
        text.indexOf("somewhat disagree") !== -1
    ) {
        signals++;
    }

    if (
        text.indexOf("neither agree nor disagree") !== -1
    ) {
        signals++;
    }

    return signals >= 1;
};


/* ------------------------------------------------------------
   MATRIX ROW EXTRACTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.getMatrixRows = function (
    container
) {

    if (!container) {
        return [];
    }

    var rows = [];

    try {

        var rowNodes =
            container.querySelectorAll(
                "tr,[role='row'],[data-row]"
            );

        for (
            var i = 0;
            i < rowNodes.length;
            i++
        ) {

            var row =
                rowNodes[i];

            var text =
                ISE.SpecializedSurvey.text(
                    row
                );

            if (!text) {
                continue;
            }

            var controls = [];

            try {

                var rowControls =
                    row.querySelectorAll(
                        "input," +
                        "button," +
                        "[role='radio']," +
                        "[role='checkbox']," +
                        "[role='option']," +
                        "[data-value]," +
                        "[data-answer]"
                    );

                for (
                    var j = 0;
                    j < rowControls.length;
                    j++
                ) {

                    if (
                        ISE.SpecializedSurvey.visible(
                            rowControls[j]
                        )
                    ) {

                        controls.push(
                            rowControls[j]
                        );
                    }
                }

            } catch (error) {}

            rows.push({

                element: row,

                text: text,

                controls: controls,

                index: i
            });
        }

    } catch (error) {}

    return rows;
};


/* ------------------------------------------------------------
   MATRIX COLUMN EXTRACTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.getMatrixColumns =
function (
