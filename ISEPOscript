   ------------------------------------------------------------ */

ISE.AnswerEngine.getAge = function () {

    var profile = ISE.AnswerEngine.ensureProfile();

    if (Number.isFinite(Number(profile.age))) {
        return Number(profile.age);
    }

    if (profile.dob) {

        var dob = ISE.SemanticEngine.parseDate(profile.dob);

        if (dob) {

            var now = new Date();

            var age = now.getFullYear() - dob.getFullYear();

            var monthDifference =
                now.getMonth() - dob.getMonth();

            if (
                monthDifference < 0 ||
                (
                    monthDifference === 0 &&
                    now.getDate() < dob.getDate()
                )
            ) {
                age--;
            }

            return age;
        }
    }

    return null;
};


