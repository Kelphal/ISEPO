/* ============================================================
   QUESTION TYPE DETECTION
   ============================================================ */

ISE.AdvancedSemantics.detectQuestionForm =
function(
    text
)
{
    var value =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    if(
        !value
    )
    {
        return "unknown";
    }

    if(
        value.indexOf("?") !==
        -1
    )
    {
        if(
            /^(do|does|did|is|are|was|were|have|has|can|could|would|will|did|has)\b/i
                .test(
                    value
                )
        )
        {
            return "yes-no";
        }
    }

    if(
        /^(how many|how much|what number|number of)\b/i
            .test(
                value
            )
    )
    {
        return "quantity";
    }

    if(
        /^(what|which|where|when|who|why|how)\b/i
            .test(
                value
            )
    )
    {
        return "open-selection";
    }

    if(
        /\b(yes or no|true or false)\b/i
            .test(
                value
            )
    )
    {
        return "yes-no";
    }

    return "unknown";
};


