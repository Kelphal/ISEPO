            element.textContent ||
            ""
        )
        .replace(/\s+/g, " ")
        .trim();

    } catch (error) {

        return "";
    }
};


ISE.PlatformEngine.attr =
function (
    element,
    name
) {

    if (!element || !name) {
        return "";
    }

    try {

        return String(
            element.getAttribute(
                name
            ) || ""
        ).trim();

    } catch (error) {

        return "";
