        element.tagName ||
        ""
    ).toLowerCase();
};


ISE.PlatformEngine.visible =
function (
    element
) {

    if (!element) {
        return false;
    }

    try {

        if (
            element.hidden ||
            element.disabled
        ) {
            return false;
        }

        var style =
            window.getComputedStyle(
                element
            );

        if (
            style.display === "none" ||
            style.visibility === "hidden"
        ) {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );

    } catch (error) {

        return true;
    }
};


ISE.PlatformEngine.disabled =
function (
    element
) {

    if (!element) {
        return true;
    }

    if (
        element.disabled === true
    ) {
        return true;
    }

    var aria =
        ISE.PlatformEngine
            .attr(
                element,
                "aria-disabled"
            )
            .toLowerCase();

    if (
        aria === "true"
    ) {
        return true;
    }

    return false;
};


