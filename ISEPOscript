/* ------------------------------------------------------------
   TEST: DIAGNOSIS QUESTION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.testDiagnosis =
function()
{
    var question =
    {
        text:
            "Have you been diagnosed with any of the following illnesses/conditions?"
    };

    if(
        !ISE.AnswerEngine ||
        typeof ISE.AnswerEngine
            .resolve !==
        "function"
    )
    {
        return {
            success:
                false,

            reason:
                "Answer engine unavailable."
        };
    }

    var resolution =
        ISE.AnswerEngine
            .resolve(
                question.text
            );

    /*
     * The configured profile explicitly says the user
     * has no diagnosed conditions. Therefore this test
     * expects the supported answer to be No.
     */

    return {
        question:
            question.text,

        resolution:
            resolution,

        expected:
            "No",

        correct:
            !!(
                resolution &&
                resolution.supported &&
                ISE.RecoveryEngine
                    .answersEquivalent(
                        resolution.answer,
                        "No"
                    )
            )
    };
};


/* ------------------------------------------------------------
   TEST: VEHICLE QUESTION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.testVehicle =
function()
{
    var question =
        "Do you own a car?";

    if(
        !ISE.AnswerEngine ||
        typeof ISE.AnswerEngine
            .resolve !==
        "function"
    )
    {
        return {
            success:
                false
        };
    }

    var result =
        ISE.AnswerEngine
            .resolve(
                question
            );

    return {
        question:
            question,

        resolution:
            result,

        expected:
            "Yes",

        correct:
            !!(
                result &&
                result.supported &&
                ISE.RecoveryEngine
                    .answersEquivalent(
