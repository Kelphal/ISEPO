/* ------------------------------------------------------------
   PLATFORM CONTROL SCAN
   ------------------------------------------------------------ */

ISE.PlatformEngine.scan =
function (
    root
) {

    var adapter =
        ISE.PlatformEngine
            .getAdapter();

    if (!adapter) {
        return [];
    }

    var controls =
        adapter.collectControls(
            root ||
            document
        );

    ISE.PlatformEngine
        .countTypes(
            controls
        );

    return controls;
};


/* ------------------------------------------------------------
   CONTROL READINESS
   ------------------------------------------------------------ */

ISE.PlatformEngine.isReady =
function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        ISE.PlatformEngine
            .disabled(
                element
            )
    ) {
        return false;
    }

    if (
        !ISE.PlatformEngine
            .visible(
                element
            )
    ) {
        return false;
    }

    var type =
        ISE.PlatformEngine
            .controlType(
                element
            );

    return (
        type !==
        "unknown"
    );
};


/* ------------------------------------------------------------
   WAIT FOR CONTROL
   ------------------------------------------------------------ */

ISE.PlatformEngine.waitForControl =
function (
    container,
    matcher,
    callback
) {

    if (
        !container ||
        typeof callback !==
        "function"
    ) {
        return;
    }

    var attempts = 0;

    var maxAttempts = 10;

    var timer =
        setInterval(
            function () {

                attempts++;

                var controls =
                    ISE.PlatformEngine
                        .collectControls(
                            container
                        );

                var found = null;

                for (
                    var i = 0;
                    i < controls.length;
                    i++
                ) {

                    if (
                        typeof matcher !==
                        "function" ||
                        matcher(
                            controls[i]
                        )
                    ) {

                        found =
                            controls[i];

                        break;
                    }
                }

                if (
                    found
                ) {

                    clearInterval(
                        timer
                    );

                    callback(
                        found
                    );

                    return;
                }

                if (
                    attempts >=
                    maxAttempts
                ) {

                    clearInterval(
                        timer
                    );
                }

            },
            300
        );

    ISE.DynamicEngine
        .timers
        .push(
            timer
        );
};


/* ------------------------------------------------------------
   VERIFICATION
   ------------------------------------------------------------ */

ISE.PlatformEngine.verify =
function (
    element,
    expected
) {

    if (!element) {
        return false;
    }

    var type =
        ISE.PlatformEngine
            .controlType(
                element
            );

    if (
        type ===
        "radio" ||
        type ===
        "checkbox"
    ) {

        var bool =
            ISE.PlatformEngine
                .booleanAnswer(
                    expected
                );

        if (
            bool ===
            null
        ) {

            return true;
        }

        return (
            ISE.PlatformEngine
                .isSelected(
                    element
                ) ===
            bool
        );
    }

    if (
        type ===
        "select"
    ) {

        var current =
            ISE.PlatformEngine
                .normalize(
                    element.value
                );

        var target =
            ISE.PlatformEngine
                .normalize(
                    expected
                );

        return (
            current ===
            target ||
            current.indexOf(
                target
            ) !== -1 ||
            target.indexOf(
                current
            ) !== -1
        );
    }

    return true;
};


/* ------------------------------------------------------------
   ADVANCED FILL ROUTER
   ------------------------------------------------------------ */

ISE.PlatformEngine.fill =
function (
    element,
    answer
) {

    if (
        !element ||
        answer ===
        null ||
        typeof answer ===
        "undefined"
    ) {
        return false;
    }

    var type =
        ISE.PlatformEngine
            .controlType(
                element
            );

    var success =
        false;

    if (
        type ===
        "select"
    ) {

        success =
            ISE.PlatformEngine
                .fillSelect(
                    element,
                    answer
                );

    } else if (
        type ===
        "radio"
    ) {

        var radioValue =
            ISE.PlatformEngine
                .booleanAnswer(
                    answer
                );

        if (
            radioValue !==
            null
        ) {

            success =
                ISE.PlatformEngine
                    .fillBooleanControl(
                        element,
                        radioValue
                    );

        } else {

            success =
                ISE.PlatformEngine
                    .click(
                        element
                    );
        }

    } else if (
        type ===
        "checkbox"
    ) {

        var checkValue =
            ISE.PlatformEngine
                .booleanAnswer(
                    answer
                );

        if (
            checkValue !==
            null
        ) {

            success =
                ISE.PlatformEngine
                    .fillBooleanControl(
                        element,
                        checkValue
                    );

        } else {

            success =
                ISE.PlatformEngine
                    .click(
                        element
                    );
        }

    } else if (
        type ===
        "text" ||
        type ===
        "number" ||
        type ===
        "date" ||
        type ===
        "month" ||
        type ===
        "textarea"
    ) {

        success =
            ISE.PlatformEngine
                .fillText(
                    element,
                    answer
                );

    } else if (
        type ===
        "custom" ||
        type ===
        "option" ||
        type ===
        "button"
    ) {

        success =
            ISE.PlatformEngine
                .fillARIA(
                    element,
                    answer
                );

        if (!success) {

            success =
                ISE.PlatformEngine
                    .click(
                        element
                    );
        }
    }

    if (success) {

        ISE.PlatformEngine
            .statistics
            .controlsFilled++;
    }

    if (
        success &&
        !ISE.PlatformEngine
            .verify(
                element,
                answer
            )
    ) {

        ISE.PlatformEngine
            .statistics
            .verificationFailures++;

        return false;
    }

    return success;
};


/* ------------------------------------------------------------
   QUESTION CONTROL DISCOVERY
   ------------------------------------------------------------ */

ISE.PlatformEngine.controlsForQuestion =
function (
    question
) {

    if (!question) {
        return [];
    }

    var container =
        question.container ||
        question.element ||
        null;

    if (!container) {
        return [];
    }

    return ISE.PlatformEngine
        .scan(
            container
        );
};


/* ------------------------------------------------------------
   ANSWER-CONTROL MATCH
   ------------------------------------------------------------ */

ISE.PlatformEngine.findAnswerControl =
function (
    question,
    answer
) {

    var controls =
        ISE.PlatformEngine
            .controlsForQuestion(
                question
            );

    if (!controls.length) {
        return null;
    }

    var text =
        question.text ||
        "";

    var result =
        ISE.PlatformEngine
            .findBestControl(
                controls,
                String(
                    answer
                ),
                text
            );

    return result;
};


/* ------------------------------------------------------------
   AUTOFILL BRIDGE
   ------------------------------------------------------------ */

ISE.PlatformEngine.autofillQuestion =
function (
    question,
    answer
) {

    if (
        !question ||
        answer ===
        null ||
        typeof answer ===
        "undefined"
    ) {
        return {
            success: false,
            reason:
                "Missing answer."
        };
    }

    var controls =
        ISE.PlatformEngine
            .controlsForQuestion(
                question
            );

    if (!controls.length) {

        return {
            success: false,
            reason:
                "No answer controls found."
        };
    }

    /*
     * Let specialized survey structures retain control
     * when they know how to handle the question.
     */

    if (
        ISE.SpecializedSurvey &&
        typeof ISE.SpecializedSurvey
            .process ===
            "function"
    ) {

        try {

            var specialized =
                ISE.SpecializedSurvey
                    .process(
                        question.text,
                        question.container
                    );

            if (
                specialized &&
                specialized.success
            ) {

                return specialized;
            }

        } catch (error) {}
    }

    var candidate =
        ISE.PlatformEngine
            .findAnswerControl(
                question,
                answer
            );

    if (
        !candidate ||
        !candidate.element
    ) {

        return {
            success: false,
            reason:
                "No sufficiently matched control."
        };
    }

    /*
     * Conservative threshold.
     *
     * We do not blindly click arbitrary controls.
     */

    if (
        candidate.score <
        45
    ) {

        return {
            success: false,
            reason:
                "Control confidence too low.",
            score:
                candidate.score
        };
    }

    var success =
        ISE.PlatformEngine
            .fill(
                candidate.element,
                answer
            );

    if (!success) {

        return {
            success: false,
            reason:
                "Control fill failed.",
            score:
                candidate.score
        };
    }

    return {
        success: true,
        score:
            candidate.score,

        control:
            candidate.element
    };
};


