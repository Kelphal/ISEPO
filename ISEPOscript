/* ------------------------------------------------------------
   GROUP CONTROLS
   ------------------------------------------------------------ */

ISE.AdvancedControls.groupControls = function (
    controls
) {

    var groups = {};

    if (!Array.isArray(controls)) {
        return groups;
    }

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var key =
            ISE.AdvancedControls.groupKey(
                control
            );

        if (!key) {
            key =
                "anonymous:" +
                i;
        }

        if (!groups[key]) {
            groups[key] = [];
        }

        groups[key].push(
            control
        );
    }

    return groups;
};


