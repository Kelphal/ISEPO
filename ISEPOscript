    /* ============================================================
       COMPOUND QUESTION SPLITTING
       ============================================================ */

    function splitCompound(
        text
    ) {

        var normalized =
            normalize(text);

        /*
         * Don't split ordinary phrases where
         * "and" belongs to the subject.
         */

        var parts =
            normalized.split(
                /\s+(?:and|or)\s+/
            );

        if (
            parts.length <= 1
        ) {
            return null;
        }

        var operator =
            /\s+or\s+/.test(
                normalized
            )
            ?
            "OR"
            :
            "AND";

        return {

            operator:
                operator,

            parts:
                parts
        };
    }


    /* ============================================================
       COMPOUND RESOLUTION
       ============================================================ */

    function resolveCompound(
        text
