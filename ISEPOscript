ISE.AnswerEngine.getIncome = function () {

    var profile = ISE.AnswerEngine.ensureProfile();

    var candidates = [
        profile.income,
        profile.householdIncome,
        profile.household_income
    ];

    for (var i = 0; i < candidates.length; i++) {

        if (
            candidates[i] !== undefined &&
            candidates[i] !== null &&
            candidates[i] !== ""
        ) {

            var parsed = ISE.SemanticEngine.parseMoney(
                candidates[i]
            );

            if (parsed !== null) {
                return parsed;
            }
        }
    }

    return null;
};


