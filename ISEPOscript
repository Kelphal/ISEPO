/* ------------------------------------------------------------
   MUTATION OBSERVER
   ------------------------------------------------------------ */

ISE.Orchestrator.observer =
null;


ISE.Orchestrator.startObserver =
function()
{
    if(
        !ISE.Orchestrator
            .config
            .inspectDynamicContent
    )
    {
        return;
    }

    if(
        typeof MutationObserver ===
        "undefined"
    )
    {
        return;
    }

    if(
        ISE.Orchestrator
            .observer
    )
    {
        return;
    }

    try
    {
        ISE.Orchestrator
            .observer =
            new MutationObserver(
                function(
                    mutations
                )
                {
                    if(
                        !mutations ||
                        !mutations.length
                    )
                    {
                        return;
                    }

                    ISE.Orchestrator
                        .handleDynamicChange(
                            mutations
                        );
                }
            );

        ISE.Orchestrator
            .observer
            .observe(
                document.documentElement ||
                document,
                {
                    childList:
                        true,

                    subtree:
                        true,

                    attributes:
                        true,

                    attributeFilter:
                    [
                        "value",
                        "checked",
                        "selected",
                        "aria-checked",
                        "aria-selected",
                        "aria-expanded",
                        "disabled",
                        "hidden"
                    ]
                }
            );
    }
    catch(error)
    {
        ISE.Orchestrator
            .statistics
            .orchestrationErrors++;

        ISE.Orchestrator
            .observer =
            null;
    }
};


/* ------------------------------------------------------------
   OBSERVER STOP
   ------------------------------------------------------------ */

ISE.Orchestrator.stopObserver =
function()
{
    if(
        ISE.Orchestrator
            .observer
    )
    {
        try
        {
            ISE.Orchestrator
                .observer
                .disconnect();
        }
        catch(error)
        {
        }
    }

    ISE.Orchestrator
        .observer =
        null;
};


/* ------------------------------------------------------------
   ROUTE CHANGE HOOK
   ------------------------------------------------------------ */

ISE.Orchestrator.routeOriginals =
{
    pushState:
        null,

    replaceState:
        null
};


ISE.Orchestrator.routeHooked =
false;


ISE.Orchestrator.startRouteHooks =
function()
{
    if(
        ISE.Orchestrator
            .routeHooked
    )
    {
        return;
    }

    try
    {
        ISE.Orchestrator
            .routeOriginals
            .pushState =
            history.pushState;

        ISE.Orchestrator
            .routeOriginals
            .replaceState =
            history.replaceState;

        history.pushState =
        function()
        {
            var result =
                ISE.Orchestrator
                    .routeOriginals
                    .pushState
                    .apply(
                        this,
                        arguments
                    );

            ISE.Orchestrator
                .scheduleScan(
                    "pushState",
                    300
                );

            return result;
        };

        history.replaceState =
        function()
        {
            var result =
                ISE.Orchestrator
                    .routeOriginals
                    .replaceState
                    .apply(
                        this,
                        arguments
                    );

            ISE.Orchestrator
                .scheduleScan(
                    "replaceState",
                    300
                );

            return result;
        };

        window.addEventListener(
            "popstate",
            function()
            {
                ISE.Orchestrator
                    .scheduleScan(
                        "popstate",
                        300
                    );
            }
        );

        window.addEventListener(
            "hashchange",
            function()
            {
                ISE.Orchestrator
                    .scheduleScan(
                        "hashchange",
                        300
                    );
            }
        );

        ISE.Orchestrator
            .routeHooked =
            true;
    }
    catch(error)
    {
        ISE.Orchestrator
            .statistics
            .orchestrationErrors++;
    }
};


