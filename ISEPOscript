        for (
            var i = 0;
            i < matches.length;
            i++
        ) {

            var match =
                matches[i];

            var fact =
                match.fact;

            var value =
                profileBoolean(
                    fact.key
                );

            if (
                value === null
            ) {
                continue;
            }

            var confidence =
                0.92;

            if (
                match.score >= 2
            ) {
                confidence =
                    0.98;
            }

            if (
                match.aliases.length >= 3
            ) {
                confidence =
                    0.99;
            }

            var answer =
                value
                ?
                "Yes"
                :
                "No";

            /*
             * For a negative question, reverse the
             * logical answer so the selected response
             * answers the actual wording.
             */

            if (
                isNegativeQuestion(
                    question
                )
            ) {

                answer =
                    invertBooleanAnswer(
                        answer
                    );
            }

            return {

                supported:
                    true,

                answer:
                    answer,

                confidence:
                    confidence,

                category:
                    fact.category,

                source:
