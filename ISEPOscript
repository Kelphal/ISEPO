/* ------------------------------------------------------------
   SEMANTIC TOKEN SCORE
   ------------------------------------------------------------ */

ISE.PlatformEngine.tokenScore =
function (
    a,
    b
) {

    a =
        ISE.PlatformEngine
            .normalize(
                a
            );

    b =
        ISE.PlatformEngine
            .normalize(
                b
            );

    if (
        !a ||
        !b
    ) {
        return 0;
    }

    if (
        a === b
    ) {
        return 1;
    }

    var aTokens =
        a.split(
            /\s+/
        );

    var bTokens =
        b.split(
            /\s+/
        );

    var set =
        new Set(
            bTokens
        );

    var matches = 0;

    for (
        var i = 0;
        i < aTokens.length;
        i++
    ) {

        if (
            set.has(
                aTokens[i]
            )
        ) {

            matches++;
        }
    }

    if (
        !aTokens.length
    ) {
        return 0;
    }

    return (
        matches /
        aTokens.length
    );
};


/* ------------------------------------------------------------
   CONTROL SCORE
   ------------------------------------------------------------ */

ISE.PlatformEngine.scoreControl =
function (
    control,
    answer,
    questionText
) {

    if (
        !control ||
        ISE.PlatformEngine
            .disabled(
                control
            )
    ) {
        return 0;
    }

    var description =
        ISE.PlatformEngine
            .description(
                control
            );

    var value =
        ISE.PlatformEngine
            .controlValue(
                control
            );

    var score = 0;

    if (
        answer
    ) {

        score +=
            ISE.PlatformEngine
                .tokenScore(
                    answer,
                    description
                ) *
            70;

        score +=
            ISE.PlatformEngine
                .tokenScore(
                    answer,
                    value
                ) *
            30;
    }

    /*
     * A control inside a question containing
     * the expected wording gets a contextual bonus.
     */

    if (
        questionText &&
        description
    ) {

        var context =
            ISE.PlatformEngine
                .tokenScore(
                    questionText,
                    description
                );

        score +=
            context *
            10;
    }

    return score;
};


/* ------------------------------------------------------------
   BEST CONTROL
   ------------------------------------------------------------ */

ISE.PlatformEngine.findBestControl =
function (
    controls,
    answer,
    questionText
) {

    var best = null;

    var bestScore = 0;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var score =
            ISE.PlatformEngine
                .scoreControl(
                    controls[i],
                    answer,
                    questionText
                );

        ISE.PlatformEngine
            .statistics
            .controlsScored++;

        if (
            score >
            bestScore
        ) {

            bestScore =
                score;

            best =
                controls[i];
        }
    }

    return {
        element:
            best,

        score:
            bestScore
    };
};


/* ------------------------------------------------------------
   SAFE EVENT DISPATCH
   ------------------------------------------------------------ */

ISE.PlatformEngine.dispatch =
function (
    element,
    type
) {

    if (!element) {
        return;
    }

    try {

        element.dispatchEvent(
            new Event(
                type,
                {
                    bubbles:
                        true,

                    cancelable:
                        true
                }
            )
        );

    } catch (error) {

        try {

            var event =
                document.createEvent(
                    "Event"
                );

            event.initEvent(
                type,
                true,
                true
            );

            element.dispatchEvent(
                event
            );

        } catch (secondError) {}
    }
};


/* ------------------------------------------------------------
   NATIVE VALUE SETTER
   ------------------------------------------------------------ */

ISE.PlatformEngine.setNativeValue =
function (
    element,
    value
) {

    if (!element) {
        return false;
    }

    try {

        var descriptor =
            Object.getOwnPropertyDescriptor(
                Object.getPrototypeOf(
                    element
                ),
                "value"
            );

        if (
            descriptor &&
            descriptor.set
        ) {

            descriptor.set.call(
                element,
                value
            );

            return true;
        }

    } catch (error) {}

    try {

        element.value =
            value;

        return true;

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   TEXT INPUT
   ------------------------------------------------------------ */

ISE.PlatformEngine.fillText =
function (
    element,
    value
) {

    if (
        !element ||
        ISE.PlatformEngine
            .disabled(
                element
            )
    ) {
        return false;
    }

    var success =
        ISE.PlatformEngine
            .setNativeValue(
                element,
                String(
                    value
                )
            );

    if (!success) {
        return false;
    }

    ISE.PlatformEngine
        .dispatch(
            element,
            "input"
        );

    ISE.PlatformEngine
        .dispatch(
            element,
            "change"
        );

    return true;
};


/* ------------------------------------------------------------
   SELECT OPTION MATCHING
   ------------------------------------------------------------ */

ISE.PlatformEngine.findSelectOption =
function (
    select,
    answer
) {

    if (!select) {
        return null;
    }

    var options =
        select.options;

    if (!options) {
        return null;
    }

    var target =
        ISE.PlatformEngine
            .normalize(
                answer
            );

    var exact = null;

    var contains = null;

    var semantic = null;

    var semanticScore =
        0;

    for (
        var i = 0;
        i < options.length;
        i++
    ) {

        var option =
            options[i];

        var text =
            ISE.PlatformEngine
                .normalize(
                    option.textContent ||
                    option.label ||
                    option.value
                );

        var value =
            ISE.PlatformEngine
                .normalize(
                    option.value
                );

        if (
            text === target ||
            value === target
        ) {

            exact =
                option;

            break;
        }

        if (
            text.indexOf(
                target
            ) !== -1 ||
            target.indexOf(
                text
            ) !== -1
        ) {

            contains =
                option;
        }

        var score =
            Math.max(
                ISE.PlatformEngine
                    .tokenScore(
                        target,
                        text
                    ),

                ISE.PlatformEngine
                    .tokenScore(
                        target,
                        value
                    )
            );

        if (
            score >
            semanticScore
        ) {

            semanticScore =
                score;

            semantic =
                option;
        }
    }

    return (
        exact ||
        contains ||
        (
            semanticScore >=
            0.65
                ? semantic
                : null
        )
    );
};


/* ------------------------------------------------------------
   SELECT FILL
   ------------------------------------------------------------ */

ISE.PlatformEngine.fillSelect =
function (
    select,
    answer
) {

    if (
        !select ||
        ISE.PlatformEngine
            .disabled(
                select
            )
    ) {
        return false;
    }

    var option =
        ISE.PlatformEngine
            .findSelectOption(
                select,
                answer
            );

    if (!option) {
        return false;
    }

    try {

        select.value =
            option.value;

        option.selected =
            true;

        ISE.PlatformEngine
            .dispatch(
                select,
                "input"
            );

        ISE.PlatformEngine
            .dispatch(
                select,
                "change"
            );

        ISE.PlatformEngine
            .statistics
            .controlsFilled++;

        return true;

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   RADIO / CHECKBOX STATE
   ------------------------------------------------------------ */

ISE.PlatformEngine.isSelected =
function (
    element
) {

    if (!element) {
        return false;
    }

    try {

        if (
            element.checked === true
        ) {
            return true;
        }

    } catch (error) {}

    var state =
        ISE.PlatformEngine
            .ariaState(
                element
            );

    return (
        state ===
        "true"
    );
};


/* ------------------------------------------------------------
   CLICK CONTROL
   ------------------------------------------------------------ */

ISE.PlatformEngine.click =
function (
    element
) {

    if (
        !element ||
        ISE.PlatformEngine
            .disabled(
                element
            )
    ) {
        return false;
    }

    try {

        if (
            typeof element.click ===
            "function"
        ) {

            element.click();

        } else {

            element.dispatchEvent(
                new MouseEvent(
                    "click",
                    {
                        bubbles:
                            true,

                        cancelable:
                            true,

                        view:
                            window
                    }
                )
            );
        }

        return true;

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   RADIO / CHECKBOX FILL
   ------------------------------------------------------------ */

ISE.PlatformEngine.fillBooleanControl =
function (
    element,
    desired
) {

    if (
        !element ||
        ISE.PlatformEngine
            .disabled(
                element
            )
    ) {
        return false;
    }

    var current =
        ISE.PlatformEngine
            .isSelected(
                element
            );

    if (
        current ===
        desired
    ) {

        return true;
    }

    return ISE.PlatformEngine
        .click(
            element
        );
};


/* ------------------------------------------------------------
   CUSTOM ARIA CONTROL FILL
   ------------------------------------------------------------ */

ISE.PlatformEngine.fillARIA =
function (
    element,
    answer
) {

    if (
        !element ||
        ISE.PlatformEngine
            .disabled(
                element
            )
    ) {
        return false;
    }

    var role =
        ISE.PlatformEngine
            .attr(
                element,
                "role"
            )
            .toLowerCase();

    if (
        role === "radio" ||
        role === "option" ||
        role === "menuitemradio"
    ) {

        return ISE.PlatformEngine
            .click(
                element
            );
    }

    if (
        role === "checkbox" ||
        role === "menuitemcheckbox" ||
        role === "switch"
    ) {

        return ISE.PlatformEngine
            .click(
                element
            );
    }

    if (
        role === "button"
    ) {

        return ISE.PlatformEngine
            .click(
                element
            );
    }

    return false;
};


/* ------------------------------------------------------------
   CUSTOM CARD DETECTION
   ------------------------------------------------------------ */

ISE.PlatformEngine.findAnswerCards =
function (
    container
) {

    var results = [];

    if (!container) {
        return results;
    }

    var selectors = [

        "[data-answer]",

        "[data-option]",

        "[data-choice]",

        "[data-value]",

        "[role='radio']",

        "[role='checkbox']",

        "[role='option']",

        "button",

        "label"
    ];

    var selector =
        selectors.join(",");

    try {

        var nodes =
            container.querySelectorAll(
                selector
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var node =
                nodes[i];

            if (
                !ISE.PlatformEngine
                    .visible(
                        node
                    )
            ) {
                continue;
            }

            if (
                ISE.PlatformEngine
                    .disabled(
                        node
                    )
            ) {
                continue;
            }

            var text =
                ISE.PlatformEngine
                    .description(
                        node
                    );

            if (!text) {
                continue;
            }

            results.push(
                node
            );
        }

    } catch (error) {}

    return ISE.PlatformEngine
        .unique(
            results
        );
};


/* ------------------------------------------------------------
   BOOLEAN ANSWER MATCHING
   ------------------------------------------------------------ */

ISE.PlatformEngine.booleanAnswer =
function (
    answer
) {

    var normalized =
        ISE.PlatformEngine
            .normalize(
                answer
            );

    if (
        ISE.semantic &&
        typeof ISE.semantic.isYes ===
        "function" &&
        ISE.semantic.isYes(
            normalized
        )
    ) {

        return true;
    }

    if (
        ISE.semantic &&
        typeof ISE.semantic.isNo ===
        "function" &&
        ISE.semantic.isNo(
            normalized
        )
    ) {

        return false;
    }

    if (
        normalized ===
        "true"
    ) {
        return true;
    }

    if (
        normalized ===
        "false"
    ) {
        return false;
    }

    return null;
};


