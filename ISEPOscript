    /* ============================================================
   INTELLIGENT SURVEY ENGINE
   PART 4 — CONTROL SEMANTICS + SAFE AUTOFILL ENGINE
   ============================================================ */

ISE.ControlEngine = ISE.ControlEngine || {};
ISE.AutofillEngine = ISE.AutofillEngine || {};

ISE.ControlEngine.version = "4.0.0";


/* ------------------------------------------------------------
   BASIC DOM HELPERS
   ------------------------------------------------------------ */

ISE.ControlEngine.isElement = function (element) {

    return !!(
        element &&
        element.nodeType === 1
    );
};


ISE.ControlEngine.tag = function (element) {

    if (!ISE.ControlEngine.isElement(element)) {
        return "";
    }

    return String(
        element.tagName || ""
    ).toLowerCase();
};


ISE.ControlEngine.attr = function (
    element,
    name
) {

    if (!ISE.ControlEngine.isElement(element)) {
        return "";
    }

    try {
        return element.getAttribute(name) || "";
    } catch (error) {
        return "";
    }
};


ISE.ControlEngine.text = function (element) {

    if (!ISE.ControlEngine.isElement(element)) {
        return "";
    }

    var parts = [];

    try {
        if (element.innerText) {
            parts.push(element.innerText);
        }
    } catch (error) {}

    try {
        if (element.textContent) {
            parts.push(element.textContent);
        }
    } catch (error) {}

    try {
        var aria = element.getAttribute("aria-label");

        if (aria) {
            parts.push(aria);
        }
    } catch (error) {}

    try {
        var title = element.getAttribute("title");

        if (title) {
            parts.push(title);
        }
    } catch (error) {}

    try {
        var value = element.getAttribute("value");

        if (value) {
            parts.push(value);
        }
    } catch (error) {}

    return parts
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
};


ISE.ControlEngine.normalizedText = function (
    element
) {

    return ISE.SemanticEngine.normalize(
        ISE.ControlEngine.text(element)
    );
};


/* ------------------------------------------------------------
   VISIBILITY
   ------------------------------------------------------------ */

ISE.ControlEngine.isVisible = function (
    element
) {

    if (!ISE.ControlEngine.isElement(element)) {
        return false;
    }

    try {

        var style =
            window.getComputedStyle(element);

        if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.opacity === "0"
        ) {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        if (
            rect.width <= 0 ||
            rect.height <= 0
        ) {
            return false;
        }

        return true;

    } catch (error) {

        return true;
    }
};


ISE.ControlEngine.isDisabled = function (
    element
) {

    if (!ISE.ControlEngine.isElement(element)) {
        return true;
    }

    try {

        if (element.disabled === true) {
            return true;
        }

    } catch (error) {}

    var ariaDisabled =
        ISE.ControlEngine.attr(
            element,
            "aria-disabled"
        );

    if (
        ISE.SemanticEngine.normalize(
            ariaDisabled
        ) === "true"
    ) {
        return true;
    }

    var disabledAttr =
        ISE.ControlEngine.attr(
            element,
            "disabled"
        );

    return disabledAttr !== "";
};


/* ------------------------------------------------------------
   CONTROL TYPE
   ------------------------------------------------------------ */

ISE.ControlEngine.getType = function (
    element
) {

    var tag =
        ISE.ControlEngine.tag(element);

    if (tag === "input") {

        return (
            element.type ||
            "text"
        ).toLowerCase();
    }

    if (tag === "select") {
        return "select";
    }

    if (tag === "textarea") {
        return "textarea";
    }

    var role =
        ISE.ControlEngine.attr(
            element,
            "role"
        );

    role =
        ISE.SemanticEngine.normalize(role);

    if (role) {
        return role;
    }

    if (
        tag === "button"
    ) {
        return "button";
    }

    if (
        element.isContentEditable
    ) {
        return "contenteditable";
    }

    return "unknown";
};


/* ------------------------------------------------------------
   LABEL LOOKUP
   ------------------------------------------------------------ */

ISE.ControlEngine.findLabelForInput = function (
    input
) {

    if (!ISE.ControlEngine.isElement(input)) {
        return null;
    }

    var id =
        ISE.ControlEngine.attr(
            input,
            "id"
        );

    if (id) {

        try {

            var label =
                document.querySelector(
                    'label[for="' +
                    CSS.escape(id) +
                    '"]'
                );

            if (label) {
                return label;
            }

        } catch (error) {}
    }

    var parent = input.parentElement;

    while (parent) {

        if (
            ISE.ControlEngine.tag(parent) ===
            "label"
        ) {
            return parent;
        }

        parent = parent.parentElement;
    }

    return null;
};


ISE.ControlEngine.getLabelText = function (
    control
) {

    var pieces = [];

    var ariaLabel =
        ISE.ControlEngine.attr(
            control,
            "aria-label"
        );

    if (ariaLabel) {
        pieces.push(ariaLabel);
    }

    var labelledBy =
        ISE.ControlEngine.attr(
            control,
            "aria-labelledby"
        );

    if (labelledBy) {

        var ids =
            labelledBy.split(/\s+/);

        for (
            var i = 0;
            i < ids.length;
            i++
        ) {

            try {

                var node =
                    document.getElementById(
                        ids[i]
                    );

                if (node) {
                    pieces.push(
                        ISE.ControlEngine.text(node)
                    );
                }

            } catch (error) {}
        }
    }

    var label =
        ISE.ControlEngine.findLabelForInput(
            control
        );

    if (label) {
        pieces.push(
            ISE.ControlEngine.text(label)
        );
    }

    var placeholder =
        ISE.ControlEngine.attr(
            control,
            "placeholder"
        );

    if (placeholder) {
        pieces.push(placeholder);
    }

    var title =
        ISE.ControlEngine.attr(
            control,
            "title"
        );

    if (title) {
        pieces.push(title);
    }

    var name =
        ISE.ControlEngine.attr(
            control,
            "name"
        );

    if (name) {
        pieces.push(name);
    }

    return pieces
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
};


/* ------------------------------------------------------------
   CONTROL DESCRIPTION
   ------------------------------------------------------------ */

ISE.ControlEngine.describe = function (
    control
) {

    var type =
        ISE.ControlEngine.getType(control);

    var label =
        ISE.ControlEngine.getLabelText(
            control
        );

    var text =
        ISE.ControlEngine.text(control);

    var value =
        ISE.ControlEngine.attr(
            control,
            "value"
        );

    var name =
        ISE.ControlEngine.attr(
            control,
            "name"
        );

    var id =
        ISE.ControlEngine.attr(
            control,
            "id"
        );

    return {
        element: control,
        type: type,
        label: label,
        text: text,
        value: value,
        name: name,
        id: id,
        normalized:
            ISE.SemanticEngine.normalize(
                [
                    label,
                    text,
                    value,
                    name,
                    id
                ].join(" ")
            )
    };
};


/* ------------------------------------------------------------
   CONTROL COLLECTION
   ------------------------------------------------------------ */

ISE.ControlEngine.collect = function (
    container
) {

    var root =
        container ||
        document;

    var selectors = [
        "input",
        "select",
        "textarea",
        "button",
        "[role='radio']",
        "[role='checkbox']",
        "[role='option']",
        "[role='button']",
        "[role='combobox']",
        "[contenteditable='true']"
    ];

    var found = [];

    try {

        var nodes =
            root.querySelectorAll(
                selectors.join(",")
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var element = nodes[i];

            if (
                !ISE.ControlEngine.isVisible(
                    element
                )
            ) {
                continue;
            }

            if (
                ISE.ControlEngine.isDisabled(
                    element
                )
            ) {
                continue;
            }

            found.push(element);
        }

    } catch (error) {

        if (ISE.warn) {
            ISE.warn(
                "Control collection failed:",
                error
            );
        }
    }

    return found;
};


/* ------------------------------------------------------------
   CONTROL TEXT
   ------------------------------------------------------------ */

ISE.ControlEngine.getOptionText = function (
    option
) {

    if (!option) {
        return "";
    }

    var pieces = [];

    try {
        pieces.push(
            option.textContent || ""
        );
    } catch (error) {}

    try {
        pieces.push(
            option.value || ""
        );
    } catch (error) {}

    try {

        var label =
            option.getAttribute(
                "aria-label"
            );

        if (label) {
            pieces.push(label);
        }

    } catch (error) {}

    return pieces
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
};


/* ------------------------------------------------------------
   SELECT OPTIONS
   ------------------------------------------------------------ */

ISE.ControlEngine.getSelectOptions = function (
    select
) {

    if (
        !select ||
        ISE.ControlEngine.tag(select) !==
        "select"
    ) {
        return [];
    }

    var result = [];

    try {

        var options =
            select.options;

        for (
            var i = 0;
            i < options.length;
            i++
        ) {

            var option =
                options[i];

            result.push({
                element: option,
                index: i,
                text:
                    ISE.ControlEngine.getOptionText(
                        option
                    ),
                value:
                    option.value || "",
                selected:
                    option.selected === true,
                disabled:
                    option.disabled === true
            });
        }

    } catch (error) {}

    return result;
};


/* ------------------------------------------------------------
   VALUE SIMILARITY
   ------------------------------------------------------------ */

ISE.ControlEngine.similarity = function (
    desired,
    candidate
) {

    var a =
        ISE.SemanticEngine.normalize(
            desired
        );

    var b =
        ISE.SemanticEngine.normalize(
            candidate
        );

    if (!a || !b) {
        return 0;
    }

    if (a === b) {
        return 1;
    }

    if (
        ISE.AnswerEngine &&
        ISE.AnswerEngine.answerMatches(
            desired,
            candidate
        )
    ) {
        return 0.98;
    }

    var overlap =
        ISE.SemanticEngine.tokenOverlap(
            a,
            b
        );

    if (b.indexOf(a) !== -1) {
        return Math.max(
            overlap,
            0.9
        );
    }

    if (a.indexOf(b) !== -1) {
        return Math.max(
            overlap,
            0.86
        );
    }

    return overlap;
};


/* ------------------------------------------------------------
   RANGE CONTROL SCORING
   ------------------------------------------------------------ */

ISE.ControlEngine.rangeScore = function (
    answer,
    candidate
) {

    if (!answer) {
        return 0;
    }

    if (
        answer.kind !== "range" &&
        answer.kind !== "number"
    ) {
        return 0;
    }

    var numericValue =
        Number(answer.value);

    if (!Number.isFinite(numericValue)) {
        return 0;
    }

    if (
        ISE.AnswerEngine.rangeMatches(
            numericValue,
            candidate
        )
    ) {
        return 1;
    }

    return 0;
};


/* ------------------------------------------------------------
   CONTROL SCORING
   ------------------------------------------------------------ */

ISE.ControlEngine.score = function (
    answer,
    description
) {

    if (
        !answer ||
        !description
    ) {
        return 0;
    }

    var score = 0;

    var candidateText =
        [
            description.label,
            description.text,
            description.value,
            description.name
        ].join(" ");

    var similarity =
        ISE.ControlEngine.similarity(
            answer.value,
            candidateText
        );

    score =
        Math.max(
            score,
            similarity
        );

    var rangeScore =
        ISE.ControlEngine.rangeScore(
            answer,
            candidateText
        );

    score =
        Math.max(
            score,
            rangeScore
        );

    if (
        answer.kind === "single"
    ) {

        if (
            answer.value === "Yes" &&
            ISE.SemanticEngine.isYes(
                candidateText
            )
        ) {
            score = Math.max(
                score,
                1
            );
        }

        if (
            answer.value === "No" &&
            ISE.SemanticEngine.isNo(
                candidateText
            )
        ) {
            score = Math.max(
                score,
                1
            );
        }

        if (
            ISE.SemanticEngine.isNone(
                answer.value
            ) &&
            ISE.SemanticEngine.isNone(
                candidateText
            )
        ) {
            score = Math.max(
                score,
                1
            );
        }
    }

    return score;
};


/* ------------------------------------------------------------
   BEST CONTROL
   ------------------------------------------------------------ */

ISE.ControlEngine.findBest = function (
    answer,
    controls
) {

    if (
        !answer ||
        !Array.isArray(controls)
    ) {
        return null;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var description =
            ISE.ControlEngine.describe(
                control
            );

        var score =
            ISE.ControlEngine.score(
                answer,
                description
            );

        if (score > bestScore) {

            bestScore = score;

            best = {
                element: control,
                description: description,
                score: score
            };
        }
    }

    if (!best) {
        return null;
    }

    return best;
};


/* ------------------------------------------------------------
   EVENT DISPATCH
   ------------------------------------------------------------ */

ISE.ControlEngine.dispatch = function (
    element,
    eventName
) {

    if (!element) {
        return;
    }

    try {

        var event =
            new Event(
                eventName,
                {
                    bubbles: true,
                    cancelable: true
                }
            );

        element.dispatchEvent(
            event
        );

    } catch (error) {

        try {

            var fallback =
                document.createEvent(
                    "Event"
                );

            fallback.initEvent(
                eventName,
                true,
                true
            );

            element.dispatchEvent(
                fallback
            );

        } catch (secondError) {}
    }
};


/* ------------------------------------------------------------
   REACT / FRAMEWORK INPUT SUPPORT
   ------------------------------------------------------------ */

ISE.ControlEngine.setNativeValue = function (
    element,
    value
) {

    if (!element) {
        return false;
    }

    var prototype =
        Object.getPrototypeOf(
            element
        );

    var descriptor = null;

    try {

        descriptor =
            Object.getOwnPropertyDescriptor(
                prototype,
                "value"
            );

    } catch (error) {}

    try {

        if (
            descriptor &&
            descriptor.set
        ) {

            descriptor.set.call(
                element,
                value
            );

        } else {

            element.value = value;
        }

        return true;

    } catch (error) {

        try {
            element.value = value;
            return true;
        } catch (secondError) {
            return false;
        }
    }
};


/* ------------------------------------------------------------
   TEXT INPUT FILL
   ------------------------------------------------------------ */

ISE.ControlEngine.fillText = function (
    element,
    value
) {

    if (!element) {
        return false;
    }

    var text =
        value === null ||
        value === undefined
            ? ""
            : String(value);

    var type =
        ISE.ControlEngine.getType(
            element
        );

    if (
        type === "contenteditable" ||
        element.isContentEditable
    ) {

        try {

            element.focus();

            element.textContent =
                text;

            ISE.ControlEngine.dispatch(
                element,
                "input"
            );

            ISE.ControlEngine.dispatch(
                element,
                "change"
            );

            return true;

        } catch (error) {
            return false;
        }
    }

    if (
        type === "text" ||
        type === "search" ||
        type === "email" ||
        type === "tel" ||
        type === "url" ||
        type === "number" ||
        type === "date" ||
        type === "month" ||
        type === "year" ||
        type === "textarea" ||
        type === "unknown"
    ) {

        var success =
            ISE.ControlEngine.setNativeValue(
                element,
                text
            );

        if (!success) {
            return false;
        }

        try {
            element.focus();
        } catch (error) {}

        ISE.ControlEngine.dispatch(
            element,
            "input"
        );

        ISE.ControlEngine.dispatch(
            element,
            "change"
        );

        ISE.ControlEngine.dispatch(
            element,
            "blur"
        );

        return true;
    }

    return false;
};


/* ------------------------------------------------------------
   DATE FORMATTING
   ------------------------------------------------------------ */

ISE.ControlEngine.formatDateForInput = function (
    date,
    type
) {

    if (!date) {
        return "";
    }

    var year =
        date.getFullYear();

    var month =
        String(
            date.getMonth() + 1
        ).padStart(2, "0");

    var day =
        String(
            date.getDate()
        ).padStart(2, "0");

    if (type === "month") {
        return year + "-" + month;
    }

    if (type === "date") {
        return (
            year +
            "-" +
            month +
            "-" +
            day
        );
    }

    return String(year);
};


/* ------------------------------------------------------------
   SELECT FILL
   ------------------------------------------------------------ */

ISE.ControlEngine.fillSelect = function (
    select,
    answer
) {

    if (!select) {
        return false;
    }

    var options =
        ISE.ControlEngine.getSelectOptions(
            select
        );

    if (!options.length) {
        return false;
    }

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < options.length;
        i++
    ) {

        var option =
            options[i];

        if (option.disabled) {
            continue;
        }

        var score =
            ISE.ControlEngine.similarity(
                answer.value,
                option.text + " " + option.value
            );

        if (
            answer.kind === "range" ||
            answer.kind === "number"
        ) {

            score =
                Math.max(
                    score,
                    ISE.ControlEngine.rangeScore(
                        answer,
                        option.text + " " + option.value
                    )
                );
        }

        if (score > bestScore) {

            bestScore = score;
            best = option;
        }
    }

    if (!best) {
        return false;
    }

    /*
     * Range options often have only a label such as:
     * "$50,000-$74,999"
     * or
     * "30-39"
     *
     * A very high semantic score is required before
     * modifying the control.
     */

    if (
        bestScore < 0.65
    ) {
        return false;
    }

    try {

        select.focus();

        var changed =
            ISE.ControlEngine.setNativeValue(
                select,
                best.value
            );

        if (!changed) {

            select.value =
                best.value;
        }

        /*
         * Some custom survey frameworks watch the
         * selectedIndex property.
         */

        try {
            select.selectedIndex =
                best.index;
        } catch (error) {}

        ISE.ControlEngine.dispatch(
            select,
            "input"
        );

        ISE.ControlEngine.dispatch(
            select,
            "change"
        );

        ISE.ControlEngine.dispatch(
            select,
            "blur"
        );

        return true;

    } catch (error) {

        return false;
    }
};


/* ------------------------------------------------------------
   RADIO / CHECKBOX STATE
   ------------------------------------------------------------ */

ISE.ControlEngine.isChecked = function (
    element
) {

    if (!element) {
        return false;
    }

    try {

        if (
            element.checked === true
        ) {
            return true;
        }

    } catch (error) {}

    var aria =
        ISE.ControlEngine.attr(
            element,
            "aria-checked"
        );

    return (
        ISE.SemanticEngine.normalize(
            aria
        ) === "true"
    );
};


/* ------------------------------------------------------------
   NATIVE CLICK
   ------------------------------------------------------------ */

ISE.ControlEngine.click = function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        ISE.ControlEngine.isDisabled(
            element
        )
    ) {
        return false;
    }

    try {

        element.focus();

    } catch (error) {}

    try {

        element.click();

        return true;

    } catch (error) {}

    try {

        var event =
            new MouseEvent(
                "click",
                {
                    bubbles: true,
                    cancelable: true,
                    view: window
                }
            );

        element.dispatchEvent(
            event
        );

        return true;

    } catch (error) {}

    return false;
};


/* ------------------------------------------------------------
   RADIO / CHECKBOX FILL
   ------------------------------------------------------------ */

ISE.ControlEngine.fillChoice = function (
    control,
    answer
) {

    if (!control) {
        return false;
    }

    var description =
        ISE.ControlEngine.describe(
            control
        );

    var score =
        ISE.ControlEngine.score(
            answer,
            description
        );

    if (score < 0.65) {
        return false;
    }

    var type =
        ISE.ControlEngine.getType(
            control
        );

    /*
     * Native radio and checkbox.
     */

    if (
        type === "radio" ||
        type === "checkbox"
    ) {

        if (
            !ISE.ControlEngine.isChecked(
                control
            )
        ) {

            return ISE.ControlEngine.click(
                control
            );
        }

        return true;
    }

    /*
     * ARIA radio/checkbox.
     */

    if (
        type === "radio" ||
        type === "checkbox"
    ) {

        return ISE.ControlEngine.click(
            control
        );
    }

    /*
     * Buttons and custom controls.
     */

    if (
        type === "button" ||
        type === "option" ||
        type === "combobox"
    ) {

        return ISE.ControlEngine.click(
            control
        );
    }

    return false;
};


/* ------------------------------------------------------------
   GENERIC ANSWER FILL
   ------------------------------------------------------------ */

ISE.ControlEngine.fill = function (
    control,
    answer
) {

    if (
        !control ||
        !answer
    ) {
        return {
            success: false,
            reason: "Missing control or answer."
        };
    }

    var type =
        ISE.ControlEngine.getType(
            control
        );

    if (
        type === "select"
    ) {

        var selectSuccess =
            ISE.ControlEngine.fillSelect(
                control,
                answer
            );

        return {
            success: selectSuccess,
            method: "select"
        };
    }

    if (
        type === "radio" ||
        type === "checkbox" ||
        type === "option" ||
        type === "button"
    ) {

        var choiceSuccess =
            ISE.ControlEngine.fillChoice(
                control,
                answer
            );

        return {
            success: choiceSuccess,
            method: "choice"
        };
    }

    if (
        type === "combobox"
    ) {

        var comboSuccess =
            ISE.ControlEngine.fillText(
                control,
                answer.value
            );

        return {
            success: comboSuccess,
            method: "combobox"
        };
    }

    if (
        type === "date" ||
        type === "month"
    ) {

        var date =
            answer.value instanceof Date
                ? answer.value
                : ISE.SemanticEngine.parseDate(
                    answer.value
                );

        if (!date) {

            return {
                success: false,
                method: "date",
                reason: "Invalid date."
            };
        }

        var formatted =
            ISE.ControlEngine.formatDateForInput(
                date,
                type
            );

        var dateSuccess =
            ISE.ControlEngine.fillText(
                control,
                formatted
            );

        return {
            success: dateSuccess,
            method: "date"
        };
    }

    if (
        answer.kind === "number" ||
        answer.kind === "year"
    ) {

        var numericSuccess =
            ISE.ControlEngine.fillText(
                control,
                String(answer.value)
            );

        return {
            success: numericSuccess,
            method: "number"
        };
    }

    var textSuccess =
        ISE.ControlEngine.fillText(
            control,
            answer.value
        );

    return {
        success: textSuccess,
        method: "text"
    };
};


/* ------------------------------------------------------------
   VERIFICATION
   ------------------------------------------------------------ */

ISE.ControlEngine.verify = function (
    control,
    answer
) {

    if (
        !control ||
        !answer
    ) {
        return false;
    }

    var type =
        ISE.ControlEngine.getType(
            control
        );

    if (
        type === "select"
    ) {

        try {

            var selected =
                control.options[
                    control.selectedIndex
                ];

            if (!selected) {
                return false;
            }

            var candidate =
                ISE.ControlEngine.getOptionText(
                    selected
                );

            if (
                ISE.ControlEngine.score(
                    answer,
                    {
                        label: candidate,
                        text: candidate,
                        value:
                            selected.value || "",
                        name: ""
                    }
                ) >= 0.65
            ) {
                return true;
            }

        } catch (error) {}

        return false;
    }

    if (
        type === "radio" ||
        type === "checkbox"
    ) {

        return ISE.ControlEngine.isChecked(
            control
        );
    }

    if (
        type === "button" ||
        type === "option"
    ) {

        var aria =
            ISE.ControlEngine.attr(
                control,
                "aria-selected"
            );

        if (
            ISE.SemanticEngine.normalize(
                aria
            ) === "true"
        ) {
            return true;
        }

        var selectedAttr =
            ISE.ControlEngine.attr(
                control,
                "data-selected"
            );

        if (
            ISE.SemanticEngine.normalize(
                selectedAttr
            ) === "true"
        ) {
            return true;
        }

        /*
         * Some survey UIs expose selection
         * using a class rather than ARIA.
         */

        try {

            var classes =
                String(
                    control.className || ""
                ).toLowerCase();

            if (
                classes.indexOf("selected") !== -1 ||
                classes.indexOf("active") !== -1 ||
                classes.indexOf("checked") !== -1
            ) {
                return true;
            }

        } catch (error) {}

        return false;
    }

    if (
        type === "contenteditable"
    ) {

        return (
            ISE.SemanticEngine.normalize(
                control.textContent
            ) ===
            ISE.SemanticEngine.normalize(
                answer.value
            )
        );
    }

    try {

        var current =
            control.value;

        if (
            current !== undefined &&
            current !== null
        ) {

            if (
                answer.kind === "number" ||
                answer.kind === "year"
            ) {

                return (
                    Number(current) ===
                    Number(answer.value)
                );
            }

            return (
                ISE.SemanticEngine.normalize(
                    current
                ) ===
                ISE.SemanticEngine.normalize(
                    answer.value
                )
            );
        }

    } catch (error) {}

    return false;
};


/* ------------------------------------------------------------
   QUESTION CONTROL SEARCH
   ------------------------------------------------------------ */

ISE.ControlEngine.findForQuestion = function (
    question
) {

    if (!question) {
        return [];
    }

    var container =
        question.container ||
        question.element ||
        null;

    var controls =
        ISE.ControlEngine.collect(
            container
        );

    if (!controls.length) {

        controls =
            ISE.ControlEngine.collect(
                document
            );
    }

    return controls;
};


/* ------------------------------------------------------------
   MULTI-CONTROL DATE GROUP
   ------------------------------------------------------------ */

ISE.ControlEngine.findDateParts = function (
    question
) {

    var controls =
        ISE.ControlEngine.findForQuestion(
            question
        );

    var result = {
        day: null,
        month: null,
        year: null
    };

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var description =
            ISE.ControlEngine.describe(
                control
            );

        var text =
            description.normalized;

        if (
            !result.month &&
            (
                text.indexOf("month") !== -1 ||
                text.indexOf("mm") !== -1
            )
        ) {
            result.month = control;
            continue;
        }

        if (
            !result.day &&
            (
                text.indexOf("day") !== -1 ||
                text.indexOf("dd") !== -1
            )
        ) {
            result.day = control;
            continue;
        }

        if (
            !result.year &&
            (
                text.indexOf("year") !== -1 ||
                text.indexOf("yyyy") !== -1
            )
        ) {
            result.year = control;
            continue;
        }
    }

    return result;
};


/* ------------------------------------------------------------
   MULTI-CONTROL DATE FILL
   ------------------------------------------------------------ */

ISE.ControlEngine.fillDateParts = function (
    question,
    answer
) {

    var date =
        answer.value instanceof Date
            ? answer.value
            : ISE.SemanticEngine.parseDate(
                answer.value
            );

    if (!date) {
        return false;
    }

    var parts =
        ISE.ControlEngine.findDateParts(
            question
        );

    var success = false;

    if (parts.month) {

        var monthAnswer = {
            kind: "number",
            value:
                date.getMonth() + 1
        };

        success =
            ISE.ControlEngine.fill(
                parts.month,
                monthAnswer
            ).success || success;
    }

    if (parts.day) {

        var dayAnswer = {
            kind: "number",
            value:
                date.getDate()
        };

        success =
            ISE.ControlEngine.fill(
                parts.day,
                dayAnswer
            ).success || success;
    }

    if (parts.year) {

        var yearAnswer = {
            kind: "year",
            value:
                date.getFullYear()
        };

        success =
            ISE.ControlEngine.fill(
                parts.year,
                yearAnswer
            ).success || success;
    }

    return success;
};


/* ------------------------------------------------------------
   AUTOFILL ENGINE
   ------------------------------------------------------------ */

ISE.AutofillEngine.statistics =
    ISE.AutofillEngine.statistics || {
        attempts: 0,
        successful: 0,
        failed: 0,
        unsupported: 0,
        verified: 0,
        retries: 0
    };


ISE.AutofillEngine.lastResults = [];


/* ------------------------------------------------------------
   RESULT RECORDER
   ------------------------------------------------------------ */

ISE.AutofillEngine.record = function (
    result
) {

    ISE.AutofillEngine.lastResults.push(
        result
    );

    if (
        ISE.AutofillEngine.lastResults.length >
        100
    ) {

        ISE.AutofillEngine.lastResults.shift();
    }
};


/* ------------------------------------------------------------
   SAFE QUESTION PROCESSING
   ------------------------------------------------------------ */

ISE.AutofillEngine.processQuestion = function (
    question
) {

    ISE.AutofillEngine.statistics.attempts++;

    if (!question) {

        ISE.AutofillEngine.statistics.failed++;

        return {
            success: false,
            reason: "No question object."
        };
    }

    var questionText =
        question.text ||
        question.questionText ||
        "";

    if (!questionText) {

        ISE.AutofillEngine.statistics.failed++;

        return {
            success: false,
            reason: "Question has no text."
        };
    }

    /*
     * Part 3 determines whether the answer is actually
     * supported by the configured profile.
     */

    var answer =
        ISE.AnswerEngine.resolve(
            questionText
        );

    if (
        !answer ||
        !answer.supported
    ) {

        ISE.AutofillEngine.statistics.unsupported++;

        var unsupportedResult = {
            success: false,
            supported: false,
            question: questionText,
            answer: null,
            reason:
                answer &&
                answer.reason
                    ? answer.reason
                    : "Unsupported question."
        };

        ISE.AutofillEngine.record(
            unsupportedResult
        );

        if (ISE.warn) {
            ISE.warn(
                "Unsupported survey question — no answer invented:",
                questionText
            );
        }

        return unsupportedResult;
    }

    var controls =
        ISE.ControlEngine.findForQuestion(
            question
        );

    if (!controls.length) {

        /*
         * A DOB question can sometimes use three
         * separate controls that Part 2 may have
         * grouped differently.
         */

        if (
            answer.kind === "date"
        ) {

            var datePartsSuccess =
                ISE.ControlEngine.fillDateParts(
                    question,
                    answer
                );

            if (datePartsSuccess) {

                ISE.AutofillEngine.statistics.successful++;

                var dateResult = {
                    success: true,
                    supported: true,
                    verified: false,
                    question: questionText,
                    answer: answer,
                    method: "date-parts"
                };

                ISE.AutofillEngine.record(
                    dateResult
                );

                return dateResult;
            }
        }

        ISE.AutofillEngine.statistics.failed++;

        var noControlResult = {
            success: false,
            supported: true,
            question: questionText,
            answer: answer,
            reason: "No usable controls found."
        };

        ISE.AutofillEngine.record(
            noControlResult
        );

        return noControlResult;
    }

    /*
     * First attempt: find the best individual control.
     */

    var best =
        ISE.ControlEngine.findBest(
            answer,
            controls
        );

    if (!best) {

        ISE.AutofillEngine.statistics.failed++;

        var noMatchResult = {
            success: false,
            supported: true,
            question: questionText,
            answer: answer,
            reason:
                "No control matched the configured answer."
        };

        ISE.AutofillEngine.record(
            noMatchResult
        );

        return noMatchResult;
    }

    /*
     * Require a meaningful semantic match.
     * This is intentionally conservative so that an
     * unrelated option is not clicked merely because
     * it exists on the page.
     */

    if (
        best.score < 0.65
    ) {

        ISE.AutofillEngine.statistics.failed++;

        var lowConfidenceResult = {
            success: false,
            supported: true,
            question: questionText,
            answer: answer,
            bestScore: best.score,
            reason:
                "Control match confidence was too low."
        };

        ISE.AutofillEngine.record(
            lowConfidenceResult
        );

        return lowConfidenceResult;
    }

    var fillResult =
        ISE.ControlEngine.fill(
            best.element,
            answer
        );

    if (!fillResult.success) {

        ISE.AutofillEngine.statistics.retries++;

        /*
         * Retry once using a direct click for choice
         * controls or native value assignment for inputs.
         */

        var retrySuccess = false;

        var type =
            ISE.ControlEngine.getType(
                best.element
            );

        if (
            type === "radio" ||
            type === "checkbox" ||
            type === "button" ||
            type === "option"
        ) {

            retrySuccess =
                ISE.ControlEngine.click(
                    best.element
                );

        } else {

            retrySuccess =
                ISE.ControlEngine.fillText(
                    best.element,
                    answer.value
                );
        }

        if (!retrySuccess) {

            ISE.AutofillEngine.statistics.failed++;

            var fillFailedResult = {
                success: false,
                supported: true,
                question: questionText,
                answer: answer,
                control: best.description,
                score: best.score,
                reason: "Control fill failed."
            };

            ISE.AutofillEngine.record(
                fillFailedResult
            );

            return fillFailedResult;
        }
    }

    /*
     * Verification happens after the control event has
     * had a chance to propagate through the survey app.
     */

    var verified =
        ISE.ControlEngine.verify(
            best.element,
            answer
        );

    /*
     * A short retry can handle React/Vue/Angular style
     * controls where state propagation occurs asynchronously.
     */

    if (!verified) {

        ISE.AutofillEngine.statistics.retries++;

        try {

            ISE.ControlEngine.dispatch(
                best.element,
                "input"
            );

            ISE.ControlEngine.dispatch(
                best.element,
                "change"
            );

        } catch (error) {}

        verified =
            ISE.ControlEngine.verify(
                best.element,
                answer
            );
    }

    if (verified) {
        ISE.AutofillEngine.statistics.verified++;
    }

    ISE.AutofillEngine.statistics.successful++;

    var finalResult = {
        success: true,
        supported: true,
        verified: verified,
        question: questionText,
        answer: answer,
        control: best.description,
        score: best.score,
        method:
            fillResult.method ||
            "unknown"
    };

    ISE.AutofillEngine.record(
        finalResult
    );

    if (ISE.log) {

        ISE.log(
            verified
                ? "Profile-supported answer filled and verified:"
                : "Profile-supported answer filled; verification pending:",
            finalResult
        );
    }

    return finalResult;
};


/* ------------------------------------------------------------
   PROCESS ALL DETECTED QUESTIONS
   ------------------------------------------------------------ */

ISE.AutofillEngine.processAll = function () {

    var questions =
        Array.isArray(
            ISE.STATE.questions
        )
            ? ISE.STATE.questions
            : [];

    var results = [];

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        results.push(
            ISE.AutofillEngine.processQuestion(
                questions[i]
            )
        );
    }

    return results;
};


/* ------------------------------------------------------------
   PROCESS NEW QUESTIONS ONLY
   ------------------------------------------------------------ */

ISE.AutofillEngine.processNew = function () {

    var questions =
        Array.isArray(
            ISE.STATE.questions
        )
            ? ISE.STATE.questions
            : [];

    var results = [];

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        var question =
            questions[i];

        if (
            question._autofillProcessed === true
        ) {
            continue;
        }

        question._autofillProcessed = true;

        results.push(
            ISE.AutofillEngine.processQuestion(
                question
            )
        );
    }

    return results;
};


/* ------------------------------------------------------------
   RETRY FAILED QUESTIONS
   ------------------------------------------------------------ */

ISE.AutofillEngine.retryFailed = function () {

    var questions =
        Array.isArray(
            ISE.STATE.questions
        )
            ? ISE.STATE.questions
            : [];

    var results = [];

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        var question =
            questions[i];

        if (
            question._lastAutofillResult &&
            question._lastAutofillResult.success
        ) {
            continue;
        }

        var result =
            ISE.AutofillEngine.processQuestion(
                question
            );

        question._lastAutofillResult =
            result;

        results.push(result);
    }

    return results;
};


/* ------------------------------------------------------------
   DIAGNOSTIC SUMMARY
