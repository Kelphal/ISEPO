/* ------------------------------------------------------------
   QUESTION FINGERPRINT
   ------------------------------------------------------------ */

ISE.Orchestrator.fingerprint =
function(
    question
)
{
    if(
        !question
    )
    {
        return "";
    }

    var text =
        ISE.Orchestrator
            .normalize(
                question.text ||
                question.question ||
                ""
            );

    var category =
        ISE.Orchestrator
            .normalize(
                question.category ||
                ""
            );

    var container =
        question.container ||
        question.element ||
        null;

    var controls = 0;

    if(
        container
    )
    {
        try
        {
            controls =
                container.querySelectorAll(
                    "input," +
                    "select," +
                    "textarea," +
                    "button," +
                    "[role='radio']," +
                    "[role='checkbox']," +
                    "[role='option']," +
                    "[role='combobox']," +
                    "[role='slider']"
                ).length;
        }
        catch(error)
        {
            controls = 0;
        }
    }

    return [
        text,
        category,
        controls
    ].join("|");
};


/* ------------------------------------------------------------
   QUESTION CONNECTIVITY
   ------------------------------------------------------------ */

ISE.Orchestrator.isAlive =
function(
    question
)
{
    if(
        !question
    )
    {
        return false;
    }

    var element =
        question.container ||
        question.element;

    if(
        !element
    )
    {
        return false;
    }

    try
    {
        return !!element.isConnected;
    }
    catch(error)
    {
        return true;
    }
};


/* ------------------------------------------------------------
   QUESTION VISIBILITY
   ------------------------------------------------------------ */

ISE.Orchestrator.isVisible =
function(
    question
)
{
    if(
        !question
    )
    {
        return false;
    }

    var element =
        question.container ||
        question.element;

    if(
        !element
    )
    {
        return false;
    }

    try
    {
        if(
            element.hidden
        )
        {
            return false;
        }

        var style =
            window.getComputedStyle(
                element
            );

        if(
            style.display ===
            "none" ||
            style.visibility ===
            "hidden"
        )
        {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );
    }
    catch(error)
    {
        return true;
    }
};


/* ------------------------------------------------------------
   QUESTION EXPIRATION
   ------------------------------------------------------------ */

ISE.Orchestrator.isExpired =
function(
    question
)
{
    if(
        !question
    )
    {
        return true;
    }

    var created =
        Number(
            question.createdAt ||
            question.detectedAt ||
            0
        );

    if(
        !created
    )
    {
        return false;
    }

    return (
        ISE.Orchestrator.now() -
        created >
        ISE.Orchestrator
            .config
            .questionExpiration
    );
};


/* ------------------------------------------------------------
   SAFE QUESTION EXTRACTION
   ------------------------------------------------------------ */

ISE.Orchestrator.extractQuestions =
function()
{
    var questions = [];

    /*
     * Primary DOM intelligence engine.
     */

    if(
        ISE.DOM
    )
    {
        if(
            typeof ISE.DOM
                .discoverQuestions ===
            "function"
        )
        {
            try
            {
                var discovered =
                    ISE.DOM
                        .discoverQuestions(
                            document
                        );

                if(
                    Array.isArray(
                        discovered
                    )
                )
                {
                    questions =
                        questions.concat(
                            discovered
                        );
                }
            }
            catch(error)
            {
                ISE.Orchestrator
                    .statistics
                    .orchestrationErrors++;
            }
        }

        /*
         * Alternate scan API.
         */

        if(
            typeof ISE.DOM.scan ===
            "function"
        )
        {
            try
            {
                var scanResult =
                    ISE.DOM.scan(
                        document
                    );

                if(
                    Array.isArray(
                        scanResult
                    )
                )
                {
                    questions =
                        questions.concat(
                            scanResult
                        );
                }
            }
            catch(error)
            {
                ISE.Orchestrator
                    .statistics
                    .orchestrationErrors++;
            }
        }
    }

    /*
     * Remove nulls.
     */

    var valid = [];

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        if(
            questions[i]
        )
        {
            valid.push(
                questions[i]
            );
        }
    }

    return valid;
};


/* ------------------------------------------------------------
   QUESTION DEDUPLICATION
   ------------------------------------------------------------ */

ISE.Orchestrator.deduplicate =
function(
    questions
)
{
    var result = [];

    var seen =
        {};

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        var question =
            questions[i];

        var id =
            ISE.Orchestrator
                .questionId(
                    question
                );

        var fingerprint =
            ISE.Orchestrator
                .fingerprint(
                    question
                );

        var key =
            id ||
            fingerprint;

        if(
            !key
        )
        {
            continue;
        }

        if(
            seen[key]
        )
        {
            ISE.Orchestrator
                .statistics
                .duplicateQuestions++;

            continue;
        }

        seen[key] =
            true;

        result.push(
            question
        );
    }

    return result;
};


