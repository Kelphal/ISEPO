        ];

        for (
            var i = 0;
            i <
            attributes.length;
            i++
        ) {

            var value =
                attr(
                    element,
                    attributes[i]
                );

            if (
                value
            ) {

                values.push(
                    value
                );
            }
        }


        try {

            if (
                element.innerText
            ) {

                values.push(
                    element.innerText
                );

            }
            else if (
                element.textContent
            ) {

                values.push(
                    element.textContent
                );
            }

        }
        catch (error) {
        }


        return limit(
            clean(
                values.join(
                    " "
                )
            ),
            engine.config
                .maximumQuestionText
        );
    }


    function ownText(
        element
    ) {

        if (
            !element
        ) {

            return "";
        }

        var result =
            [];

        try {

            for (
                var i = 0;
                i <
                element.childNodes.length;
                i++
            ) {

                var node =
                    element.childNodes[i];

                if (
                    node.nodeType ===
                    3
                ) {

                    var text =
                        clean(
                            node.nodeValue
                        );

                    if (
                        text
                    ) {

                        result.push(
                            text
                        );
                    }
                }
            }

        }
        catch (error) {
        }

        return clean(
            result.join(
                " "
            )
        );
    }


    /* ============================================================
       WORD / PHRASE HELPERS
       ============================================================ */

    function containsAny(
        text,
        values
    ) {

        var normalized =
            lower(
                text
            );

        for (
            var i = 0;
            i <
            values.length;
            i++
        ) {

            if (
                normalized.indexOf(
                    lower(
                        values[i]
                    )
                ) !==
                -1
            ) {

                return true;
            }
        }

        return false;
    }


    function countWords(
        text
    ) {

        var normalized =
            normalize(
                text
            );

        if (
            !normalized
        ) {

            return 0;
        }

        return normalized
            .split(
                /\s+/
            )
            .length;
    }


    function similarity(
        first,
        second
    ) {

        var a =
            new Set(
                normalize(
                    first
                )
                    .split(
                        /\s+/
                    )
                    .filter(
                        Boolean
                    )
            );

        var b =
            new Set(
                normalize(
                    second
                )
                    .split(
                        /\s+/
                    )
                    .filter(
                        Boolean
                    )
            );

        if (
            !a.size ||
            !b.size
        ) {

            return 0;
        }

        var common =
            0;

        a.forEach(
            function (
                word
            ) {

                if (
                    b.has(
                        word
                    )
                ) {

                    common++;
                }
            }
        );

        return common /
            Math.max(
                a.size,
                b.size
            );
    }


    /* ============================================================
       CONTROL DETECTION
       ============================================================ */

    function isControl(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {

            return false;
        }

        var elementTag =
            tag(
                element
            );

        if (
            [
                "input",
                "select",
                "textarea",
                "button"
            ].indexOf(
                elementTag
            ) !==
            -1
        ) {

            return true;
        }

        var role =
            lower(
                attr(
                    element,
                    "role"
                )
            );

        return [

            "radio",
            "checkbox",
            "option",
            "combobox",
            "listbox",
            "slider",
            "button",
            "spinbutton",
            "switch"

        ].indexOf(
            role
        ) !==
        -1;
    }


    function collectControls(
        container
    ) {

        if (
            !container ||
            !container.querySelectorAll
        ) {

            return [];
        }

        var selectors = [

            "input",
            "select",
            "textarea",
            "button",
            "[role='radio']",
            "[role='checkbox']",
            "[role='option']",
            "[role='combobox']",
            "[role='listbox']",
            "[role='slider']",
            "[role='spinbutton']",
            "[role='switch']"
        ];

        var controls =
            [];

        for (
            var i = 0;
            i <
            selectors.length;
            i++
        ) {

            try {

                var found =
                    container.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j <
                    found.length;
                    j++
                ) {

                    if (
                        controls.indexOf(
                            found[j]
                        ) ===
                        -1
                    ) {

                        controls.push(
                            found[j]
                        );
                    }

                    if (
                        controls.length >=
                        engine.config
                            .maximumControls
                    ) {

                        return controls;
                    }
                }

            }
            catch (error) {
            }
        }

        return controls;
    }


    /* ============================================================
       CHOICE DETECTION
       ============================================================ */

    function choiceText(
        element
    ) {

        if (
            !element
        ) {

            return "";
        }

        var values =
            [];

        var attributes = [

            "aria-label",
            "data-value",
            "data-answer",
            "data-option",
            "data-choice",
            "value",
            "title"
        ];

        for (
            var i = 0;
            i <
            attributes.length;
            i++
        ) {

            var value =
                attr(
                    element,
                    attributes[i]
                );

            if (
                value
            ) {

                values.push(
                    value
                );
            }
        }


        try {

            if (
                element.innerText
            ) {

                values.push(
                    element.innerText
                );

            }
            else if (
                element.textContent
            ) {

                values.push(
                    element.textContent
                );
            }

        }
        catch (error) {
        }


        return clean(
            values.join(
                " "
            )
        );
