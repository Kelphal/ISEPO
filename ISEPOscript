                root.querySelectorAll(
                    "input, select, textarea, button, " +
                    "[role='radio'], [role='checkbox'], " +
                    "[role='option'], [role='combobox'], " +
                    "[role='slider']"
                )
            );

        } catch (error) {

            return [];

        }
    };

    // ============================================================
    // ANSWER COMPARISON
    // ============================================================

    FI.answersEquivalent = function (a, b) {

        var aa =
            FI.normalize(a);

        var bb =
            FI.normalize(b);

        if (aa === bb) {
            return true;
        }

        var yes = [
            "yes",
            "y",
            "true",
            "1"
        ];

        var no = [
            "no",
            "n",
            "false",
            "0"
        ];

        if (
            yes.indexOf(aa) !== -1 &&
            yes.indexOf(bb) !== -1
        ) {
            return true;
        }

        if (
            no.indexOf(aa) !== -1 &&
            no.indexOf(bb) !== -1
        ) {
            return true;
        }

        return false;
    };

    // ============================================================
    // FILL QUESTION
    // ============================================================

    FI.fillQuestion = async function (
        question,
        answerResult
    ) {

        var answer =
            answerResult.answer;

        // --------------------------------------------------------
        // RECOVERY ENGINE
        // --------------------------------------------------------

        if (
            ISE.RecoveryEngine &&
            typeof ISE.RecoveryEngine.process ===
            "function"
        ) {

            try {

                var result =
                    await ISE.RecoveryEngine.process(
                        question,
                        answer
                    );

                if (result) {
                    return result;
                }

            } catch (error) {

                FI.STATE.statistics.errors++;

            }

        }

        // --------------------------------------------------------
        // AUTOFILL ENGINE
        // --------------------------------------------------------

        if (
            ISE.AutofillEngine &&
            typeof ISE.AutofillEngine.processQuestion ===
            "function"
        ) {

            try {

                var autofillResult =
                    await ISE.AutofillEngine.processQuestion(
                        question,
                        answer
                    );

                if (autofillResult) {
                    return autofillResult;
                }

            } catch (error) {

                FI.STATE.statistics.errors++;

            }

        }

        // --------------------------------------------------------
        // PLATFORM ENGINE
        // --------------------------------------------------------

        if (
            ISE.PlatformEngine &&
            typeof ISE.PlatformEngine.autofillQuestion ===
            "function"
        ) {

            try {

                var platformResult =
                    await ISE.PlatformEngine.autofillQuestion(
                        question,
                        answer
                    );

                if (platformResult) {
                    return platformResult;
                }

            } catch (error) {

                FI.STATE.statistics.errors++;

            }

        }

        return {
            success: false,
            reason: "No autofill engine succeeded."
        };
    };

    // ============================================================
    // VERIFICATION
    // ============================================================

    FI.verifyQuestion = function (
        question,
        answer
    ) {

        try {

            if (
                ISE.RecoveryEngine &&
                typeof ISE.RecoveryEngine.verifyQuestion ===
                "function"
            ) {

                var recoveryResult =
                    ISE.RecoveryEngine.verifyQuestion(
                        question,
                        answer
                    );

                if (recoveryResult) {
                    return true;
                }

            }

        } catch (error) {}

        try {

            if (
                ISE.AutofillEngine &&
                typeof ISE.AutofillEngine.verify ===
                "function"
            ) {

                var result =
                    ISE.AutofillEngine.verify(
                        question,
                        answer
                    );

                if (result) {
                    return true;
                }

            }

        } catch (error) {}

        // --------------------------------------------------------
        // BASIC CONTROL VERIFICATION
        // --------------------------------------------------------

        var controls =
            FI.getControls(question);

        if (!controls.length) {
            return false;
        }

        var normalizedAnswer =
            FI.normalize(answer);

        var yesAnswer =
            normalizedAnswer === "yes";

        var noAnswer =
            normalizedAnswer === "no";

        for (
            var i = 0;
            i < controls.length;
            i++
        ) {

            var control =
                controls[i];

            var type =
                FI.normalize(
                    control.type ||
                    FI.attr(control, "role")
                );

            if (
                type === "radio" ||
                type === "checkbox"
            ) {

                if (!control.checked) {
                    continue;
                }

                var text =
                    FI.textOf(
                        control.parentElement
                    );

                var value =
                    FI.normalize(
                        control.value ||
                        FI.attr(control, "aria-label") ||
                        text
                    );

                if (
                    FI.answersEquivalent(
                        value,
                        answer
                    )
                ) {
                    return true;
                }

                if (
                    yesAnswer &&
                    value.indexOf("yes") !== -1
                ) {
                    return true;
                }

                if (
                    noAnswer &&
                    value.indexOf("no") !== -1
                ) {
                    return true;
                }
            }

            if (
                control.tagName &&
                control.tagName.toLowerCase() ===
                "select"
            ) {

                var selected =
                    control.options[
                        control.selectedIndex
                    ];

                if (!selected) {
                    continue;
                }

                if (
                    FI.answersEquivalent(
                        selected.textContent,
                        answer
                    ) ||
                    FI.answersEquivalent(
                        selected.value,
                        answer
                    )
                ) {
                    return true;
                }
            }
        }

        return false;
    };

    // ============================================================
    // PROCESS ONE QUESTION
    // ============================================================

    FI.processQuestion = async function (
        question
    ) {

        if (!FI.isQuestionEligible(question)) {
            return false;
        }

        var fingerprint =
            FI.fingerprint(question);

        if (
            FI.CONFIG.preserveSuccessfulQuestions &&
            FI.STATE.successful[fingerprint]
        ) {
            FI.STATE.statistics.skipped++;
            return false;
        }

        var text =
            FI.questionText(question);

        FI.UI.log(
            "Checking: " +
            text.slice(0, 100)
        );

        var resolved =
            FI.resolveAnswer(question);

        if (
            !resolved.supported ||
            resolved.answer == null
        ) {

            FI.STATE.unsupported[fingerprint] =
                true;

            FI.STATE.statistics.unsupported++;

            FI.UI.log(
                "Unsupported: " +
                text.slice(0, 70)
            );

            return false;
        }

        if (
            resolved.confidence <
            FI.CONFIG.minimumConfidence
        ) {

            FI.STATE.statistics.skipped++;

            FI.UI.log(
                "Low confidence: " +
                text.slice(0, 70)
            );

            return false;
        }

        // --------------------------------------------------------
        // IMPORTANT SAFETY RULE
        //
        // We only use explicitly supported profile-derived
        // answers. Nothing is guessed here.
        // --------------------------------------------------------

        FI.STATE.statistics.questionsProcessed++;

        var fillResult;

        try {

            fillResult =
                await FI.fillQuestion(
                    question,
                    resolved
                );

        } catch (error) {

            FI.STATE.statistics.errors++;

            FI.STATE.failed[fingerprint] =
                true;

            return false;
        }

        var success =
            !!(
                fillResult &&
                (
                    fillResult.success === true ||
                    fillResult === true
                )
            );

        // --------------------------------------------------------
        // VERIFICATION
        // --------------------------------------------------------

        if (
            success &&
            FI.CONFIG.verifyAfterFill
        ) {

            var verified =
                FI.verifyQuestion(
                    question,
                    resolved.answer
                );

            if (verified) {

                FI.STATE.statistics.verified++;

                FI.STATE.statistics.successful++;

                FI.STATE.successful[fingerprint] =
                    true;

                FI.UI.log(
                    "Filled: " +
                    text.slice(0, 70)
                );

                return true;

            }

            FI.STATE.statistics.verificationFailed++;

        }

        if (success) {

            FI.STATE.statistics.successful++;

            FI.STATE.successful[fingerprint] =
                true;

            FI.UI.log(
                "Filled: " +
                text.slice(0, 70)
            );

            return true;
        }

        FI.STATE.statistics.failed++;

        FI.STATE.failed[fingerprint] =
            true;

        FI.UI.log(
            "Fill failed: " +
            text.slice(0, 70)
        );

        return false;
    };

    // ============================================================
    // FULL SCAN
    // ============================================================

    FI.scanNow = async function () {

        if (!FI.CONFIG.enabled) {
            return;
        }

        if (FI.STATE.scanning) {
            return;
        }

        FI.STATE.scanning = true;

        FI.STATE.statistics.scans++;

        FI.UI.status(
            "Scanning " +
            FI.STATE.platform +
            "..."
        );

        try {

            var questions =
                FI.discoverQuestions();

            FI.UI.log(
                "Found " +
                questions.length +
                " question(s)."
            );

            for (
                var i = 0;
                i < questions.length;
                i++
            ) {

                if (!FI.CONFIG.enabled) {
                    break;
                }

                await FI.processQuestion(
                    questions[i]
                );
            }

        } catch (error) {

            FI.STATE.statistics.errors++;

            console.error(
                "[ISE] Scan error:",
                error
            );

        }

        FI.STATE.scanning = false;

        FI.UI.updateStats();

        FI.UI.status(
            FI.CONFIG.enabled ?
            "Monitoring..." :
            "Disabled"
        );
    };

    // ============================================================
    // RETRY FAILED
    // ============================================================

    FI.retryFailed = async function () {

        var questions =
            FI.discoverQuestions();

        FI.STATE.statistics.retries++;

        FI.UI.status(
            "Retrying..."
        );

        for (
            var i = 0;
            i < questions.length;
            i++
        ) {

            var fingerprint =
                FI.fingerprint(
                    questions[i]
                );

            if (
                FI.STATE.failed[fingerprint]
            ) {

                delete FI.STATE.failed[
                    fingerprint
                ];

                await FI.processQuestion(
                    questions[i]
                );
            }
        }

        FI.UI.updateStats();

        FI.UI.status(
            "Monitoring..."
        );
    };

    // ============================================================
    // MUTATION OBSERVER
    // ============================================================

    FI.startObserver = function () {

        if (
            !FI.CONFIG.processDynamicQuestions
        ) {
            return;
        }

        if (
            typeof MutationObserver ===
            "undefined"
        ) {
            return;
        }

        if (FI.STATE.observer) {
            return;
        }

        try {

            FI.STATE.observer =
                new MutationObserver(
                    function () {

                        if (
                            FI.STATE.mutationTimer
                        ) {
                            clearTimeout(
                                FI.STATE.mutationTimer
                            );
                        }

                        FI.STATE.mutationTimer =
                            setTimeout(
                                function () {

                                    if (
                                        FI.STATE.running
                                    ) {
                                        FI.scanNow();
                                    }

                                },
                                FI.CONFIG.mutationDelay
                            );

                    }
                );

            FI.STATE.observer.observe(
                document.documentElement ||
                document.body,
                {
                    childList: true,
                    subtree: true,
                    attributes: true
                }
            );

        } catch (error) {

            FI.STATE.statistics.errors++;

        }
    };

    // ============================================================
    // PERIODIC SCANNER
    // ============================================================

    FI.startScanner = function () {

        if (FI.STATE.scanTimer) {
            clearInterval(
                FI.STATE.scanTimer
            );
        }

        FI.STATE.scanTimer =
            setInterval(
                function () {

                    if (
                        FI.STATE.running &&
                        FI.CONFIG.continuous
                    ) {
                        FI.scanNow();
                    }

                },
                FI.CONFIG.scanInterval
            );
    };

    // ============================================================
    // START
    // ============================================================

    FI.start = function () {

        if (FI.STATE.started) {
            return;
        }

        FI.STATE.started = true;
        FI.STATE.running = true;

        // Make absolutely sure UI exists.
        FI.UI.create();

        FI.UI.status(
            "Starting..."
        );

        FI.UI.log(
            "Platform: " +
            FI.STATE.platform
        );

        console.log(
            "[ISE] Part 22 started."
        );

        FI.startObserver();

        FI.startScanner();

        setTimeout(
            function () {

                if (
                    FI.STATE.running
                ) {
                    FI.scanNow();
                }

            },
            FI.CONFIG.startupDelay
        );
    };

    // ============================================================
    // STOP
    // ============================================================

    FI.stop = function () {

        FI.STATE.running = false;

        if (FI.STATE.scanTimer) {

            clearInterval(
                FI.STATE.scanTimer
            );

            FI.STATE.scanTimer = null;
        }

        if (FI.STATE.mutationTimer) {

            clearTimeout(
                FI.STATE.mutationTimer
            );

            FI.STATE.mutationTimer = null;
        }

        if (FI.STATE.observer) {

            try {
                FI.STATE.observer.disconnect();
            } catch (error) {}

            FI.STATE.observer = null;
        }

        FI.UI.status(
            "Stopped"
        );
    };

    // ============================================================
    // RESTART
    // ============================================================

    FI.restart = function () {

        FI.stop();

        FI.STATE.started = false;

        setTimeout(
            function () {
                FI.start();
            },
            100
        );
    };

