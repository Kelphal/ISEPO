        var compound =
            splitCompound(
                text
            );

        if (
            !compound
        ) {
            return null;
        }

        /*
         * Only process compound questions when
         * each component can be independently
         * resolved.
         */

        var results = [];

        for (
            var i = 0;
            i < compound.parts.length;
            i++
        ) {

            var part =
                compound.parts[i];

            var result =
                resolveSimple(
                    part
                );

            if (
                !result ||
                !result.supported
            ) {
                return null;
            }

            results.push(
                result
            );
        }

        var booleans =
            results.every(
                function (result) {

                    return (
                        isYes(
                            result.answer
                        ) ||
                        isNo(
                            result.answer
                        )
                    );
                }
            );

        if (
            !booleans
        ) {
            return null;
        }

        var finalAnswer;

        if (
            compound.operator ===
            "AND"
        ) {

            engine.statistics.andQuestions++;

            finalAnswer =
                results.every(
                    function (result) {

                        return isYes(
                            result.answer
                        );
                    }
                )
                ?
                "Yes"
                :
                "No";
        }
        else {

            engine.statistics.orQuestions++;

            finalAnswer =
                results.some(
                    function (result) {

                        return isYes(
                            result.answer
                        );
                    }
                )
                ?
                "Yes"
                :
                "No";
        }

        var confidence =
            Math.min.apply(
                null,
                results.map(
                    function (result) {

                        return (
                            result.confidence ||
                            0
                        );
                    }
                )
            );

        return {

            supported:
                true,

            answer:
                finalAnswer,

            confidence:
                confidence,

            category:
                "compound",

            source:
                "logical." +
                compound.operator,

            components:
                results
        };
    }


