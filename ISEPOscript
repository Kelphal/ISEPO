/* ------------------------------------------------------------
   DETAILED QUESTION DIAGNOSTIC
   ------------------------------------------------------------ */

ISE.RecoveryEngine.inspectQuestion =
function(
    question
)
{
    if(
        !question
    )
    {
        return null;
    }

    var id =
        ISE.RecoveryEngine
            .questionId(
                question
            );

    var attempts =
        ISE.RecoveryEngine
            .attempts[id] ||
        null;

    var success =
        ISE.RecoveryEngine
            .successes[id] ||
        null;

    var failure =
        ISE.RecoveryEngine
            .failures[id] ||
        null;

    var resolution = null;

    if(
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine
            .resolve ===
        "function"
    )
    {
        try
        {
            resolution =
                ISE.AnswerEngine
                    .resolve(
                        question.text
                    );
        }
        catch(error)
        {
            resolution = null;
        }
    }

    var controls = [];

    if(
        ISE.PlatformEngine &&
        typeof ISE.PlatformEngine
            .controlsForQuestion ===
        "function"
    )
    {
        try
        {
            controls =
                ISE.PlatformEngine
                    .controlsForQuestion(
                        question
                    );
        }
        catch(error)
        {
            controls = [];
        }
    }

    var controlDetails = [];

    for(
        var i = 0;
        i < controls.length;
        i++
    )
    {
        var control =
            controls[i];

        controlDetails.push(
        {
            type:
                ISE.PlatformEngine
                    ? ISE.PlatformEngine
                        .controlType(
                            control
                        )
                    : "",

            description:
                ISE.PlatformEngine
                    ? ISE.PlatformEngine
                        .description(
                            control
                        )
                    : "",

            value:
                ISE.RecoveryEngine
                    .readControl(
                        control
                    ),

            disabled:
                control.disabled ===
                true
        });
    }

    return {
        id:
            id,

        text:
            question.text ||
            "",

        category:
            question.category ||
            "",

        resolution:
            resolution,

        controls:
            controlDetails,

        attempts:
            attempts,

        success:
            success,

        failure:
            failure
    };
};


/* ------------------------------------------------------------
   UNSUPPORTED QUESTION REPORT
   ------------------------------------------------------------ */

ISE.RecoveryEngine.unsupportedReport =
function()
{
    var report = [];

    var keys =
        Object.keys(
            ISE.RecoveryEngine
                .failures
        );

    for(
        var i = 0;
        i < keys.length;
        i++
    )
    {
        var failure =
            ISE.RecoveryEngine
                .failures[
                    keys[i]
                ];

        if(
            !failure
        )
        {
            continue;
        }

        var type =
            ISE.RecoveryEngine
                .classifyFailure(
                    failure.result
                );

        if(
            type ===
            "unsupported"
        )
        {
            report.push(
            {
                id:
                    keys[i],

                reason:
                    failure.reason,

                time:
                    failure.time
            });
        }
    }

    return report;
};


/* ------------------------------------------------------------
   VERIFICATION REPORT
   ------------------------------------------------------------ */

ISE.RecoveryEngine.verificationReport =
function()
{
    var keys =
        Object.keys(
            ISE.RecoveryEngine
                .successes
        );

    var report = [];

    for(
        var i = 0;
        i < keys.length;
        i++
