// GENERAL CLASSIFIER
// ================================================================

ISE.classifier.classify =
function (text) {

    const normalized =
        ISE.text.expandContractions(
            text
        );

    if (!normalized) {

        return {
            category: "unknown",
            confidence: 0,
            field: null
        };
    }

    // Medical diagnosis receives
    // priority because it has a
    // specialized semantic engine.

    const medical =
        ISE.classifier
            .detectMedicalDiagnosis(
                normalized
            );

    if (
        medical.matched &&
        medical.confidence >= 0.48
    ) {

        return {
            category:
                medical.category,

            confidence:
                medical.confidence,

            field:
                medical.profileField
        };
    }

    let best = {

        category: "unknown",

        confidence: 0,

        field: null,

        evidence: []
    };

    for (
        const [
            category,
            intent
        ]
        of Object.entries(
            ISE.INTENTS
        )
    ) {

        let score = 0;

        const evidence = [];

        for (
            const phrase
            of intent.phrases
        ) {

            const normalizedPhrase =
                ISE.text.normalize(
                    phrase
                );

            if (
                normalized.includes(
                    normalizedPhrase
                )
            ) {

                score +=
                    normalizedPhrase.length >
                    15
                        ? 0.50
                        : 0.30;

                evidence.push(
                    normalizedPhrase
                );
            }
        }

        const synonymGroups = {

            date_of_birth:
                ["birth"],

            age:
                ["age"],

            gender:
                ["gender"],

            sex:
                ["sex"],

            marital_status:
                ["married"],

            children:
                ["children"],

            vehicles:
                ["vehicle"],

            employment:
                ["employment"],

            education:
                ["education"],

            income:
                ["income"],

            location:
                ["location"]
        };

        const group =
            synonymGroups[
                category
            ];

        if (group) {

            for (
                const synonym
                of group
            ) {

                if (
                    normalized.includes(
                        synonym
                    )
                ) {

                    score += 0.18;

                    evidence.push(
                        synonym
                    );
                }
            }
        }

        if (
            normalized.includes("?")
        ) {

            score += 0.05;
        }

        if (
            score >
            best.confidence
        ) {

            best = {

                category,

                confidence:
                    Math.min(
                        score,
                        1
                    ),

                field:
                    intent.field,

                evidence
            };
        }
    }

    return best;
};


// ================================================================
// PROFILE VALUE RESOLUTION
// ================================================================

ISE.profile = {};

ISE.profile.get =
function (field) {

    if (
        !field
    ) {
        return null;
    }

    if (
        Object.prototype.hasOwnProperty.call(
            ISE.PROFILE,
            field
        )
    ) {

        return ISE.PROFILE[field];
    }

    if (
        ISE.PROFILE.custom &&
        Object.prototype.hasOwnProperty.call(
            ISE.PROFILE.custom,
            field
        )
    ) {

        return ISE.PROFILE.custom[field];
    }

    return null;
};


ISE.profile.isConfigured =
function (field) {

    const value =
        ISE.profile.get(
            field
        );

    return !(
        value === null ||
        value === undefined ||
        value === ""
    );
};


// ================================================================
// DATE MATH
// ================================================================

ISE.date = {};

ISE.date.parse =
function (value) {

    if (
        typeof value !==
        "string"
    ) {
        return null;
    }

    const match =
        value.match(
            /^(\d{4})-(\d{2})-(\d{2})$/
        );

    if (!match) {
        return null;
    }

    const year =
        Number(match[1]);

    const month =
        Number(match[2]);

    const day =
        Number(match[3]);

    if (
        !Number.isInteger(year) ||
        !Number.isInteger(month) ||
        !Number.isInteger(day)
    ) {
        return null;
    }

    return {
        year,
        month,
        day
    };
};


ISE.date.age =
function (date) {

    if (!date) {
        return null;
    }

    const now =
        new Date();

    let age =
        now.getFullYear() -
        date.year;

    const currentMonth =
        now.getMonth() + 1;

    const currentDay =
        now.getDate();

    if (
        currentMonth <
        date.month
    ) {

        age--;
    }

    else if (
        currentMonth ===
        date.month &&
        currentDay <
        date.day
    ) {

        age--;
    }

    return age;
};


// ================================================================
// ANSWER OBJECT CREATION
// ================================================================

ISE.answer = {};

ISE.answer.unsupported =
function (reason) {

    return {

        supported: false,

        reason:
            reason ||
            "No explicit profile value."
    };
};


ISE.answer.supported =
function (
    type,
    value,
    metadata
) {

    return Object.assign({

        supported: true,

        type,

        value

    }, metadata || {});
};


// ================================================================
// SEMANTIC ANSWER RESOLVER
// ================================================================

ISE.answer.resolve =
function (
    classification,
    questionText
) {

    if (
        !classification ||
        classification.category ===
        "unknown"
    ) {

        return ISE.answer.unsupported(
            "Question could not be classified."
        );
    }

    // ------------------------------------------------------------
    // MEDICAL DIAGNOSIS
    // ------------------------------------------------------------

    if (
        classification.category ===
        "medical_diagnosis"
    ) {

        const conditions =
            ISE.PROFILE
                .diagnosedConditions;

        if (
            !Array.isArray(
                conditions
            )
        ) {

            return ISE.answer.unsupported(
                "diagnosedConditions is not configured."
            );
        }

        if (
            conditions.length === 0
        ) {

            return ISE.answer.supported(
                "none",
                "none",
                {
                    semantic:
                        "none_of_the_above",

                    explicit:
                        true
                }
            );
        }

        return ISE.answer.supported(
            "medical_conditions",
            conditions,
            {
                semantic:
                    "configured_conditions",

                explicit:
                    true
            }
        );
    }

    // ------------------------------------------------------------
    // DATE OF BIRTH
    // ------------------------------------------------------------

    if (
        classification.category ===
        "date_of_birth"
    ) {

        const date =
            ISE.date.parse(
                ISE.PROFILE
                    .dateOfBirth
            );

        if (!date) {

            return ISE.answer.unsupported(
                "Invalid dateOfBirth."
            );
        }

        return ISE.answer.supported(
            "date",
            date
        );
    }

    // ------------------------------------------------------------
    // AGE
    // ------------------------------------------------------------

    if (
        classification.category ===
        "age"
    ) {

        const date =
            ISE.date.parse(
                ISE.PROFILE
                    .dateOfBirth
            );

        const derivedAge =
            ISE.date.age(
                date
            );

        if (
            derivedAge === null
        ) {

            return ISE.answer.unsupported(
                "Age could not be derived."
            );
        }

        return ISE.answer.supported(
            "number",
            derivedAge,
            {
                derivedFrom:
                    "dateOfBirth"
            }
        );
    }

    // ------------------------------------------------------------
    // ALL OTHER EXPLICIT PROFILE FIELDS
    // ------------------------------------------------------------

    const field =
        classification.field;

    if (
        !field
    ) {

        return ISE.answer.unsupported(
            "No profile field."
        );
    }

    if (
        !ISE.profile.isConfigured(
            field
        )
    ) {

        return ISE.answer.unsupported(
            "Profile field is not configured: " +
            field
        );
    }

    return ISE.answer.supported(
        typeof ISE.profile.get(field) ===
        "number"
            ? "number"
            : "text",

        ISE.profile.get(field)
    );
};


// ================================================================
// MEDICAL ANSWER SEMANTICS
// ================================================================

ISE.medical = {};

ISE.medical.shouldSelectNone =
function () {

    return (
        Array.isArray(
            ISE.PROFILE
                .diagnosedConditions
        ) &&
        ISE.PROFILE
            .diagnosedConditions
            .length === 0
    );
};


ISE.medical.matchesNoneControl =
function (
    controlText
) {

    const normalized =
        ISE.text.expandContractions(
            controlText
        );

    if (!normalized) {
        return false;
    }

    for (
        const phrase
        of ISE.MEDICAL.noneAnswers
    ) {

        const target =
            ISE.text.normalize(
                phrase
            );

        if (
            normalized ===
            target
        ) {
            return true;
        }

        if (
            normalized.startsWith(
                target + " "
            )
        ) {
            return true;
        }
    }

    return false;
};


ISE.medical.isIndividualCondition =
function (
    controlText
) {

    const normalized =
        ISE.text.normalize(
            controlText
        );

    if (!normalized) {
        return false;
    }

    if (
        ISE.medical
            .matchesNoneControl(
                normalized
            )
    ) {
        return false;
    }

    return (
        normalized.includes(
            "diabetes"
        ) ||
        normalized.includes(
            "asthma"
        ) ||
        normalized.includes(
            "cancer"
        ) ||
        normalized.includes(
            "arthritis"
        ) ||
        normalized.includes(
            "depression"
        ) ||
        normalized.includes(
            "anxiety"
        ) ||
        normalized.includes(
            "heart disease"
        ) ||
        normalized.includes(
            "high blood pressure"
        ) ||
        normalized.includes(
            "hypertension"
        ) ||
        normalized.includes(
            "copd"
        ) ||
        normalized.includes(
            "cholesterol"
        )
    );
};


// ================================================================
// QUESTION EVIDENCE MODEL
// ================================================================

ISE.question = {};

ISE.question.createEvidence =
function () {

    return {

        questionMark: 0,

        interrogative: 0,

        semantic: 0,

        container: 0,

        controlAssociation: 0,

        answerChoicePenalty: 0,

        shortTextPenalty: 0,

        total: 0
    };
};


ISE.question.score =
function (
    text,
    element
) {

    const evidence =
        ISE.question
            .createEvidence();

    const normalized =
        ISE.text.expandContractions(
            text
        );

    if (!normalized) {
        return evidence;
    }

    if (
        normalized.includes("?")
    ) {

        evidence.questionMark =
            0.20;
    }

    const firstWord =
        ISE.text
            .tokens(normalized)[0];

    if (
        ISE.language
            .interrogatives
            .includes(firstWord)
    ) {

        evidence.interrogative =
            0.16;
    }

    const classification =
        ISE.classifier
            .classify(normalized);

    evidence.semantic =
        Math.min(
            classification.confidence *
            0.60,
            0.60
        );

    if (
        element &&
        typeof element
            .querySelector ===
            "function"
    ) {

        if (
            element.querySelector(
                "input,select,textarea,button,[role='radio'],[role='checkbox'],[role='option'],[role='combobox']"
            )
        ) {

            evidence.controlAssociation =
                0.16;
        }
    }

    if (
        normalized.length <
        8
    ) {

        evidence.shortTextPenalty =
            0.20;
    }

    if (
        ISE.semantic.isYes(
            normalized
        ) ||
        ISE.semantic.isNo(
            normalized
        ) ||
        ISE.semantic.isNoneAnswer(
            normalized
        )
    ) {

        evidence.answerChoicePenalty =
            0.65;
    }

    evidence.total =
        Math.max(
            0,
            evidence.questionMark +
            evidence.interrogative +
            evidence.semantic +
            evidence.container +
            evidence.controlAssociation -
            evidence.answerChoicePenalty -
            evidence.shortTextPenalty
        );

    return evidence;
};


