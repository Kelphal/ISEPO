    /* ============================================================
       CHOICE RANGE MATCHING
       ============================================================ */

    function scoreRangeChoice(
        expectedValue,
        choiceText
    ) {

        var range =
            parseRange(
                choiceText
            );

        if (!range) {
            return 0;
        }

        if (
            expectedValue >=
            range.min &&
            expectedValue <=
            range.max
        ) {

            return 100;
        }

        return 0;
    }


    /* ============================================================
       TEXT SIMILARITY
       ============================================================ */

    function tokenize(
        text
    ) {

        return unique(
            normalize(
                text
            )
                .split(
                    /\s+/
                )
                .filter(
                    function (token) {

                        return (
                            token.length >
                            1
                        );
                    }
                )
        );
    }


    function similarity(
        a,
        b
    ) {

        var first =
            tokenize(
                a
            );

        var second =
            tokenize(
                b
            );

        if (
            !first.length ||
            !second.length
        ) {
            return 0;
        }

        var matches =
            0;

        for (
            var i = 0;
            i < first.length;
            i++
        ) {

            if (
                second.indexOf(
                    first[i]
                ) !== -1
            ) {
                matches++;
            }
        }

        return (
            matches /
            Math.max(
                first.length,
                second.length
            )
        );
    }


    /* ============================================================
       ANSWER CHOICE SCORING
       ============================================================ */

    function scoreChoice(
        expected,
        choice,
        questionType,
        profileValue
    ) {

        var choiceText =
            cleanText(
                choice.text
            );

        var expectedText =
            cleanText(
                expected
            );

        var normalizedChoice =
            normalize(
                choiceText
            );

        var normalizedExpected =
            normalize(
                expectedText
            );

        var score =
            0;

        /*
         * Exact match.
         */

        if (
            normalizedChoice ===
            normalizedExpected
        ) {

            score += 100;
        }

        /*
         * Yes / No semantic matching.
         */

        if (
            isYes(
                expectedText
            ) &&
            normalize(
                choiceText
            ) ===
            "yes"
        ) {

            score += 100;
        }

        if (
            isNo(
                expectedText
            ) &&
            normalize(
                choiceText
            ) ===
            "no"
        ) {

            score += 100;
        }

        /*
         * Numeric expected answer.
         */

        var expectedNumber =
            parseNumeric(
                expectedText
            );

        if (
            expectedNumber !== null
        ) {

            var choiceNumber =
                parseNumeric(
                    choiceText
                );

            if (
                choiceNumber !== null &&
                choiceNumber ===
                expectedNumber
            ) {

                score += 95;
            }

            score +=
                scoreRangeChoice(
                    expectedNumber,
                    choiceText
                );
        }

        /*
         * Profile-aware range matching.
         */

        if (
            profileValue &&
            typeof profileValue.value ===
            "number"
        ) {

            score +=
                scoreRangeChoice(
                    profileValue.value,
                    choiceText
                );
        }

        /*
         * Text similarity.
         */

        score +=
            similarity(
                expectedText,
                choiceText
            ) *
            50;

        /*
         * Avoid selecting "other" unless
         * it was explicitly requested.
         */

        if (
            containsAny(
                normalizedChoice,
                [
                    "other",
                    "none",
                    "not applicable",
                    "don't know",
                    "not sure",
                    "prefer not"
                ]
            )
        ) {

            score -= 20;
        }

        return score;
    }


    /* ============================================================
       FIND BEST CHOICE
       ============================================================ */

    function findBestChoice(
        expected,
        choices,
        questionType,
        profileValue
    ) {

        var best =
            null;

        var bestScore =
            -Infinity;

        for (
            var i = 0;
            i < choices.length;
            i++
        ) {

            var score =
                scoreChoice(
                    expected,
                    choices[i],
                    questionType,
                    profileValue
                );

            if (
                score >
                bestScore
            ) {

                bestScore =
                    score;

                best =
                    choices[i];
            }
        }

        if (
            !best
        ) {

            return null;
        }

        if (
            bestScore <
            45
        ) {

            engine.statistics
                .failedChoiceMatches++;

            return null;
        }

        engine.statistics
            .matchedChoices++;

        return {

            choice:
                best,

            score:
                bestScore
        };
    }


    /* ============================================================
       ANSWER RESOLUTION
       ============================================================ */

    function resolveAnswer(
        questionText
    ) {

        /*
         * Logical reasoning gets first chance.
         */

        if (
            ISE.LogicalReasoning &&
            typeof ISE.LogicalReasoning.safeResolve ===
            "function"
        ) {

            var logical =
                ISE.LogicalReasoning
                    .safeResolve(
                        questionText
                    );

            if (
                logical &&
                logical.supported
            ) {

                return logical;
            }
        }

        /*
         * Experience intelligence.
         */

        if (
            ISE.ExperienceIntelligence &&
            typeof ISE.ExperienceIntelligence.safeResolve ===
            "function"
        ) {

            var experience =
                ISE.ExperienceIntelligence
                    .safeResolve(
                        questionText
                    );

            if (
                experience &&
                experience.supported
            ) {

                return experience;
            }
        }

        /*
         * Advanced semantics.
         */

        if (
            ISE.AdvancedSemantics &&
            typeof ISE.AdvancedSemantics.safeResolve ===
            "function"
        ) {

            var advanced =
                ISE.AdvancedSemantics
                    .safeResolve(
                        questionText
                    );

            if (
                advanced &&
                advanced.supported
            ) {

                return advanced;
            }
        }

        /*
         * Nothing supported.
         */

        return {

            supported:
                false,

            reason:
                "No configured or derived answer"
        };
    }


    /* ============================================================
       SELECT FILLING
       ============================================================ */

    function setSelect(
        select,
        option
    ) {

        if (
            !select ||
            !option
        ) {
            return false;
        }

        try {

            var options =
                select.options;

            for (
                var i = 0;
                i < options.length;
                i++
            ) {

                if (
                    options[i] ===
                    option
                ) {

                    select.selectedIndex =
                        i;

                    try {

                        options[i]
                            .selected =
                            true;

                    }
                    catch (error) {
                    }

                    try {

                        select.dispatchEvent(
                            new Event(
                                "input",
                                {
                                    bubbles:
                                        true
                                }
                            )
                        );

                    }
                    catch (error) {
                    }

                    try {

                        select.dispatchEvent(
                            new Event(
                                "change",
                                {
                                    bubbles:
                                        true
                                }
                            )
                        );

                    }
                    catch (error) {
                    }

                    return true;
                }
            }

        }
        catch (error) {
        }

        return false;
    }


    /* ============================================================
       CONTROL CLICKING
       ============================================================ */

    function clickControl(
        element
    ) {

        if (
            !element ||
            isDisabled(
                element
            )
        ) {
            return false;
        }

        try {

            element.click();

            return true;

        }
        catch (error) {
        }

        try {

            element.dispatchEvent(
                new MouseEvent(
                    "click",
                    {
                        bubbles:
                            true,

                        cancelable:
                            true,

                        view:
                            window
                    }
                )
            );

            return true;

        }
        catch (error) {
        }

        return false;
    }


