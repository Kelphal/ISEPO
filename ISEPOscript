/* ------------------------------------------------------------
   CONTROL DESCRIPTION
   ------------------------------------------------------------ */

ISE.PlatformEngine.description =
function (
    element
) {

    if (!element) {
        return "";
    }

    var pieces = [];

    var aria =
        ISE.PlatformEngine
            .attr(
                element,
                "aria-label"
            );

    if (aria) {
        pieces.push(
            aria
        );
    }

    var labelledBy =
        ISE.PlatformEngine
            .attr(
                element,
                "aria-labelledby"
            );

    if (
        labelledBy
    ) {

        var ids =
            labelledBy
                .split(
                    /\s+/
                );

        for (
            var i = 0;
            i < ids.length;
            i++
        ) {

            try {

                var labelNode =
                    document.getElementById(
                        ids[i]
                    );

                if (
                    labelNode
                ) {

                    pieces.push(
                        ISE.PlatformEngine
                            .text(
                                labelNode
                            )
                    );
                }

            } catch (error) {}
        }
    }

    var title =
        ISE.PlatformEngine
            .attr(
                element,
                "title"
            );

    if (title) {
        pieces.push(
            title
        );
    }

    var placeholder =
        ISE.PlatformEngine
            .attr(
                element,
                "placeholder"
            );

    if (placeholder) {
        pieces.push(
            placeholder
        );
    }

    var value =
        ISE.PlatformEngine
            .controlValue(
                element
            );

    if (value) {
        pieces.push(
            value
        );
    }

    var label =
        ISE.PlatformEngine
            .labelFor(
                element
            );

    if (label) {
        pieces.push(
            label
        );
    }

    var directText =
        ISE.PlatformEngine
            .text(
                element
            );

    if (
        directText &&
        directText.length <
        500
    ) {

        pieces.push(
            directText
        );
    }

    return ISE.PlatformEngine
        .normalize(
            pieces.join(
                " "
            )
        );
};


/* ------------------------------------------------------------
   CONTROL COLLECTION
   ------------------------------------------------------------ */

ISE.PlatformEngine.collectControls =
function (
    root
) {

    var controls = [];

    if (!root) {
        return controls;
    }

    try {

        if (
            root.matches &&
            root.matches(
                ISE.PlatformEngine
                    .commonSelectors
            )
        ) {

            controls.push(
                root
            );
        }

    } catch (error) {}

    try {

        var nodes =
            root.querySelectorAll(
                ISE.PlatformEngine
                    .commonSelectors
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            if (
                ISE.PlatformEngine
                    .visible(
                        nodes[i]
                    )
            ) {

                controls.push(
                    nodes[i]
                );
            }
        }

    } catch (error) {}

    controls =
        ISE.PlatformEngine
            .unique(
                controls
            );

    ISE.PlatformEngine
        .statistics
        .controlsFound +=
        controls.length;

    return controls;
};


/* ------------------------------------------------------------
   UNIQUE
   ------------------------------------------------------------ */

ISE.PlatformEngine.unique =
function (
    array
) {

    var output = [];

    var seen =
        new Set();

    for (
        var i = 0;
        i < array.length;
        i++
    ) {

        if (
            !array[i] ||
            seen.has(
                array[i]
            )
        ) {
            continue;
        }

        seen.add(
            array[i]
        );

        output.push(
            array[i]
        );
    }

    return output;
};


