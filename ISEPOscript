/* ------------------------------------------------------------
   BASIC HELPERS
   ------------------------------------------------------------ */

ISE.RecoveryEngine.normalize =
function(value)
{
    if(
        ISE.text &&
        typeof ISE.text.normalize ===
        "function"
    )
    {
        return ISE.text.normalize(
            value || ""
        );
    }

    return String(
        value || ""
    )
    .toLowerCase()
    .replace(/\s+/g," ")
    .trim();
};


ISE.RecoveryEngine.now =
function()
{
    return Date.now();
};


ISE.RecoveryEngine.delay =
function(
    milliseconds,
    callback
)
{
    if(
        typeof callback !==
        "function"
    )
    {
        return null;
    }

    var timer =
        setTimeout(
            callback,
            milliseconds
        );

    ISE.RecoveryEngine
        .timers
        .push(
            timer
        );

    return timer;
};


/* ------------------------------------------------------------
   SAFE OBJECT COPY
   ------------------------------------------------------------ */

ISE.RecoveryEngine.copy =
function(
    object
)
{
    if(
        !object ||
        typeof object !==
        "object"
    )
    {
        return object;
    }

    try
    {
        return Object.assign(
            {},
            object
        );
    }
    catch(error)
    {
        return object;
    }
};


/* ------------------------------------------------------------
   QUESTION ID
   ------------------------------------------------------------ */

ISE.RecoveryEngine.questionId =
function(
    question
)
{
    if(
        !question
    )
    {
        return "";
    }

    if(
        question.recoveryId
    )
    {
        return String(
            question.recoveryId
        );
    }

    var text =
        question.text ||
        question.question ||
        "";

    text =
        ISE.RecoveryEngine
            .normalize(
                text
            );

    var category =
        question.category ||
        "";

    var container =
        question.container ||
        question.element ||
        null;

    var containerId = "";

    try
    {
        if(
            container
        )
        {
            containerId =
                container.id ||
                container.getAttribute(
                    "data-question-id"
                ) ||
                container.getAttribute(
                    "data-id"
                ) ||
                "";
        }
    }
    catch(error)
    {
        containerId = "";
    }

    return [
        category,
        text,
        containerId
    ]
    .join("::");
};


/* ------------------------------------------------------------
   ANSWER NORMALIZATION
   ------------------------------------------------------------ */

ISE.RecoveryEngine.answerText =
function(
    answer
)
{
    if(
        answer ===
        null ||
        typeof answer ===
        "undefined"
    )
    {
        return "";
    }

    if(
        typeof answer ===
        "object"
    )
    {
        if(
            answer.value !==
            undefined
        )
        {
            return String(
                answer.value
            );
        }

        if(
            answer.text !==
            undefined
        )
        {
            return String(
                answer.text
            );
        }

        if(
            answer.answer !==
            undefined
        )
        {
            return String(
                answer.answer
            );
        }
    }

    return String(
        answer
    );
};


/* ------------------------------------------------------------
   ANSWER EQUIVALENCE
   ------------------------------------------------------------ */

ISE.RecoveryEngine.answersEquivalent =
function(
    actual,
    expected
)
{
    var a =
        ISE.RecoveryEngine
            .normalize(
                ISE.RecoveryEngine
                    .answerText(
                        actual
                    )
            );

    var b =
        ISE.RecoveryEngine
            .normalize(
                ISE.RecoveryEngine
                    .answerText(
                        expected
                    )
            );

    if(
        a === b
    )
    {
        return true;
    }

    if(
        !a ||
        !b
    )
    {
        return false;
    }

    if(
        ISE.semantic &&
        typeof ISE.semantic.isYes ===
        "function" &&
        typeof ISE.semantic.isNo ===
        "function"
    )
    {
        var ay =
            ISE.semantic.isYes(a);

        var by =
            ISE.semantic.isYes(b);

        if(
            ay &&
            by
        )
        {
            return true;
        }

        var an =
            ISE.semantic.isNo(a);

        var bn =
            ISE.semantic.isNo(b);

        if(
            an &&
            bn
        )
        {
            return true;
        }
    }

    if(
        a.indexOf(b) !== -1 ||
        b.indexOf(a) !== -1
    )
    {
        return true;
    }

    return false;
};


/* ------------------------------------------------------------
   ELEMENT HELPERS
   ------------------------------------------------------------ */

ISE.RecoveryEngine.tag =
function(
    element
)
{
    if(
        !element
    )
    {
        return "";
    }

    return String(
        element.tagName ||
        ""
    ).toLowerCase();
};


ISE.RecoveryEngine.attr =
function(
    element,
    name
)
{
    if(
        !element ||
        !name
    )
    {
        return "";
    }

    try
    {
        return String(
            element.getAttribute(
                name
            ) || ""
        ).trim();
    }
    catch(error)
    {
        return "";
    }
};


ISE.RecoveryEngine.visible =
function(
    element
)
{
    if(
        !element
    )
    {
        return false;
    }

    try
    {
        if(
            element.hidden ||
            element.disabled
        )
        {
            return false;
        }

        var style =
            window.getComputedStyle(
                element
            );

        if(
            style.display ===
            "none" ||
            style.visibility ===
            "hidden"
        )
        {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );
    }
    catch(error)
    {
        return true;
    }
};


/* ------------------------------------------------------------
   CONTROL CURRENT VALUE
   ------------------------------------------------------------ */

ISE.RecoveryEngine.readControl =
function(
    element
)
{
    if(
        !element
    )
    {
        return "";
    }

    var tag =
        ISE.RecoveryEngine
            .tag(
                element
            );

    var type =
        ISE.RecoveryEngine
            .attr(
                element,
                "type"
            )
            .toLowerCase();

    if(
        tag ===
        "select"
    )
    {
        try
        {
            var option =
                element.options[
                    element.selectedIndex
                ];

            if(
                option
            )
            {
                return (
                    option.textContent ||
                    option.value ||
                    ""
                );
            }
        }
        catch(error)
        {
        }

        return element.value ||
            "";
    }

    if(
        type ===
        "radio" ||
        type ===
        "checkbox"
    )
    {
        try
        {
            if(
                element.checked
            )
            {
                return (
                    element.value ||
                    "true"
                );
            }

            return "false";
        }
        catch(error)
        {
            return "";
        }
    }

    var ariaChecked =
        ISE.RecoveryEngine
            .attr(
                element,
                "aria-checked"
            );

    if(
        ariaChecked
    )
    {
        return ariaChecked;
    }

    var ariaSelected =
        ISE.RecoveryEngine
            .attr(
                element,
                "aria-selected"
            );

    if(
        ariaSelected
    )
    {
        return ariaSelected;
    }

    try
    {
        if(
            element.value !==
            undefined
        )
        {
            return String(
                element.value
            );
        }
    }
    catch(error)
    {
    }

    var dataValue =
        ISE.RecoveryEngine
            .attr(
                element,
                "data-value"
            );

    if(
        dataValue
    )
    {
        return dataValue;
    }

    var dataAnswer =
        ISE.RecoveryEngine
            .attr(
                element,
                "data-answer"
            );

    if(
        dataAnswer
    )
    {
        return dataAnswer;
    }

    return "";
};


/* ------------------------------------------------------------
   QUESTION SNAPSHOT
   ------------------------------------------------------------ */

ISE.RecoveryEngine.snapshot =
function(
    question
)
{
    var snapshot =
    {
