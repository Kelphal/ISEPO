};


/* ------------------------------------------------------------
   ATTEMPT RECORD
   ------------------------------------------------------------ */

ISE.RecoveryEngine.recordAttempt =
function(
    question,
    answer,
    result
)
{
    var id =
        ISE.RecoveryEngine
            .questionId(
                question
            );

    if(
        !id
    )
    {
        return;
    }

    if(
        !ISE.RecoveryEngine
            .attempts[id]
    )
    {
        ISE.RecoveryEngine
            .attempts[id] =
        {
            count: 0,
            first:
                ISE.RecoveryEngine
                    .now(),

            last:
                0,

            answer:
                answer,

            results: []
        };
    }

    var record =
        ISE.RecoveryEngine
            .attempts[id];

    record.count++;

    record.last =
        ISE.RecoveryEngine
            .now();

    record.answer =
        answer;

    record.results.push(
        {
            time:
                ISE.RecoveryEngine
                    .now(),

            result:
                result || null
        }
    );

    if(
        record.results.length >
        20
    )
    {
        record.results.shift();
    }

    ISE.RecoveryEngine
        .statistics
        .attempts++;
};


