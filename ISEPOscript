/* ------------------------------------------------------------
   NUMBER EXTRACTION
   ------------------------------------------------------------ */

ISE.SemanticEngine.extractNumbers = function (text) {

    var normalized = ISE.SemanticEngine.normalize(text);
    var matches = normalized.match(/\d+(?:\.\d+)?/g);

    if (!matches) {
        return [];
    }

    return matches.map(function (value) {
        return Number(value);
    }).filter(function (value) {
        return Number.isFinite(value);
    });
};


ISE.SemanticEngine.extractFirstNumber = function (text) {

    var values = ISE.SemanticEngine.extractNumbers(text);

    if (!values.length) {
        return null;
    }

    return values[0];
};


/* ------------------------------------------------------------
   MONEY PARSING
   ------------------------------------------------------------ */

ISE.SemanticEngine.parseMoney = function (text) {

    if (text === null || text === undefined) {
        return null;
    }

    var value = String(text)
        .toLowerCase()
        .replace(/,/g, "")
        .replace(/\$/g, "")
        .trim();

    var match = value.match(/(\d+(?:\.\d+)?)\s*(k|thousand|m|million)?/i);

    if (!match) {
        return null;
    }

    var number = Number(match[1]);

    if (!Number.isFinite(number)) {
        return null;
    }

    var suffix = (match[2] || "").toLowerCase();

    if (suffix === "k" || suffix === "thousand") {
        number *= 1000;
    }

    if (suffix === "m" || suffix === "million") {
        number *= 1000000;
    }

    return number;
};


/* ------------------------------------------------------------
   RANGE PARSING
   ------------------------------------------------------------ */

ISE.SemanticEngine.parseRange = function (text) {

    var normalized = ISE.SemanticEngine.normalize(text);

    if (!normalized) {
        return null;
    }

    var numbers = ISE.SemanticEngine.extractNumbers(normalized);

    if (!numbers.length) {
        return null;
    }

    var lower = null;
    var upper = null;

    if (
        normalized.indexOf("under") !== -1 ||
        normalized.indexOf("less than") !== -1 ||
        normalized.indexOf("below") !== -1
    ) {
        upper = numbers[0] - 0.000001;

        return {
            lower: null,
            upper: upper,
            type: "upper"
        };
    }

    if (
        normalized.indexOf("over") !== -1 ||
        normalized.indexOf("more than") !== -1 ||
        normalized.indexOf("above") !== -1
    ) {
        lower = numbers[0];

        return {
            lower: lower,
            upper: null,
            type: "lower"
        };
    }

    if (
        normalized.indexOf("or more") !== -1 ||
        normalized.indexOf("and over") !== -1 ||
        normalized.indexOf("+") !== -1
    ) {
        lower = numbers[0];

        return {
            lower: lower,
            upper: null,
            type: "lower"
        };
    }

    if (numbers.length >= 2) {

        lower = Math.min(numbers[0], numbers[1]);
        upper = Math.max(numbers[0], numbers[1]);

        return {
            lower: lower,
            upper: upper,
            type: "between"
        };
    }

    return {
        lower: numbers[0],
        upper: numbers[0],
        type: "exact"
    };
};


ISE.SemanticEngine.rangeContains = function (range, value) {

    if (!range || !Number.isFinite(value)) {
        return false;
    }

    if (
        range.lower !== null &&
        range.lower !== undefined &&
        value < range.lower
    ) {
        return false;
    }

    if (
        range.upper !== null &&
        range.upper !== undefined &&
        value > range.upper
    ) {
        return false;
    }

    return true;
};


/* ------------------------------------------------------------
   AGE RANGE HANDLING
   ------------------------------------------------------------ */

ISE.SemanticEngine.ageRange = function (text) {

    var normalized = ISE.SemanticEngine.normalize(text);

    var direct = ISE.SemanticEngine.parseRange(normalized);

    if (direct) {
        return direct;
    }

    var decade = normalized.match(/(\d{2})\s*(?:to|through|thru)\s*(\d{2})/);

    if (decade) {

        return {
            lower: Number(decade[1]),
            upper: Number(decade[2]),
            type: "between"
        };
    }

    var plus = normalized.match(/(\d{2})\s*(?:and over|\+|or older)/);

    if (plus) {

        return {
            lower: Number(plus[1]),
            upper: null,
            type: "lower"
        };
    }

    return null;
};


/* ------------------------------------------------------------
   DATE PARSING
   ------------------------------------------------------------ */

ISE.SemanticEngine.parseDate = function (value) {

    if (!value) {
        return null;
    }

    var date = new Date(value);

    if (!Number.isNaN(date.getTime())) {
        return date;
    }

    var match = String(value).match(
        /^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/
    );

    if (!match) {
        return null;
    }

    var month = Number(match[1]);
    var day = Number(match[2]);
    var year = Number(match[3]);

    if (year < 100) {
        year += 2000;
    }

    var result = new Date(year, month - 1, day);

    if (Number.isNaN(result.getTime())) {
        return null;
    }

    return result;
};


