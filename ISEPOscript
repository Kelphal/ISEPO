                    var aliases = {
                        "married": ["married", "married or living with partner"],
                        "male": ["male", "man", "boy"],
                        "full-time": ["full time", "full-time", "employed full time"],
                        "master's degree": ["masters", "master's", "master degree", "graduate degree"],
                        "technology": ["technology", "information technology", "it"]
                    };
                    var list = aliases[target] || [];
                    for (var i = 0; i < list.length; i++) {
                        if (a.indexOf(this.normalize(list[i])) >= 0) score = 0.96;
                    }
                }
            }
            return { score: score, value: value, source: derived.source };
        },

        resolveChoices: function (question, choices) {
            var best = null;
            for (var i = 0; i < choices.length; i++) {
                var item = choices[i];
                var text = typeof item === "string" ? item : (item.text || item.label || item.value || "");
                var scored = this.scoreChoice(question, text);
                if (!best || scored.score > best.score) best = { index: i, text: text, score: scored.score, source: scored.source };
            }
            return best;
        }
    };

    // Keep legacy PROFILE fields synchronized with the canonical profile.
    ISE.PROFILE.dateOfBirth = ISE.PROFILE_V9.dateOfBirth;
    ISE.PROFILE.age = ISE.ProfileIntelligence.age();
    ISE.PROFILE.gender = ISE.PROFILE_V9.gender;
