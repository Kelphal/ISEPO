    };
};


/* ============================================================
   QUESTION + OPTION ANALYSIS
   ============================================================ */

ISE.AdvancedSemantics.analyzeQuestionOptions =
function(
    questionText,
    options
)
{
    var analysis =
        ISE.AdvancedSemantics
            .analyze(
                questionText
            );

    var output = [];

    if(
        !Array.isArray(
            options
        )
    )
    {
        return {
            analysis:
                analysis,

            options:
                output
        };
    }

    var resolution =
        ISE.AdvancedSemantics
            .resolve(
                questionText
            );

    for(
        var i = 0;
        i < options.length;
        i++
    )
    {
        var option =
            options[i];

        var text =
            typeof option ===
            "string"
                ? option
                : (
                    option.text ||
                    option.label ||
                    option.value ||
                    ""
                );

        var similarity =
            resolution &&
            resolution.answer !==
            undefined
                ? ISE.AdvancedSemantics
                    .optionSimilarity(
                        text,
                        resolution.answer
                    )
                : 0;

        var range =
            analysis.range
                ? ISE.AdvancedSemantics
                    .matchOption(
                        text,
                        analysis.category
                    )
                : null;

        output.push(
            {
                option:
                    text,

                similarity:
                    similarity,

                range:
                    range,

                score:
                    Math.max(
                        similarity,
                        range &&
                        range.supported
                            ? range.confidence
                            : 0
                    )
            }
        );
    }

    output.sort(
        function(
            a,
            b
        )
        {
            return b.score -
                a.score;
        }
    );

    return {
        analysis:
            analysis,

        resolution:
            resolution,

        options:
            output
    };
};


/* ============================================================
   CONTRADICTION DETECTION
   ============================================================ */

ISE.AdvancedSemantics.detectContradiction =
function(
    question,
    answer
)
{
    var text =
        ISE.AdvancedSemantics
            .normalize(
                question
            );

    var normalizedAnswer =
        ISE.AdvancedSemantics
            .normalize(
                answer
            );

    var negation =
        ISE.AdvancedSemantics
            .detectNegation(
                text
            );

    var booleanAnswer =
        ISE.AdvancedSemantics
            .normalizeBoolean(
                normalizedAnswer
            );

    if(
        booleanAnswer &&
        negation.detected
    )
    {
        /*
         * Do not automatically flip the answer.
         * Flag the situation for the higher-level
         * engine to inspect.
         */

        return {
            detected:
                true,

            reason:
                "Question contains negation.",

            answer:
                booleanAnswer,

            negation:
                negation
        };
    }

    return {
        detected:
            false,

        reason:
            null
    };
};


/* ============================================================
   CONFIDENCE CALIBRATION
   ============================================================ */

ISE.AdvancedSemantics.calibrateConfidence =
function(
    resolution
)
{
    if(
        !resolution
    )
    {
        return 0;
    }

    var confidence =
        Number(
            resolution.confidence
        );

    if(
        isNaN(
            confidence
        )
    )
    {
        confidence =
            resolution.deterministic
                ? 1
                : 0.5;
    }

    if(
        resolution.source ===
        "explicit-profile"
    )
    {
        confidence =
            1;
    }

    if(
        resolution.source ===
        "logical-profile-derivation"
    )
    {
        confidence =
            Math.max(
                confidence,
                0.98
            );
    }

    if(
        resolution.source ===
        "profile"
    )
    {
        confidence =
            Math.max(
                confidence,
                0.99
            );
    }

    return Math.max(
        0,
        Math.min(
            1,
            confidence
        )
    );
};


/* ============================================================
   FINAL SAFETY GATE
   ============================================================ */

ISE.AdvancedSemantics.safeResolve =
function(
    questionText
)
{
    var resolution =
        ISE.AdvancedSemantics
            .resolve(
                questionText
            );

    if(
        !resolution
    )
    {
        return {
            supported:
                false,

            confidence:
                0,

            reason:
                "No resolution returned."
        };
    }

    resolution.confidence =
        ISE.AdvancedSemantics
            .calibrateConfidence(
                resolution
            );

    if(
        resolution.supported ===
        false
    )
    {
        return resolution;
    }

    if(
        resolution.answer ===
        undefined ||
        resolution.answer ===
        null
    )
    {
        resolution.supported =
            false;

        resolution.reason =
            "Resolver did not produce an answer.";

        return resolution;
    }

    if(
        resolution.analysis &&
        resolution.analysis.conditional &&
        resolution.analysis.conditional
            .detected
    )
    {
        /*
         * Conditional questions can depend on
         * information not present in the profile.
         * Do not blindly answer them.
         */

        resolution.supported =
            false;

        resolution.reason =
            "Question contains conditional language requiring additional context.";

        return resolution;
    }

    if(
        resolution.confidence <
        ISE.AdvancedSemantics
            .config
            .minimumConfidence
    )
    {
        resolution.supported =
            false;

        resolution.reason =
            "Semantic confidence is below the configured safety threshold.";

        return resolution;
    }

    return resolution;
};


