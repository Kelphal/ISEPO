   DIAGNOSIS RESOLUTION
   ------------------------------------------------------------ */

ISE.AnswerEngine.resolveDiagnosis = function (questionText) {

    var profile = ISE.AnswerEngine.ensureProfile();

    var conditions = profile.diagnosedConditions;

    if (!Array.isArray(conditions)) {
        return null;
    }

    /*
     * IMPORTANT:
     * An empty diagnosedConditions array means the user explicitly
     * supplied that they have not been diagnosed with any condition.
     */

    if (conditions.length === 0) {

        return {
            supported: true,
            kind: "single",
            value: "No",
            confidence: 1,
            category: "diagnosis",
            reason: "Configured profile contains no diagnosed conditions."
        };
    }

    return {
        supported: false,
        kind: "unsupported",
        value: null,
        confidence: 0,
        category: "diagnosis",
        reason: "Specific diagnosed conditions would need configured profile data."
    };
};


