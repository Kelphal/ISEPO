// ================================================================
// NONE-OF-THE-ABOVE SEMANTIC DETECTOR
// ================================================================

ISE.semantic = {};

ISE.semantic.isNoneAnswer = function (
    value
) {

    const text =
        ISE.text.expandContractions(
            value
        );

    if (!text) {
        return false;
    }

    for (
        const phrase
        of ISE.MEDICAL.noneAnswers
    ) {

        if (
            text ===
            ISE.text.normalize(phrase)
        ) {
            return true;
        }
    }

    if (
        text.startsWith(
            "none of the above"
        )
    ) {
        return true;
    }

    if (
        text.startsWith(
            "none of these"
        )
    ) {
        return true;
    }

    if (
        text.includes(
            "not diagnosed"
        )
    ) {
        return true;
    }

    if (
        text.includes(
            "never diagnosed"
        )
    ) {
        return true;
    }

    return false;
};


ISE.semantic.isYes = function (
    value
) {

    const text =
        ISE.text.expandContractions(
            value
        );

    return ISE.BOOLEAN.yes.some(
        phrase =>
            text ===
            ISE.text.normalize(phrase)
    );
};


ISE.semantic.isNo = function (
    value
) {

    const text =
        ISE.text.expandContractions(
            value
        );

    return ISE.BOOLEAN.no.some(
        phrase =>
            text ===
            ISE.text.normalize(phrase)
    );
};


// ================================================================
