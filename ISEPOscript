/* ------------------------------------------------------------
   RANGE QUESTION DETECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.isRangeQuestion =
function (
    question
) {

    var text =
        ISE.SpecializedSurvey.normalize(
            question
        );

    return (
        text.indexOf("between") !== -1 ||
        text.indexOf("from") !== -1 ||
