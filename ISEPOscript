                );
            }
        }

        return result;
    }


    /* ============================================================
       DOM HELPERS
       ============================================================ */

    function isElement(
        value
    ) {

        return (
            value &&
            typeof value ===
            "object" &&
            value.nodeType === 1
        );
    }


    function isVisible(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {
            return false;
        }

        if (
            element.hidden
        ) {
            return false;
        }

        var style;

        try {

            style =
                window.getComputedStyle(
                    element
                );

        }
        catch (error) {

            return true;
        }

        if (
            style.display ===
            "none"
        ) {
            return false;
        }

        if (
            style.visibility ===
            "hidden"
        ) {
            return false;
        }

        if (
            Number(
                style.opacity
            ) === 0
        ) {
            return false;
        }

        return true;
    }


    function isDisabled(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {
            return true;
        }

        if (
            element.disabled
        ) {
            return true;
        }

        if (
            element.getAttribute(
                "aria-disabled"
            ) ===
            "true"
        ) {
            return true;
        }

        return false;
    }


    function tagName(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {
            return "";
        }

        return String(
            element.tagName ||
            ""
        ).toLowerCase();
    }


    function attr(
        element,
        name
    ) {

        if (
            !isElement(
                element
            )
        ) {
            return "";
        }

        var value =
            element.getAttribute(
                name
            );

        return value ===
            null
            ?
            ""
            :
            String(value);
    }


    function elementText(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {
            return "";
        }

        var aria =
            attr(
                element,
                "aria-label"
            );

        var title =
            attr(
                element,
                "title"
            );

        var text =
            element.innerText ||
            element.textContent ||
            "";

        return cleanText(
            [
                aria,
                title,
                text
            ]
                .filter(
                    Boolean
                )
                .join(" ")
        );
    }


    /* ============================================================
       QUESTION-MARK DETECTION
       ============================================================ */

    function hasQuestionMark(
        text
    ) {

        return /\?/.test(
            text
        );
    }


    function startsLikeQuestion(
        text
    ) {

        var normalized =
            normalize(
                text
            );

        return (
            /^(what|which|where|when|why|how|who|whose|whom)\b/.test(
                normalized
            ) ||
            /^(do|does|did|have|has|had|are|is|was|were|can|could|would|will|should)\b/.test(
                normalized
            ) ||
            /^please select\b/.test(
                normalized
            ) ||
            /^select\b/.test(
                normalized
            ) ||
            /^tell us\b/.test(
                normalized
            )
        );
    }


    /* ============================================================
       ANSWER-CHOICE DETECTION
       ============================================================ */

    function isChoiceText(
        text
    ) {

        var normalized =
            normalize(
                text
            );

        if (!normalized) {
            return false;
        }

        /*
         * Very short standard answer choices.
         */

        if (
            [
                "yes",
                "no",
                "maybe",
                "none",
                "none of these",
                "none of the above",
                "not applicable",
                "n/a",
                "other",
                "other please specify",
                "don't know",
                "dont know",
                "not sure",
                "prefer not to say",
                "prefer not to answer"
            ].indexOf(
                normalized
            ) !== -1
        ) {
            return true;
        }

        /*
         * Numeric/rating answers.
         */

        if (
            /^\d+$/.test(
                normalized
            )
        ) {
            return true;
        }

        /*
         * Common rating wording.
         */

        if (
            containsAny(
                normalized,
                [
                    "strongly agree",
                    "somewhat agree",
                    "agree",
                    "neutral",
                    "somewhat disagree",
                    "strongly disagree",
                    "very satisfied",
                    "satisfied",
                    "dissatisfied",
                    "very dissatisfied",
                    "extremely likely",
                    "very likely",
                    "likely",
                    "unlikely",
                    "very unlikely"
                ]
            )
        ) {
            return true;
        }

        /*
         * Range-looking answer.
         */

        if (
            /\d+\s*(?:-|to|through)\s*\d+/.test(
                normalized
            )
        ) {
            return true;
        }

        if (
            /\$[\d,]+/.test(
                normalized
            )
        ) {
            return true;
        }

        return false;
    }


    /* ============================================================
       CONTROL DISCOVERY
       ============================================================ */

    function collectControls(
        container
    ) {

        if (
            !isElement(
                container
            )
        ) {
            return [];
        }

        var selectors = [
            "input",
            "select",
            "textarea",
            "button",
            "[role='radio']",
            "[role='checkbox']",
            "[role='option']",
            "[role='button']",
            "[role='combobox']",
            "[role='slider']"
        ];

        var controls = [];

        for (
            var i = 0;
            i < selectors.length;
            i++
        ) {

            try {

                var found =
                    container.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j < found.length;
                    j++
                ) {

                    if (
                        controls.indexOf(
                            found[j]
                        ) === -1
                    ) {

                        controls.push(
                            found[j]
                        );
                    }
                }

            }
            catch (error) {

                /*
                 * Invalid selector should never
                 * break the complete scanner.
                 */

            }
        }

        return controls.filter(
            function (control) {

                return (
                    isVisible(
                        control
                    ) &&
                    !isDisabled(
                        control
                    )
                );
            }
        );
    }


    /* ============================================================
       CONTROL TYPE
       ============================================================ */

    function controlType(
        control
    ) {

        if (
            !isElement(
                control
            )
        ) {
            return "unknown";
        }

        var tag =
            tagName(
                control
            );

        var role =
            normalize(
                attr(
                    control,
                    "role"
                )
            );

        if (
            tag === "select"
        ) {
            return "select";
        }

        if (
            tag === "textarea"
        ) {
            return "textarea";
        }

        if (
            tag === "input"
        ) {

            var inputType =
                normalize(
                    attr(
                        control,
                        "type"
                    )
                );

            if (
                inputType === "radio"
            ) {
                return "radio";
            }

            if (
                inputType === "checkbox"
            ) {
                return "checkbox";
            }

            if (
                inputType === "number"
            ) {
                return "number";
            }

            if (
                inputType === "date"
            ) {
                return "date";
            }

            if (
                inputType === "range"
            ) {
                return "range";
            }

            if (
                inputType === "button" ||
                inputType === "submit"
            ) {
                return "button";
            }

            return "input";
        }

        if (
            role === "radio"
        ) {
            return "radio";
        }

        if (
            role === "checkbox"
        ) {
            return "checkbox";
        }

        if (
            role === "option"
        ) {
            return "option";
        }

        if (
            role === "combobox"
        ) {
            return "combobox";
        }

        if (
            role === "slider"
        ) {
            return "range";
        }

        if (
            role === "button"
        ) {
            return "button";
        }

        if (
            tag === "button"
        ) {
            return "button";
        }

        return "unknown";
    }


    /* ============================================================
       CONTROL DESCRIPTION
       ============================================================ */

    function controlDescription(
        control
    ) {

        if (
            !isElement(
                control
            )
        ) {
            return "";
        }

        var values = [

            attr(
                control,
                "aria-label"
            ),

            attr(
                control,
                "aria-labelledby"
            ),

            attr(
                control,
                "data-value"
            ),

            attr(
                control,
                "data-answer"
            ),

            attr(
                control,
                "data-option"
            ),

            attr(
                control,
                "data-choice"
            ),

            attr(
                control,
                "value"
            ),

            elementText(
                control
            )
        ];

        /*
         * Associated label.
         */

        var id =
            attr(
                control,
                "id"
            );

        if (
            id
        ) {

            try {

                var label =
                    document.querySelector(
                        "label[for='" +
                        CSS.escape(
                            id
                        ) +
                        "']"
                    );

                if (
                    label
                ) {

                    values.push(
                        elementText(
                            label
                        )
                    );
                }

            }
            catch (error) {
            }
        }

        /*
         * Parent label.
         */

        var parent =
            control.parentElement;

        if (
            parent &&
            tagName(
                parent
            ) === "label"
        ) {

            values.push(
                elementText(
                    parent
                )
            );
        }

        return unique(
            values
        ).join(
            " "
        );
    }


    /* ============================================================
       QUESTION TEXT EXTRACTION
       ============================================================ */

    function extractQuestionText(
        container,
        controls
    ) {

        if (
            !isElement(
                container
            )
        ) {
            return "";
        }

        var candidates = [];

        /*
         * Explicit question selectors.
         */

        var selectors = [

            "[data-question]",

            "[data-question-text]",

            "[data-testid*='question']",

            "[class*='question']",

            "[class*='Question']",

            "legend",

            "h1",

            "h2",

            "h3",

            "h4",

            "h5"
        ];

        for (
            var i = 0;
            i < selectors.length;
            i++
        ) {

            try {

                var elements =
                    container.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j < elements.length;
                    j++
                ) {

                    var text =
                        elementText(
                            elements[j]
                        );

                    if (
                        text
                    ) {

                        candidates.push(
                            text
                        );
                    }
                }

            }
            catch (error) {
            }
        }

        /*
         * Container's own text is useful as
         * fallback, but we remove known controls.
         */

        var clone;

        try {

            clone =
                container.cloneNode(
                    true
                );

            var cloneControls =
                clone.querySelectorAll(
                    "input,select,textarea,button,[role]"
                );

            for (
                var k = 0;
                k < cloneControls.length;
                k++
            ) {

                if (
                    cloneControls[k] &&
                    cloneControls[k].parentNode
                ) {

                    cloneControls[k]
                        .parentNode
                        .removeChild(
                            cloneControls[k]
                        );
                }
            }

            var cloneText =
                elementText(
                    clone
                );

            if (
                cloneText
            ) {

                candidates.push(
                    cloneText
                );
            }

        }
        catch (error) {
        }

        /*
         * Remove answer-choice text from
         * candidates where possible.
         */

        var choiceTexts =
            controls.map(
                function (control) {

                    return cleanText(
                        controlDescription(
                            control
                        )
                    );
                }
            );

        var best =
            "";

        var bestScore =
            -Infinity;

        for (
            var c = 0;
            c < candidates.length;
            c++
        ) {

            var candidate =
                cleanText(
                    candidates[c]
                );

            if (
                !candidate
            ) {
                continue;
            }

            var score =
                0;

            if (
                hasQuestionMark(
                    candidate
                )
            ) {
                score += 10;
            }

            if (
                startsLikeQuestion(
                    candidate
                )
            ) {
                score += 8;
            }

            if (
                isChoiceText(
                    candidate
                )
            ) {
                score -= 12;
            }

            /*
             * Penalize exact answer-choice text.
             */

            for (
                var q = 0;
                q < choiceTexts.length;
                q++
            ) {

                if (
                    candidate ===
                    choiceTexts[q]
                ) {

                    score -= 10;
                }
            }

            /*
             * Questions usually have enough
             * semantic content to be longer
             * than a basic choice.
             */

            if (
                candidate.length >
                25
            ) {
                score += 2;
            }

            if (
                candidate.length >
                80
            ) {
                score += 1;
            }

            if (
                score >
                bestScore
            ) {

                bestScore =
                    score;

                best =
                    candidate;
            }
        }

        return best;
    }


    /* ============================================================
       QUESTION CONTAINER VALIDATION
       ============================================================ */

    function isLikelyQuestionContainer(
        container
    ) {

        if (
            !isElement(
                container
            )
        ) {
            return false;
        }

        if (
            !isVisible(
                container
            )
        ) {
            return false;
        }

        var controls =
            collectControls(
                container
            );

        if (
            controls.length === 0
        ) {
            return false;
        }

        var text =
            extractQuestionText(
                container,
                controls
            );

        if (
            !text
        ) {
            return false;
        }

        /*
         * Never classify a pure answer choice
         * as a question.
         */

        if (
            isChoiceText(
                text
            ) &&
            !hasQuestionMark(
                text
            )
        ) {

            engine.statistics
                .ignoredAnswerChoices++;

            return false;
        }

        var score =
            0;

        if (
            hasQuestionMark(
                text
            )
        ) {
            score += 5;
        }

        if (
            startsLikeQuestion(
                text
            )
        ) {
            score += 5;
        }

        if (
            controls.length >= 1
        ) {
            score += 2;
        }

        if (
            controls.length >= 2
        ) {
            score += 2;
        }

        if (
            controls.length >= 4
        ) {
            score += 1;
        }

        return score >= 5;
    }


    /* ============================================================
       FIND QUESTION CONTAINERS
       ============================================================ */

    function findQuestionContainers(
        root
    ) {

        if (
            !isElement(
                root
            )
        ) {
            return [];
        }

        var candidates = [];

        /*
         * Explicit question structures.
         */

        var selectors = [

            "[data-question]",

            "[data-question-id]",

            "[data-question-text]",

            "fieldset",

            "form",

            "[role='group']",

            "[role='radiogroup']",

            "[class*='question']",

            "[class*='Question']",

            "[class*='survey-question']",

            "[class*='SurveyQuestion']"
        ];

        for (
            var i = 0;
            i < selectors.length;
            i++
        ) {

            try {

                var found =
                    root.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j < found.length;
                    j++
                ) {

                    if (
                        candidates.indexOf(
                            found[j]
                        ) === -1
                    ) {

                        candidates.push(
                            found[j]
                        );
                    }
                }

            }
            catch (error) {
            }
        }

        /*
         * Add nearest containers around controls.
         */

        var controls =
            collectControls(
                root
            );

        for (
            var c = 0;
            c < controls.length;
            c++
        ) {

            var control =
                controls[c];

            var current =
                control.parentElement;

            var depth =
                0;

            while (
                current &&
                depth < 8
            ) {

                if (
                    candidates.indexOf(
                        current
                    ) === -1
                ) {

                    candidates.push(
                        current
                    );
                }

                current =
                    current.parentElement;

                depth++;
            }
        }

        /*
         * Filter and deduplicate.
         */

        var valid =
            candidates.filter(
                function (container) {

                    return isLikelyQuestionContainer(
                        container
                    );
                }
            );

        /*
         * Remove nested duplicates.
         */

        valid.sort(
            function (a, b) {

                return (
                    a.querySelectorAll(
                        "*"
                    ).length -
                    b.querySelectorAll(
                        "*"
                    ).length
                );
            }
        );

        var result = [];

        for (
            var v = 0;
            v < valid.length;
            v++
        ) {

            var candidate =
                valid[v];

            var alreadyContained =
                false;

            for (
                var r = 0;
                r < result.length;
                r++
            ) {

                if (
                    result[r].contains(
                        candidate
                    )
                ) {

                    alreadyContained =
                        true;

                    break;
                }
            }

            if (
                !alreadyContained
            ) {

                result.push(
                    candidate
                );
            }
        }

        return result;
    }


    /* ============================================================
       CHOICE EXTRACTION
       ============================================================ */

    function collectChoices(
        container,
        controls
    ) {

        var choices = [];

        for (
            var i = 0;
            i < controls.length;
            i++
        ) {

            var control =
                controls[i];

            var type =
                controlType(
                    control
                );

            if (
                type === "button" ||
                type === "radio" ||
                type === "checkbox" ||
                type === "option"
            ) {

                var description =
                    cleanText(
                        controlDescription(
                            control
                        )
                    );

                if (
                    description
                ) {

                    choices.push({

                        element:
                            control,

                        text:
                            description,

                        type:
                            type
                    });
                }
            }
        }

        /*
         * Select options.
         */

        try {

            var selects =
                container.querySelectorAll(
                    "select"
                );

            for (
                var s = 0;
                s < selects.length;
                s++
            ) {

                var options =
                    selects[s]
                        .querySelectorAll(
                            "option"
                        );

                for (
                    var o = 0;
                    o < options.length;
                    o++
                ) {

                    var option =
                        options[o];

                    var optionText =
                        cleanText(
                            elementText(
                                option
                            )
                        );

                    if (
                        optionText
                    ) {

                        choices.push({

                            element:
                                option,

                            select:
                                selects[s],

                            text:
                                optionText,

                            type:
                                "option"
                        });
                    }
                }
            }

        }
        catch (error) {
        }

        engine.statistics
            .choicesFound +=
            choices.length;

        return choices;
    }


    /* ============================================================
       QUESTION TYPE DETECTION
       ============================================================ */

    function detectQuestionType(
        text,
        controls,
        choices
    ) {

        var normalized =
            normalize(
                text
            );

        var types = {

            single:
                false,

            multi:
                false,

            dropdown:
                false,

            numeric:
                false,

            date:
                false,

            rating:
                false,

            yesNo:
                false,

            range:
                false
        };

        if (
            controls.some(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "select"
                    );
                }
            )
        ) {

            types.dropdown =
                true;
        }

        if (
            controls.some(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "number"
                    );
                }
            )
        ) {

            types.numeric =
                true;
        }

        if (
            controls.some(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "date"
                    );
                }
            )
        ) {

            types.date =
                true;
        }

        if (
            controls.some(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "range"
                    );
                }
            )
        ) {

            types.range =
                true;
        }

        if (
            containsAny(
                normalized,
                [
                    "select all that apply",
                    "select all",
                    "choose all",
                    "check all that apply",
                    "which of the following apply"
                ]
            )
        ) {

            types.multi =
                true;
        }

        var checkboxCount =
            controls.filter(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "checkbox"
                    );
                }
            ).length;

        if (
            checkboxCount > 0
        ) {

            types.multi =
                true;
        }

        var radioCount =
            controls.filter(
                function (control) {

                    return (
                        controlType(
                            control
                        ) ===
                        "radio"
                    );
                }
            ).length;

        if (
            radioCount > 0
        ) {

            types.single =
                true;
        }

        if (
            containsAny(
                normalized,
                [
                    "rate",
                    "rating",
                    "satisfied",
                    "agree",
                    "disagree",
                    "likely",
                    "unlikely",
                    "how would you rate"
                ]
            ) &&
            choices.length >= 3
        ) {

            types.rating =
                true;
        }

        if (
            containsAny(
                normalized,
                [
                    "yes or no",
                    "yes/no",
                    "do you",
                    "have you",
                    "are you",
                    "did you",
                    "is your",
                    "does your"
                ]
            ) &&
            choices.some(
                function (choice) {

                    return (
                        normalize(
                            choice.text
                        ) ===
                        "yes"
                    );
                }
            ) &&
            choices.some(
                function (choice) {

                    return (
                        normalize(
                            choice.text
                        ) ===
                        "no"
                    );
                }
            )
        ) {

            types.yesNo =
                true;
        }

        if (
            choices.some(
                function (choice) {

                    return /\d+\s*(?:-|to|through)\s*\d+/.test(
                        normalize(
                            choice.text
                        )
                    );
                }
            )
        ) {

            types.range =
                true;
        }

        if (
            types.multi
        ) {

            engine.statistics.multiSelect++;
        }
        else if (
            types.dropdown
        ) {

            engine.statistics.dropdown++;
        }
        else if (
            types.numeric
        ) {

            engine.statistics.numeric++;
        }
        else if (
            types.yesNo
        ) {

            engine.statistics.yesNo++;
        }
        else if (
            types.rating
        ) {

            engine.statistics.ratings++;
        }
        else {

            engine.statistics.singleSelect++;
        }

        return types;
    }


    /* ============================================================
       NUMERIC VALUE PARSING
       ============================================================ */

    function parseNumeric(
        text
    ) {

        if (
            text === null ||
            text === undefined
        ) {
            return null;
        }

        var normalized =
            normalize(
                text
            );

        /*
         * Remove currency commas.
         */

        var cleaned =
            normalized
                .replace(
                    /,/g,
                    ""
                );

        var match =
            cleaned.match(
                /-?\d+(?:\.\d+)?/
            );

        if (!match) {
            return null;
        }

        var value =
            Number(
                match[0]
            );

        if (
            isNaN(value)
        ) {
            return null;
        }

        if (
            /\bthousand\b/.test(
                cleaned
            ) ||
            /\bk\b/.test(
                cleaned
            )
        ) {
            value *= 1000;
        }

        if (
            /\bmillion\b/.test(
                cleaned
            ) ||
            /\bm\b/.test(
                cleaned
            )
        ) {
            value *= 1000000;
        }

        return value;
    }


    /* ============================================================
       RANGE PARSING
       ============================================================ */

    function parseRange(
        text
    ) {

        var normalized =
            normalize(
                text
            )
                .replace(
                    /,/g,
                    ""
                );

        var match =
            normalized.match(
                /(\d+(?:\.\d+)?)\s*(?:-|to|through)\s*(\d+(?:\.\d+)?)/i
            );

        if (!match) {

            /*
             * Handle "under X".
             */

            var under =
                normalized.match(
                    /(?:under|less than|below)\s+\$?(\d+(?:\.\d+)?)/i
                );

            if (under) {

                return {

                    min:
                        -Infinity,

                    max:
                        Number(
                            under[1]
                        ) - 0.000001,

                    type:
                        "upper"
                };
            }

            /*
             * Handle "X or more".
             */

            var over =
                normalized.match(
                    /(?:over|more than|at least|and above)\s+\$?(\d+(?:\.\d+)?)/i
                );

            if (over) {

                return {

                    min:
                        Number(
                            over[1]
                        ),

                    max:
                        Infinity,

                    type:
                        "lower"
                };
            }

            return null;
        }

        return {

            min:
                Number(
                    match[1]
                ),

            max:
                Number(
                    match[2]
                ),

            type:
                "range"
        };
    }


    /* ============================================================
       PROFILE VALUE FOR QUESTION
       ============================================================ */

    function profileValueForQuestion(
        text
    ) {

        if (
            !ISE.PROFILE
        ) {
            return null;
        }

        var normalized =
            normalize(
