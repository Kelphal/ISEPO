// ================================================================
// SAFE DOM HELPERS
// ================================================================

ISE.DOM.isElement = function (
    value
) {

    return (
        value instanceof Element
    );
};


ISE.DOM.isDocument = function (
    value
) {

    return (
        value instanceof Document
    );
};


ISE.DOM.isShadowRoot = function (
    value
) {

    return (
        typeof ShadowRoot !== "undefined" &&
        value instanceof ShadowRoot
    );
};


ISE.DOM.isContainer = function (
    value
) {

    return (
        ISE.DOM.isElement(value) ||
        ISE.DOM.isDocument(value) ||
        ISE.DOM.isShadowRoot(value)
    );
};


// ================================================================
// SAFE SELECTOR
// ================================================================

ISE.DOM.queryAll = function (
    root,
    selector
) {

    if (
        !root ||
        typeof root.querySelectorAll !==
        "function"
    ) {
        return [];
    }

    try {

        return Array.from(
            root.querySelectorAll(
                selector
            )
        );

    } catch (error) {

        ISE.warn(
            "Selector failed:",
            selector,
            error
        );

        return [];
    }
};


ISE.DOM.query = function (
    root,
    selector
) {

    if (
        !root ||
        typeof root.querySelector !==
        "function"
    ) {
        return null;
    }

    try {

        return root.querySelector(
            selector
        );

    } catch {

        return null;
    }
};


// ================================================================
// ATTRIBUTE READER
// ================================================================

ISE.DOM.attributes = function (
    element
) {

    const result = {};

    if (
        !element ||
        !element.attributes
    ) {
        return result;
    }

    for (
        const attribute
        of Array.from(
            element.attributes
        )
    ) {

        result[
            attribute.name
        ] =
            attribute.value;
    }

    return result;
};


// ================================================================
// TEXT FROM ATTRIBUTES
// ================================================================

ISE.DOM.attributeText = function (
    element
) {

    if (!element) {
        return "";
    }

    const names = [

        "aria-label",

        "aria-labelledby",

        "aria-describedby",

        "data-question",

        "data-question-text",

        "data-question-label",

        "data-label",

        "data-title",

        "data-placeholder",

        "data-option",

        "data-answer",

        "data-choice",

        "data-value",

        "title",

        "placeholder",

        "alt",

        "name",

        "id"
    ];

    const pieces = [];

    for (
        const name
        of names
    ) {

        try {

            const value =
                element.getAttribute(
                    name
                );

            if (
                value &&
                value.trim()
            ) {

                pieces.push(
                    value.trim()
                );
            }

        } catch {
        }
    }

    return pieces.join(" ");
};


// ================================================================
// DIRECT TEXT EXTRACTION
// ================================================================

/*
 * Normal innerText is dangerous for survey questions.
 *
 * Example:
 *
 *   Have you been diagnosed with...
 *
 *   ○ Diabetes
 *   ○ Asthma
 *   ○ None of the above
 *
 * If we simply use container.innerText,
 * the classifier receives the question AND every answer.
 *
 * That can make the classifier think:
 *
 *   "Diabetes"
 *
 * is part of the question.
 *
 * This function deliberately removes interactive
 * descendants when possible.
 */

ISE.DOM.directText = function (
    element
) {

    if (!element) {
        return "";
    }

    const clone =
        element.cloneNode(
            true
        );

    const removeSelectors = [

        "input",

        "select",

        "textarea",

        "button",

        "option",

        "[role='radio']",

        "[role='checkbox']",

        "[role='option']",

        "[role='combobox']",

        "[role='listbox']",

        "[contenteditable='true']"
    ];

    for (
        const selector
        of removeSelectors
    ) {

        for (
            const node
            of ISE.DOM.queryAll(
                clone,
                selector
            )
        ) {

            try {
                node.remove();
            } catch {
            }
        }
    }

    return ISE.text.normalize(
        clone.innerText ||
        clone.textContent ||
        ""
    );
};


// ================================================================
// LABEL TEXT
// ================================================================

ISE.DOM.labelText = function (
    control
) {

    if (!control) {
        return "";
    }

    const pieces = [];

    /*
     * Explicitly associated labels.
     */

    try {

        if (
            control.labels
        ) {

            for (
                const label
                of Array.from(
                    control.labels
                )
            ) {

                pieces.push(
                    label.innerText ||
                    label.textContent ||
                    ""
                );
            }
        }

    } catch {
    }


    /*
     * Label using the control's ID.
     */

    try {

        const id =
            control.getAttribute(
                "id"
            );

        if (id) {

            const escaped =
                CSS.escape(id);

            const labels =
                ISE.DOM.queryAll(
                    document,
                    "label[for='" +
                    escaped +
                    "']"
                );

            for (
                const label
                of labels
            ) {

                pieces.push(
                    label.innerText ||
                    label.textContent ||
                    ""
                );
            }
        }

    } catch {
    }


    /*
     * Parent label.
     */

    try {

        const parentLabel =
            control.closest(
                "label"
            );

        if (
            parentLabel
        ) {

            pieces.push(
                parentLabel.innerText ||
                parentLabel.textContent ||
                ""
            );
        }

    } catch {
    }

    return ISE.text.normalize(
        pieces.join(" ")
    );
};


// ================================================================
// ARIA TEXT RESOLUTION
// ================================================================

ISE.DOM.resolveAriaReference =
function (
    element,
    attribute
) {

    if (!element) {
        return "";
    }

    let ids = "";

    try {

        ids =
            element.getAttribute(
                attribute
            ) || "";

    } catch {

        return "";
    }

    if (!ids) {
        return "";
    }

    const pieces = [];

    for (
        const id
        of ids.split(/\s+/)
    ) {

        if (!id) {
            continue;
        }

        let referenced = null;

        try {

            referenced =
                document.getElementById(
                    id
                );

        } catch {
        }

        if (
            referenced
        ) {

            pieces.push(
                referenced.innerText ||
                referenced.textContent ||
                ""
            );
        }
    }

    return ISE.text.normalize(
        pieces.join(" ")
    );
};


ISE.DOM.ariaText = function (
    element
) {

    if (!element) {
        return "";
    }

    return [

        ISE.DOM.resolveAriaReference(
            element,
            "aria-labelledby"
        ),

        ISE.DOM.resolveAriaReference(
            element,
            "aria-describedby"
        ),

        element.getAttribute(
            "aria-label"
        ) || ""
    ]
        .filter(Boolean)
        .join(" ");
};


// ================================================================
// CONTROL DESCRIPTION
// ================================================================

ISE.DOM.controlDescription =
function (
    control
) {

    if (!control) {
        return "";
    }

    const pieces = [

        ISE.DOM.attributeText(
            control
        ),

        ISE.DOM.labelText(
            control
        ),

        ISE.DOM.ariaText(
            control
        )
    ];

    /*
     * Nearby text is useful for custom controls.
     */

    try {

        if (
            control.parentElement
        ) {

            pieces.push(
                ISE.DOM.directText(
                    control.parentElement
                )
            );
        }

    } catch {
    }

    return ISE.text.normalize(
        pieces
            .filter(Boolean)
            .join(" ")
    );
};


// ================================================================
// CONTROL TYPE
// ================================================================

ISE.DOM.controlType =
function (
    control
) {

    if (!control) {
        return "unknown";
    }

    const tag =
        String(
            control.tagName || ""
        ).toLowerCase();

    if (
        tag === "input"
    ) {

        return (
            String(
                control.type ||
                "text"
            ).toLowerCase()
        );
    }

    if (
        tag === "select"
    ) {

        return (
            control.multiple
                ? "select-multiple"
                : "select"
        );
    }

    if (
        tag === "textarea"
    ) {

        return "textarea";
    }

    if (
        tag === "button"
    ) {

        return "button";
    }

    const role =
        ISE.text.normalize(
            control.getAttribute?.(
                "role"
            ) || ""
        );

    if (role) {
        return "aria-" + role;
    }

    if (
        control.isContentEditable
    ) {

        return "contenteditable";
    }

    return "custom";
};


// ================================================================
// INTERACTIVE TEST
// ================================================================

ISE.DOM.isInteractive =
function (
    element
) {

    if (!element) {
        return false;
    }

    const type =
        ISE.DOM.controlType(
            element
        );

    return [

        "text",

        "search",

        "email",

        "tel",

        "url",

        "number",

        "date",

        "datetime-local",

        "month",

        "week",

        "time",

        "radio",

        "checkbox",

        "range",

        "select",

        "select-multiple",

        "textarea",

        "button",

        "submit",

        "reset",

        "aria-radio",

        "aria-checkbox",

        "aria-option",

        "aria-combobox",

        "aria-listbox",

        "aria-spinbutton",

        "aria-slider",

        "aria-switch",

        "contenteditable"
    ].includes(type);
};


// ================================================================
// VISIBILITY
// ================================================================

ISE.DOM.isVisible =
function (
    element
) {

    if (!element) {
        return false;
    }

    try {

        const style =
            window.getComputedStyle(
                element
            );

        if (
            style.display ===
            "none"
        ) {
            return false;
        }

        if (
            style.visibility ===
            "hidden"
        ) {
            return false;
        }

        if (
            Number(
                style.opacity
            ) === 0
        ) {
            return false;
        }

        const rect =
            element.getBoundingClientRect();

        if (
            rect.width === 0 &&
            rect.height === 0
        ) {
            return false;
        }

        return true;

    } catch {

        return true;
    }
};


// ================================================================
// DISABLED TEST
// ================================================================

ISE.DOM.isDisabled =
function (
    element
) {

    if (!element) {
        return true;
    }

    try {

        if (
            element.disabled
        ) {
            return true;
        }

    } catch {
    }

    try {

        if (
            element.getAttribute(
                "aria-disabled"
            ) === "true"
        ) {
            return true;
        }

    } catch {
    }

    return false;
};


// ================================================================
// CONTROL COLLECTION
// ================================================================

ISE.DOM.collectControls =
function (
    container
) {

    if (!container) {
        return [];
    }

    const controls = [];

    const seen =
        new Set();

    const selector =
        ISE.DOM.controlSelectors
            .join(",");

    const nodes =
        ISE.DOM.queryAll(
            container,
            selector
        );

    for (
        const node
        of nodes
    ) {

        if (
            seen.has(node)
        ) {
            continue;
        }

        seen.add(node);

        if (
            !ISE.DOM.isVisible(
                node
            )
        ) {
            continue;
        }

        controls.push(
            node
        );
    }

    return controls;
};


// ================================================================
// ANSWER-CHOICE DETECTION
// ================================================================

ISE.DOM.isAnswerChoice =
function (
    element
) {

    if (!element) {
        return false;
    }

    const type =
        ISE.DOM.controlType(
            element
        );

    /*
     * Native options and radio/checkbox
     * labels are extremely likely to be
     * answer choices.
     */

    if (
        type === "radio" ||
        type === "checkbox" ||
        type === "option" ||
        type === "aria-radio" ||
        type === "aria-checkbox" ||
        type === "aria-option"
    ) {

        return true;
    }

    const tag =
        String(
            element.tagName || ""
        ).toLowerCase();

    if (
        tag === "option"
    ) {
        return true;
    }

    if (
        tag === "label"
    ) {

        const associated =
            ISE.DOM.query(
                element,
                "input,select,textarea"
            );

        if (
            associated
        ) {
            return true;
        }
    }

    const text =
        ISE.DOM.controlDescription(
            element
        );

    if (!text) {
        return false;
    }

    if (
        ISE.semantic.isYes(
            text
        )
    ) {
        return true;
    }

    if (
        ISE.semantic.isNo(
            text
        )
    ) {
        return true;
    }

    if (
        ISE.semantic.isNoneAnswer(
            text
        )
    ) {
        return true;
    }

    /*
     * A short element containing a common
     * survey-choice phrase is usually a choice.
     */

    if (
        text.length <= 100
    ) {

        const choiceWords = [

            "strongly agree",

            "agree",

            "neutral",

            "disagree",

            "strongly disagree",

            "very satisfied",

            "satisfied",

            "dissatisfied",

            "very dissatisfied",

            "always",

            "often",

            "sometimes",

            "rarely",

            "never",

            "daily",

            "weekly",

            "monthly",

            "yearly",

            "less than",

            "more than",

            "not sure",

            "don't know",

            "prefer not to say"
        ];

        if (
            ISE.text.containsAny(
                text,
                choiceWords
            )
        ) {
            return true;
        }
    }

    return false;
};


// ================================================================
// QUESTION CONTAINER SCORE
// ================================================================

ISE.DOM.questionContainerScore =
function (
    element
) {

    if (!element) {
        return 0;
    }

    let score = 0;

    const tag =
        String(
            element.tagName || ""
        ).toLowerCase();

    const className =
        ISE.text.normalize(
            typeof element.className ===
            "string"
                ? element.className
                : ""
        );

    const id =
        ISE.text.normalize(
            element.id || ""
        );

    const attributes =
        ISE.DOM.attributes(
            element
        );

    const attributeText =
        ISE.text.normalize(
            Object.values(
                attributes
            ).join(" ")
        );

    const combined =
        [
            className,
            id,
            attributeText
        ].join(" ");

    /*
     * Strong semantic container indicators.
     */

    if (
        tag === "fieldset"
    ) {
        score += 0.45;
    }

    if (
        combined.includes(
            "question"
        )
    ) {
        score += 0.35;
    }

    if (
        combined.includes(
            "survey"
        )
    ) {
        score += 0.08;
    }

    if (
        combined.includes(
            "screen"
        )
    ) {
        score += 0.05;
    }

    if (
        element.hasAttribute(
            "data-question"
        )
    ) {
        score += 0.45;
    }

    if (
        element.hasAttribute(
            "data-question-id"
        )
    ) {
        score += 0.45;
    }

    if (
        element.getAttribute(
            "role"
        ) === "group"
    ) {
        score += 0.30;
    }

    if (
        element.getAttribute(
            "role"
        ) === "radiogroup"
    ) {
        score += 0.40;
    }

    const controls =
        ISE.DOM.collectControls(
            element
        );

    if (
        controls.length
    ) {
        score += 0.15;
    }

    /*
     * Avoid gigantic page-level containers.
     */

    if (
        controls.length > 30
    ) {
        score -= 0.20;
    }

    return Math.max(
        0,
        Math.min(
            score,
            1
        )
    );
};


// ================================================================
// QUESTION TEXT EXTRACTION
// ================================================================

ISE.DOM.questionText =
function (
    container
) {

    if (!container) {
        return "";
    }

    const pieces = [];

    /*
     * Explicit question attributes
     * receive high priority.
     */

    const explicitAttributes = [

        "data-question",

        "data-question-text",

        "data-question-label",

        "aria-label",

        "title"
    ];

    for (
        const attribute
        of explicitAttributes
    ) {

        try {

            const value =
                container.getAttribute(
                    attribute
                );

            if (
                value &&
                value.trim()
            ) {

                pieces.push(
                    value.trim()
                );
            }

        } catch {
        }
    }


    /*
     * Fieldset legends are particularly
     * reliable for survey questions.
     */

    for (
        const legend
        of ISE.DOM.queryAll(
            container,
            "legend"
        )
    ) {

        const text =
            legend.innerText ||
            legend.textContent ||
            "";

        if (
            text.trim()
        ) {

            pieces.push(
                text.trim()
            );
        }
    }


    /*
     * Headings inside question containers.
     */

    const headingSelectors = [

        "h1",

        "h2",

        "h3",

        "h4",

        "h5",

        "h6",

        "[role='heading']"
    ];

    for (
        const selector
        of headingSelectors
    ) {

        for (
            const heading
            of ISE.DOM.queryAll(
                container,
                selector
            )
        ) {

            if (
                ISE.DOM.isAnswerChoice(
                    heading
                )
            ) {
                continue;
            }

            const text =
                heading.innerText ||
                heading.textContent ||
                "";

            if (
                text.trim()
            ) {

                pieces.push(
                    text.trim()
                );
            }
        }
    }


    /*
     * Direct text from the container
     * with controls removed.
     */

    const direct =
        ISE.DOM.directText(
            container
        );

    if (direct) {
        pieces.push(direct);
    }


    /*
     * Deduplicate text fragments.
     */

    const unique =
        Array.from(
            new Set(
                pieces
                    .map(
                        ISE.text.normalize
                    )
                    .filter(Boolean)
            )
        );

    /*
     * Prefer the shortest strong
     * semantic question when multiple
     * nested containers contributed text.
     */

    unique.sort(
        (a, b) => {

            const aQuestion =
                ISE.question
                    .score(
                        a,
                        container
                    )
                    .total;

            const bQuestion =
                ISE.question
                    .score(
                        b,
                        container
                    )
                    .total;

            if (
                bQuestion !==
                aQuestion
            ) {

                return (
                    bQuestion -
                    aQuestion
                );
            }

            return (
                a.length -
                b.length
            );
        }
    );

    return unique[0] || "";
};


// ================================================================
// QUESTION CANDIDATE TEST
// ================================================================

ISE.DOM.isQuestionCandidate =
function (
    element
) {

    if (!element) {
        return false;
    }

    if (
        ISE.DOM.isAnswerChoice(
            element
        )
    ) {
        return false;
    }

    const text =
        ISE.DOM.questionText(
            element
        );

    if (
        !text ||
        text.length < 5
    ) {
        return false;
    }

    const score =
        ISE.question.score(
            text,
            element
        );

    const containerScore =
        ISE.DOM.questionContainerScore(
            element
        );

    const total =
        Math.min(
            1,
            score.total +
            containerScore * 0.35
        );

    return (
        total >=
        ISE.CONFIG
            .minimumQuestionConfidence
    );
};


// ================================================================
// DISCOVER QUESTION CONTAINERS
// ================================================================

ISE.DOM.discoverQuestionContainers =
function (
    root
) {

    if (!root) {
        return [];
    }

    const candidates =
        [];

    const seen =
        new Set();

    /*
     * First collect explicit
     * question containers.
     */

    for (
        const selector
        of ISE.DOM.questionSelectors
    ) {

        const nodes =
            ISE.DOM.queryAll(
                root,
                selector
            );

        for (
            const node
            of nodes
        ) {

            if (
                seen.has(node)
            ) {
                continue;
            }

            seen.add(node);

            if (
                ISE.DOM.isQuestionCandidate(
                    node
                )
            ) {

                candidates.push(
                    node
                );
            }
        }
    }


    /*
     * Fieldsets can sometimes lack
     * useful class names entirely.
     */

    for (
        const fieldset
        of ISE.DOM.queryAll(
            root,
            "fieldset"
        )
    ) {

        if (
            seen.has(fieldset)
        ) {
            continue;
        }

        seen.add(fieldset);

        if (
            ISE.DOM.isQuestionCandidate(
                fieldset
            )
        ) {

            candidates.push(
                fieldset
            );
        }
    }


    /*
     * Groups and radiogroups.
     */

    for (
        const group
        of ISE.DOM.queryAll(
            root,
            "[role='group'],[role='radiogroup']"
        )
    ) {

        if (
            seen.has(group)
        ) {
            continue;
        }

        seen.add(group);

        if (
            ISE.DOM.isQuestionCandidate(
                group
            )
        ) {

            candidates.push(
                group
            );
        }
    }


    /*
     * Generic fallback.
     *
     * This catches survey platforms that
     * don't use recognizable class names.
     */

    const generic =
        ISE.DOM.queryAll(
            root,
            "div,section,article,form"
        );

    for (
        const node
        of generic
    ) {

        if (
            seen.has(node)
        ) {
            continue;
        }

        /*
         * Generic scanning is deliberately
         * stricter than explicit selectors.
         */

        const controls =
            ISE.DOM.collectControls(
                node
            );

        if (
            controls.length === 0
        ) {
            continue;
        }

        if (
            controls.length > 20
        ) {
            continue;
        }

        const text =
            ISE.DOM.questionText(
                node
            );

        if (
            !text
        ) {
            continue;
        }

        const evidence =
            ISE.question.score(
                text,
                node
            );

        if (
            evidence.total <
            0.58
        ) {
            continue;
        }

        seen.add(node);

        candidates.push(
            node
        );
    }


    /*
     * Remove nested duplicates.
     *
     * If a question container contains
     * another question container, keep
     * the most specific one.
     */

    return ISE.DOM
        .removeNestedQuestionContainers(
            candidates
        );
};


// ================================================================
// REMOVE NESTED QUESTION CONTAINERS
// ================================================================

ISE.DOM.removeNestedQuestionContainers =
function (
    candidates
) {

    const unique =
        Array.from(
            new Set(
                candidates
            )
        );

    const result =
        [];

    for (
        const candidate
        of unique
    ) {

        let containsAnother =
            false;

        for (
            const other
            of unique
        ) {

            if (
                candidate ===
                other
            ) {
                continue;
            }

            if (
                candidate.contains(
                    other
                )
            ) {

                const candidateScore =
                    ISE.DOM.questionContainerScore(
                        candidate
                    );

                const otherScore =
                    ISE.DOM.questionContainerScore(
                        other
                    );

                /*
                 * If the nested node has
                 * stronger question evidence,
                 * discard the outer node.
                 */

                if (
                    otherScore >=
                    candidateScore
                ) {

                    containsAnother =
                        true;

                    break;
                }
            }
        }

        if (
            !containsAnother
        ) {

            result.push(
                candidate
            );
        }
    }

    return result;
};


// ================================================================
// FIND NEAREST QUESTION CONTAINER
// ================================================================

ISE.DOM.nearestQuestionContainer =
function (
    element
) {

    if (!element) {
        return null;
    }

    let current =
        element;

    let depth =
        0;

    while (
        current &&
        depth < 12
    ) {

        if (
            ISE.DOM.isQuestionCandidate(
                current
            )
        ) {

            return current;
        }

        current =
            current.parentElement;

        depth++;
    }

    return null;
};


// ================================================================
// QUESTION OBJECT CREATION
// ================================================================

ISE.DOM.buildQuestionObject =
function (
    container
) {

    if (!container) {
        return null;
    }

    const text =
        ISE.DOM.questionText(
            container
        );

    if (!text) {
        return null;
    }

    const evidence =
        ISE.question.score(
            text,
            container
        );

    const classification =
        ISE.classifier.classify(
            text
        );

    const controls =
        ISE.DOM.collectControls(
            container
        );

    const object = {

        id:
            ++ISE.STATE
                .questionCounter,

        element:
            container,

        text,

        normalizedText:
            ISE.text
                .normalize(text),

        evidence,

        classification,

        controls,

        controlCount:
            controls.length,

        platform:
            ISE.STATE.platform,

        timestamp:
            Date.now()
    };

    return object;
};


// ================================================================
// QUESTION REGISTRATION
// ================================================================

ISE.DOM.registerQuestion =
function (
    container
) {

    if (!container) {
        return null;
    }

    const question =
        ISE.DOM.buildQuestionObject(
            container
        );

    if (!question) {
        return null;
    }

    ISE.STATE.questions.push(
        question
    );

    ISE.STATE.statistics
        .questionsDetected++;

    return question;
};


// ================================================================
// CONTROL RELATIONSHIP ANALYSIS
// ================================================================

ISE.DOM.analyzeControls =
function (
    question
) {

    if (!question) {
        return [];
    }

    const results =
        [];

    for (
        const control
        of question.controls
    ) {

        const description =
            ISE.DOM.controlDescription(
                control
            );

        const type =
            ISE.DOM.controlType(
                control
            );

        const result = {

            element:
                control,

            type,

            description,

            visible:
                ISE.DOM.isVisible(
                    control
                ),

            disabled:
                ISE.DOM.isDisabled(
                    control
                ),

            answerChoice:
                ISE.DOM.isAnswerChoice(
                    control
                ),

            value:
                control.value ??
                control.getAttribute?.(
                    "data-value"
                ) ??
                "",

            checked:
                Boolean(
                    control.checked
                ),

            selected:
                Boolean(
                    control.selected
                ),

            ariaChecked:
                control.getAttribute?.(
                    "aria-checked"
                ),

            ariaSelected:
                control.getAttribute?.(
                    "aria-selected"
                )
        };

        results.push(
            result
        );
    }

    return results;
};


// ================================================================
// SHADOW DOM DISCOVERY
// ================================================================

ISE.DOM.collectShadowRoots =
function (
    root
) {

    const roots =
        [];

    if (
        !ISE.CONFIG
            .inspectShadowRoots
    ) {
        return roots;
    }

    if (
        !root ||
        typeof root.querySelectorAll !==
        "function"
    ) {
        return roots;
    }

    const elements =
        ISE.DOM.queryAll(
            root,
            "*"
        );

    for (
        const element
        of elements
    ) {

        try {

            if (
                element.shadowRoot
            ) {

                roots.push(
                    element.shadowRoot
                );
            }

        } catch {
        }
    }

    return roots;
};


// ================================================================
// DEEP DOM SCAN
// ================================================================

ISE.DOM.deepDiscover =
function (
    root,
    output
) {

    if (!root) {
        return;
    }

    if (!output) {
        output = [];
    }

    const questions =
        ISE.DOM
            .discoverQuestionContainers(
                root
            );

    for (
        const question
        of questions
    ) {

        if (
            !output.includes(
                question
            )
        ) {

            output.push(
                question
            );
        }
    }


    /*
     * Accessible shadow roots.
     */

    const shadowRoots =
        ISE.DOM.collectShadowRoots(
            root
        );

    for (
        const shadowRoot
        of shadowRoots
    ) {

        ISE.DOM.deepDiscover(
            shadowRoot,
            output
        );
    }


    /*
     * Same-origin frames.
     */

    if (
        ISE.CONFIG
            .inspectSameOriginFrames
    ) {

        const frames =
            ISE.DOM.queryAll(
                root,
                "iframe,frame"
            );

        for (
            const frame
            of frames
        ) {

            try {

                const frameDocument =
                    frame.contentDocument;

                if (
                    frameDocument
                ) {

                    ISE.DOM.deepDiscover(
                        frameDocument,
                        output
                    );
                }

            } catch {
                /*
                 * Cross-origin frames cannot
                 * be inspected from this document.
                 */
            }
        }
    }

    return output;
};


// ================================================================
// PLATFORM DETECTION
// ================================================================

ISE.platform = {};

ISE.platform.detect =
function () {

    const host =
        ISE.text.normalize(
            location.hostname
        );

    if (
        host.includes(
            "primeopinion"
        )
    ) {

        return "primeopinion";
    }

    if (
        host.includes(
            "surveymeasure"
        )
    ) {

        return "surveymeasure";
    }

    if (
        host.includes(
            "sago"
        )
    ) {

        return "sago";
    }

    if (
        host.includes(
            "purespectrum"
        )
    ) {

        return "purespectrum";
    }

    if (
        host.includes(
            "rdsecured"
        )
    ) {

        return "rdsecured";
    }

    if (
        host.includes(
            "samplicio"
        )
    ) {

        return "samplicio";
    }

    return "unknown";
};


// ================================================================
// FULL DOM QUESTION SCAN
// ================================================================

ISE.DOM.scan =
function () {

    if (
        ISE.STATE.scanning
    ) {
        return [];
    }

    ISE.STATE.scanning =
        true;

    try {

        ISE.STATE.statistics
            .scans++;

        const discovered =
            ISE.DOM.deepDiscover(
                document,
                []
            );

        const questions =
            [];

        for (
            const container
            of discovered
        ) {

            /*
             * Never treat an answer choice
             * itself as a question.
             */

            if (
                ISE.DOM.isAnswerChoice(
                    container
                )
            ) {
                continue;
            }

            if (
                !ISE.DOM.isQuestionCandidate(
                    container
                )
            ) {
                continue;
            }

            const existing =
                ISE.STATE.questions
                    .find(
                        question =>
                            question.element ===
                            container
                    );

            if (
                existing
            ) {

                questions.push(
                    existing
                );

                continue;
            }

            const question =
                ISE.DOM.registerQuestion(
                    container
                );

            if (
                question
            ) {

                questions.push(
                    question
                );
            }
        }

        return questions;

    } finally {

        ISE.STATE.scanning =
            false;
    }
};


