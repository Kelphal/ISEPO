            0,

        shadowRootsObserved:
            0,

        shadowRootsScanned:
            0,

        shadowQuestions:
            0,

        frameQuestions:
            0,

        normalQuestions:
            0,

        mutations:
            0,

        frameMutations:
            0,

        shadowMutations:
            0,

        scanRequests:
            0,

        scans:
            0,

        retries:
            0,

        staleFrames:
            0,

        staleShadowRoots:
            0,

        staleQuestions:
            0,

        errors:
            0
    };


    /* ============================================================
       BASIC HELPERS
       ============================================================ */

    function now() {

        return Date.now();
    }


    function normalize(
        value
    ) {

        if (
            value === null ||
            value === undefined
        ) {

            return "";
        }

        return String(
            value
        )
            .toLowerCase()
            .replace(
                /[\r\n\t]+/g,
                " "
            )
            .replace(
                /\s+/g,
                " "
            )
            .trim();
    }


    function clean(
        value
    ) {

        return normalize(
            value
        );
    }


    function isElement(
        value
    ) {

        return (
            value &&
            typeof value ===
            "object" &&
            value.nodeType === 1
        );
    }


    function isDocument(
        value
    ) {

        return (
            value &&
            typeof value ===
            "object" &&
            value.nodeType === 9
        );
    }


    function isShadowRoot(
        value
    ) {

        return (
            value &&
            typeof value ===
            "object" &&
            value.nodeType === 11 &&
            !!value.host
        );
    }


    function isVisible(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {

            return false;
        }

        if (
            element.hidden
        ) {

            return false;
        }

        if (
            element.getAttribute(
                "aria-hidden"
            ) ===
            "true"
        ) {

            return false;
        }

        try {

            var style =
                window.getComputedStyle(
                    element
                );

            if (
                style.display ===
                "none"
            ) {

                return false;
            }

            if (
                style.visibility ===
                "hidden"
            ) {

                return false;
            }

        }
        catch (error) {
        }

        return true;
    }


    function attr(
        element,
        name
    ) {

        if (
            !isElement(
                element
            )
        ) {

            return "";
        }

        try {

            return (
                element.getAttribute(
                    name
                ) ||
                ""
            );

        }
        catch (error) {

            return "";
        }
    }


    function tag(
        element
    ) {

        if (
            !isElement(
                element
            )
        ) {

            return "";
        }

        return String(
            element.tagName ||
            ""
        ).toLowerCase();
    }


    /* ============================================================
       HASHING
       ============================================================ */

    function hash(
        value
    ) {

        var text =
            String(
                value ||
                ""
            );

        var h =
            2166136261;

        for (
            var i = 0;
            i < text.length;
            i++
        ) {

            h ^=
                text.charCodeAt(
                    i
                );

            h +=
                (
                    h << 1
                ) +
                (
                    h << 4
                ) +
                (
                    h << 7
                ) +
                (
                    h << 8
                ) +
                (
                    h << 24
                );
        }

        return (
            h >>> 0
        ).toString(
            16
        );
    }


    /* ============================================================
       ROOT IDENTIFICATION
       ============================================================ */

    function rootId(
        root
    ) {

        if (
            isDocument(
                root
            )
        ) {

            return "document";
        }

        if (
            isShadowRoot(
                root
            )
        ) {

            var host =
                root.host;

            var hostId =
                attr(
                    host,
                    "id"
                );

            var hostName =
                tag(
                    host
                );

            var hostClass =
                attr(
                    host,
                    "class"
                );

            return (
                "shadow:" +
                hash(
                    hostName +
                    "|" +
                    hostId +
                    "|" +
                    hostClass
                )
            );
        }

        if (
            isElement(
                root
            )
        ) {

            return (
                "element:" +
                hash(
                    tag(
                        root
                    ) +
                    "|" +
                    attr(
                        root,
                        "id"
                    ) +
                    "|" +
                    attr(
                        root,
                        "class"
                    )
                )
            );
        }

        return "";
    }


    /* ============================================================
       ELEMENT TREE HELPERS
       ============================================================ */

    function getChildren(
        root
    ) {

        if (
            !root
        ) {

            return [];
        }

        try {

            if (
                root.children
            ) {

                return Array.from(
                    root.children
                );
            }

            if (
                root.childNodes
            ) {

                return Array.from(
                    root.childNodes
                ).filter(
                    function (node) {

                        return (
                            node.nodeType ===
                            1
                        );
                    }
                );
            }

        }
        catch (error) {
        }

        return [];
    }


    function allElements(
        root
    ) {

        if (
            !root ||
            !root.querySelectorAll
        ) {

            return [];
        }

        try {

            return Array.from(
                root.querySelectorAll(
                    "*"
                )
            );

        }
        catch (error) {

            return [];
        }
    }


    /* ============================================================
       QUESTION DISCOVERY
       ============================================================ */

    function getContextEngine() {

        return (
            ISE.ContextIntelligence ||
            null
        );
    }


    function discoverQuestions(
        root
    ) {

        var context =
            getContextEngine();

        if (
            context &&
            typeof context.findQuestionContainers ===
            "function"
        ) {

            try {

                return context
                    .findQuestionContainers(
                        root
                    );

            }
            catch (error) {
            }
        }

        /*
         * Fallback discovery.
         */

        if (
            !root ||
            !root.querySelectorAll
        ) {

            return [];
        }

        var selectors = [

            "[data-question]",

            "[data-question-id]",

            "[data-question-text]",

            "fieldset",

            "[role='group']",

            "[role='radiogroup']",

            "[class*='question']",

            "[class*='Question']",

            "[class*='survey-question']",

            "[class*='SurveyQuestion']"
        ];

        var result = [];

        for (
            var i = 0;
            i < selectors.length;
            i++
        ) {

            try {

                var found =
                    root.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j < found.length;
                    j++
                ) {

                    if (
                        result.indexOf(
                            found[j]
                        ) ===
                        -1
                    ) {

                        result.push(
                            found[j]
                        );
                    }
                }

            }
            catch (error) {
            }
        }

        return result.filter(
            function (element) {

                return (
                    isVisible(
                        element
                    ) &&
                    !!element.querySelector(
                        "input,select,textarea,button,[role='radio'],[role='checkbox'],[role='option'],[role='combobox'],[role='slider']"
                    )
                );
            }
        );
    }


    /* ============================================================
       QUESTION REGISTRATION
       ============================================================ */

    function registerQuestions(
        root,
        sourceType,
        sourceId
    ) {

        var questions =
            discoverQuestions(
                root
            );

        for (
            var i = 0;
            i < questions.length;
            i++
        ) {

            var question =
                questions[i];

            if (
                !question
            ) {

                continue;
            }

            var id =
                attr(
                    question,
                    "data-question-id"
                ) ||
                attr(
                    question,
                    "id"
                ) ||
                (
                    sourceType +
                    ":" +
                    hash(
                        (
                            question.innerText ||
                            question.textContent ||
                            ""
                        ).slice(
                            0,
                            500
                        )
                    )
                );

            engine.state
                .questionRecords
                .set(
                    id,
                    {

                        element:
                            question,

                        sourceType:
                            sourceType,

                        sourceId:
                            sourceId,

                        timestamp:
                            now()
                    }
                );

            engine.state
                .questionCounter++;

            if (
                sourceType ===
                "shadow"
            ) {

                engine.statistics
                    .shadowQuestions++;

            }
            else if (
                sourceType ===
                "frame"
            ) {

                engine.statistics
                    .frameQuestions++;

            }
            else {

                engine.statistics
                    .normalQuestions++;
            }
        }

        return questions;
    }


    /* ============================================================
       SHADOW ROOT DISCOVERY
       ============================================================ */

    function findShadowRoots(
        root
    ) {

        if (
            !engine.config
                .inspectShadowRoots
        ) {

            return [];
        }

        var roots = [];

        if (
            !root
        ) {

            return roots;
        }

        var elements =
            allElements(
                root
            );

        for (
            var i = 0;
            i < elements.length;
            i++
        ) {

            var element =
                elements[i];

            var shadow;

            try {

                shadow =
                    element.shadowRoot;

            }
            catch (error) {

                shadow =
                    null;
            }

            if (
                shadow
            ) {

                if (
                    roots.indexOf(
                        shadow
                    ) ===
                    -1
                ) {

                    roots.push(
                        shadow
                    );
                }
            }
        }

        return roots;
    }


    /* ============================================================
       SHADOW ROOT REGISTRATION
       ============================================================ */

    function registerShadowRoot(
        shadow
    ) {

        if (
            !isShadowRoot(
                shadow
            )
        ) {

            return null;
        }

        var id =
            rootId(
                shadow
            );

        if (
            !id
        ) {

            return null;
        }

        var existing =
            engine.state
                .shadowRecords
                .get(
                    id
                );

        if (
            existing
        ) {

            existing.lastSeen =
                now();

            return existing;
        }

        var record = {

            id:
                id,

            root:
                shadow,

            host:
                shadow.host,

            observer:
                null,

            createdAt:
                now(),

            lastSeen:
                now(),

            scans:
                0,

            mutations:
                0
        };

        engine.state
            .shadowRecords
            .set(
                id,
                record
            );

        engine.statistics
            .shadowRootsDiscovered++;

        engine.state
            .shadowCounter++;

        return record;
    }


    /* ============================================================
       SHADOW OBSERVER
       ============================================================ */

    function observeShadowRoot(
        record
    ) {

        if (
            !record ||
            !record.root
        ) {

            return false;
        }

        if (
            !engine.config
                .observeShadowRoots
        ) {

            return false;
        }

        if (
            typeof MutationObserver ===
            "undefined"
        ) {

            return false;
        }

        if (
            record.observer
        ) {

            return true;
        }

        try {

            record.observer =
                new MutationObserver(
                    function (
                        mutations
                    ) {

                        record.lastSeen =
                            now();

                        record.mutations +=
                            mutations.length;

                        engine.statistics
                            .shadowMutations +=
                            mutations.length;

                        engine.statistics
                            .mutations +=
                            mutations.length;

                        requestScan(
                            "shadow-mutation"
                        );

                    }
                );

            record.observer.observe(
                record.root,
                {

                    childList:
                        true,

                    subtree:
                        true,

                    attributes:
                        true,

                    characterData:
                        true
                }
            );

            engine.statistics
                .shadowRootsObserved++;

            return true;

        }
        catch (error) {

            engine.statistics
                .errors++;

            record.observer =
                null;

            return false;
        }
    }


    /* ============================================================
       SHADOW ROOT SCAN
       ============================================================ */

    function scanShadowRoot(
        record
    ) {

        if (
            !record ||
            !record.root
        ) {

            return [];
        }

        record.lastSeen =
            now();

        record.scans++;

        engine.statistics
            .shadowRootsScanned++;

        var questions =
            registerQuestions(
                record.root,
                "shadow",
                record.id
            );

        /*
         * Continue recursively through nested
         * open shadow roots.
         */

        if (
            engine.config
                .inspectShadowRoots
        ) {

            var nested =
                findShadowRoots(
                    record.root
                );

            for (
                var i = 0;
                i < nested.length;
                i++
            ) {

                var nestedRecord =
                    registerShadowRoot(
                        nested[i]
                    );

                if (
                    nestedRecord
                ) {

                    observeShadowRoot(
                        nestedRecord
                    );

                    scanShadowRoot(
                        nestedRecord
                    );
                }
            }
        }

        return questions;
    }


    /* ============================================================
       DOCUMENT SHADOW SCAN
       ============================================================ */

    function scanAllShadowRoots(
        root
    ) {

        if (
            !root
        ) {

            return;
        }

        var roots =
            findShadowRoots(
                root
            );

        for (
            var i = 0;
            i < roots.length;
            i++
        ) {

            var record =
                registerShadowRoot(
                    roots[i]
                );

            if (
                record
            ) {

                observeShadowRoot(
                    record
                );

                scanShadowRoot(
                    record
                );
            }
        }
    }


    /* ============================================================
       FRAME DISCOVERY
       ============================================================ */

    function getFrames(
        root
    ) {

        if (
            !root ||
            !root.querySelectorAll
        ) {

            return [];
        }

        try {

            return Array.from(
                root.querySelectorAll(
                    "iframe,frame"
                )
            );

        }
        catch (error) {

            return [];
        }
    }


    function frameId(
        frame
    ) {

        if (
            !isElement(
                frame
            )
        ) {

            return "";
        }

        var explicit =
            attr(
                frame,
                "id"
            );

        if (
            explicit
        ) {

            return (
                "frame:id:" +
                explicit
            );
        }

        var name =
            attr(
                frame,
                "name"
            );

        if (
            name
        ) {

            return (
                "frame:name:" +
                name
            );
        }

        var src =
            attr(
                frame,
                "src"
            );

        return (
            "frame:" +
            hash(
                tag(
                    frame
                ) +
                "|" +
                src
            )
        );
    }


    /* ============================================================
       FRAME ACCESS
       ============================================================ */

    function accessFrameDocument(
        frame
    ) {

        if (
            !frame
        ) {

            return null;
        }

        try {

            var documentObject =
                frame.contentDocument;

            if (
                documentObject &&
                documentObject.documentElement
            ) {

                return documentObject;
            }

        }
        catch (error) {

            /*
             * Cross-origin access is blocked by the
             * browser. We intentionally stop here.
             */

            return null;
        }

        return null;
    }


    /* ============================================================
       FRAME REGISTRATION
       ============================================================ */

    function registerFrame(
        frame,
        depth
    ) {

        if (
            !isElement(
                frame
            )
        ) {

            return null;
        }

        var id =
            frameId(
                frame
            );

        if (
            !id
        ) {

            return null;
        }

        var existing =
            engine.state
                .frameRecords
                .get(
                    id
                );

        if (
            existing
        ) {

            existing.lastSeen =
                now();

            existing.element =
                frame;

            return existing;
        }

        var record = {

            id:
                id,

            element:
                frame,

            document:
                null,

            observer:
                null,

            depth:
                depth ||
                0,

            createdAt:
                now(),

            lastSeen:
                now(),

            accessible:
                false,

            scans:
                0,

            mutations:
                0
        };

        engine.state
            .frameRecords
            .set(
                id,
                record
            );

        engine.statistics
            .framesDiscovered++;

        engine.state
            .frameCounter++;

        return record;
    }


    /* ============================================================
       FRAME OBSERVER
       ============================================================ */

    function observeFrame(
        record
    ) {

        if (
            !record ||
            !record.document
        ) {

            return false;
        }

        if (
            !engine.config
                .observeFrames
        ) {

            return false;
        }

        if (
            typeof MutationObserver ===
            "undefined"
        ) {

            return false;
        }

        if (
            record.observer
        ) {

            return true;
        }

        try {

            record.observer =
                new MutationObserver(
                    function (
                        mutations
                    ) {

                        record.lastSeen =
                            now();

                        record.mutations +=
                            mutations.length;

                        engine.statistics
                            .frameMutations +=
                            mutations.length;

                        engine.statistics
                            .mutations +=
                            mutations.length;

                        requestScan(
                            "frame-mutation"
                        );

                    }
                );

            record.observer.observe(
                record.document
                    .documentElement ||
                record.document
                    .body,
                {

                    childList:
                        true,

                    subtree:
                        true,

                    attributes:
                        true,

                    characterData:
                        true
                }
            );

            engine.statistics
                .framesObserved++;

            return true;

        }
        catch (error) {

            engine.statistics
                .errors++;

            record.observer =
                null;

            return false;
        }
    }


    /* ============================================================
       FRAME SCANNING
       ============================================================ */

    function scanFrame(
        record
    ) {

        if (
            !record ||
            !record.document
        ) {

            return [];
        }

        record.lastSeen =
            now();

        record.scans++;

        engine.statistics
            .framesScanned++;

        var body =
            record.document.body ||
            record.document.documentElement;

        if (
            !body
        ) {

            return [];
        }

        var questions =
            registerQuestions(
                body,
                "frame",
                record.id
            );

        scanAllShadowRoots(
            body
        );

        /*
         * Nested iframe support.
         */

        if (
            engine.config
                .inspectNestedFrames &&
            record.depth <
            engine.config.maxFrameDepth
        ) {

            scanFrames(
                body,
                record.depth + 1
            );
        }

        return questions;
    }


    /* ============================================================
       FRAME TREE SCANNING
       ============================================================ */

    function scanFrames(
        root,
        depth
    ) {

        if (
            !engine.config
                .inspectFrames
        ) {

            return;
        }

        if (
            depth >
            engine.config.maxFrameDepth
        ) {

            return;
        }

        var frames =
            getFrames(
                root
            );

        for (
            var i = 0;
            i < frames.length;
            i++
        ) {

            var frame =
                frames[i];

            var record =
                registerFrame(
                    frame,
                    depth
                );

            if (
                !record
            ) {

                continue;
            }

            var documentObject =
                accessFrameDocument(
                    frame
                );

            if (
                !documentObject
            ) {

                engine.statistics
                    .framesBlocked++;

                record.accessible =
                    false;

                continue;
            }

            record.document =
                documentObject;

            record.accessible =
                true;

            engine.statistics
                .framesAccessible++;

            if (
                depth > 0
            ) {

                engine.statistics
                    .nestedFrames++;
            }

            observeFrame(
                record
            );

            scanFrame(
                record
            );
        }
    }


    /* ============================================================
       ROOT SCAN
       ============================================================ */

    function scanRoot() {

        engine.statistics
            .scans++;

        engine.state.lastScan =
            now();

        var root =
            document.body ||
            document.documentElement;

        if (
            !root
        ) {

            return;
        }

        /*
         * Normal page questions.
         */

        registerQuestions(
            root,
            "document",
            "document"
        );

        /*
         * Open Shadow DOM.
         */

        scanAllShadowRoots(
            root
        );

        /*
         * Same-origin frames.
         */

        scanFrames(
            root,
            0
        );

        /*
         * Let DynamicIntelligence perform its
         * normal page-level processing.
         */

        if (
            ISE.DynamicIntelligence &&
            typeof ISE.DynamicIntelligence.scan ===
            "function"
        ) {

            try {

                ISE.DynamicIntelligence.scan(
                    root,
                    "frame-shadow"
                );

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }
    }


    /* ============================================================
       SCHEDULED SCANNING
       ============================================================ */

    function requestScan(
        reason
    ) {

        if (
            !engine.state.running
        ) {

            return;
        }

        engine.statistics
            .scanRequests++;

        if (
            engine.state.scanTimer
        ) {

            return;
        }

        engine.state.scanTimer =
            setTimeout(
                function () {

                    engine.state.scanTimer =
                        null;

                    scanRoot();

                },
                engine.config
                    .scanDelay
            );
    }


    /* ============================================================
       FRAME LIFECYCLE SCANNER
       ============================================================ */

    function refreshFrames() {

        var root =
            document.body ||
            document.documentElement;

        if (
            !root
        ) {

            return;
        }

        scanFrames(
            root,
            0
        );
    }


    /* ============================================================
       SHADOW LIFECYCLE SCANNER
       ============================================================ */

    function refreshShadowRoots() {

        var root =
            document.body ||
            document.documentElement;

        if (
            !root
        ) {

            return;
        }

        scanAllShadowRoots(
            root
        );
    }


    /* ============================================================
       CLEANUP
       ============================================================ */

    function cleanupFrames() {

        var current =
            now();

        engine.state
            .frameRecords
            .forEach(
                function (
                    record,
                    id
                ) {

                    var alive =
                        false;

                    try {

                        alive =
                            !!(
                                record.element &&
                                document.documentElement
                                    .contains(
                                        record.element
                                    )
                            );

                    }
                    catch (error) {
                    }

                    if (
                        !alive &&
                        (
                            current -
                            record.lastSeen
                        ) >
                        30000
                    ) {

                        if (
                            record.observer
                        ) {

                            try {

                                record.observer
                                    .disconnect();

                            }
                            catch (error) {
                            }
                        }

                        engine.state
                            .frameRecords
                            .delete(
                                id
                            );

                        engine.statistics
                            .staleFrames++;
                    }
                }
            );
    }


    function cleanupShadowRoots() {

        var current =
            now();

        engine.state
            .shadowRecords
            .forEach(
                function (
                    record,
                    id
                ) {

                    var alive =
                        false;

                    try {

                        alive =
                            !!(
                                record.host &&
                                document.documentElement
                                    .contains(
                                        record.host
                                    )
                            );

                    }
                    catch (error) {
                    }

                    if (
                        !alive &&
                        (
                            current -
                            record.lastSeen
                        ) >
                        30000
                    ) {

                        if (
                            record.observer
                        ) {

                            try {

                                record.observer
                                    .disconnect();

                            }
                            catch (error) {
                            }
