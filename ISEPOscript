                );

            var numberB =
                Number(
                    b.replace(
                        /[$,% ,]/g,
                        ""
                    )
                );

            if (
                !isNaN(numberA) &&
                !isNaN(numberB)
            ) {

                return (
                    numberA ===
                    numberB
                );
            }

            return false;
        };


