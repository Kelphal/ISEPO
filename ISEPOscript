/* ============================================================
   RANGE INTERPRETATION
   ============================================================ */

ISE.AdvancedSemantics.parseRange =
function(
    text
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    var values = [];

    var regex =
        /(?:\$?\s*)?(\d+(?:,\d{3})*(?:\.\d+)?)\s*(k|m)?/gi;

    var match;

    while(
        (
            match =
            regex.exec(
                normalized
            )
        ) !==
        null
    )
    {
        var number =
            Number(
                match[1]
                    .replace(
                        /,/g,
                        ""
                    )
            );

        if(
            match[2] ===
            "k"
        )
        {
            number *=
                1000;
        }

        if(
            match[2] ===
            "m"
        )
        {
            number *=
                1000000;
        }

        if(
            !isNaN(number)
        )
        {
            values.push(
                number
            );
        }
    }

    if(
        values.length <
        2
    )
    {
        return null;
    }

    return {
        minimum:
            Math.min(
                values[0],
                values[1]
            ),

        maximum:
            Math.max(
                values[0],
                values[1]
            )
    };
};


/* ============================================================
   VALUE-IN-RANGE
   ============================================================ */

ISE.AdvancedSemantics.valueInRange =
function(
    value,
    range
)
{
    var number =
        Number(
            value
        );

    if(
        isNaN(number) ||
        !range
    )
    {
        return false;
    }

    return (
        number >=
        range.minimum &&
        number <=
        range.maximum
    );
};


