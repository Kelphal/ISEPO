/* ------------------------------------------------------------
   EXPIRE OLD MEMORY
   ------------------------------------------------------------ */

ISE.DynamicEngine.cleanupMemory =
function () {

    var now =
        Date.now();

    var maxAge =
        30 *
        60 *
        1000;

    var processed =
        ISE.DynamicEngine
            .processedFingerprints;

    var failed =
        ISE.DynamicEngine
            .failedFingerprints;

    Object.keys(
        processed
    )
    .forEach(
        function (
            key
        ) {

            if (
                now -
                processed[key].time >
                maxAge
            ) {

                delete processed[key];
            }
        }
    );

    Object.keys(
        failed
    )
    .forEach(
        function (
            key
        ) {

            if (
                now -
                failed[key].time >
                maxAge
            ) {

                delete failed[key];
            }
        }
    );
};


/* ------------------------------------------------------------
   MUTATION INTEREST TEST
   ------------------------------------------------------------ */

ISE.DynamicEngine.isInterestingMutation =
function (
    mutation
) {

    if (!mutation) {
        return false;
    }

    if (
        mutation.type ===
        "characterData"
    ) {

        return true;
    }

    if (
        mutation.type ===
        "attributes"
    ) {

        var name =
            String(
                mutation.attributeName ||
                ""
            ).toLowerCase();

        return [
            "value",
            "checked",
            "selected",
            "disabled",
            "hidden",
            "style",
            "class",
            "aria-label",
            "aria-checked",
            "aria-selected",
            "data-value",
            "data-answer"
        ].indexOf(
            name
        ) !== -1;
    }

    if (
        mutation.type ===
        "childList"
    ) {

        return (
            mutation.addedNodes &&
            mutation.addedNodes.length > 0
        );
    }

    return false;
};


/* ------------------------------------------------------------
   NODE CONTAINS SURVEY CONTENT
   ------------------------------------------------------------ */

ISE.DynamicEngine.looksLikeSurveyNode =
function (
    node
) {

    if (!node) {
        return false;
    }

    var name =
        ISE.DynamicEngine
            .nodeType(
                node
            );

    if (
        name === "input" ||
        name === "select" ||
        name === "textarea" ||
        name === "button" ||
        name === "fieldset" ||
        name === "table"
    ) {
        return true;
    }

    var role =
        ISE.DynamicEngine
            .attr(
                node,
                "role"
            );

    if (
        role === "radio" ||
        role === "checkbox" ||
        role === "option" ||
        role === "combobox" ||
        role === "listbox" ||
        role === "slider" ||
        role === "grid"
    ) {
        return true;
    }

    var dataQuestion =
        ISE.DynamicEngine
            .attr(
                node,
                "data-question"
            );

    if (dataQuestion) {
        return true;
    }

    var className =
        ISE.DynamicEngine
            .attr(
                node,
                "class"
            )
            .toLowerCase();

    if (
        className.indexOf(
            "question"
        ) !== -1 ||
        className.indexOf(
            "survey"
        ) !== -1 ||
        className.indexOf(
            "answer"
        ) !== -1
    ) {
        return true;
    }

    return false;
};


/* ------------------------------------------------------------
   FIND RELEVANT ROOT
   ------------------------------------------------------------ */

ISE.DynamicEngine.nearestRelevantRoot =
function (
    node
) {

    if (!node) {
        return null;
    }

    var current =
        node;

    var depth = 0;

    while (
        current &&
        depth < 12
    ) {

        if (
            ISE.DynamicEngine
                .looksLikeSurveyNode(
                    current
                )
        ) {

            return current;
        }

        current =
            current.parentElement;

        depth++;
    }

    return node.parentElement ||
        node;
};


/* ------------------------------------------------------------
   QUEUE NODE
   ------------------------------------------------------------ */

ISE.DynamicEngine.queueNode =
function (
    node
) {

    if (!node) {
        return;
    }

    var root =
        ISE.DynamicEngine
            .nearestRelevantRoot(
                node
            );

    if (!root) {
        return;
    }

    if (
        ISE.DynamicEngine
            .scanQueue
            .indexOf(
                root
            ) === -1
    ) {

        ISE.DynamicEngine
            .scanQueue
            .push(
                root
            );
    }
};


/* ------------------------------------------------------------
   QUEUE MUTATION
   ------------------------------------------------------------ */

ISE.DynamicEngine.queueMutation =
function (
    mutation
) {

    if (!mutation) {
        return;
    }

    ISE.DynamicEngine
        .dynamicStats
        .mutations++;

    if (
        mutation.target
    ) {

        ISE.DynamicEngine
            .queueNode(
                mutation.target
            );
    }

    if (
        mutation.addedNodes
    ) {

        for (
            var i = 0;
            i <
            mutation.addedNodes.length;
            i++
        ) {

            ISE.DynamicEngine
                .queueNode(
                    mutation.addedNodes[i]
                );
        }
    }

    ISE.DynamicEngine
        .scheduleScan();
};


/* ------------------------------------------------------------
   SCHEDULE SCAN
   ------------------------------------------------------------ */

ISE.DynamicEngine.scheduleScan =
function () {

    if (
        ISE.DynamicEngine
            .scanScheduled
    ) {
        return;
    }

    ISE.DynamicEngine
        .scanScheduled = true;

    var timer =
        setTimeout(
            function () {

                ISE.DynamicEngine
                    .scanScheduled = false;

                ISE.DynamicEngine
                    .flushQueue();

            },
            180
        );

    ISE.DynamicEngine
        .timers
        .push(
            timer
        );
};


/* ------------------------------------------------------------
   FLUSH QUEUE
   ------------------------------------------------------------ */

ISE.DynamicEngine.flushQueue =
function () {

    if (
        ISE.DynamicEngine
            .processing
    ) {
        return;
    }

    ISE.DynamicEngine
        .processing = true;

    try {

        var queue =
            ISE.DynamicEngine
                .scanQueue
                .slice();

        ISE.DynamicEngine
            .scanQueue = [];

        for (
            var i = 0;
            i < queue.length;
            i++
        ) {

            ISE.DynamicEngine
                .scanRoot(
                    queue[i]
                );
        }

    } catch (error) {

        if (ISE.warn) {

            ISE.warn(
                "Dynamic queue processing error:",
                error
            );
        }

    } finally {

        ISE.DynamicEngine
            .processing = false;
    }
};


/* ------------------------------------------------------------
   QUESTION EXTRACTION
   ------------------------------------------------------------ */

ISE.DynamicEngine.extractQuestions =
function (
    root
) {

    if (!root) {
        return [];
    }

    var questions = [];

    /*
     * First use the question intelligence system
     * already built in earlier parts.
     */

    if (
        ISE.DOM &&
        typeof ISE.DOM.discoverQuestions ===
        "function"
    ) {

        try {

            var discovered =
                ISE.DOM.discoverQuestions(
                    root
                );

            if (
                Array.isArray(
                    discovered
                )
            ) {

                questions =
                    questions.concat(
                        discovered
                    );
            }

        } catch (error) {}
    }

    /*
     * Fallback discovery.
     */

    if (!questions.length) {

        var nodes = [];

        try {

            nodes =
                root.querySelectorAll(
                    "[data-question]," +
                    "[data-question-id]," +
                    "[data-survey-question]," +
                    "fieldset"
                );

        } catch (error) {}

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var node =
                nodes[i];

            var text =
                ISE.DynamicEngine
                    .text(
                        node
                    );

            if (!text) {
                continue;
            }

            questions.push({

                element:
                    node,

                container:
                    node,

                text:
                    text
            });
        }
    }

    return questions;
};


/* ------------------------------------------------------------
   QUESTION NORMALIZATION
   ------------------------------------------------------------ */

ISE.DynamicEngine.normalizeQuestion =
function (
    question
) {

    if (!question) {
        return null;
    }

    var element =
        question.element ||
        null;

    var container =
        question.container ||
        element ||
        null;

    var text =
        question.text ||
        question.question ||
        "";

    if (!text && container) {

        text =
            ISE.DynamicEngine
                .text(
                    container
                );
    }

    text =
        ISE.DynamicEngine
            .normalize(
                text
            );

    if (!text) {
        return null;
    }

    var normalized = {

        element:
            element,

        container:
            container,

        text:
            text,

        category:
            question.category ||
            null,

        type:
            question.type ||
            null,

        fingerprint:
            ""
    };

    normalized.fingerprint =
        ISE.DynamicEngine
            .fingerprint(
                normalized
            );

    return normalized;
};


/* ------------------------------------------------------------
   DUPLICATE QUESTION COLLAPSING
   ------------------------------------------------------------ */

ISE.DynamicEngine.collapseDuplicates =
function (
    questions
) {

    var output = [];

    var seen = {};

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        var question =
            ISE.DynamicEngine
                .normalizeQuestion(
                    questions[i]
                );

        if (!question) {
            continue;
        }

        var fingerprint =
            question.fingerprint;

        if (!fingerprint) {
            continue;
        }

        if (
            seen[fingerprint]
        ) {

            ISE.DynamicEngine
                .dynamicStats
                .duplicateQuestions++;

            continue;
        }

        seen[fingerprint] =
            true;

        output.push(
            question
        );
    }

    return output;
};


/* ------------------------------------------------------------
   QUESTION PROCESSOR
   ------------------------------------------------------------ */

ISE.DynamicEngine.processQuestion =
function (
    question
) {

    if (!question) {
        return {
            success: false,
            reason:
                "Missing question."
        };
    }

    var normalized =
        ISE.DynamicEngine
            .normalizeQuestion(
                question
            );

    if (!normalized) {

        return {
            success: false,
            reason:
                "Could not normalize question."
        };
    }

    var fingerprint =
        normalized.fingerprint;

    if (
        ISE.DynamicEngine
            .wasProcessed(
                fingerprint
            )
    ) {

        ISE.DynamicEngine
            .dynamicStats
            .questionsSkipped++;

        return {
            success: false,
            skipped: true,
            reason:
                "Question already processed."
        };
    }

    /*
     * Specialized structures get first opportunity.
     */

    if (
        ISE.SpecializedSurvey &&
        typeof ISE.SpecializedSurvey
            .process ===
            "function"
    ) {

        try {

            var specialized =
                ISE.SpecializedSurvey
                    .process(
                        normalized.text,
                        normalized.container
                    );

            if (
                specialized &&
                specialized.success
            ) {

                ISE.DynamicEngine
                    .markProcessed(
                        fingerprint,
                        specialized
                    );

                ISE.DynamicEngine
                    .dynamicStats
                    .questionsProcessed++;

                return specialized;
            }

        } catch (error) {

            if (ISE.warn) {

                ISE.warn(
                    "Specialized processing failed:",
                    error
                );
            }
        }
    }

    /*
     * Standard autofill engine.
     */

    if (
        ISE.AutofillEngine &&
        typeof ISE.AutofillEngine
            .processQuestion ===
            "function"
    ) {

        try {

            var result =
                ISE.AutofillEngine
                    .processQuestion(
                        normalized
                    );

            if (
                result &&
                result.success
            ) {

                ISE.DynamicEngine
                    .markProcessed(
                        fingerprint,
                        result
                    );

                ISE.DynamicEngine
                    .dynamicStats
                    .questionsProcessed++;

                return result;
            }

            if (
                result &&
                result.reason
            ) {

                ISE.DynamicEngine
                    .markFailed(
                        fingerprint,
                        result.reason
                    );
            }

        } catch (error) {

            ISE.DynamicEngine
                .markFailed(
                    fingerprint,
                    error.message ||
                    "Processing error"
                );
        }
    }

    ISE.DynamicEngine
        .dynamicStats
        .questionsSkipped++;

    return {
        success: false,
        unsupported: true,
        reason:
            "No profile-supported answer."
    };
};


/* ------------------------------------------------------------
   SCAN ROOT
   ------------------------------------------------------------ */

ISE.DynamicEngine.scanRoot =
function (
    root
) {

    if (!root) {
        return;
    }

    ISE.DynamicEngine
        .dynamicStats
        .rescans++;

    var questions =
        ISE.DynamicEngine
            .extractQuestions(
                root
            );

    questions =
        ISE.DynamicEngine
            .collapseDuplicates(
                questions
            );

    for (
        var i = 0;
        i < questions.length;
        i++
    ) {

        ISE.DynamicEngine
            .processQuestion(
                questions[i]
            );
    }

    ISE.DynamicEngine
        .scanShadowRoots(
            root
        );

    ISE.DynamicEngine
        .scanFrames(
            root
        );
};


/* ------------------------------------------------------------
   DEEP SHADOW ROOT COLLECTION
   ------------------------------------------------------------ */

ISE.DynamicEngine.collectShadowRoots =
function (
    root
) {

    var roots = [];

    if (!root) {
        return roots;
    }

    var elements = [];

    try {

        if (
            root.querySelectorAll
        ) {

            elements =
                root.querySelectorAll(
                    "*"
                );
        }

    } catch (error) {}

    for (
        var i = 0;
        i < elements.length;
        i++
    ) {

        var element =
            elements[i];

        try {

            if (
                element.shadowRoot
            ) {

                roots.push(
                    element.shadowRoot
                );

                ISE.DynamicEngine
                    .dynamicStats
                    .shadowRoots++;
            }

        } catch (error) {}
    }

    return roots;
};


/* ------------------------------------------------------------
   SCAN SHADOW ROOTS
   ------------------------------------------------------------ */

ISE.DynamicEngine.scanShadowRoots =
function (
    root
) {

    if (
        !ISE.CONFIG ||
        ISE.CONFIG.inspectShadowRoots !==
        true
    ) {
        return;
    }

    var roots =
        ISE.DynamicEngine
            .collectShadowRoots(
                root
            );

    for (
        var i = 0;
        i < roots.length;
        i++
    ) {

        var shadow =
            roots[i];

        ISE.DynamicEngine
            .scanRoot(
                shadow
            );
    }
};


/* ------------------------------------------------------------
   SAME-ORIGIN FRAME CHECK
   ------------------------------------------------------------ */

ISE.DynamicEngine.getFrameDocument =
function (
    frame
) {

    if (!frame) {
        return null;
    }

    try {

        return (
            frame.contentDocument ||
            frame.contentWindow.document
        );

    } catch (error) {

        /*
         * Cross-origin frames intentionally stop here.
         */

        return null;
    }
};


/* ------------------------------------------------------------
   FRAME COLLECTION
   ------------------------------------------------------------ */

ISE.DynamicEngine.collectFrames =
function (
    root
) {

    var frames = [];

    if (!root) {
        return frames;
    }

    try {

        var nodes =
            root.querySelectorAll(
                "iframe,frame"
            );

        for (
            var i = 0;
            i < nodes.length;
            i++
        ) {

            var documentRef =
                ISE.DynamicEngine
                    .getFrameDocument(
                        nodes[i]
                    );

            if (
                documentRef
            ) {

                frames.push(
                    documentRef
                );

                ISE.DynamicEngine
                    .dynamicStats
                    .frames++;
            }
        }

    } catch (error) {}

    return frames;
};


/* ------------------------------------------------------------
   FRAME SCAN
   ------------------------------------------------------------ */

ISE.DynamicEngine.scanFrames =
function (
    root
) {

    if (
        !ISE.CONFIG ||
        ISE.CONFIG.inspectSameOriginFrames !==
        true
    ) {
        return;
    }

    var frames =
        ISE.DynamicEngine
            .collectFrames(
                root
            );

    for (
        var i = 0;
        i < frames.length;
        i++
    ) {

        ISE.DynamicEngine
            .scanRoot(
                frames[i]
            );
    }
};


/* ------------------------------------------------------------
   OBSERVER TARGETS
   ------------------------------------------------------------ */

ISE.DynamicEngine.getObserverTargets =
function () {

    var targets = [];

    if (document) {

        targets.push(
            document.documentElement ||
            document
        );
    }

    /*
     * Include same-origin iframe documents.
     */

    if (
        ISE.CONFIG &&
        ISE.CONFIG.inspectSameOriginFrames ===
        true
    ) {

        var frames =
            ISE.DynamicEngine
                .collectFrames(
                    document
                );

        for (
            var i = 0;
            i < frames.length;
            i++
        ) {

            targets.push(
                frames[i]
            );
        }
    }

    return ISE.DynamicEngine
        .unique(
            targets
        );
};


/* ------------------------------------------------------------
   OBSERVER CREATION
   ------------------------------------------------------------ */

ISE.DynamicEngine.observe =
function (
    target
) {

    if (!target) {
        return null;
    }

    if (
        typeof MutationObserver ===
        "undefined"
    ) {
        return null;
    }

    var observer =
        new MutationObserver(
            function (
                mutations
            ) {

                for (
                    var i = 0;
                    i < mutations.length;
                    i++
                ) {

                    var mutation =
                        mutations[i];

                    if (
                        ISE.DynamicEngine
                            .isInterestingMutation(
                                mutation
                            )
                    ) {

                        ISE.DynamicEngine
                            .queueMutation(
                                mutation
                            );
                    }
                }
            }
        );

    try {

        observer.observe(
            target,
            {
                childList: true,
                subtree: true,
                characterData: true,
                attributes: true,
                attributeFilter: [
                    "value",
                    "checked",
                    "selected",
                    "disabled",
                    "hidden",
                    "style",
                    "class",
                    "aria-label",
                    "aria-checked",
                    "aria-selected",
                    "data-value",
                    "data-answer"
                ]
            }
        );

        ISE.DynamicEngine
            .observers
            .push(
                observer
            );

        return observer;

    } catch (error) {

        return null;
    }
};


/* ------------------------------------------------------------
   RECONNECT FRAME OBSERVERS
   ------------------------------------------------------------ */

ISE.DynamicEngine.refreshFrameObservers =
function () {

    if (
        !ISE.CONFIG ||
        ISE.CONFIG.inspectSameOriginFrames !==
        true
    ) {
        return;
    }

    var frames =
        ISE.DynamicEngine
            .collectFrames(
                document
            );

    for (
        var i = 0;
        i < frames.length;
        i++
    ) {

        ISE.DynamicEngine
            .observe(
                frames[i]
            );
    }
};


/* ------------------------------------------------------------
   PERIODIC RESCAN
   ------------------------------------------------------------ */

ISE.DynamicEngine.startPeriodicScan =
function () {

    var timer =
        setInterval(
            function () {

                if (
                    ISE.DynamicEngine
                        .processing
                ) {
                    return;
                }

                ISE.DynamicEngine
                    .cleanupMemory();

                ISE.DynamicEngine
                    .scanRoot(
                        document
                    );

                ISE.DynamicEngine
                    .refreshFrameObservers();

            },
            2500
        );

    ISE.DynamicEngine
        .timers
        .push(
            timer
        );
};


/* ------------------------------------------------------------
   SPA NAVIGATION HOOKS
   ------------------------------------------------------------ */

ISE.DynamicEngine.hookHistory =
function () {

    if (
        ISE.DynamicEngine
            .historyHooked
    ) {
        return;
    }

    ISE.DynamicEngine
        .historyHooked = true;

    try {

        var originalPush =
            history.pushState;

        history.pushState =
            function () {

                var result =
                    originalPush.apply(
                        this,
                        arguments
                    );

                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .scanRoot(
                                document
                            );

                    },
                    100
                );

                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .scanRoot(
                                document
                            );

                    },
                    600
                );

                return result;
            };

        var originalReplace =
            history.replaceState;

        history.replaceState =
            function () {

                var result =
                    originalReplace.apply(
                        this,
                        arguments
                    );

                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .scanRoot(
                                document
                            );

                    },
                    100
                );

                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .scanRoot(
                                document
                            );

                    },
                    600
                );

                return result;
            };

    } catch (error) {}


    window.addEventListener(
        "popstate",
        function () {

            setTimeout(
                function () {

                    ISE.DynamicEngine
                        .scanRoot(
                            document
                        );

                },
                100
            );

            setTimeout(
                function () {

                    ISE.DynamicEngine
                        .scanRoot(
                            document
                        );

                },
                600
            );
        }
    );
};


/* ------------------------------------------------------------
   URL CHANGE DETECTION
   ------------------------------------------------------------ */

ISE.DynamicEngine.currentURL =
    location.href;


ISE.DynamicEngine.checkURL =
function () {

    var current =
        location.href;

    if (
        current ===
        ISE.DynamicEngine.currentURL
    ) {
        return;
    }

    ISE.DynamicEngine.currentURL =
        current;

    /*
     * New SPA route.
     */

    ISE.DynamicEngine
        .processedFingerprints = {};

    ISE.DynamicEngine
        .failedFingerprints = {};

    setTimeout(
        function () {

            ISE.DynamicEngine
                .scanRoot(
                    document
                );

        },
        150
    );

    setTimeout(
        function () {

            ISE.DynamicEngine
                .scanRoot(
                    document
                );

        },
        800
    );
};


/* ------------------------------------------------------------
   URL WATCHER
   ------------------------------------------------------------ */

ISE.DynamicEngine.startURLWatcher =
function () {

    var timer =
        setInterval(
            function () {

                ISE.DynamicEngine
                    .checkURL();

            },
            500
        );

    ISE.DynamicEngine
        .timers
        .push(
            timer
        );
};


/* ------------------------------------------------------------
   DELAYED CONTROL CHECK
   ------------------------------------------------------------ */

ISE.DynamicEngine.retryQuestionLater =
function (
    question,
    delays
) {

    if (
        !question
    ) {
        return;
    }

    var list =
        Array.isArray(
            delays
        )
            ? delays
            : [
                300,
                800,
                1600,
                3000
            ];

    for (
        var i = 0;
        i < list.length;
        i++
    ) {

        (function (
            delay
        ) {

            var timer =
                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .dynamicStats
                            .delayedQuestions++;

                        ISE.DynamicEngine
                            .processQuestion(
                                question
                            );

                    },
                    delay
                );

            ISE.DynamicEngine
                .timers
                .push(
                    timer
                );

        })(
            list[i]
        );
    }
};


/* ------------------------------------------------------------
   CONTROL APPEARANCE MONITOR
   ------------------------------------------------------------ */

ISE.DynamicEngine.watchQuestion =
function (
    question
) {

    if (!question) {
        return;
    }

    /*
     * Some survey platforms render the question
     * before rendering its actual answer controls.
     *
     * Recheck without assuming the answer.
     */

    ISE.DynamicEngine
        .retryQuestionLater(
            question,
            [
                250,
                600,
                1200,
                2500
            ]
        );
};


/* ------------------------------------------------------------
   CUSTOM EVENT HOOK
   ------------------------------------------------------------ */

ISE.DynamicEngine.hookSurveyEvents =
function () {

    var events = [

        "change",

        "input",

        "click",

        "survey:question",

        "question:loaded",

        "question:shown",

        "survey:render",

        "survey:next"
    ];

    for (
        var i = 0;
        i < events.length;
        i++
    ) {

        (function (
            eventName
        ) {

            document.addEventListener(
                eventName,
                function (
                    event
                ) {

                    var target =
                        event.target;

                    if (!target) {
                        return;
                    }

                    ISE.DynamicEngine
                        .queueNode(
                            target
                        );

                    ISE.DynamicEngine
                        .scheduleScan();

                },
                true
            );

        })(
            events[i]
        );
    }
};


/* ------------------------------------------------------------
   PLATFORM-SPECIFIC DOM SIGNALS
   ------------------------------------------------------------ */

ISE.DynamicEngine.platformSignals =
function () {

    var host =
        location.hostname
            .toLowerCase();

    var result = {

        primeOpinion:
            host.indexOf(
                "primeopinion"
            ) !== -1,

        surveyMeasure:
            host.indexOf(
                "surveymeasure"
            ) !== -1,

        sago:
            host.indexOf(
                "sago"
            ) !== -1,

        pureSpectrum:
            host.indexOf(
                "purespectrum"
            ) !== -1,

        rdsecured:
            host.indexOf(
                "rdsecured"
            ) !== -1,

        samplicio:
            host.indexOf(
                "samplicio"
            ) !== -1
    };

    return result;
};


/* ------------------------------------------------------------
   PLATFORM ADAPTATION
   ------------------------------------------------------------ */

ISE.DynamicEngine.platformAdaptation =
function () {

    var signals =
        ISE.DynamicEngine
            .platformSignals();

    /*
     * These adaptations only change scan timing and
     * DOM observation behavior. They do not fabricate
     * answers or automatically submit surveys.
     */

    if (
        signals.primeOpinion
    ) {

        return {
            name:
                "Prime Opinion",

            scanDelay:
                150,

            retryDelay:
                600
        };
    }

    if (
        signals.surveyMeasure
    ) {

        return {
            name:
                "SurveyMeasure",

            scanDelay:
                200,

            retryDelay:
                800
        };
    }

    if (
        signals.sago
    ) {

        return {
            name:
                "Sago",

            scanDelay:
                200,

            retryDelay:
                900
        };
    }

    if (
        signals.pureSpectrum
    ) {

        return {
            name:
                "PureSpectrum",

            scanDelay:
                150,

            retryDelay:
                700
        };
    }

    if (
        signals.rdsecured
    ) {

        return {
            name:
                "RDSecured",

            scanDelay:
                250,

            retryDelay:
                900
        };
    }

    if (
        signals.samplicio
    ) {

        return {
            name:
                "Samplicio",

            scanDelay:
                250,

            retryDelay:
                900
        };
    }

    return {
        name:
            "Generic Survey Platform",

        scanDelay:
            250,

        retryDelay:
            1000
    };
};


/* ------------------------------------------------------------
   INITIAL DOCUMENT SCAN
   ------------------------------------------------------------ */

ISE.DynamicEngine.initialScan =
function () {

    var adaptation =
        ISE.DynamicEngine
            .platformAdaptation();

    var delays = [

        0,

        adaptation.scanDelay,

        adaptation.scanDelay * 3,

        adaptation.retryDelay,

        adaptation.retryDelay * 2,

        3000
    ];

    for (
        var i = 0;
        i < delays.length;
        i++
    ) {

        (function (
            delay
        ) {

            var timer =
                setTimeout(
                    function () {

                        ISE.DynamicEngine
                            .scanRoot(
                                document
                            );

                    },
                    delay
                );

            ISE.DynamicEngine
                .timers
                .push(
                    timer
                );

        })(
            delays[i]
        );
    }
};


/* ------------------------------------------------------------
   START
   ------------------------------------------------------------ */

ISE.DynamicEngine.start =
function () {

    if (
        ISE.DynamicEngine.started
    ) {
        return false;
    }

    ISE.DynamicEngine.started =
        true;

    /*
     * Main document observer.
     */

    ISE.DynamicEngine.observe(
        document.documentElement ||
        document
    );


    /*
     * Same-origin frames.
     */

    ISE.DynamicEngine
        .refreshFrameObservers();


    /*
     * SPA history.
     */

    ISE.DynamicEngine
