        undefined
    )
    {
        return null;
    }

    var text =
        ISE.AdvancedSemantics
            .normalize(
                value
            );

    var multiplier =
        1;

    if(
        /\bk\b/.test(
            text
        )
    )
    {
        multiplier =
            1000;
    }

    if(
        /\bm\b/.test(
            text
        )
    )
    {
        multiplier =
            1000000;
    }

    var cleaned =
        text
            .replace(
                /,/g,
                ""
            )
            .replace(
                /\$/g,
                ""
            );

    var match =
        cleaned.match(
            /(\d+(?:\.\d+)?)/
        );

    if(
        !match
    )
    {
        return null;
    }

    var number =
        Number(
            match[1]
        );

    if(
        isNaN(number)
    )
    {
        return null;
    }

    return (
        number *
        multiplier
    );
};


