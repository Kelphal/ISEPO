/* ============================================================
   TOKEN OVERLAP
   ============================================================ */

ISE.AdvancedSemantics.tokenOverlap =
function(
    a,
    b
)
{
    var left =
        ISE.AdvancedSemantics
            .tokens(
                a
            );

    var right =
        ISE.AdvancedSemantics
            .tokens(
                b
            );

    if(
        !left.length ||
        !right.length
    )
    {
        return 0;
    }

    var lookup =
        {};

    for(
        var i = 0;
        i < right.length;
        i++
    )
    {
        lookup[
            right[i]
        ] =
            true;
    }

    var matches = 0;

    for(
        var j = 0;
        j < left.length;
        j++
    )
    {
        if(
            lookup[
                left[j]
            ]
        )
        {
            matches++;
        }
    }

    return (
        matches /
        Math.max(
            left.length,
            right.length
        )
    );
};


