   ============================================================ */

ISE.PlatformEngine.buildQuestion =
function(
    container
)
{
    if(
        !container
    )
    {
        return null;
    }

    var controls =
        ISE.PlatformEngine
            .collectControls(
                container
            );

    if(
        !controls.length
    )
    {
        return null;
    }

    var text =
        ISE.PlatformEngine
            .extractQuestionText(
                container
            );

    if(
        !text ||
        text.length <
        3
    )
    {
        return null;
    }

    var id =
        ISE.PlatformEngine
            .safeAttr(
                container,
                "data-question-id"
            ) ||
        ISE.PlatformEngine
            .safeAttr(
                container,
                "id"
            ) ||
        ISE.PlatformEngine
            .normalize(
                text
            ).slice(
                0,
                120
            );

    var question =
    {
        id:
            id,

        text:
            text,

        question:
            text,

        container:
            container,

        element:
            container,

        controls:
            controls,

        platform:
            ISE.PlatformEngine
                .platform,

        adapter:
            ISE.PlatformEngine
                .adapter,

        detectedAt:
            Date.now(),

        state:
            "detected"
    };

    /*
     * Use the existing classifier so answer
     * choices themselves aren't treated as questions.
     */

    if(
        ISE.classifier &&
        typeof ISE.classifier.classify ===
        "function"
    )
    {
        try
        {
            question.classification =
                ISE.classifier
                    .classify(
                        text
                    );
        }
        catch(error)
        {
        }
    }

    return question;
};


/* ============================================================
   GENERIC DISCOVERY
   ============================================================ */

ISE.PlatformEngine.discoverGeneric =
function(
    root
)
{
    var scope =
        root ||
        document;

    var questions =
        [];

    try
    {
        var selectors =
            ISE.PlatformEngine
                .adapter &&
            ISE.PlatformEngine
                .adapter
                .questionSelectors
            ?
            ISE.PlatformEngine
                .adapter
                .questionSelectors
            :
            ISE.PlatformEngine
                .common
                .questionSelectors;

        var nodes =
            scope.querySelectorAll(
                selectors.join(",")
            );

        for(
            var i = 0;
            i < nodes.length;
            i++
        )
        {
            if(
                ISE.PlatformEngine
                    .config
                    .processVisibleOnly &&
                !ISE.PlatformEngine
                    .isVisible(
                        nodes[i]
                    )
            )
            {
                continue;
            }

            var question =
                ISE.PlatformEngine
                    .buildQuestion(
                        nodes[i]
                    );

            if(
                question
            )
            {
                questions.push(
                    question
                );
            }
        }
    }
    catch(error)
    {
    }

    /*
     * Some survey systems don't expose a
     * question wrapper. Find controls and
     * climb upward automatically.
     */

    try
    {
        var controls =
            scope.querySelectorAll(
                ISE.PlatformEngine
                    .common
                    .controlSelectors
                    .join(",")
            );

        for(
            var j = 0;
            j < controls.length;
            j++
        )
        {
            if(
                !ISE.PlatformEngine
                    .isVisible(
                        controls[j]
                    )
            )
            {
                continue;
            }

            var parent =
                ISE.PlatformEngine
                    .findQuestionContainer(
                        controls[j]
                    );

            if(
                !parent
            )
            {
                continue;
            }

            var fallback =
                ISE.PlatformEngine
                    .buildQuestion(
                        parent
                    );

            if(
                fallback
            )
            {
                questions.push(
                    fallback
                );
            }
        }
    }
    catch(error)
    {
    }

    return ISE.PlatformEngine
        .deduplicateQuestions(
            questions
        );
};


/* ============================================================
   DEDUPLICATION
   ============================================================ */

ISE.PlatformEngine.deduplicateQuestions =
function(
    questions
)
{
    var result =
        [];

    var seen =
        {};

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        var q =
            questions[i];

        var normalized =
            ISE.PlatformEngine
                .normalize(
                    q.text
                );

        var key =
            q.id +
            "|" +
            normalized;

        if(
            seen[key]
        )
        {
            continue;
        }

        seen[key] =
            true;

        result.push(
            q
        );
    }

    return result;
};


/* ============================================================
   ANSWER RESOLUTION
   ============================================================ */

ISE.PlatformEngine.resolveAnswer =
function(
    question
)
{
    if(
        !question
    )
    {
        return {
            supported:
                false,

            reason:
                "Missing question."
        };
    }

    var text =
        question.text ||
        question.question ||
        "";

    /*
     * Advanced semantic engine.
     */

    if(
        ISE.AdvancedSemantics &&
        typeof ISE.AdvancedSemantics
            .safeResolve ===
        "function"
    )
    {
        try
        {
            var advanced =
                ISE.AdvancedSemantics
                    .safeResolve(
                        text
                    );

            if(
                advanced &&
                advanced.supported
            )
            {
                return advanced;
            }
        }
        catch(error)
        {
        }
    }

    /*
     * Existing AnswerEngine.
     */

    if(
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine
            .resolve ===
        "function"
    )
    {
        try
        {
            var answer =
                ISE.AnswerEngine
                    .resolve(
                        text
                    );

            if(
                answer &&
                answer.supported
            )
            {
                return answer;
            }
        }
        catch(error)
        {
        }
    }

    /*
     * Specialized survey engine.
     */

    if(
        ISE.SpecializedSurvey &&
        typeof ISE.SpecializedSurvey
            .resolve ===
        "function"
    )
    {
        try
        {
            var specialized =
                ISE.SpecializedSurvey
                    .resolve(
                        question
                    );

            if(
                specialized &&
                specialized.supported
            )
            {
                return specialized;
            }
        }
        catch(error)
        {
        }
    }

    return {
        supported:
            false,

        reason:
            "No profile-supported answer."
    };
};


/* ============================================================
   QUESTION FINGERPRINT
   ============================================================ */

ISE.PlatformEngine.fingerprint =
function(
    question
)
{
    if(
        !question
    )
    {
        return "";
    }

    var text =
        ISE.PlatformEngine
            .normalize(
                question.text
            );

    var controls =
        question.controls ||
        [];

    var controlTypes =
        [];

    for(
        var i = 0;
        i < controls.length;
        i++
    )
    {
        controlTypes.push(
            ISE.PlatformEngine
                .controlType(
                    controls[i]
                )
        );
    }

    return (
        text +
        "|" +
        controlTypes.join(",")
    );
};


/* ============================================================
   QUESTION ELIGIBILITY
   ============================================================ */

ISE.PlatformEngine.isEligible =
function(
    question
)
{
    if(
        !question
    )
    {
        return false;
    }

    if(
        !question.controls ||
        !question.controls.length
    )
    {
        return false;
    }

    if(
        ISE.PlatformEngine
            .config
            .processVisibleOnly &&
        !ISE.PlatformEngine
            .isVisible(
                question.container
            )
    )
    {
        return false;
    }

    /*
     * Don't process obvious navigation controls
     * as questions.
     */

    var text =
        ISE.PlatformEngine
            .normalize(
                question.text
            );

    if(
        /^(next|continue|submit|finish|done|back|previous|skip|exit|close)$/
            .test(
                text
            )
    )
    {
        return false;
    }

    /*
     * Existing question classifier gets
     * final say when available.
     */

    if(
        ISE.question &&
        typeof ISE.question.score ===
        "function"
    )
    {
        try
        {
            var score =
                ISE.question.score(
                    text
                );

            if(
                typeof score ===
                "number" &&
                score <
                0.25
            )
            {
                return false;
            }
        }
        catch(error)
        {
        }
    }

    return true;
};


/* ============================================================
   FULL AUTOMATIC QUESTION PROCESSOR
   ============================================================ */

ISE.PlatformEngine.processQuestion =
function(
    question
)
{
    if(
        !ISE.PlatformEngine
            .isEligible(
                question
            )
    )
    {
        return {
            success:
                false,

            ignored:
                true
        };
    }

    var fingerprint =
        ISE.PlatformEngine
            .fingerprint(
                question
            );

    if(
        ISE.PlatformEngine
            .processingQuestions[
                fingerprint
            ]
    )
    {
        return {
            success:
                false,

            processing:
                true
        };
    }

    ISE.PlatformEngine
        .processingQuestions[
            fingerprint
        ] =
        true;

    ISE.PlatformEngine
        .processCount++;

    question.state =
        "processing";

    var result =
        null;

    try
    {
        var resolution =
            ISE.PlatformEngine
                .resolveAnswer(
                    question
                );

        question.resolution =
            resolution;

        if(
            !resolution ||
            !resolution.supported
        )
        {
            question.state =
                "unsupported";

            ISE.PlatformEngine
                .unsupportedCount++;

            ISE.PlatformEngine
                .unsupportedQuestions[
                    fingerprint
                ] =
                question;

            /*
             * IMPORTANT:
             * We do not invent an answer.
             */

            result =
            {
                success:
                    false,

                unsupported:
                    true,

                question:
                    question,

                resolution:
                    resolution
            };

            return result;
        }

        /*
         * Use the existing recovery system whenever
         * available. That provides verification and
         * retries automatically.
         */

        if(
            ISE.RecoveryEngine &&
            typeof ISE.RecoveryEngine
                .process ===
            "function"
        )
        {
            result =
                ISE.RecoveryEngine
                    .process(
                        question,
                        resolution.answer
                    );
        }
        else
        if(
            ISE.AutofillEngine &&
            typeof ISE.AutofillEngine
                .processQuestion ===
            "function"
        )
        {
            result =
                ISE.AutofillEngine
                    .processQuestion(
                        question,
                        resolution.answer
                    );
        }
        else
        {
            result =
            {
                success:
                    false,

                reason:
                    "Autofill engine unavailable."
            };
        }

        if(
            result &&
            result.success
        )
        {
            question.state =
                "filled";

            question.answer =
                resolution.answer;

            question.filledAt =
                Date.now();

            ISE.PlatformEngine
                .successCount++;

            ISE.PlatformEngine
                .processedQuestions[
                    fingerprint
                ] =
                question;
        }
        else
        {
            question.state =
                "failed";

            ISE.PlatformEngine
                .failureCount++;

            ISE.PlatformEngine
                .failedQuestions[
                    fingerprint
                ] =
                question;
        }

        return result;
    }
    catch(error)
    {
        question.state =
            "error";

        ISE.PlatformEngine
            .failureCount++;

        ISE.PlatformEngine
            .failedQuestions[
                fingerprint
            ] =
            question;

        if(
            ISE.warn
        )
        {
            ISE.warn(
                "Automatic question processing error:",
                error
            );
        }

        return {
            success:
                false,

            error:
                true,

            reason:
                error.message ||
                "Unknown processing error."
        };
    }
    finally
    {
        delete
            ISE.PlatformEngine
                .processingQuestions[
                    fingerprint
                ];
    }
};


/* ============================================================
   AUTOMATIC QUESTION PROCESSING
   ============================================================ */

ISE.PlatformEngine.processDiscovered =
function(
    questions
)
{
    if(
        !questions ||
        !questions.length
    )
    {
        return [];
    }

    var results =
        [];

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        var result =
            ISE.PlatformEngine
                .processQuestion(
                    questions[i]
                );

        results.push(
            result
        );
    }

    return results;
};


/* ============================================================
   FRAME DISCOVERY
   ============================================================ */

ISE.PlatformEngine.findFrames =
function(
    root
)
{
    var frames =
        [];

    var scope =
        root ||
        document;

    try
    {
        var nodes =
            scope.querySelectorAll(
                "iframe"
            );

        for(
            var i = 0;
            i < nodes.length;
            i++
        )
        {
            try
            {
                var frameDocument =
                    nodes[i]
                        .contentDocument;

                if(
                    frameDocument
                )
                {
                    frames.push(
                        {
                            element:
                                nodes[i],

                            document:
                                frameDocument
                        }
                    );

                    ISE.PlatformEngine
                        .frameCount++;
                }
            }
            catch(error)
            {
            }
        }
    }
    catch(error)
    {
    }

    return frames;
};


ISE.PlatformEngine.discoverFrames =
function()
{
    var frames =
        ISE.PlatformEngine
            .findFrames(
                document
            );

    var questions =
        [];

    for(
        var i = 0;
        i < frames.length;
        i++
    )
    {
        try
        {
            var frameDocument =
                frames[i]
                    .document;

            var frameAdapter =
                ISE.PlatformEngine
                    .adapter;

            var found =
                frameAdapter &&
                typeof frameAdapter
                    .discover ===
                "function"
                ?
                frameAdapter.discover(
                    frameDocument
                )
                :
                ISE.PlatformEngine
                    .discoverGeneric(
                        frameDocument
                    );

            for(
                var j = 0;
                j < found.length;
                j++
            )
            {
                found[j].frame =
                    frames[i].element;

                found[j].frameDocument =
                    frameDocument;

                questions.push(
                    found[j]
                );
            }
        }
        catch(error)
        {
        }
    }

    return questions;
};


/* ============================================================
   SHADOW DOM
   ============================================================ */

ISE.PlatformEngine.discoverShadowRoots =
function(
    root
)
{
    var roots =
        [];

    var scope =
        root ||
        document;

    try
    {
        var elements =
            scope.querySelectorAll(
                "*"
            );

        for(
            var i = 0;
            i < elements.length;
            i++
        )
        {
            try
            {
                if(
                    elements[i]
                        .shadowRoot
                )
                {
                    roots.push(
                        elements[i]
                            .shadowRoot
                    );

                    ISE.PlatformEngine
                        .shadowCount++;
                }
            }
            catch(error)
            {
            }
        }
    }
    catch(error)
    {
    }

    return roots;
};


ISE.PlatformEngine.discoverShadowQuestions =
function()
{
    var roots =
        ISE.PlatformEngine
            .discoverShadowRoots(
                document
            );

    var questions =
        [];

    for(
        var i = 0;
        i < roots.length;
        i++
    )
    {
        try
        {
            var found =
                ISE.PlatformEngine
                    .discoverGeneric(
                        roots[i]
                    );

            for(
                var j = 0;
                j < found.length;
                j++
            )
            {
                found[j].shadowRoot =
                    roots[i];

                questions.push(
                    found[j]
                );
            }
        }
        catch(error)
        {
        }
    }

    return questions;
};


/* ============================================================
   COMPLETE AUTOMATIC DISCOVERY
   ============================================================ */

ISE.PlatformEngine.fullDiscover =
function()
{
    ISE.PlatformEngine
        .selectAdapter();

    var questions =
        [];

    try
    {
        questions =
            ISE.PlatformEngine
                .adapter
                .discover(
                    document
                );
    }
    catch(error)
    {
        questions =
            ISE.PlatformEngine
                .discoverGeneric(
                    document
                );
    }

    if(
        ISE.PlatformEngine
            .config
            .inspectFrames
    )
    {
        questions =
            questions.concat(
                ISE.PlatformEngine
                    .discoverFrames()
            );
    }

    if(
        ISE.PlatformEngine
            .config
            .inspectShadowRoots
    )
    {
        questions =
            questions.concat(
                ISE.PlatformEngine
                    .discoverShadowQuestions()
            );
    }

    return ISE.PlatformEngine
        .deduplicateQuestions(
            questions
        );
};


/* ============================================================
   AUTOMATIC SCAN
   ============================================================ */

ISE.PlatformEngine.scan =
function(
    reason
)
{
    if(
        ISE.PlatformEngine
            .processing
    )
    {
        ISE.PlatformEngine
            .pendingScan =
            true;

        return [];
    }

    ISE.PlatformEngine
        .processing =
        true;

    ISE.PlatformEngine
        .scanCount++;

    ISE.PlatformEngine
        .lastScan =
        Date.now();

    ISE.PlatformEngine
        .lastActivity =
        Date.now();

    var results =
        [];

    try
    {
        var questions =
            ISE.PlatformEngine
                .fullDiscover();

        results =
            ISE.PlatformEngine
                .processDiscovered(
                    questions
                );
    }
    catch(error)
    {
        if(
            ISE.warn
        )
        {
            ISE.warn(
                "Automatic scan error:",
                error
            );
        }
    }
    finally
    {
        ISE.PlatformEngine
            .processing =
            false;

        if(
            ISE.PlatformEngine
                .pendingScan
        )
        {
            ISE.PlatformEngine
                .pendingScan =
                false;

            setTimeout(
                function()
                {
                    ISE.PlatformEngine
                        .scan(
                            "pending"
                        );
                },
                ISE.PlatformEngine
                    .config
                    .mutationDelay
            );
        }
    }

    return results;
};


/* ============================================================
   AUTOMATIC MUTATION OBSERVER
   ============================================================ */

ISE.PlatformEngine.startObserver =
function()
{
    if(
        ISE.PlatformEngine
            .observer
    )
    {
        return;
    }

    if(
        typeof MutationObserver ===
        "undefined"
    )
    {
        return;
    }

    var timer =
        null;

    ISE.PlatformEngine
        .observer =
        new MutationObserver(
            function(
                mutations
            )
            {
                if(
                    !ISE.PlatformEngine
                        .running
                )
                {
                    return;
                }

                var relevant =
                    false;

                for(
                    var i = 0;
                    i < mutations.length;
                    i++
                )
                {
                    if(
                        mutations[i]
                            .addedNodes &&
                        mutations[i]
                            .addedNodes
                            .length
                    )
                    {
                        relevant =
                            true;

                        break;
                    }

                    if(
                        mutations[i]
                            .removedNodes &&
                        mutations[i]
                            .removedNodes
                            .length
                    )
                    {
                        relevant =
                            true;

                        break;
                    }

                    if(
                        mutations[i]
                            .type ===
                        "attributes"
                    )
                    {
                        relevant =
                            true;

                        break;
                    }
                }

                if(
                    !relevant
                )
                {
                    return;
                }

                clearTimeout(
                    timer
                );

                timer =
                    setTimeout(
                        function()
                        {
                            ISE.PlatformEngine
                                .scan(
                                    "mutation"
                                );
                        },
                        ISE.PlatformEngine
                            .config
                            .mutationDelay
                    );
            }
        );

    try
    {
        ISE.PlatformEngine
            .observer
            .observe(
                document.documentElement ||
                document.body,
                {
                    subtree:
                        true,

                    childList:
                        true,

                    attributes:
                        true,

                    attributeFilter:
                    [
                        "class",
                        "style",
                        "hidden",
                        "disabled",
                        "aria-hidden",
                        "aria-disabled",
                        "aria-label",
                        "value",
                        "checked",
                        "selected"
                    ]
                }
            );
    }
    catch(error)
    {
        ISE.PlatformEngine
            .observer =
            null;
    }
};


/* ============================================================
   AUTOMATIC INTERVAL
   ============================================================ */

ISE.PlatformEngine.startInterval =
function()
{
    if(
        ISE.PlatformEngine
            .scanTimer
    )
    {
        return;
    }

    ISE.PlatformEngine
        .scanTimer =
        setInterval(
            function()
            {
                if(
                    !ISE.PlatformEngine
                        .running
                )
                {
                    return;
                }

                ISE.PlatformEngine
                    .scan(
                        "interval"
                    );
            },
            ISE.PlatformEngine
                .config
                .scanInterval
        );
};


/* ============================================================
   STOP INTERVAL
   ============================================================ */

ISE.PlatformEngine.stopInterval =
function()
{
    if(
        ISE.PlatformEngine
            .scanTimer
    )
    {
        clearInterval(
            ISE.PlatformEngine
                .scanTimer
        );

        ISE.PlatformEngine
            .scanTimer =
            null;
    }
};


/* ============================================================
   AUTOMATIC PAGE EVENTS
   ============================================================ */

ISE.PlatformEngine.attachPageEvents =
function()
{
    var events =
    [
        "load",
        "pageshow",
        "popstate",
        "hashchange"
    ];

    for(
        var i = 0;
        i < events.length;
        i++
    )
    {
        try
        {
            window.addEventListener(
                events[i],
                function()
                {
                    if(
                        !ISE.PlatformEngine
                            .running
                    )
                    {
                        return;
                    }

                    setTimeout(
                        function()
                        {
                            ISE.PlatformEngine
                                .scan(
                                    "page-event"
                                );
                        },
                        150
                    );
                }
            );
        }
        catch(error)
        {
        }
    }
};


/* ============================================================
   AUTOMATIC HISTORY / SPA DETECTION
   ============================================================ */

ISE.PlatformEngine.patchHistory =
function()
{
    try
    {
        if(
            history.__ISE_PATCHED__
        )
        {
            return;
        }

        var originalPush =
            history.pushState;

        var originalReplace =
            history.replaceState;

        history.pushState =
        function()
        {
            var result =
                originalPush.apply(
                    this,
                    arguments
                );

            setTimeout(
                function()
                {
                    if(
                        ISE.PlatformEngine
                            .running
                    )
                    {
                        ISE.PlatformEngine
                            .scan(
                                "pushState"
                            );
                    }
                },
                150
            );

            return result;
        };

        history.replaceState =
        function()
        {
            var result =
                originalReplace.apply(
                    this,
                    arguments
                );

            setTimeout(
                function()
                {
                    if(
                        ISE.PlatformEngine
                            .running
                    )
                    {
                        ISE.PlatformEngine
                            .scan(
                                "replaceState"
                            );
                    }
                },
                150
            );

            return result;
        };

        history.__ISE_PATCHED__ =
            true;
    }
    catch(error)
    {
    }
};


/* ============================================================
   AUTOMATIC START
   ============================================================ */

ISE.PlatformEngine.start =
function()
{
    if(
        ISE.PlatformEngine
            .running
    )
    {
        return;
    }

    ISE.PlatformEngine
        .running =
        true;

    ISE.PlatformEngine
        .selectAdapter();

    ISE.PlatformEngine
        .startObserver();

    ISE.PlatformEngine
        .startInterval();

    ISE.PlatformEngine
        .attachPageEvents();

    ISE.PlatformEngine
        .patchHistory();

    /*
     * Immediate first scan.
     */

    setTimeout(
        function()
        {
            if(
                ISE.PlatformEngine
                    .running
            )
            {
