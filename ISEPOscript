    return columns;
};


/* ------------------------------------------------------------
   MATRIX ROW LABEL
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.rowLabel = function (
    row
) {

    if (!row) {
        return "";
    }

    var text =
        ISE.SpecializedSurvey.text(
            row
        );

    /*
     * Remove obvious answer-choice wording.
     */

    var controls =
        row.controls ||
        [];

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var controlText =
            ISE.SpecializedSurvey.text(
                controls[i]
            );

        if (!controlText) {
            continue;
        }

        if (
            ISE.QuestionIntelligence &&
            ISE.QuestionIntelligence
                .isAnswerChoice(
                    controlText,
                    controls[i]
                )
        ) {

            text =
                text.replace(
                    controlText,
                    ""
                );
        }
    }

    return text
        .replace(/\s+/g, " ")
        .trim();
};


/* ------------------------------------------------------------
   MATRIX ROW PROFILE RESOLUTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.resolveMatrixRow =
function (
    rowText
) {

    if (!rowText) {
        return null;
    }

    /*
     * A matrix row can itself be a supported
     * profile question.
     */

    var result =
        ISE.AnswerEngine.resolve(
            rowText
        );

    if (
        result &&
        result.supported
    ) {
        return result;
    }

    /*
     * Sometimes the matrix repeats a demographic
     * question with a shortened row label.
     */

    var category =
        ISE.QuestionIntelligence
            ? ISE.QuestionIntelligence
                .detectCategory(
                    rowText
                )
            : null;

    if (!category) {
        return null;
    }

    /*
     * Ask the normal resolver again using the
     * category-bearing text.
     */

    result =
        ISE.AnswerEngine.resolve(
            rowText
        );

    if (
        result &&
        result.supported
    ) {
        return result;
    }

    return null;
};


/* ------------------------------------------------------------
   MATRIX ANSWER MATCHING
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.findMatrixChoice =
function (
    controls,
    answer
) {

    if (
        !Array.isArray(controls) ||
        !controls.length
    ) {
        return null;
    }

    var normalizedAnswer =
        ISE.SpecializedSurvey.normalize(
            answer
        );

    var best = null;
    var bestScore = 0;

    for (
        var i = 0;
        i < controls.length;
        i++
    ) {

        var control =
            controls[i];

        var text =
            ISE.SpecializedSurvey.normalize(
                ISE.SpecializedSurvey.text(
                    control
                )
            );

        var value =
            ISE.SpecializedSurvey.normalize(
                ISE.SpecializedSurvey.attr(
                    control,
                    "value"
                )
            );

        var dataValue =
            ISE.SpecializedSurvey.normalize(
                ISE.SpecializedSurvey.attr(
                    control,
                    "data-value"
                )
            );

        var dataAnswer =
            ISE.SpecializedSurvey.normalize(
                ISE.SpecializedSurvey.attr(
                    control,
                    "data-answer"
                )
            );

        var score = 0;

        if (
            text === normalizedAnswer ||
            value === normalizedAnswer ||
            dataValue === normalizedAnswer ||
            dataAnswer === normalizedAnswer
        ) {
            score = 1;
        }

        if (
            text.indexOf(
                normalizedAnswer
            ) !== -1
        ) {
            score =
                Math.max(
                    score,
                    0.85
                );
        }

        if (
            value.indexOf(
                normalizedAnswer
            ) !== -1
        ) {
            score =
                Math.max(
                    score,
                    0.82
                );
        }

        var overlap =
            ISE.SemanticEngine
                .tokenOverlap(
                    text,
                    normalizedAnswer
                );

        score =
            Math.max(
                score,
                overlap
            );

        if (
            score > bestScore
        ) {

            bestScore = score;

            best = control;
        }
    }

    if (
        !best ||
        bestScore < 0.55
    ) {
        return null;
    }

    return {
        element: best,
        score: bestScore
    };
};


/* ------------------------------------------------------------
   MATRIX FILL
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.fillMatrix =
function (
    question,
    container
) {

    var rows =
        ISE.SpecializedSurvey
            .getMatrixRows(
                container
            );

    if (
        rows.length < 2
    ) {

        return {
            success: false,
            reason: "No matrix rows detected."
        };
    }

    var processed = 0;
    var unsupported = 0;

    for (
        var i = 0;
        i < rows.length;
        i++
    ) {

        var row =
            rows[i];

        var rowText =
            ISE.SpecializedSurvey
                .rowLabel(
                    row
                );

        if (!rowText) {
            continue;
        }

        var answer =
            ISE.SpecializedSurvey
                .resolveMatrixRow(
                    rowText
                );

        /*
         * Unsupported matrix rows are left alone.
         * No arbitrary scale selection.
         */

        if (
            !answer ||
            !answer.supported
        ) {

            unsupported++;
            continue;
        }

        var match =
            ISE.SpecializedSurvey
                .findMatrixChoice(
                    row.controls,
                    answer.value
                );

        if (
            !match
        ) {
            unsupported++;
            continue;
        }

        if (
            ISE.SpecializedSurvey.click(
                match.element
            )
        ) {

            processed++;
        }
    }

    return {

        success:
            processed > 0,

        method:
            "matrix",

        processed:
            processed,

        unsupported:
            unsupported,

        totalRows:
            rows.length
    };
};


/* ------------------------------------------------------------
   "SELECT ALL THAT APPLY" DETECTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.isMultiSelectQuestion =
function (
    question
) {

    var text =
        ISE.SpecializedSurvey.normalize(
            question
        );

    return (
        text.indexOf("select all") !== -1 ||
        text.indexOf("select any") !== -1 ||
        text.indexOf("choose all") !== -1 ||
        text.indexOf("choose any") !== -1 ||
        text.indexOf("check all") !== -1 ||
        text.indexOf("check any") !== -1 ||
        text.indexOf("select all that apply") !== -1 ||
        text.indexOf("choose all that apply") !== -1
    );
};


/* ------------------------------------------------------------
   MULTI-SELECT ANSWER RESOLUTION
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.resolveMultiAnswer =
function (
    question
) {

    var result =
        ISE.AnswerEngine.resolve(
            question
        );

    if (
        !result ||
        !result.supported
    ) {
        return null;
    }

    if (
        Array.isArray(
            result.value
        )
    ) {
        return result;
    }

    /*
     * A scalar answer can safely become a single-item
     * selection when the question is explicitly
     * multi-select.
     */

    return {
        supported: true,
        category:
            result.category,
        value: [
            result.value
        ],
        confidence:
            result.confidence,
        reason:
            result.reason
    };
};


/* ------------------------------------------------------------
   MULTI-SELECT FILL
   ------------------------------------------------------------ */

ISE.SpecializedSurvey.fillMultiSelect =
function (
    question,
    container
) {

    if (
        !ISE.SpecializedSurvey
            .isMultiSelectQuestion(
                question
            )
    ) {
        return {
            success: false,
            reason:
                "Question is not explicitly multi-select."
        };
    }

    var answer =
        ISE.SpecializedSurvey
            .resolveMultiAnswer(
                question
            );

    if (
        !answer ||
        !answer.supported
    ) {

        return {
            success: false,
            reason:
                "No profile-supported multi-select answer."
        };
    }

    var choices =
        ISE.SpecializedSurvey
            .dedupeChoices(
                ISE.SpecializedSurvey
                    .collectChoices(
                        container
                    )
            );

    var selected = 0;

    for (
        var i = 0;
        i < answer.value.length;
        i++
    ) {

        var match =
            ISE.SpecializedSurvey
                .bestChoice(
                    choices,
                    answer.value[i]
                );

        if (
            !match ||
            match.score < 0.65
        ) {
            continue;
        }

        if (
            ISE.SpecializedSurvey.click(
                match.choice.element
            )
        ) {

            selected++;
        }
    }

    return {

        success:
            selected > 0,

        method:
            "multi-select",

        selected:
            selected,

        requested:
            answer.value.length
    };
};


