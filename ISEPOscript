/* ============================================================
   QUESTION CONTAINER DETECTION
   ============================================================ */

ISE.PlatformEngine.findQuestionContainer =
function(
    control
)
{
    if(
        !control
    )
    {
        return null;
    }

    var current =
        control;

    var depth =
        0;

    while(
        current &&
        depth <
        15
    )
    {
        var tag =
            (
                current.tagName ||
                ""
            ).toLowerCase();

        if(
            tag ===
            "fieldset"
        )
        {
            return current;
        }

        var role =
            ISE.PlatformEngine
                .safeAttr(
                    current,
                    "role"
                );

        if(
            role ===
            "group" ||
            role ===
            "radiogroup"
        )
        {
            return current;
        }

        var identifiers =
            [
                "data-question",
                "data-question-id",
                "data-questionid",
                "data-question-text",
                "data-question-label"
            ];

        for(
            var i = 0;
            i < identifiers.length;
            i++
        )
        {
            if(
                ISE.PlatformEngine
                    .safeAttr(
                        current,
                        identifiers[i]
                    )
            )
            {
                return current;
            }
        }

        var id =
            ISE.PlatformEngine
                .safeAttr(
                    current,
                    "id"
                );

        var className =
            ISE.PlatformEngine
                .safeAttr(
                    current,
                    "class"
                );

        var combined =
            ISE.PlatformEngine
                .normalize(
                    id +
                    " " +
                    className
                );

        if(
            /\bquestion\b/.test(
                combined
            )
        )
        {
            return current;
        }

        current =
            current.parentElement;

        depth++;
    }

    return control.parentElement ||
        null;
};


/* ============================================================
   QUESTION TEXT EXTRACTION
   ============================================================ */

ISE.PlatformEngine.extractQuestionText =
function(
    container
)
{
    if(
        !container
    )
    {
        return "";
    }

    var candidates =
    [];

    var selectors =
    [
        "[data-question-text]",
        "[data-question-title]",
        "[data-question-label]",
        "[aria-label]",
        "legend",
        "h1",
        "h2",
        "h3",
        "h4",
        "label",
        "p"
    ];

    for(
        var i = 0;
        i < selectors.length;
        i++
    )
    {
        try
        {
            var nodes =
                container
                    .querySelectorAll(
                        selectors[i]
                    );

            for(
                var j = 0;
                j < nodes.length;
                j++
            )
            {
                if(
                    !ISE.PlatformEngine
                        .isVisible(
                            nodes[j]
                        )
                )
                {
                    continue;
                }

                var text =
                    ISE.PlatformEngine
                        .elementText(
                            nodes[j]
                        );

                if(
                    text.length >
                    2
                )
                {
                    candidates.push(
                        text
                    );
                }
            }
        }
        catch(error)
        {
        }
    }

    candidates.sort(
        function(
            a,
            b
        )
        {
            return (
                b.length -
                a.length
            );
        }
    );

    if(
        candidates.length
    )
    {
        return candidates[0];
    }

    return ISE.PlatformEngine
        .elementText(
            container
        );
};


