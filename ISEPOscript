                "[class*='survey-question']",
                "fieldset",
                "[role='group']"
            ],

            controlSelectors: [

                "input",
                "select",
                "textarea",
                "button",
                "[role='radio']",
                "[role='checkbox']",
                "[role='option']",
                "[role='combobox']"
            ],

            priority:
                10
        }
    };


    /* ============================================================
       GENERIC PLATFORM
       ============================================================ */

    engine.genericPlatform = {

        name:
            "Generic Survey",

        questionSelectors: [

            "[data-question]",
            "[data-question-id]",
            "[data-questionid]",
            "[data-testid*='question']",
            "[class*='question']",
            "[class*='Question']",
            "[class*='survey-question']",
            "[class*='SurveyQuestion']",
            "fieldset",
            "[role='group']",
            "[role='radiogroup']"
        ],

        controlSelectors: [

            "input",
            "select",
            "textarea",
            "button",
            "[role='radio']",
            "[role='checkbox']",
            "[role='option']",
            "[role='combobox']",
            "[role='slider']"
        ],

        priority:
            1
    };


    /* ============================================================
       PLATFORM SCORING
       ============================================================ */

    function scorePlatform(
        key,
        definition
    ) {

        var score =
            0;

        var host =
            currentHost();

        var path =
            currentPath();

        var url =
            currentURL();

        if (
            definition.hosts
        ) {

            for (
                var i = 0;
                i <
                definition.hosts.length;
                i++
            ) {

                if (
                    host ===
                    normalize(
                        definition.hosts[i]
                    )
                ) {

                    score +=
                        100;

                    break;
                }
            }
        }


        if (
            definition.hostContains
        ) {

            for (
                var j = 0;
                j <
                definition.hostContains.length;
                j++
            ) {

                if (
                    host.indexOf(
                        normalize(
                            definition
                                .hostContains[j]
                        )
                    ) !==
                    -1
                ) {

                    score +=
                        70;

                    break;
                }
            }
        }


        if (
            definition.pathContains
        ) {

            for (
                var k = 0;
                k <
                definition.pathContains.length;
                k++
            ) {

                if (
                    path.indexOf(
                        normalize(
                            definition
                                .pathContains[k]
                        )
                    ) !==
                    -1
                ) {

                    score +=
                        8;
                }
            }
        }


        if (
            definition.keywords
        ) {

            var bodyText =
                normalize(
                    document.body
                    ?
                    (
                        document.body
                            .innerText ||
                        document.body
                            .textContent ||
                        ""
                    )
                    :
                    ""
                );

            bodyText =
                limitText(
                    bodyText,
                    10000
                );

            for (
                var m = 0;
                m <
                definition.keywords.length;
                m++
            ) {

                var keyword =
                    normalize(
                        definition
                            .keywords[m]
                    );

                if (
                    keyword &&
                    (
                        bodyText.indexOf(
                            keyword
                        ) !==
                        -1 ||
                        url.indexOf(
                            keyword
                        ) !==
                        -1
                    )
                ) {

                    score +=
                        4;
                }
            }
        }


        return score;
    }


    /* ============================================================
       PLATFORM DETECTION
       ============================================================ */

    engine.detectPlatform =
        function () {

            engine.statistics
                .platformDetections++;

            var bestKey =
                "generic";

            var bestScore =
                0;

            Object.keys(
                engine.platforms
            ).forEach(
                function (
                    key
                ) {

                    var definition =
                        engine.platforms[key];

                    var score =
                        scorePlatform(
                            key,
                            definition
                        );

                    if (
                        score >
                        bestScore
                    ) {

                        bestScore =
                            score;

                        bestKey =
                            key;
                    }
                }
            );


            var platform;

            if (
                bestKey ===
                "generic"
            ) {

                platform =
                    engine.genericPlatform;

                engine.statistics
                    .genericFallbacks++;

            }
            else {

                platform =
                    Object.assign(
                        {
                            key:
                                bestKey,

                            confidence:
                                Math.min(
                                    1,
                                    bestScore /
                                    100
                                )
                        },
                        engine.platforms[
                            bestKey
                        ]
                    );
            }


            if (
                bestKey ===
                "generic" &&
                engine.config
                    .detectUnknownPlatforms
            ) {

                engine.statistics
                    .unknownPlatforms++;
            }


            engine.state
                .platformConfidence =
                bestKey ===
                "generic"
                ?
                0
                :
                Math.min(
                    1,
                    bestScore /
                    100
                );


            if (
                engine.state
                    .currentPlatform !==
                bestKey
            ) {

                engine.state
                    .previousPlatform =
                    engine.state
                        .currentPlatform;

                engine.state
                    .currentPlatform =
                    bestKey;

                if (
                    engine.state
                        .previousPlatform !==
                    null
                ) {

                    engine.statistics
                        .platformChanges++;
                }
            }


            engine.state
                .platformRecords
                .set(
                    bestKey,
                    {

                        key:
                            bestKey,

                        score:
                            bestScore,

                        confidence:
                            engine.state
                                .platformConfidence,

                        timestamp:
                            Date.now()
                    }
                );


            return {

                key:
                    bestKey,

                score:
                    bestScore,

                confidence:
                    engine.state
                        .platformConfidence,

                definition:
                    platform
            };
        };


    /* ============================================================
       PLATFORM KEY
       ============================================================ */

    engine.getPlatform =
        function () {

            if (
                engine.state
                    .currentPlatform
            ) {

                var key =
                    engine.state
                        .currentPlatform;

                return {

                    key:
                        key,

                    confidence:
                        engine.state
                            .platformConfidence,

                    definition:
                        key ===
                        "generic"
                        ?
                        engine.genericPlatform
                        :
                        engine.platforms[
                            key
                        ]
                };
            }

            return engine.detectPlatform();
        };


    /* ============================================================
       QUESTION SELECTOR COLLECTION
       ============================================================ */

    function selectorList(
        definition
    ) {

        if (
            definition &&
            Array.isArray(
                definition
                    .questionSelectors
            )
        ) {

            return definition
                .questionSelectors;
        }

        return engine.genericPlatform
            .questionSelectors;
    }


    function controlSelectorList(
        definition
    ) {

        if (
            definition &&
            Array.isArray(
                definition
                    .controlSelectors
            )
        ) {

            return definition
                .controlSelectors;
        }

        return engine.genericPlatform
            .controlSelectors;
    }


    /* ============================================================
       QUESTION CANDIDATE DISCOVERY
       ============================================================ */

    function collectQuestionCandidates(
        root,
        definition
    ) {

        var candidates =
            [];

        if (
            !root ||
            !root.querySelectorAll
        ) {

            return candidates;
        }

        var selectors =
            selectorList(
                definition
            );

        for (
            var i = 0;
            i <
            selectors.length;
            i++
        ) {

            try {

                var found =
                    root.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j <
                    found.length;
                    j++
                ) {

                    var element =
                        found[j];

                    if (
                        candidates
                            .indexOf(
                                element
                            ) ===
                        -1
                    ) {

                        candidates.push(
                            element
                        );
                    }
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }

        return candidates;
    }


    /* ============================================================
       QUESTION TEXT EXTRACTION
       ============================================================ */

    function directText(
        element
    ) {

        if (
            !element
        ) {

            return "";
        }

        var values =
            [];

        var attrs = [

            "data-question",
            "data-question-text",
            "data-label",
            "aria-label",
            "title"
        ];

        for (
            var i = 0;
            i <
            attrs.length;
            i++
        ) {

            var value =
                attr(
                    element,
                    attrs[i]
                );

            if (
                value
            ) {

                values.push(
                    value
                );
            }
        }

        try {

            if (
                element.innerText
            ) {

                values.push(
                    element.innerText
                );

            }
            else if (
                element.textContent
            ) {

                values.push(
                    element.textContent
                );
            }

        }
        catch (error) {
        }

        return limitText(
            cleanText(
                values.join(
                    " "
                )
            ),
            engine.config
                .maxTextLength
        );
    }


    /* ============================================================
       ANSWER CONTROL DETECTION
       ============================================================ */

    function collectControls(
        container,
        definition
    ) {

        if (
            !container ||
            !container.querySelectorAll
        ) {

            return [];
        }

        var selectors =
            controlSelectorList(
                definition
            );

        var controls =
            [];

        for (
            var i = 0;
            i <
            selectors.length;
            i++
        ) {

            try {

                var found =
                    container.querySelectorAll(
                        selectors[i]
                    );

                for (
                    var j = 0;
                    j <
                    found.length;
                    j++
                ) {

                    if (
                        controls.indexOf(
                            found[j]
                        ) ===
                        -1
                    ) {

                        controls.push(
                            found[j]
                        );
                    }
                }

            }
            catch (error) {
            }
        }

        return controls;
    }


    /* ============================================================
       QUESTION SCORE
       ============================================================ */

    function scoreQuestion(
        element
    ) {

        if (
            !element ||
            !visible(
                element
            )
        ) {

            return 0;
        }

        var text =
            directText(
                element
            );

        if (
            !text
        ) {

            return 0;
        }

        var score =
            0;

        var normalized =
            normalize(
                text
            );

        /*
         * Explicit question markers.
         */

        if (
            attr(
                element,
                "data-question"
            )
        ) {

            score +=
                0.35;
        }

        if (
            attr(
                element,
                "data-question-id"
            )
        ) {

            score +=
                0.25;
        }

        if (
            attr(
                element,
                "data-question-text"
            )
        ) {

            score +=
                0.20;
        }

        /*
         * Question punctuation.
         */

        if (
            /[?？]\s*$/.test(
                text
            )
        ) {

            score +=
                0.25;
        }

        /*
         * Common interrogative structures.
         */

        var interrogatives = [

            "do you",
            "did you",
            "have you",
            "are you",
            "were you",
            "is your",
            "are your",
            "what is",
            "what are",
            "which",
            "when",
            "where",
            "how many",
            "how much",
            "how often",
            "how old",
            "have you ever"
        ];

        for (
            var i = 0;
            i <
            interrogatives.length;
            i++
        ) {

            if (
                normalized.indexOf(
                    interrogatives[i]
                ) !==
                -1
            ) {

                score +=
                    0.08;

                break;
            }
        }

        /*
         * Controls make a question container
         * more likely to be real.
         */

        var controls =
            collectControls(
                element,
                engine.getPlatform()
                    .definition
            );

        if (
            controls.length >
            0
        ) {

            score +=
                0.25;
        }

        if (
            controls.length >
            5
        ) {

            score +=
                0.05;
        }

        return Math.min(
            1,
            score
        );
    }


    /* ============================================================
       QUESTION ACCEPTANCE
       ============================================================ */

    function isQuestion(
        element
    ) {

        var score =
            scoreQuestion(
                element
            );

        if (
            score <
            engine.config
                .questionConfidenceThreshold
        ) {

            engine.statistics
                .questionsRejected++;

            return false;
        }

        engine.statistics
            .questionsAccepted++;

        return true;
    }


    /* ============================================================
       QUESTION FINGERPRINT
       ============================================================ */

    function questionFingerprint(
        element,
        platformKey
    ) {

        var text =
            normalize(
                directText(
                    element
                )
            );

        var id =
            attr(
                element,
                "data-question-id"
            ) ||
            attr(
                element,
                "id"
            );

        var name =
            attr(
                element,
                "data-question"
            );

        return hash(
            platformKey +
            "|" +
            id +
            "|" +
            name +
            "|" +
            text
        );
    }


    /* ============================================================
       QUESTION REGISTRATION
       ============================================================ */

    function registerQuestion(
        element,
        platform
    ) {

        var fingerprint =
            questionFingerprint(
                element,
                platform.key
            );

        if (
            engine.state
                .questionRecords
                .has(
                    fingerprint
                )
        ) {

            engine.statistics
                .duplicates++;

            return engine.state
                .questionRecords
                .get(
                    fingerprint
                );
        }

        var controls =
            collectControls(
                element,
                platform.definition
            );

        if (
            controls.length ===
            0
        ) {

            return null;
        }

        var record = {

            id:
                fingerprint,

            platform:
                platform.key,

            platformConfidence:
                platform.confidence,

            element:
                element,

            text:
                directText(
                    element
                ),

            controls:
                controls,

            questionScore:
                scoreQuestion(
                    element
                ),

            createdAt:
                Date.now(),

            processed:
                false,

            supported:
                false,

            answer:
                null
        };

        engine.state
            .questionRecords
            .set(
                fingerprint,
                record
            );

        engine.state
            .questionCounter++;

        engine.statistics
            .questionsDetected++;

        engine.statistics
            .controlsDetected +=
            controls.length;

        return record;
    }


    /* ============================================================
       NESTED QUESTION FILTERING
       ============================================================ */

    function removeNestedQuestions(
        records
    ) {

        var result =
            [];

        for (
            var i = 0;
            i <
            records.length;
            i++
        ) {

            var current =
                records[i];

            var nested =
                false;

            for (
                var j = 0;
                j <
                records.length;
                j++
            ) {

                if (
                    i ===
                    j
                ) {

                    continue;
                }

                var parent =
                    records[j];

                if (
                    !parent ||
                    !current
                ) {

                    continue;
                }

                try {

                    if (
                        parent.element !==
                        current.element &&
                        parent.element
                            .contains(
                                current.element
                            )
                    ) {

                        var parentScore =
                            parent.questionScore;

                        var currentScore =
                            current.questionScore;

                        if (
                            parentScore >=
                            currentScore
                        ) {

                            nested =
                                true;

                            break;
                        }
                    }

                }
                catch (error) {
                }
            }

            if (
                !nested
            ) {

                result.push(
                    current
                );
            }
        }

        return result;
    }


    /* ============================================================
       PLATFORM-SPECIFIC SPECIAL RULES
       ============================================================ */

    function applyPlatformRules(
        record
    ) {

        if (
            !record
        ) {

            return record;
        }

        var text =
            normalize(
                record.text
            );

        /*
         * Prime Opinion.
         */

        if (
            record.platform ===
            "primeopinion"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                likelyProfileQuestion:
                    /age|gender|married|children|car|employment|education|income|location/
                        .test(
                            text
                        ),

                multiSelect:
                    /select all|all that apply|choose all/
                        .test(
                            text
                        )
            };
        }


        /*
         * SurveyMeasure.
         */

        else if (
            record.platform ===
            "surveymeasure"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                multiSelect:
                    /select all|all that apply|multiple answers/
                        .test(
                            text
                        ),

                grid:
                    /rate each|for each|matrix|grid/
                        .test(
                            text
                        )
            };
        }


        /*
         * Sago.
         */

        else if (
            record.platform ===
            "sago"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                ranking:
                    /rank|ranking|order these/
                        .test(
                            text
                        ),

                grid:
                    /matrix|grid|rate each|for each/
                        .test(
                            text
                        ),

                multiSelect:
                    /select all|all that apply|choose all/
                        .test(
                            text
                        )
            };
        }


        /*
         * PureSpectrum.
         */

        else if (
            record.platform ===
            "purespectrum"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                numeric:
                    /how many|how much|enter.*number|number of/
                        .test(
                            text
                        ),

                slider:
                    /move the slider|slide|drag/
                        .test(
                            text
                        ),

                grid:
                    /matrix|grid|rate each|for each/
                        .test(
                            text
                        )
            };
        }


        /*
         * RDSecured.
         */

        else if (
            record.platform ===
            "rdsecured"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                multiSelect:
                    /select all|all that apply|multiple/
                        .test(
                            text
                        )
            };
        }


        /*
         * Samplicio.
         */

        else if (
            record.platform ===
            "samplicio"
        ) {

            record.flags = {

                likelyQuestion:
                    true,

                grid:
                    /matrix|grid|rate each|for each/
                        .test(
                            text
                        ),

                multiSelect:
                    /select all|all that apply|choose all/
                        .test(
                            text
                        )
            };
        }


        /*
         * Generic.
         */

        else {

            record.flags = {

                likelyQuestion:
                    true,

                multiSelect:
                    /select all|all that apply|multiple/
                        .test(
                            text
                        )
            };
        }

        return record;
    }


    /* ============================================================
       SEMANTIC ENGINE HANDOFF
       ============================================================ */

    function resolveAnswer(
        record
    ) {

        if (
            !record ||
            !record.text
        ) {

            return {

                supported:
                    false,

                answer:
                    null,

                confidence:
                    0,

                reason:
                    "missing-question-text"
            };
        }

        /*
         * Part 16 is the primary reasoning layer.
         */

        if (
            ISE.LogicalReasoning &&
            typeof ISE.LogicalReasoning
                .safeResolve ===
            "function"
        ) {

            try {

                var logical =
                    ISE.LogicalReasoning
                        .safeResolve(
                            record.text
                        );

                if (
                    logical &&
                    logical.supported
                ) {

                    return logical;
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        /*
         * Part 14 fallback.
         */

        if (
            ISE.AdvancedSemantics &&
            typeof ISE.AdvancedSemantics
                .safeResolve ===
            "function"
        ) {

            try {

                var advanced =
                    ISE.AdvancedSemantics
                        .safeResolve(
                            record.text
                        );

                if (
                    advanced &&
                    advanced.supported
                ) {

                    return advanced;
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        /*
         * Original AnswerEngine fallback.
         */

        if (
            ISE.AnswerEngine &&
            typeof ISE.AnswerEngine
                .resolve ===
            "function"
        ) {

            try {

                var answer =
                    ISE.AnswerEngine
                        .resolve(
                            record.text
                        );

                if (
                    answer &&
                    answer.supported
                ) {

                    return answer;
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        return {

            supported:
                false,

            answer:
                null,

            confidence:
                0,

            reason:
                "no-profile-supported-answer"
        };
    }


    /* ============================================================
       CONTROL ENGINE HANDOFF
       ============================================================ */

    function fillRecord(
        record,
        resolution
    ) {

        if (
            !record ||
            !resolution ||
            !resolution.supported
        ) {

            return {

                success:
                    false,

                reason:
                    "unsupported"
            };
        }


        /*
         * Never submit or advance.
         */

        if (
            ISE.AutofillEngine &&
            typeof ISE.AutofillEngine
                .processQuestion ===
            "function"
        ) {

            try {

                var result =
                    ISE.AutofillEngine
                        .processQuestion(
                            record.element,
                            resolution
                        );

                if (
                    result &&
                    (
                        result.success ||
                        result.filled ||
                        result.verified
                    )
                ) {

                    return {

                        success:
                            true,

                        result:
                            result
                    };
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        /*
         * RecoveryEngine fallback.
         */

        if (
            ISE.RecoveryEngine &&
            typeof ISE.RecoveryEngine
                .process ===
            "function"
        ) {

            try {

                var recovered =
                    ISE.RecoveryEngine
                        .process(
                            record,
                            resolution
                        );

                if (
                    recovered &&
                    (
                        recovered.success ||
                        recovered.verified
                    )
                ) {

                    return {

                        success:
                            true,

                        result:
                            recovered
                    };
                }

            }
            catch (error) {

                engine.statistics
                    .errors++;
            }
        }


        return {

            success:
                false,

            reason:
                "autofill-engine-unavailable"
        };
    }


    /* ============================================================
       PROCESS QUESTION
       ============================================================ */

    engine.processQuestion =
        function (
            record
        ) {

            if (
                !record
            ) {

                return {

                    success:
                        false,

                    reason:
                        "missing-record"
                };
            }

            if (
                !record.element
            ) {

                return {

                    success:
                        false,

                    reason:
                        "missing-element"
                };
            }

            if (
                !visible(
                    record.element
                )
            ) {

                return {

                    success:
                        false,

                    reason:
                        "not-visible"
                };
            }


            applyPlatformRules(
                record
            );


            var resolution =
                resolveAnswer(
                    record
                );


            if (
                !resolution ||
                !resolution.supported
            ) {

                record.processed =
                    true;

                record.supported =
                    false;

                record.answer =
                    null;

                return {

                    success:
                        false,

                    supported:
                        false,

                    reason:
                        resolution &&
                        resolution.reason
                        ?
                        resolution.reason
                        :
                        "unsupported"
                };
            }


            /*
             * Only accept answers supported by
             * configured profile data/reasoning.
             */

            if (
                Number(
                    resolution.confidence ||
                    0
                ) <
                engine.config
                    .confidenceThreshold
            ) {

                record.processed =
                    true;

                record.supported =
                    false;

                return {

                    success:
                        false,

                    supported:
                        false,

                    reason:
                        "low-confidence-answer"
                };
            }


            record.supported =
                true;

            record.answer =
                resolution.answer;

            var fillResult =
                fillRecord(
                    record,
                    resolution
                );

