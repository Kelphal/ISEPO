/* ------------------------------------------------------------
   MASTER QUESTION RESOLVER
   ------------------------------------------------------------ */

ISE.AnswerEngine.resolve = function (questionText) {

    if (!questionText) {
        return {
            supported: false,
            kind: "unsupported",
            value: null,
            confidence: 0,
            category: null,
            reason: "Question text was empty."
        };
    }

    var categoryResult =
        ISE.AnswerEngine.detectCategory(questionText);

    if (!categoryResult) {

        return {
            supported: false,
            kind: "unsupported",
            value: null,
            confidence: 0,
            category: null,
            reason: "No configured profile category matched this question."
        };
    }

    var category = categoryResult.category;
    var result = null;

    if (category === "diagnosis") {
        result = ISE.AnswerEngine.resolveDiagnosis(questionText);
    }

    if (category === "vehicle") {
        result = ISE.AnswerEngine.resolveVehicle(questionText);
    }

    if (category === "children") {
        result = ISE.AnswerEngine.resolveChildren(questionText);
    }

    if (category === "age") {
        result = ISE.AnswerEngine.resolveAge(questionText);
    }

    if (category === "dob") {
        result = ISE.AnswerEngine.resolveDOB(questionText);
    }

    if (category === "gender") {
        result = ISE.AnswerEngine.resolveGender();
    }

    if (category === "marital") {
        result = ISE.AnswerEngine.resolveMarital();
    }

    if (category === "employment") {
        result = ISE.AnswerEngine.resolveEmployment();
    }

    if (category === "education") {
        result = ISE.AnswerEngine.resolveEducation();
    }

    if (category === "income") {
        result = ISE.AnswerEngine.resolveIncome(questionText);
    }

    if (category === "location") {
        result = ISE.AnswerEngine.resolveLocation();
    }

    if (!result) {

        return {
            supported: false,
            kind: "unsupported",
            value: null,
            confidence: 0,
            category: category,
            reason: "The category was recognized, but no configured answer was available."
        };
    }

    result.detectedCategory = category;
    result.categoryConfidence = categoryResult.confidence;

    return result;
};


/* ------------------------------------------------------------
   CONTROL VALUE NORMALIZATION
   ------------------------------------------------------------ */

ISE.AnswerEngine.normalizeAnswer = function (value) {

    if (value === null || value === undefined) {
        return "";
    }

    return ISE.SemanticEngine.normalize(value);
};


ISE.AnswerEngine.answerMatches = function (
    desired,
    candidate
) {

    var wanted =
        ISE.AnswerEngine.normalizeAnswer(desired);

    var actual =
        ISE.AnswerEngine.normalizeAnswer(candidate);

    if (!wanted || !actual) {
        return false;
    }

    if (wanted === actual) {
        return true;
    }

    if (
        wanted === "yes" &&
        ISE.SemanticEngine.isYes(actual)
    ) {
        return true;
    }

    if (
        wanted === "no" &&
        ISE.SemanticEngine.isNo(actual)
    ) {
        return true;
    }

    if (
        wanted === "none" &&
        ISE.SemanticEngine.isNone(actual)
    ) {
        return true;
    }

    return false;
};


/* ------------------------------------------------------------
   RANGE ANSWER MATCHING
   ------------------------------------------------------------ */

ISE.AnswerEngine.rangeMatches = function (
    numericValue,
    candidateText
) {

    if (!Number.isFinite(Number(numericValue))) {
        return false;
    }

    var range =
        ISE.SemanticEngine.parseRange(candidateText);

    if (!range) {
        return false;
    }

    return ISE.SemanticEngine.rangeContains(
        range,
        Number(numericValue)
    );
};


