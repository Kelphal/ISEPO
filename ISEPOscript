/* ------------------------------------------------------------
   PROCESS ONE QUESTION
   ------------------------------------------------------------ */

ISE.Orchestrator.processQuestion =
function(
    question
)
{
    if(
        !ISE.Orchestrator
            .isEligible(
                question
            )
    )
    {
        ISE.Orchestrator
            .statistics
            .skippedQuestions++;

        return {
            success:
                false,

            skipped:
                true
        };
    }

    ISE.Orchestrator
        .markProcessing(
            question
        );

    ISE.Orchestrator
        .statistics
        .questionsProcessed++;

    try
    {
        ISE.Orchestrator
            .classify(
                question
            );

        var resolution =
            ISE.Orchestrator
                .resolve(
                    question
                );

        if(
            !ISE.Orchestrator
                .canAnswer(
                    question,
                    resolution
                )
        )
        {
            ISE.Orchestrator
                .markUnsupported(
                    question,
                    resolution
                );

            ISE.Orchestrator
                .removeProcessing(
                    question
                );

            return {
                success:
                    false,

                unsupported:
                    true,

                resolution:
                    resolution || null
            };
        }

        /*
         * Recovery engine performs the actual fill
         * and independent verification.
         */

        var result =
            ISE.RecoveryEngine &&
            typeof ISE.RecoveryEngine
                .process ===
            "function"
                ? ISE.RecoveryEngine
                    .process(
                        question,
                        resolution.answer,
                        false
                    )
                : null;

        if(
            result &&
            result.success
        )
        {
            ISE.Orchestrator
                .markSuccess(
                    question,
                    result
                );
        }
        else
        {
            ISE.Orchestrator
                .markFailure(
                    question,
                    result
                );
        }

        ISE.Orchestrator
            .removeProcessing(
                question
            );

        return result;
    }
    catch(error)
    {
        ISE.Orchestrator
            .statistics
            .orchestrationErrors++;

        ISE.Orchestrator
            .removeProcessing(
                question
            );

        ISE.Orchestrator
            .markFailure(
                question,
                {
                    success:
                        false,

                    reason:
                        error.message ||
                        "Orchestration exception."
                }
            );

        return {
            success:
                false,

            reason:
                error.message ||
                "Orchestration exception."
        };
    }
};


/* ------------------------------------------------------------
   PROCESS QUESTION BATCH
   ------------------------------------------------------------ */

ISE.Orchestrator.processBatch =
function(
    questions
)
{
    if(
        !Array.isArray(
            questions
        )
    )
    {
        return [];
    }

    var results = [];

    var limit =
        Math.min(
            questions.length,
            ISE.Orchestrator
                .config
                .maximumProcessingPerCycle
        );

    for(
        var i = 0;
        i < limit;
        i++
    )
    {
        results.push(
            ISE.Orchestrator
                .processQuestion(
                    questions[i]
                )
        );
    }

    /*
     * Keep remaining questions queued.
     */

    if(
        questions.length >
        limit
    )
    {
        for(
            var j = limit;
            j < questions.length;
            j++
        )
        {
            ISE.Orchestrator
                .pendingQuestions
                .push(
                    questions[j]
                );
        }
    }

    return results;
};


/* ------------------------------------------------------------
   QUEUE PENDING QUESTIONS
   ------------------------------------------------------------ */

ISE.Orchestrator.queueQuestions =
function(
    questions
)
{
    if(
        !Array.isArray(
            questions
        )
    )
    {
        return;
    }

    for(
        var i = 0;
        i < questions.length;
        i++
    )
    {
        var question =
            ISE.Orchestrator
                .prepareQuestion(
                    questions[i]
                );

        if(
            !question
        )
        {
            continue;
        }

        if(
            !ISE.Orchestrator
                .isEligible(
                    question
                )
        )
        {
            continue;
        }

        ISE.Orchestrator
            .pendingQuestions
            .push(
                question
            );
    }
};


/* ------------------------------------------------------------
   DEDUPLICATE PENDING QUEUE
   ------------------------------------------------------------ */

ISE.Orchestrator.cleanQueue =
function()
{
    var queue =
        ISE.Orchestrator
            .pendingQuestions;

    var result = [];

    var seen =
        {};

    for(
        var i = 0;
        i < queue.length;
        i++
    )
    {
        var question =
            queue[i];

        if(
            !question
        )
        {
            continue;
        }

        var id =
            ISE.Orchestrator
                .questionId(
                    question
                );

        if(
            !id
        )
        {
            continue;
        }

        if(
            seen[id]
        )
        {
            continue;
        }

        seen[id] =
            true;

        result.push(
            question
        );
    }

    ISE.Orchestrator
        .pendingQuestions =
        result;
};


/* ------------------------------------------------------------
   PROCESS PENDING
   ------------------------------------------------------------ */

ISE.Orchestrator.processPending =
function()
{
    if(
        !ISE.Orchestrator
            .pendingQuestions
            .length
    )
    {
        return [];
    }

    ISE.Orchestrator
        .cleanQueue();

    var batch =
        ISE.Orchestrator
            .pendingQuestions
            .splice(
                0,
                ISE.Orchestrator
                    .config
                    .maximumProcessingPerCycle
            );

    return ISE.Orchestrator
        .processBatch(
            batch
        );
};


/* ------------------------------------------------------------
   SCAN
   ------------------------------------------------------------ */

ISE.Orchestrator.scan =
function(
    reason
)
{
    if(
        ISE.Orchestrator
            .scanning
    )
    {
        ISE.Orchestrator
            .scanPending = true;

        return;
    }

    ISE.Orchestrator
        .scanning = true;

    ISE.Orchestrator
        .scanGeneration++;

    ISE.Orchestrator
        .domGeneration++;

    ISE.Orchestrator
        .statistics
        .scans++;

    ISE.Orchestrator
        .lastScan =
        ISE.Orchestrator.now();

    try
    {
        /*
         * Let existing DOM intelligence refresh itself.
         */

        if(
            ISE.DOM &&
            typeof ISE.DOM.fullScan ===
            "function"
        )
        {
            try
            {
                ISE.DOM.fullScan(
                    document
                );
            }
            catch(error)
            {
                ISE.Orchestrator
                    .statistics
                    .orchestrationErrors++;
            }
        }

        var questions =
            ISE.Orchestrator
                .extractQuestions();

        questions =
            ISE.Orchestrator
                .deduplicate(
                    questions
                );

        ISE.Orchestrator
            .statistics
            .questionsSeen +=
            questions.length;

        ISE.Orchestrator
            .queueQuestions(
                questions
            );

        ISE.Orchestrator
            .processPending();

        ISE.Orchestrator
            .lastProcess =
            ISE.Orchestrator.now();

        if(
            ISE.log
        )
        {
            ISE.log(
                "Intelligent scan:",
                reason || "manual",
                "questions:",
                questions.length
            );
        }
    }
    catch(error)
    {
        ISE.Orchestrator
            .statistics
            .orchestrationErrors++;

        if(
            ISE.warn
        )
        {
            ISE.warn(
                "Orchestrator scan error:",
                error
            );
        }
    }
    finally
    {
        ISE.Orchestrator
            .scanning = false;

        if(
            ISE.Orchestrator
                .scanPending
        )
        {
            ISE.Orchestrator
                .scanPending = false;

            ISE.Orchestrator
                .scheduleScan(
                    "pending-scan"
                );
        }
    }
};


/* ------------------------------------------------------------
   SCHEDULE SCAN
   ------------------------------------------------------------ */

ISE.Orchestrator.scheduleScan =
function(
    reason,
    delay
)
{
    var wait =
        delay !==
        undefined
            ? Number(
                delay
              )
            : ISE.Orchestrator
                .config
                .scanDelay;

    if(
        isNaN(wait)
    )
    {
        wait =
            ISE.Orchestrator
                .config
                .scanDelay;
    }

    if(
        ISE.Orchestrator
            .scanTimer
    )
    {
        clearTimeout(
            ISE.Orchestrator
                .scanTimer
        );
    }

    ISE.Orchestrator
        .scanTimer =
        setTimeout(
            function()
            {
                ISE.Orchestrator
                    .scanTimer =
                    null;

                ISE.Orchestrator
                    .scan(
                        reason ||
                        "scheduled"
                    );
            },
            Math.max(
                0,
                wait
            )
        );
};


