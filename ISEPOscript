ISE.PlatformEngine.safeAttr =
function(
    element,
    name
)
{
    if(
        !element ||
        !element.getAttribute
    )
    {
        return "";
    }

    try
    {
        return element.getAttribute(
            name
        ) || "";
    }
    catch(error)
    {
        return "";
    }
};


ISE.PlatformEngine.elementText =
function(
    element
)
{
    if(
        !element
    )
    {
        return "";
    }

    var parts = [];

    try
    {
        if(
            element.innerText
        )
        {
            parts.push(
                element.innerText
            );
        }

        if(
            element.textContent
        )
        {
            parts.push(
                element.textContent
            );
        }

        var aria =
            ISE.PlatformEngine
                .safeAttr(
                    element,
                    "aria-label"
                );

        if(
            aria
        )
        {
            parts.push(
                aria
            );
        }

        var title =
            ISE.PlatformEngine
                .safeAttr(
                    element,
                    "title"
                );

        if(
            title
        )
        {
            parts.push(
                title
            );
        }
    }
    catch(error)
    {
    }

    return ISE.PlatformEngine
        .normalize(
            parts.join(" ")
        );
};


ISE.PlatformEngine.isVisible =
function(
    element
)
{
    if(
        !element
    )
    {
        return false;
    }

    try
    {
        if(
            element.hidden
        )
        {
            return false;
        }

        var style =
            window.getComputedStyle(
                element
            );

        if(
            style.display ===
            "none"
        )
        {
            return false;
        }

        if(
            style.visibility ===
            "hidden"
        )
        {
            return false;
        }

        if(
            parseFloat(
                style.opacity
            ) ===
            0
        )
        {
            return false;
        }

        var rect =
            element.getBoundingClientRect();

        return (
            rect.width > 0 &&
            rect.height > 0
        );
    }
    catch(error)
    {
        return true;
    }
};


ISE.PlatformEngine.isDisabled =
function(
    element
)
{
    if(
        !element
    )
    {
        return true;
    }

    try
    {
        if(
            element.disabled
        )
        {
            return true;
        }

        var aria =
            ISE.PlatformEngine
                .safeAttr(
                    element,
                    "aria-disabled"
                );

        if(
            aria ===
            "true"
        )
        {
            return true;
        }

        var disabled =
            ISE.PlatformEngine
                .safeAttr(
                    element,
                    "disabled"
                );

        return (
            disabled !==
            null &&
            disabled !==
            ""
        );
    }
    catch(error)
    {
        return false;
    }
};


