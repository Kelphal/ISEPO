/* ============================================================
   CATEGORY SCORE
   ============================================================ */

ISE.AdvancedSemantics.categoryScore =
function(
    text,
    category
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    var terms =
        ISE.AdvancedSemantics
            .categoryTerms[
                category
            ];

    if(
        !terms
    )
    {
        return 0;
    }

    var score = 0;

    for(
        var i = 0;
        i < terms.length;
        i++
    )
    {
        var term =
            ISE.AdvancedSemantics
                .normalize(
                    terms[i]
                );

        if(
            normalized ===
            term
        )
        {
            score += 1;
            continue;
        }

        if(
            normalized.indexOf(
                term
            ) !== -1
        )
        {
            score +=
                term.indexOf(" ") !== -1
                    ? 0.60
                    : 0.35;
        }
    }

    return Math.min(
        1,
        score
    );
};


