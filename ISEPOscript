                                normalize(alias)
                            ) !== -1
                        ) {

                            score +=
                                1;

                            matchedAliases.push(
                                alias
                            );
                        }
                    }
                );

                if (score > 0) {

                    matches.push({

                        fact:
                            fact,

                        score:
                            score,

                        aliases:
                            matchedAliases
                    });
                }
            }
        );

        matches.sort(
            function (a, b) {

                return (
                    b.score -
                    a.score
                );
            }
        );

        return matches;
