};


/* ============================================================
   RANGE BOUNDARY DETECTION
   ============================================================ */

ISE.AdvancedSemantics.detectBoundary =
function(
    text
)
{
    var normalized =
        ISE.AdvancedSemantics
            .normalize(
                text
            );

    var lower =
        null;

    var upper =
        null;

    var lowerMatch =
        normalized.match(
            /(?:under|below|less than|up to)\s*\$?\s*([\d,.]+)\s*(k|m)?/
        );

    if(
        lowerMatch
    )
    {
        upper =
            ISE.AdvancedSemantics
                .parseMoney(
                    lowerMatch[1] +
                    (
                        lowerMatch[2] ||
                        ""
                    )
                );
    }

    var upperMatch =
        normalized.match(
            /(?:over|above|more than|at least)\s*\$?\s*([\d,.]+)\s*(k|m)?/
        );

    if(
        upperMatch
    )
    {
        lower =
            ISE.AdvancedSemantics
                .parseMoney(
                    upperMatch[1] +
                    (
                        upperMatch[2] ||
                        ""
                    )
                );
    }

    if(
        lower ===
        null &&
        upper ===
        null
    )
    {
        return null;
    }

    return {
        minimum:
            lower,

        maximum:
            upper
    };
};


/* ============================================================
   PROFILE RANGE ANSWER
   ============================================================ */

ISE.AdvancedSemantics.resolveRangeAgainstProfile =
function(
    optionText,
    category
)
{
    var profile =
        ISE.PROFILE ||
        {};

    var value =
        null;

    if(
        category ===
        "income"
    )
    {
        value =
            Number(
                profile.income
            );

        if(
            isNaN(value)
        )
        {
            value =
                ISE.AdvancedSemantics
                    .parseMoney(
                        profile.householdIncome
                    );
        }
    }

    if(
        category ===
        "age"
    )
    {
        value =
            Number(
                profile.age
            );
    }

    if(
        category ===
        "children"
    )
    {
        value =
            Number(
                profile.children
            );
    }

    if(
        category ===
        "vehicle"
    )
    {
        value =
            Number(
                profile.cars
            );
    }

    if(
        value ===
        null ||
        isNaN(value)
    )
    {
        return {
            supported:
                false,

            reason:
                "No numeric profile value available."
        };
    }

    var range =
        ISE.AdvancedSemantics
            .parseRange(
                optionText
            );

    if(
        range
    )
    {
        return {
            supported:
                true,

            answer:
                ISE.AdvancedSemantics
                    .valueInRange(
                        value,
                        range
                    )
                    ? "yes"
                    : "no",

            matched:
                ISE.AdvancedSemantics
                    .valueInRange(
                        value,
                        range
                    ),

            confidence:
                1,

            source:
                "profile-range"
        };
    }

    var boundary =
        ISE.AdvancedSemantics
            .detectBoundary(
                optionText
            );

    if(
        boundary
    )
    {
        var matches =
            true;

        if(
            boundary.minimum !==
            null
        )
        {
            matches =
                matches &&
                value >=
                boundary.minimum;
        }

        if(
            boundary.maximum !==
            null
        )
        {
            matches =
                matches &&
                value <=
                boundary.maximum;
        }

        return {
            supported:
                true,

            answer:
                matches
                    ? "yes"
                    : "no",

            matched:
                matches,

            confidence:
                1,

            source:
                "profile-boundary"
        };
    }

    return {
        supported:
            false,

        reason:
            "Option does not contain a recognized range."
    };
};


