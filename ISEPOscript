/* ------------------------------------------------------------
   CLASSIFICATION
   ------------------------------------------------------------ */

ISE.Orchestrator.classify =
function(
    question
)
{
    if(
        !question
    )
    {
        return null;
    }

    if(
        question.category
    )
    {
        return question;
    }

    if(
        ISE.classifier &&
        typeof ISE.classifier.classify ===
        "function"
    )
    {
        try
        {
            var classification =
                ISE.classifier
                    .classify(
                        question.text ||
                        ""
                    );

            if(
                classification
            )
            {
                if(
                    typeof classification ===
                    "string"
                )
                {
                    question.category =
                        classification;
                }
                else
                {
                    question.classification =
                        classification;

                    if(
                        classification.category
                    )
                    {
                        question.category =
                            classification.category;
                    }
                }
            }
        }
        catch(error)
        {
            ISE.Orchestrator
                .statistics
                .orchestrationErrors++;
        }
    }

    if(
        !question.category &&
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine
            .detectCategory ===
        "function"
    )
    {
        try
        {
            question.category =
                ISE.AnswerEngine
                    .detectCategory(
                        question.text ||
                        ""
                    );
        }
        catch(error)
        {
        }
    }

    return question;
};


/* ------------------------------------------------------------
   RESOLUTION PREVIEW
   ------------------------------------------------------------ */

ISE.Orchestrator.resolve =
function(
    question
)
{
    if(
        !question
    )
    {
        return null;
    }

    if(
        ISE.AnswerEngine &&
        typeof ISE.AnswerEngine
            .resolve ===
        "function"
    )
    {
        try
        {
            var resolution =
                ISE.AnswerEngine
                    .resolve(
                        question.text ||
                        ""
                    );

            ISE.Orchestrator
                .statistics
                .semanticResolutions++;

            question.resolution =
                resolution;

            return resolution;
        }
        catch(error)
        {
            ISE.Orchestrator
                .statistics
                .orchestrationErrors++;

            return null;
        }
    }

    return null;
};


/* ------------------------------------------------------------
   SUPPORTED ANSWER CHECK
   ------------------------------------------------------------ */

ISE.Orchestrator.isSupported =
function(
    question,
    resolution
)
{
    if(
        !question ||
        !resolution
    )
    {
        return false;
    }

    if(
        resolution.supported ===
        false
    )
    {
        return false;
    }

    if(
        resolution.answer ===
        null ||
        typeof resolution.answer ===
        "undefined"
    )
    {
        return false;
    }

    if(
        String(
            resolution.answer
        ).trim() ===
        ""
    )
    {
        return false;
    }

    return true;
};


/* ------------------------------------------------------------
   CONFIDENCE CHECK
   ------------------------------------------------------------ */

ISE.Orchestrator.confidence =
function(
    resolution
)
{
    if(
        !resolution
    )
    {
        return 0;
    }

    var value =
        Number(
            resolution.confidence
        );

    if(
        !isNaN(value)
    )
    {
        return Math.max(
            0,
            Math.min(
                1,
                value
            )
        );
    }

    if(
        resolution.score !==
        undefined
    )
    {
        value =
            Number(
                resolution.score
            );

        if(
            !isNaN(value)
        )
        {
            if(
                value > 1
            )
            {
                value =
                    value / 100;
            }

            return Math.max(
                0,
                Math.min(
                    1,
                    value
                )
            );
        }
    }

    return 0.5;
};


/* ------------------------------------------------------------
   PROFILE-SUPPORTED DECISION
   ------------------------------------------------------------ */

ISE.Orchestrator.canAnswer =
function(
    question,
    resolution
)
{
    if(
        !ISE.Orchestrator
            .isSupported(
                question,
                resolution
            )
    )
    {
        return false;
    }

    var confidence =
        ISE.Orchestrator
            .confidence(
                resolution
            );

    var minimum =
        0.70;

    if(
        ISE.CONFIG &&
        ISE.CONFIG
            .minimumAnswerConfidence !==
        undefined
    )
    {
        minimum =
            Number(
                ISE.CONFIG
                    .minimumAnswerConfidence
            );
    }

    /*
     * Explicitly supported deterministic
     * profile answers can pass even if an older
     * resolver did not expose confidence.
     */

    if(
        resolution.source ===
        "profile" ||
        resolution.source ===
        "explicit-profile" ||
        resolution.deterministic ===
        true
    )
    {
        return true;
    }

    return (
        confidence >=
        minimum
    );
};


/* ------------------------------------------------------------
   ANSWER-CHOICE SAFETY
   ------------------------------------------------------------ */

ISE.Orchestrator.isAnswerChoice =
function(
    question
)
{
    if(
        !question
    )
    {
        return true;
    }

    if(
        question.isAnswerChoice ===
        true
    )
    {
        return true;
    }

    var text =
        ISE.Orchestrator
            .normalize(
                question.text ||
                ""
            );

    if(
        !text
    )
    {
        return true;
    }

    /*
     * Very short text is usually an answer option,
     * not a question.
     */

    if(
        text.length <
        3
    )
    {
        return true;
    }

    /*
     * Existing DOM intelligence gets priority.
     */

    if(
        ISE.DOM &&
        typeof ISE.DOM.isAnswerChoice ===
        "function"
    )
    {
        try
        {
            if(
                ISE.DOM.isAnswerChoice(
                    question
                )
            )
            {
                return true;
            }
        }
        catch(error)
        {
        }
    }

    /*
     * Common standalone answer labels.
     */

    var exactChoices =
    [
        "yes",
        "no",
        "maybe",
        "other",
        "none",
        "none of these",
        "not sure",
        "don't know",
        "prefer not to say",
        "male",
        "female",
        "single",
        "married"
    ];

    for(
        var i = 0;
        i < exactChoices.length;
        i++
    )
    {
        if(
            text ===
            exactChoices[i]
        )
        {
            return true;
        }
    }

    return false;
};


/* ------------------------------------------------------------
   QUESTION ELIGIBILITY
   ------------------------------------------------------------ */

ISE.Orchestrator.isEligible =
function(
    question
)
{
    if(
        !question
    )
    {
        return false;
    }

    if(
        !ISE.Orchestrator
            .isAlive(
                question
            )
    )
    {
        return false;
    }

    if(
        !ISE.Orchestrator
            .isVisible(
                question
            )
    )
    {
        return false;
    }

    if(
        ISE.Orchestrator
            .isExpired(
                question
            )
    )
    {
        return false;
    }

    if(
        ISE.Orchestrator
            .isAnswerChoice(
                question
            )
    )
    {
        return false;
    }

    /*
     * A question already verified as successful
     * does not need immediate processing again.
     */

    var id =
        ISE.Orchestrator
            .questionId(
                question
            );

    if(
        id &&
        ISE.Orchestrator
            .processedIds[id]
    )
    {
        var record =
            ISE.Orchestrator
                .processedIds[id];

        if(
            record.status ===
            "success"
        )
        {
            return false;
        }
    }

    return true;
};


