            }

            /*
             * Choice-based controls.
             */

            var bestChoice =
                findBestChoice(
                    answer.answer,
                    choices,
                    questionType,
                    profileValue
                );

            if (
                !bestChoice
            ) {

                return {

                    supported:
                        true,

                    filled:
                        false,

                    answer:
                        answer,

                    question:
                        questionText,

                    reason:
                        "Answer resolved but no safe rendered choice matched",

                    type:
                        questionType
