    );

    console.log(
        "Evidence:",
        question.evidence
    );

    console.log(
        "Controls:",
        ISE.DOM.analyzeControls(
            question
        )
    );

    console.log(
        "Platform:",
        question.platform
    );

    console.groupEnd();
};


