    function extractAge(text) {

        var normalized = normalize(text);

        var match =
            normalized.match(
                /\b(\d{1,3})\s*(?:years?\s*old|yo)\b/
            );

        if (match) {
            return Number(match[1]);
        }

        match =
            normalized.match(
                /\bage\s*(?:is|of|:)?\s*(\d{1,3})\b/
            );

        if (match) {
            return Number(match[1]);
        }

        return null;
    }


    function extractMoney(text) {

        var normalized = normalize(text);

        var match =
            normalized.match(
                /\$?\s*([\d,]+(?:\.\d+)?)\s*(k|thousand|m|million)?/
